{
  "series": "Separuh Hayat",
  "season": 4,
  "episode": 7,
  "title": "S4 E7",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 4 — EPISODE 7\n## THE TRUTH"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di hadapan tingkap pejabat."
    },
    {
      "type": "paragraph",
      "text": "Di bawah, pekerja mula masuk."
    },
    {
      "type": "paragraph",
      "text": "Kereta."
    },
    {
      "type": "paragraph",
      "text": "Motosikal."
    },
    {
      "type": "paragraph",
      "text": "Lori."
    },
    {
      "type": "paragraph",
      "text": "Semua bergerak seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang paling menakutkan."
    },
    {
      "type": "paragraph",
      "text": "Dunia masih kelihatan normal."
    },
    {
      "type": "paragraph",
      "text": "Sedangkan sesuatu sedang pecah dari dalam."
    },
    {
      "type": "paragraph",
      "text": "Telefon di atas meja berdering."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "**Khalid.**"
    },
    {
      "type": "paragraph",
      "text": "Dia biarkan beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Masih marah?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak kenal kau cukup lama untuk marah.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Bagus. Maksudnya kau masih berfikir.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tahu tentang Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Semua?”"
    },
    {
      "type": "paragraph",
      "text": "“Yang penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau begitu kita perlu bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Mereka bertemu di sebuah bangunan lama."
    },
    {
      "type": "paragraph",
      "text": "Tiada tanda nama."
    },
    {
      "type": "paragraph",
      "text": "Tiada pekerja."
    },
    {
      "type": "paragraph",
      "text": "Hanya satu meja dan dua kerusi."
    },
    {
      "type": "paragraph",
      "text": "Khalid sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak kebenaran.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Masalah dengan kebenaran ialah orang biasanya hanya mahu separuh.”"
    },
    {
      "type": "paragraph",
      "text": "“Cuba aku.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid membuka sebuah fail lama."
    },
    {
      "type": "paragraph",
      "text": "“Hashim bukan pengasas pertama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Bumi Perdana sudah wujud sebelum dia mengambil alih.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid menolak satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki."
    },
    {
      "type": "paragraph",
      "text": "Usia sekitar enam puluhan."
    },
    {
      "type": "paragraph",
      "text": "Wajah serius."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang gambar itu."
    },
    {
      "type": "paragraph",
      "text": "“Siapa dia?”"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik.”"
    },
    {
      "type": "paragraph",
      "text": "“Chemist?”"
    },
    {
      "type": "paragraph",
      "text": "“Lebih daripada itu.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Dia orang yang membina asas sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang gambar sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "“Dan Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim datang kemudian.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam aku?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Lebih kurang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak suka jawapan itu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Khalid menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik bukan orang yang suka wang.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa yang dia mahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia mahu sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dia percaya kalau sistem cukup baik, manusia tidak perlu memegang terlalu banyak kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim percaya sebaliknya.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Hashim belajar daripada sistem Malik.”"
    },
    {
      "type": "paragraph",
      "text": "“Kemudian?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia ubah sistem itu.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk wang?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk kawalan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuba hentikan dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Dan kau gagal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Jawapan itu terlalu cepat."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid memandang tepat kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku buat kesilapan yang sama seperti kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku fikir aku boleh mengawal orang lain.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Khalid mengeluarkan satu lagi gambar."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Tiga orang berdiri di hadapan sebuah bangunan lama."
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Bertahun-tahun sebelum kau kenal Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik masih hidup?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau tipu.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak ada masa untuk permainan.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau benar-benar mahu tahu, tanya soalan yang betul.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa soalan yang betul?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa Hashim pilih kau?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Sepanjang perjalanan pulang, satu soalan bermain dalam kepala Rizal."
    },
    {
      "type": "paragraph",
      "text": "**Kenapa Hashim pilih aku?**"
    },
    {
      "type": "paragraph",
      "text": "Pada awalnya dia fikir kerana kepakaran."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kerana cara berfikir."
    },
    {
      "type": "paragraph",
      "text": "Tetapi semakin dia fikir—"
    },
    {
      "type": "paragraph",
      "text": "semakin pelik."
    },
    {
      "type": "paragraph",
      "text": "Hashim mempunyai orang yang lebih berpengalaman."
    },
    {
      "type": "paragraph",
      "text": "Lebih setia."
    },
    {
      "type": "paragraph",
      "text": "Lebih lama berada dalam rangkaian."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Hashim memilih seorang guru kimia berusia 50 tahun yang baru masuk ke dunia itu."
    },
    {
      "type": "paragraph",
      "text": "Kenapa?"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Adam berada di pejabat ketika Rizal tiba."
    },
    {
      "type": "paragraph",
      "text": "“Jumpa Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa dia mahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia cerita tentang Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim bukan orang pertama.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Nama itu jelas bukan nama asing baginya."
    },
    {
      "type": "paragraph",
      "text": "Rizal perasan."
    },
    {
      "type": "paragraph",
      "text": "“Kau kenal?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Aku pernah dengar nama dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang industri.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tak pernah cerita?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku tak fikir penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku rasa kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada malam yang sama, Farid duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia memegang telefon."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Nama itu masih di skrin."
    },
    {
      "type": "paragraph",
      "text": "Dia masih belum menelefon."
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba seseorang mengetuk tingkap."
    },
    {
      "type": "paragraph",
      "text": "Farid terkejut."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki berdiri di luar."
    },
    {
      "type": "paragraph",
      "text": "Farid tidak membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu menunjukkan sekeping kertas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memasukkannya melalui celah tingkap."
    },
    {
      "type": "paragraph",
      "text": "Farid mengambil."
    },
    {
      "type": "paragraph",
      "text": "Satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**AMIR AKAN BERTEMU RIZAL ESOK.**"
    },
    {
      "type": "paragraph",
      "text": "Farid melihat lelaki itu."
    },
    {
      "type": "paragraph",
      "text": "“Siapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Farid membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi lelaki itu sudah hilang."
    },
    {
      "type": "paragraph",
      "text": "Farid kembali ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat kertas itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian meramasnya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Amir bertemu Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bukan di rumah."
    },
    {
      "type": "paragraph",
      "text": "Bukan di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Di sebuah kedai kopi."
    },
    {
      "type": "paragraph",
      "text": "Tempat biasa."
    },
    {
      "type": "paragraph",
      "text": "Tempat mereka pernah duduk sebagai keluarga."
    },
    {
      "type": "paragraph",
      "text": "Amir memesan kopi."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak memesan apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Amir berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu kenapa aku pilih tempat ini?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab dulu kita pernah datang sini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tanya satu soalan.”"
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau boleh kembali ke hari kau tahu kau sakit…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Adakah kau akan buat semua ini lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang meja."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu lebih sukar daripada semua soalan lain."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Itu jawapan yang jujur.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku cuba faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Sebagai penyiasat?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebagai keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Amir menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Aku dah nampak terlalu banyak orang buat benda yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk wang?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Mula-mula mereka kata mereka buat untuk orang yang mereka sayang.”"
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kemudian mereka mula gunakan orang yang mereka sayang sebagai alasan untuk terus buat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Amir memandang tepat kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan jadi orang macam itu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar kedai, Farid melihat mereka."
    },
    {
      "type": "paragraph",
      "text": "Dia datang tanpa memberitahu Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya mahu memastikan tiada apa berlaku."
    },
    {
      "type": "paragraph",
      "text": "Tetapi apabila dia melihat Amir duduk berhadapan Rizal—"
    },
    {
      "type": "paragraph",
      "text": "hatinya semakin berat."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat Amir bangun."
    },
    {
      "type": "paragraph",
      "text": "Berjabat tangan dengan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berjalan pergi."
    },
    {
      "type": "paragraph",
      "text": "Farid masih berada di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Mesej."
    },
    {
      "type": "paragraph",
      "text": "**SEKARANG.**"
    },
    {
      "type": "paragraph",
      "text": "Farid memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua."
    },
    {
      "type": "paragraph",
      "text": "**ATAU KELUARGA KAU.**"
    },
    {
      "type": "paragraph",
      "text": "Farid menutup telefon."
    },
    {
      "type": "paragraph",
      "text": "“Cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menghidupkan enjin."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Amir sampai ke keretanya."
    },
    {
      "type": "paragraph",
      "text": "Sebelum membuka pintu, dia terdengar bunyi telefon."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "Suara lelaki."
    },
    {
      "type": "paragraph",
      "text": "“Berhenti siasat Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "“Kalau tidak, keluarga kau akan terlibat.”"
    },
    {
      "type": "paragraph",
      "text": "Amir melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Siapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang cuba beri kau peluang.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak perlukan peluang.”"
    },
    {
      "type": "paragraph",
      "text": "“Semua orang perlukan peluang.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Amir berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana lucu."
    },
    {
      "type": "paragraph",
      "text": "Kerana dia akhirnya faham."
    },
    {
      "type": "paragraph",
      "text": "Orang yang mengancamnya bukan sekadar mahu melindungi Rizal."
    },
    {
      "type": "paragraph",
      "text": "Mereka mahu dia terus menyiasat."
    },
    {
      "type": "paragraph",
      "text": "Kenapa?"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir kembali ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil semua fail."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Dia susun semuanya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia nampak sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Satu tarikh."
    },
    {
      "type": "paragraph",
      "text": "Tarikh yang sama muncul dalam dua fail berbeza."
    },
    {
      "type": "paragraph",
      "text": "Fail lama Hashim."
    },
    {
      "type": "paragraph",
      "text": "Dan rekod awal Rizal."
    },
    {
      "type": "paragraph",
      "text": "Amir berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Tak mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menyemak sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Tarikh itu bukan kebetulan."
    },
    {
      "type": "paragraph",
      "text": "Sebelum Rizal bertemu Hashim."
    },
    {
      "type": "paragraph",
      "text": "Sebelum Rizal masuk Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Sebelum Ah Len menjadi penghubung."
    },
    {
      "type": "paragraph",
      "text": "Sebelum semua itu—"
    },
    {
      "type": "paragraph",
      "text": "seseorang sudah mengetahui tentang Rizal."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Rizal sedang melihat gambar lama keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Bayi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia teringat satu ayat Hashim."
    },
    {
      "type": "paragraph",
      "text": "**“Jangan cuba jadi seperti saya. Jadi lebih baik.”**"
    },
    {
      "type": "paragraph",
      "text": "Kini dia mula tertanya-tanya."
    },
    {
      "type": "paragraph",
      "text": "Adakah Hashim benar-benar memilihnya?"
    },
    {
      "type": "paragraph",
      "text": "Atau seseorang memilihnya untuk Hashim?"
    },
    {
      "type": "paragraph",
      "text": "Telefon Rizal berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "Daripada nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "**KAU MAHU TAHU SIAPA YANG MULAKAN SEMUANYA?**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "**TANYA ADAM.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memandang nama Adam di dalam telefonnya."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menelefon."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej terakhir masuk."
    },
    {
      "type": "paragraph",
      "text": "**DAN TANYA KENAPA DIA TIDAK PERNAH CERITA TENTANG DR. MALIK.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali—"
    },
    {
      "type": "paragraph",
      "text": "Adam bukan lagi sekadar rakan kongsi."
    },
    {
      "type": "paragraph",
      "text": "Dia mungkin menyimpan rahsia."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 7**"
    }
  ],
