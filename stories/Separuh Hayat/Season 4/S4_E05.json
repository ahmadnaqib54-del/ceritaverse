  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 4 — EPISODE 5\n## THE NET"
    },
    {
      "type": "paragraph",
      "text": "Pagi itu, Rizal tiba di Bumi Perdana lebih awal daripada biasa."
    },
    {
      "type": "paragraph",
      "text": "Pukul 6:47."
    },
    {
      "type": "paragraph",
      "text": "Bangunan masih sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia suka waktu begini."
    },
    {
      "type": "paragraph",
      "text": "Tiada orang bertanya."
    },
    {
      "type": "paragraph",
      "text": "Tiada telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Tiada keputusan yang perlu dibuat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi pagi itu berbeza."
    },
    {
      "type": "paragraph",
      "text": "Dia datang bukan untuk bekerja."
    },
    {
      "type": "paragraph",
      "text": "Dia datang untuk mencari siapa yang sedang melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke bilik kawalan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa skrin memaparkan aktiviti bangunan."
    },
    {
      "type": "paragraph",
      "text": "Dia memerhatikan satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia bertanya kepada seorang penyelia,"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang ada akses penuh?”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa orang saja.”"
    },
    {
      "type": "paragraph",
      "text": "“Senaraikan.”"
    },
    {
      "type": "paragraph",
      "text": "Penyelia itu kelihatan hairan."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit kemudian, senarai itu berada di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Pengurus."
    },
    {
      "type": "paragraph",
      "text": "Penyelia."
    },
    {
      "type": "paragraph",
      "text": "Admin."
    },
    {
      "type": "paragraph",
      "text": "IT."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Hakim."
    },
    {
      "type": "paragraph",
      "text": "Beberapa nama lain."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti pada satu nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian teruskan."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada apa-apa yang jelas."
    },
    {
      "type": "paragraph",
      "text": "Itulah masalahnya."
    },
    {
      "type": "paragraph",
      "text": "Kalau pengkhianat terlalu mudah dilihat, dia bukan pengkhianat."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Maya masuk pukul 8:10."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat Rizal sudah berada di pejabat."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tidur.”"
    },
    {
      "type": "paragraph",
      "text": "Maya meletakkan fail."
    },
    {
      "type": "paragraph",
      "text": "“Masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak.”"
    },
    {
      "type": "paragraph",
      "text": "“Duit?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Operasi?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi orang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum nipis."
    },
    {
      "type": "paragraph",
      "text": "“Kau semakin kenal aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya bekerja dengan nombor. Nombor biasanya beritahu bila manusia buat sesuatu yang pelik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Ada yang pelik?”"
    },
    {
      "type": "paragraph",
      "text": "Maya membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Beberapa perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Contohnya?”"
    },
    {
      "type": "paragraph",
      "text": "“Pergerakan aset.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Maya menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Bukan semestinya salah. Tetapi coraknya berubah.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh jelaskan?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya tak mahu buat tuduhan berdasarkan corak saja.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Maya menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya nak satu perkara daripada awak.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan minta saya tutup sesuatu yang saya sendiri tak faham.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nampak masalah, beritahu aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Walaupun masalah itu melibatkan awak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Terutama kalau melibatkan aku.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang pintu yang tertutup."
    },
    {
      "type": "paragraph",
      "text": "Maya bukan ancaman."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "Tetapi orang yang tidak boleh dibeli adalah masalah yang sukar dijangka."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada waktu yang sama, Amir berada di sebuah kenderaan."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya sebuah bangunan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai di sebelahnya bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kita masuk?”"
    },
    {
      "type": "paragraph",
      "text": "Amir menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita dah lama tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita tunggu orang yang kita mahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Amir melihat telefon."
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Farid keluar dari sebuah bangunan sekitar tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Sebelum sempat menghidupkan enjin, seseorang mengetuk tingkap."
    },
    {
      "type": "paragraph",
      "text": "Farid terkejut."
    },
    {
      "type": "paragraph",
      "text": "Amir berdiri di luar."
    },
    {
      "type": "paragraph",
      "text": "Farid membuka tingkap sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Encik Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Farid keluar."
    },
    {
      "type": "paragraph",
      "text": "Mereka berdiri di tepi jalan."
    },
    {
      "type": "paragraph",
      "text": "Amir berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tanya beberapa soalan.”"
    },
    {
      "type": "paragraph",
      "text": "“Pasal apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tidak berubah wajah."
    },
    {
      "type": "paragraph",
      "text": "“Bos saya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia banyak berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang berubah.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan macam itu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mendekat sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu apa yang dia buat sebelum dia jadi macam sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "“Aku tanya sebab kau antara orang yang paling dekat dengan dia.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Saya kerja dengan dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya percaya dia.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Farid tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab masa orang lain lari, dia tak lari.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Itu jawapan yang bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi ia bukan jawapan kepada soalan aku.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya rasa itu saja yang saya ada.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian beredar."
    },
    {
      "type": "paragraph",
      "text": "Farid masuk semula ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**AMIR DAH MULA MENDEKATI KAU.**"
    },
    {
      "type": "paragraph",
      "text": "Farid melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu siapa yang menghantar."
    },
    {
      "type": "paragraph",
      "text": "Dia padam mesej itu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal bertemu Adam."
    },
    {
      "type": "paragraph",
      "text": "“Kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kau perlu lebih spesifik.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus serius."
    },
    {
      "type": "paragraph",
      "text": "“Apa dia tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum cukup bukan bermaksud tak cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Khalid apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu tentang kita.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berjalan ke tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Kau patut tinggalkan dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia beri amaran.”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang memberi amaran juga boleh menjadi ancaman.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Kita tak boleh lawan semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita tak perlu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita cari siapa yang menghubungkan mereka.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "“Farid?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Rahman?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak pasti.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut satu lagi nama."
    },
    {
      "type": "paragraph",
      "text": "“Maya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Aku bukan menuduh.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi dia ada akses.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia juga ada alasan untuk berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia belum berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Maya masih di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Hanya satu lampu menyala."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka beberapa fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu dokumen lama."
    },
    {
      "type": "paragraph",
      "text": "Nama syarikat."
    },
    {
      "type": "paragraph",
      "text": "Nama pengarah."
    },
    {
      "type": "paragraph",
      "text": "Tarikh."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Ada sesuatu yang tidak kena."
    },
    {
      "type": "paragraph",
      "text": "Bukan satu transaksi."
    },
    {
      "type": "paragraph",
      "text": "Bukan satu akaun."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sejarah."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat berubah pemilikan dalam tempoh yang terlalu singkat."
    },
    {
      "type": "paragraph",
      "text": "Maya mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Menulis di atas kertas:"
    },
    {
      "type": "paragraph",
      "text": "**SIAPA YANG MULAKAN?**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi:"
    },
    {
      "type": "paragraph",
      "text": "**HASHIM?**"
    },
    {
      "type": "paragraph",
      "text": "Dia silang."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL?**"
    },
    {
      "type": "paragraph",
      "text": "Dia silang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia tulis:"
    },
    {
      "type": "paragraph",
      "text": "**SEBELUM HASHIM.**"
    },
    {
      "type": "paragraph",
      "text": "Maya bersandar."
    },
    {
      "type": "paragraph",
      "text": "Telefon pejabat berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia terkejut."
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada suara."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian suara lelaki."
    },
    {
      "type": "paragraph",
      "text": "“Awak Maya?”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak sedang cari benda yang tidak patut dicari.”"
    },
    {
      "type": "paragraph",
      "text": "Maya terus diam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa awak?”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Maya memandang telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak panik."
    },
    {
      "type": "paragraph",
      "text": "Sebaliknya, dia mengambil fail tadi."
    },
    {
      "type": "paragraph",
      "text": "Dan menyimpannya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Suara Linda kedengaran letih."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Roy tanya bila kau datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Boleh aku jumpa dia?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Linda berhenti seketika."
    },
    {
      "type": "paragraph",
      "text": "“Kau okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ruang tamu yang kosong."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau menipu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dulu bila kau menipu, kau fikir kau pandai.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku dah kenal suara kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "“Aku cuba selesaikan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal…”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma nak kamu semua selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang cara paling selamat ialah berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Datang jumpa Roy esok.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan datang sebagai orang yang cuba menyelesaikan semua benda.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memejam mata."
    },
    {
      "type": "paragraph",
      "text": "“Datang sebagai ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Rizal pergi berjumpa Roy."
    },
    {
      "type": "paragraph",
      "text": "Roy sedang duduk di kerusi roda."
    },
    {
      "type": "paragraph",
      "text": "Bayi mereka tidur tidak jauh daripadanya."
    },
    {
      "type": "paragraph",
      "text": "“Assalamualaikum, Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Waalaikumsalam.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Roy melihat jam di tangan ayahnya."
    },
    {
      "type": "paragraph",
      "text": "“Masih pakai?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya ingat Ayah dah buang.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab Ayah dah ada banyak jam lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Yang ini lain.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Hadiah daripada kau.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah bahagia?”"
    },
    {
      "type": "paragraph",
      "text": "Soalan itu mudah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Rizal tidak mampu menjawab."
    },
    {
      "type": "paragraph",
      "text": "Roy menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau Ayah penat, baliklah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang anaknya."
    },
    {
      "type": "paragraph",
      "text": "“Balik ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "Roy menunjuk rumah."
    },
    {
      "type": "paragraph",
      "text": "“Ke sini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, semua yang dia bina terasa tidak penting."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefonnya bergetar."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**MEREKA SUDAH DALAM JARING.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Gambar."
    },
    {
      "type": "paragraph",
      "text": "Amir."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Dan dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Semua dalam satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "“Roy…”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mampu meneruskan ayat."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandang anaknya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon bergetar lagi."
    },
    {
      "type": "paragraph",
      "text": "**JARING SUDAH DITUTUP.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia faham."
    },
    {
      "type": "paragraph",
      "text": "Ini bukan lagi beberapa musuh yang bergerak secara berasingan."
    },
    {
      "type": "paragraph",
      "text": "Seseorang sedang menyusun mereka."
    },
    {
      "type": "paragraph",
      "text": "Dan mungkin—"
    },
    {
      "type": "paragraph",
      "text": "orang itu sudah berada lebih dekat daripada yang dia sangka."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 5**"
    }
