    {
      "type": "paragraph",
      "text": "“Dia ada duit.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia ada orang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Ah Len bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Dan dia ada sesuatu yang kita tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rangkaian.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Ah Len berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nak naik dari sini…”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“…kau akan perlukan orang macam dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Tak semestinya sekarang,” Ah Len menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Tapi satu hari nanti.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin lewat."
    },
    {
      "type": "paragraph",
      "text": "Ah Len sudah pergi."
    },
    {
      "type": "paragraph",
      "text": "Adam duduk di hadapan Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tak naik…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tahu maksudnya."
    },
    {
      "type": "paragraph",
      "text": "“Kita akan tersekat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat rekod kewangan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat jadual permintaan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian gambar Dato' Hashim di telefon."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki yang sudah memiliki apa yang Rizal sedang cuba bina."
    },
    {
      "type": "paragraph",
      "text": "Rangkaian."
    },
    {
      "type": "paragraph",
      "text": "Tempat."
    },
    {
      "type": "paragraph",
      "text": "Orang."
    },
    {
      "type": "paragraph",
      "text": "Modal."
    },
    {
      "type": "paragraph",
      "text": "Sistem."
    },
    {
      "type": "paragraph",
      "text": "Rizal mematikan skrin."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Belum apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum jumpa dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Rizal pulang awal."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada beberapa dokumen."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Apa tu?”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Abang punya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil dokumen itu."
    },
    {
      "type": "paragraph",
      "text": "Penyata bank."
    },
    {
      "type": "paragraph",
      "text": "Beberapa transaksi."
    },
    {
      "type": "paragraph",
      "text": "Linda tidak bercakap."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa buka?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya isteri abang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Saya nampak duit masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk."
    },
    {
      "type": "paragraph",
      "text": "“Banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya bukan bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Berapa sebenarnya abang dapat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kalau abang tak nak cerita, saya tak boleh paksa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia bangun."
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya nak abang tahu sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Saya lebih takut dengan abang yang saya tak kenal…”"
    },
    {
      "type": "paragraph",
      "text": "Linda berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…daripada penyakit abang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mampu menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal menerima mesej."
    },
    {
      "type": "paragraph",
      "text": "Daripada nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "> **“Saya dengar kau sedang berkembang.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "> **“Kalau kau nak berkembang lebih jauh, jumpa saya.”**"
    },
    {
      "type": "paragraph",
      "text": "Tiada nama."
    },
    {
      "type": "paragraph",
      "text": "Hanya satu lokasi."
    },
    {
      "type": "paragraph",
      "text": "**Ayam Gepuk Hut.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian satu lagi mesej masuk."
    },
    {
      "type": "paragraph",
      "text": "> **“Tanya Ah Len siapa saya.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak perlu bertanya."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah tahu."
    },
    {
      "type": "paragraph",
      "text": "Dato' Hashim."
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang buku nota di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya tertulis:"
    },
    {
      "type": "paragraph",
      "text": "**RM500,000.**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**Selepas itu berhenti.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Dia menconteng ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan memadam."
    },
    {
      "type": "paragraph",
      "text": "Hanya menconteng."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menulis sesuatu yang baru."
    },
    {
      "type": "paragraph",
      "text": "**SCALE.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali, dia tidak lagi berfikir tentang bagaimana untuk mendapatkan cukup wang untuk keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Dia mula berfikir tentang—"
    },
    {
      "type": "paragraph",
      "text": "**berapa besar dia boleh jadi.**"
    }
  ],
