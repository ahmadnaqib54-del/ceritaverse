{
  "series": "Separuh Hayat",
  "season": 1,
  "episode": 6,
  "title": "S1 E6",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 6\n### Pembeli Pertama"
    },
    {
      "type": "paragraph",
      "text": "Pukul 10:17 malam."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Enjin dimatikan."
    },
    {
      "type": "paragraph",
      "text": "Di sebelahnya, Adam memandang sebuah kedai makan yang masih dibuka."
    },
    {
      "type": "paragraph",
      "text": "“Dia lambat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Sepuluh minit.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk orang macam dia, sepuluh minit bukan lambat.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia sedang tengok kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Dari mana?”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kau memang menenangkan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab selamba."
    },
    {
      "type": "paragraph",
      "text": "“Saya bukan dibayar untuk menenangkan.”"
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba seseorang mengetuk cermin."
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka pintu dan masuk."
    },
    {
      "type": "paragraph",
      "text": "“Lama tunggu?”"
    },
    {
      "type": "paragraph",
      "text": "“Sepuluh minit.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Masih kira masa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja saya memang macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len duduk."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Adam."
    },
    {
      "type": "paragraph",
      "text": "“Barang?”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Boleh tengok?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len mengambil masa memeriksa."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tergesa-gesa."
    },
    {
      "type": "paragraph",
      "text": "Rizal memerhatikannya."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "“Okay saja?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya kata bagus, harga naik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak."
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya suka kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak banyak cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau pun.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka berbincang mengenai urusan itu."
    },
    {
      "type": "paragraph",
      "text": "Tidak lama."
    },
    {
      "type": "paragraph",
      "text": "Ah Len akhirnya mengeluarkan wang."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, dia hanya memandang."
    },
    {
      "type": "paragraph",
      "text": "Ini lebih banyak daripada transaksi pertama."
    },
    {
      "type": "paragraph",
      "text": "Bukan cukup untuk mencapai sasaran."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk membuat dia sedar satu perkara."
    },
    {
      "type": "paragraph",
      "text": "**Pasaran itu wujud.**"
    },
    {
      "type": "paragraph",
      "text": "Dan Ah Len adalah pintunya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas Ah Len pergi, Adam duduk diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma terfikir.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita dah jual.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kita ada pelanggan.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan pelanggan tu nak lebih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan lagi tentang boleh atau tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang masalah kita ialah…”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…berapa lama sebelum kita tak boleh kawal benda ni.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Ah Len pula tidak terus pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti di sebuah kedai makan lain."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki sudah menunggunya."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len duduk."
    },
    {
      "type": "paragraph",
      "text": "“Menarik.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan itu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dia pelik.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan orang biasa.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang yang buat benda ni rasa mereka luar biasa.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Orang biasa fikir pasal barang.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia fikir pasal sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu terdiam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Dia kira semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam mana kau tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Cara dia bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu kos. Tahu masa. Tahu output. Tahu risiko.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Siapa dia sebenarnya?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia mengeluarkan telefon."
    },
    {
      "type": "paragraph",
      "text": "“Cari tahu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Rizal masuk ke sekolah seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar datang kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu boleh tengok kerja saya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil buku latihan."
    },
    {
      "type": "paragraph",
      "text": "Dia memeriksa."
    },
    {
      "type": "paragraph",
      "text": "“Ini salah.”"
    },
    {
      "type": "paragraph",
      "text": "“Yang mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Baris kedua.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu melihat."
    },
    {
      "type": "paragraph",
      "text": "“Oh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya kira salah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betulkan.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang buku itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Semudah itu."
    },
    {
      "type": "paragraph",
      "text": "Salah."
    },
    {
      "type": "paragraph",
      "text": "Cari."
    },
    {
      "type": "paragraph",
      "text": "Betulkan."
    },
    {
      "type": "paragraph",
      "text": "Selesai."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu bahawa beberapa kilometer dari sekolah, orang lain sedang melakukan perkara yang sama terhadap hidupnya."
    },
    {
      "type": "paragraph",
      "text": "Mencari."
    },
    {
      "type": "paragraph",
      "text": "Menyusun."
    },
    {
      "type": "paragraph",
      "text": "Menyemak."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal mendapat panggilan daripada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada orang nak jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang atas saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia nak tahu siapa yang buat barang ni.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa perlu tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sebab orang yang beli barang konsisten biasanya nak tahu siapa pembuatnya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Tak perlu jumpa kalau tak nak,” Ah Len berkata."
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya tak jumpa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tetap boleh jual.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Tapi?”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya nak pastikan orang yang saya bawa masuk dalam rangkaian ni tahu siapa dia berurusan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jalan."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memberitahu."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal memberitahu Adam."
    },
    {
      "type": "paragraph",
      "text": "Adam terus tidak setuju."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Terlalu awal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len kata orang atas.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tak jumpa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita kekal dengan Ah Len.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Dan itu lebih selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Lebih selamat untuk siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Kalau permintaan meningkat, kita perlukan pasaran.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita belum cukup besar.”"
    },
    {
      "type": "paragraph",
      "text": "“Itulah masalahnya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kita baru bermula.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan lompat terlalu jauh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam kelihatan lega."
    },
    {
      "type": "paragraph",
      "text": "Tetapi beberapa saat kemudian Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi kita tetap jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekadar jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menutup muka dengan tangan."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa saya masih ikut cikgu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sebab kau sayang saya.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak apa.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan malamnya, mereka tiba di sebuah restoran."
    },
    {
      "type": "paragraph",
      "text": "Tidak besar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kelihatan mahal."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menunggu di dalam."
    },
    {
      "type": "paragraph",
      "text": "Dia bangun apabila Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memperkenalkan seorang lelaki yang lebih berusia."
    },
    {
      "type": "paragraph",
      "text": "“Ini Encik Rahman.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu menghulurkan tangan."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambut."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Guru?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rahman tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Menarik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Adam di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Rahman tidak terus bercakap tentang urusan."
    },
    {
      "type": "paragraph",
      "text": "Sebaliknya dia bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu dah lama buat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab jujur."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman memandang Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kembali kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Dan sudah boleh hasilkan barang yang konsisten?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Kami jaga kualiti.”"
