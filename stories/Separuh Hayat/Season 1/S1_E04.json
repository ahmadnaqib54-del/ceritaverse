    },
    {
      "type": "paragraph",
      "text": "“Macam mana kau tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Orang macam kau biasanya bukan orang yang saya jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Jadi…”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang kau ada?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Kita ada barang.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang kata macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia membuka pintu kereta."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bagi saya tengok.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pertemuan itu tidak lama."
    },
    {
      "type": "paragraph",
      "text": "Ah Len memeriksa sampel yang dibawa."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak memberi komen panjang."
    },
    {
      "type": "paragraph",
      "text": "Tidak terkejut."
    },
    {
      "type": "paragraph",
      "text": "Tidak memuji."
    },
    {
      "type": "paragraph",
      "text": "Hanya diam."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Kalau ini memang macam yang kau kata…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Boleh jalan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan terus bercakap pasal duit.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab sekarang saya nak tahu satu benda.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya ambil sekali…”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menunjuk ke arah Rizal."
    },
    {
      "type": "paragraph",
      "text": "“…kau boleh buat lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kembali kepada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar dari kereta."
    },
    {
      "type": "paragraph",
      "text": "Pintu ditutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "Adam tidak tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau nampak risau.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya memang risau.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Sebab sekarang benda ni bukan lagi eksperimen.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang ada orang tunggu kita buat lagi.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Dua hari kemudian, wang pertama masuk."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Telefon di tangan."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat notifikasi bank."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka aplikasi."
    },
    {
      "type": "paragraph",
      "text": "Melihat angka itu."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat dia tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia mengira semula."
    },
    {
      "type": "paragraph",
      "text": "Bukan besar."
    },
    {
      "type": "paragraph",
      "text": "Bukan ratusan ribu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk membuktikan satu perkara."
    },
    {
      "type": "paragraph",
      "text": "**Ia berhasil.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar dari kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke sebuah kedai makan."
    },
    {
      "type": "paragraph",
      "text": "Membeli makanan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian pulang."
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Linda sedang duduk bersama Roy."
    },
    {
      "type": "paragraph",
      "text": "“Ayah beli apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Makanan.”"
    },
    {
      "type": "paragraph",
      "text": "“Banyaknya.”"
    },
    {
      "type": "paragraph",
      "text": "“Lapar.”"
    },
    {
      "type": "paragraph",
      "text": "Roy ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk bersama mereka."
    },
    {
      "type": "paragraph",
      "text": "Mereka makan."
    },
    {
      "type": "paragraph",
      "text": "Linda bercerita tentang pemeriksaan kehamilan."
    },
    {
      "type": "paragraph",
      "text": "Roy bercerita tentang sekolah."
    },
    {
      "type": "paragraph",
      "text": "Rizal mendengar."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali sejak diagnosis itu, dia rasa sedikit lega."
    },
    {
      "type": "paragraph",
      "text": "Malam itu dia masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Membuka aplikasi bank sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Melihat angka tadi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia memandang cermin."
    },
    {
      "type": "paragraph",
      "text": "“Ini untuk keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berkata perlahan."
    },
    {
      "type": "paragraph",
      "text": "Seolah-olah sedang meyakinkan dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 11:52 malam."
