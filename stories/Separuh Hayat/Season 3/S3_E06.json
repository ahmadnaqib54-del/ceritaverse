{
  "series": "Separuh Hayat",
  "season": 3,
  "episode": 6,
  "title": "S3 E6",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 3 — EPISODE 6\n## THE EXPANSION"
    },
    {
      "type": "paragraph",
      "text": "Rizal datang ke pejabat sebelum semua orang."
    },
    {
      "type": "paragraph",
      "text": "Dia suka waktu itu."
    },
    {
      "type": "paragraph",
      "text": "Tiada telefon."
    },
    {
      "type": "paragraph",
      "text": "Tiada mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Tiada orang bertanya."
    },
    {
      "type": "paragraph",
      "text": "Hanya dia dan angka."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada satu fail."
    },
    {
      "type": "paragraph",
      "text": "**EXPANSION PLAN.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membukanya."
    },
    {
      "type": "paragraph",
      "text": "Tiga lokasi."
    },
    {
      "type": "paragraph",
      "text": "Tiga perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Tiga peluang."
    },
    {
      "type": "paragraph",
      "text": "Dulu satu kilang sudah terasa terlalu besar."
    },
    {
      "type": "paragraph",
      "text": "Sekarang tiga lokasi kelihatan seperti permulaan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Adam masuk pukul 8.10 pagi."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah sampai?”"
    },
    {
      "type": "paragraph",
      "text": "“Dari tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat fail di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Ini apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Langkah seterusnya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Cepat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kita dah cakap tentang ni.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita cakap tentang berkembang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan buka tiga tempat sekali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tunggu semuanya sempurna, kita takkan berkembang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang cakap benda tu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Tetapi mereka berdua tahu."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minggu kemudian, satu pejabat baru dibuka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula membina struktur yang lebih besar."
    },
    {
      "type": "paragraph",
      "text": "Pengurus."
    },
    {
      "type": "paragraph",
      "text": "Penyelia."
    },
    {
      "type": "paragraph",
      "text": "Pegawai kewangan."
    },
    {
      "type": "paragraph",
      "text": "Pegawai operasi."
    },
    {
      "type": "paragraph",
      "text": "Orang yang mengurus orang lain."
    },
    {
      "type": "paragraph",
      "text": "Itulah perubahan terbesar."
    },
    {
      "type": "paragraph",
      "text": "Dulu Rizal mengurus dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia mengurus Adam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian beberapa orang."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia mengurus sebuah organisasi."
    },
    {
      "type": "paragraph",
      "text": "Dan organisasi tidak boleh bergerak hanya kerana seorang lelaki mahu ia bergerak."
    },
    {
      "type": "paragraph",
      "text": "Rizal terpaksa belajar melepaskan kawalan."
    },
    {
      "type": "paragraph",
      "text": "Sedikit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian lebih banyak."
    },
    {
      "type": "paragraph",
      "text": "Dan dia tidak suka perasaan itu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Satu pagi, Rizal masuk ke pejabat baru."
    },
    {
      "type": "paragraph",
      "text": "Seorang pengurus muda bernama **Hakim** berdiri menunggunya."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak bentangkan laporan operasi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Hakim mula bercakap."
    },
    {
      "type": "paragraph",
      "text": "“Untuk bulan ini, prestasi lebih baik daripada sasaran.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat laporan."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Hakim menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Kita ubah beberapa proses.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang bagi arahan?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti membaca."
    },
    {
      "type": "paragraph",
      "text": "“Kamu buat perubahan tanpa tunggu saya?”"
    },
    {
      "type": "paragraph",
      "text": "Hakim kelihatan sedikit takut."
    },
    {
      "type": "paragraph",
      "text": "“Saya fikir itu lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Hakim kelihatan terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Teruskan.”"
    },
    {
      "type": "paragraph",
      "text": "Selepas Hakim keluar, Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau hampir marah.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak marah.”"
    },
    {
      "type": "paragraph",
      "text": "“Wajah kau kata lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengeluh."
    },
    {
      "type": "paragraph",
      "text": "“Kalau semua orang tunggu aku, kita takkan ke mana.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Itulah maksud berkembang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu Adam betul."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dalam fikirannya muncul satu soalan."
    },
    {
      "type": "paragraph",
      "text": "**Kalau orang lain boleh membuat keputusan tanpa aku, apa yang masih berada dalam kawalan aku?**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Linda mula melihat perubahan yang lain."
    },
    {
      "type": "paragraph",
      "text": "Rizal semakin jarang berada di rumah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi apabila dia ada, dia membawa sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Mainan."
    },
    {
      "type": "paragraph",
      "text": "Barang baru."
    },
    {
      "type": "paragraph",
      "text": "Makanan."
    },
    {
      "type": "paragraph",
      "text": "Hadiah."
    },
    {
      "type": "paragraph",
      "text": "Benda yang dulu mereka fikir tidak mampu dibeli."
    },
    {
      "type": "paragraph",
      "text": "Roy menerima semuanya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi suatu malam dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak payah beli banyak sangat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya dah ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak salah.”"
    },
    {
      "type": "paragraph",
      "text": "Roy menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Ayah selalu cakap duit tak penting.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Pandai sangat kau sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma nak Ayah ada di rumah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu lebih mahal daripada semua barang yang dia beli."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di Bumi Perdana, Adam bertemu Maya."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih risau?”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Risau tentang apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Maya diam."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dia berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Maya tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang berubah.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan macam ni.”"
    },
    {
      "type": "paragraph",
      "text": "Maya menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Kalau awak risau tentang dia, kenapa masih di sini?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak takut?”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Tipu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Dulu saya fikir kami sedang bina sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat keluar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya rasa sesuatu sedang membina kami.”"
    },
    {
      "type": "paragraph",
      "text": "Maya tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sementara itu, Rizal menerima laporan daripada Farid."
    },
    {
      "type": "paragraph",
      "text": "“Ada orang cuba masuk dalam satu urusan kita.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kerugian?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kita tak berhenti sekejap?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Berhenti?”"
    },
    {
      "type": "paragraph",
      "text": "“Bagi semuanya stabil.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu kenapa syarikat kecil mati?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Mereka fikir stabil itu sama dengan selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Bila kau berhenti bergerak, orang lain akan bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia masih kelihatan tidak yakin."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa bulan berlalu."
    },
    {
      "type": "paragraph",
      "text": "Empayar Rizal berkembang."
    },
    {
      "type": "paragraph",
      "text": "Nama syarikat semakin banyak."
    },
    {
      "type": "paragraph",
      "text": "Aset semakin banyak."
    },
    {
      "type": "paragraph",
      "text": "Orang semakin ramai."
    },
    {
      "type": "paragraph",
      "text": "Dan sesuatu yang lebih penting mula berlaku."
    },
    {
      "type": "paragraph",
      "text": "Orang mula bergantung kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana mereka takut."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia membuat keputusan."
    },
    {
      "type": "paragraph",
      "text": "Cepat."
    },
    {
      "type": "paragraph",
      "text": "Tepat."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "Apabila ada masalah, orang mencari Rizal."
    },
    {
      "type": "paragraph",
      "text": "Apabila ada peluang, orang mencari Rizal."
    },
    {
      "type": "paragraph",
      "text": "Apabila ada konflik, orang mencari Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia menjadi pusat kepada sistem itu."
    },
    {
      "type": "paragraph",
      "text": "Dan Rizal menyukai perasaan itu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu petang, seorang pengurus membuat kesilapan besar."
    },
    {
      "type": "paragraph",
      "text": "Rizal dipanggil."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke bilik mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "“Siapa buat keputusan ini?”"
    },
    {
      "type": "paragraph",
      "text": "Semua orang diam."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Saya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya fikir itu keputusan terbaik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat laporan."
    },
    {
      "type": "paragraph",
      "text": "Kerugian tidak besar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi boleh dielakkan."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tak tanya saya?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kalau setiap benda kamu tanya saya, saya tak perlukan kamu.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi belajar tanggung akibat.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar."
    },
    {
      "type": "paragraph",
      "text": "Adam yang menunggu di luar tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau akan pecat dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Dulu saya tak ada masa.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya perlukan orang yang boleh berfikir.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah mula memahami perkara yang Hashim pernah ajar."
    },
    {
      "type": "paragraph",
      "text": "**Empayar tidak dibina oleh seorang lelaki.**"
    },
    {
      "type": "paragraph",
      "text": "Ia dibina oleh sistem."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sistem juga boleh memberontak terhadap penciptanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir duduk di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada papan yang semakin penuh."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Ayam Gepuk."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Syarikat."
    },
    {
      "type": "paragraph",
      "text": "Pelaburan."
    },
    {
      "type": "paragraph",
      "text": "Nama-nama baru."
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil satu marker."
    },
    {
      "type": "paragraph",
      "text": "Menulis:"
    },
    {
      "type": "paragraph",
      "text": "**RIZAL = COMMON LINK**"
    },
    {
      "type": "paragraph",
      "text": "Dia memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengelap perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "Terlalu awal."
    },
    {
      "type": "paragraph",
      "text": "Belum cukup."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini dia tidak lagi cuba melindungi Rizal daripada kesimpulannya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Dia mula menyiasat."
    },
    {
      "type": "paragraph",
      "text": "Secara rasmi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Rizal menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Suara Adam."
    },
    {
      "type": "paragraph",
      "text": "“Amir dah mula bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia mula buka fail yang lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Sejauh mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat keluar tingkap."
    },
    {
      "type": "paragraph",
      "text": "Bandar di hadapannya kelihatan kecil."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia bermimpi memiliki rumah seperti ini."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia memiliki pemandangan seperti ini."
    },
    {
      "type": "paragraph",
      "text": "Tetapi semakin tinggi dia berdiri..."
    },
    {
      "type": "paragraph",
      "text": "semakin jauh dia daripada tanah."
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia betul-betul datang kepada kita…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memotong."
    },
    {
      "type": "paragraph",
      "text": "“Dia keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dan sebab itu dia tak boleh tahu semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Rizal memanggil semua pengurus kanan."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk mengelilingi meja."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di hadapan mereka."
    },
    {
      "type": "paragraph",
      "text": "“Mulai sekarang, kita bukan lagi satu syarikat.”"
    },
    {
      "type": "paragraph",
      "text": "Semua orang diam."
    },
    {
      "type": "paragraph",
      "text": "“Kita satu kumpulan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menekan alat kawalan."
    },
    {
      "type": "paragraph",
      "text": "Paparan besar muncul."
    },
    {
      "type": "paragraph",
      "text": "**GROUP STRUCTURE.**"
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa bidang."
    },
    {
      "type": "paragraph",
      "text": "Beberapa lokasi."
    },
    {
      "type": "paragraph",
      "text": "Semua bersambung."
    },
    {
      "type": "paragraph",
      "text": "Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Setiap bahagian ada orang sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat mereka satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cari saya untuk setiap masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi jangan buat keputusan yang boleh menjejaskan seluruh kumpulan tanpa saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Mesyuarat bermula."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali..."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak lagi menjadi pengurus."
    },
    {
      "type": "paragraph",
      "text": "Dia menjadi pemilik."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, dia pulang awal."
    },
    {
      "type": "paragraph",
      "text": "Linda terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Awal?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di sofa."
    },
    {
      "type": "paragraph",
      "text": "Roy datang."
    },
    {
      "type": "paragraph",
      "text": "“Ayah balik.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Mereka menonton televisyen."
    },
    {
      "type": "paragraph",
      "text": "Tiada mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Tiada telefon."
    },
    {
      "type": "paragraph",
      "text": "Tiada fail."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa minit, Rizal lupa tentang semuanya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefonnya bergetar."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**Amir mahu jumpa kau.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadamnya."
    },
    {
      "type": "paragraph",
      "text": "Roy memandang."
    },
    {
      "type": "paragraph",
      "text": "“Kerja?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Masalah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang anaknya."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Masalah itu sudah ada."
    },
    {
      "type": "paragraph",
      "text": "Dan kali ini..."
    },
    {
      "type": "paragraph",
      "text": "ia datang daripada keluarganya sendiri."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 6**"
    }
  ],
