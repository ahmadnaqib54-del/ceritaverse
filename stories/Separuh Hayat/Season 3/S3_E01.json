{
  "series": "Separuh Hayat",
  "season": 3,
  "episode": 1,
  "title": "S3 E1",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 3 — EPISODE 1\n## THE EMPIRE"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6.30 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di hadapan cermin."
    },
    {
      "type": "paragraph",
      "text": "Kemeja putih."
    },
    {
      "type": "paragraph",
      "text": "Seluar hitam."
    },
    {
      "type": "paragraph",
      "text": "Jam pemberian Roy masih di pergelangan tangan."
    },
    {
      "type": "paragraph",
      "text": "Sama seperti dulu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi banyak perkara lain sudah berubah."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak lagi memandu ke Bumi Perdana untuk bekerja dengan Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kini orang menunggu dia di sana."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil kunci kereta."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang di dapur."
    },
    {
      "type": "paragraph",
      "text": "“Awal?”"
    },
    {
      "type": "paragraph",
      "text": "“Mesyuarat.”"
    },
    {
      "type": "paragraph",
      "text": "“Setiap hari mesyuarat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kerja makin besar.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Besar macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Cukup besar.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Itu bukan jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil kopi."
    },
    {
      "type": "paragraph",
      "text": "“Awak nak jawapan yang mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Jawapan yang jujur.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang isterinya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Banyak benda berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Itu saya nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berkata apa-apa lagi."
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana tidak lagi terasa seperti tempat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Ia terasa seperti tempat Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana papan tanda sudah ditukar."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana pejabat sudah diubah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana orang yang masuk ke bangunan itu sekarang tahu kepada siapa mereka perlu menghadap."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Laporan operasi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil fail."
    },
    {
      "type": "paragraph",
      "text": "“Letak atas meja.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Orang kedua datang."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal, ada isu dengan pembekal.”"
    },
    {
      "type": "paragraph",
      "text": "“Panggil pengurus.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Orang ketiga."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal, ada orang nak jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bekas orang Dato’ Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Suruh tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Tutup pintu."
    },
    {
      "type": "paragraph",
      "text": "Duduk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka satu fail."
    },
    {
      "type": "paragraph",
      "text": "Di muka hadapan tertulis:"
    },
    {
      "type": "paragraph",
      "text": "**STRUKTUR KUMPULAN.**"
    },
    {
      "type": "paragraph",
      "text": "Dulu, dia hanya melihat satu operasi."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia melihat keseluruhan gambar."
    },
    {
      "type": "paragraph",
      "text": "Perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Aset."
    },
    {
      "type": "paragraph",
      "text": "Orang."
    },
    {
      "type": "paragraph",
      "text": "Hubungan."
    },
    {
      "type": "paragraph",
      "text": "Risiko."
    },
    {
      "type": "paragraph",
      "text": "Wang."
    },
    {
      "type": "paragraph",
      "text": "Dan yang paling penting—"
    },
    {
      "type": "paragraph",
      "text": "**nama.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menulis satu perkataan di atas kertas."
    },
    {
      "type": "paragraph",
      "text": "**EMPIRE.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Adam masuk."
    },
    {
      "type": "paragraph",
      "text": "Dia membawa dua fail."
    },
    {
      "type": "paragraph",
      "text": "“Kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Pagi-pagi dah masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Memang kerja kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Adam meletakkan fail."
    },
    {
      "type": "paragraph",
      "text": "“Beberapa orang lama Hashim tak suka perubahan.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk buat masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang paling penting?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menunjuk satu nama."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "“Dia mahu apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia kata dia patut dapat lebih.”"
    },
    {
      "type": "paragraph",
      "text": "“Lebih apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Dia dapat?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kau tak risau?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang rasa dia berhak biasanya susah dikawal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Jadi jangan kawal dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Gantikan dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Hashim terlalu banyak bergantung pada orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk fail."
    },
    {
      "type": "paragraph",
      "text": "“Kita tak akan buat kesilapan yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka mula menyusun semula organisasi."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang dinaikkan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang dipindahkan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang keluar."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada drama."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada jeritan."
    },
    {
      "type": "paragraph",
      "text": "Rizal cuma membuat keputusan."
    },
    {
      "type": "paragraph",
      "text": "Dan orang belajar satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak suka ancaman."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia lebih tidak suka ketidakcekapan."
    },
    {
      "type": "paragraph",
      "text": "Dalam beberapa bulan, struktur baru mula terbentuk."
    },
    {
      "type": "paragraph",
      "text": "Rizal berada di atas."
    },
    {
      "type": "paragraph",
      "text": "Adam mengendalikan bahagian teknikal dan kualiti."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pengurus lama mengurus operasi."
    },
    {
      "type": "paragraph",
      "text": "Farid semakin kerap berada berhampiran Rizal."
    },
    {
      "type": "paragraph",
      "text": "Masih belum memegang jawatan besar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sentiasa ada apabila diperlukan."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak banyak bercakap."
    },
    {
      "type": "paragraph",
      "text": "Dan Rizal suka orang seperti itu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu petang, Farid datang."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada orang nak jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang sekarang orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "Farid turut tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Yang ini lain.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia pernah kerja terus dengan Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Suruh masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki berusia sekitar lima puluhan masuk."
    },
    {
      "type": "paragraph",
      "text": "Dia memperkenalkan diri."
    },
    {
      "type": "paragraph",
      "text": "“Rahman.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berjabat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman duduk."
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma nak cakap satu benda.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Dato’ Hashim tak bina semua ni untuk seorang diri.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ramai orang akan cuba ambil bahagian.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Termasuk orang yang masih setia kepada dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Dia masih hidup?”"
    },
    {
      "type": "paragraph",
      "text": "Rahman diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Rahman berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kita jangan bercakap tentang orang yang kita tak tahu di mana.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman kelihatan sedikit terkejut."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Kita bercakap tentang apa yang ada depan kita.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk fail."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang awak kerja dengan saya?”"
    },
    {
      "type": "paragraph",
      "text": "Rahman diam."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Kalau awak nak terus kerja dengan saya, jangan kerja kerana Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kerja kerana siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Kerja kerana sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum keluar, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Dato’ pernah cakap benda yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu mengganggunya."
    },
    {
      "type": "paragraph",
      "text": "**Dato’ pernah cakap benda yang sama.**"
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Apa yang dia buat sekarang sebenarnya berbeza daripada Hashim?"
    },
    {
      "type": "paragraph",
      "text": "Dia membuka buku nota lama Hashim."
    },
    {
      "type": "paragraph",
      "text": "Masih ada di dalam laci."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**“Sistem yang bergantung kepada seorang manusia akan mati bersama manusia itu.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menulis di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**“Sebab itu sistem perlu bergantung kepada banyak orang.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menambah:"
    },
    {
      "type": "paragraph",
      "text": "**“Tetapi arah mesti datang daripada seorang.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Dia sendiri terkejut dengan apa yang ditulisnya."
    },
    {
      "type": "paragraph",
      "text": "Dia menutup buku."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, keadaan juga berubah."
    },
    {
      "type": "paragraph",
      "text": "Baby sudah lahir."
    },
    {
      "type": "paragraph",
      "text": "Rumah yang dahulu sunyi kini penuh dengan bunyi."
    },
    {
      "type": "paragraph",
      "text": "Tangisan."
    },
    {
      "type": "paragraph",
      "text": "Mainan."
    },
    {
      "type": "paragraph",
      "text": "Suara Roy."
    },
    {
      "type": "paragraph",
      "text": "Suara Linda."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di tepi katil, memegang bayi kecilnya."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak gembira?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Nama?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang bayi itu."
    },
    {
      "type": "paragraph",
      "text": "Mereka sudah memilih nama."
    },
    {
      "type": "paragraph",
      "text": "Seorang anak yang tidak tahu apa-apa tentang dunia ayahnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyentuh tangan kecil itu."
    },
    {
      "type": "paragraph",
      "text": "“Untuk dia.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua ni.”"
    },
    {
      "type": "paragraph",
      "text": "Linda diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak dia hidup senang.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang wajah suaminya."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak yang awak perlukan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu mudah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi jawapannya tidak lagi wujud."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minggu kemudian, Rizal membawa keluarga makan di Ayam Gepuk Hut."
    },
    {
      "type": "paragraph",
      "text": "Linda duduk bersama Roy dan bayi."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia duduk di sini bersama Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kini dia datang sebagai pemilik kuasa baru."
    },
    {
      "type": "paragraph",
      "text": "Seorang pekerja datang."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal, meja dah siap.”"
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Roy melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat ni dulu Dato’ punya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang ayah punya?”"
    },
    {
      "type": "paragraph",
      "text": "Linda terus memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Lebih kurang.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Hebat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Tak hebat pun.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab memiliki sesuatu tak semestinya bermaksud kita boleh menjaganya.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu ayat itu bukan tentang restoran."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di luar restoran, Adam menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada peluang.”"
    },
    {
      "type": "paragraph",
      "text": "“Peluang apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Satu pelaburan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Berapa besar?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut jumlah."
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Boleh?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Risiko?”"
    },
    {
      "type": "paragraph",
      "text": "“Besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau takut risiko.”"
    },
    {
      "type": "paragraph",
      "text": "“Dulu.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat restoran."
    },
    {
      "type": "paragraph",
      "text": "“Kita tak boleh bina empayar kalau takut benda besar.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tapi kau tahu…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“...empayar besar juga jatuh lebih kuat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jangan jadi pesimis.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Aku bukan pesimis.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menepuk bahu Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma kenal kau.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal kembali ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka satu fail baru."
    },
    {
      "type": "paragraph",
      "text": "**PELABURAN.**"
    },
    {
      "type": "paragraph",
      "text": "Di sebelahnya:"
    },
    {
      "type": "paragraph",
      "text": "**PENGEMBANGAN.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**ASET.**"
    },
    {
      "type": "paragraph",
      "text": "Dan akhirnya:"
    },
    {
      "type": "paragraph",
      "text": "**LEGITIMATE BUSINESS.**"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang perkataan terakhir itu."
    },
    {
      "type": "paragraph",
      "text": "Adam masuk."
    },
    {
      "type": "paragraph",
      "text": "“Kau serius nak masuk dunia perniagaan sebenar?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita nak bertahan lama…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…kita tak boleh hidup atas satu sumber sahaja.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kita bina sesuatu yang orang boleh nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dan sesuatu yang boleh buat orang percaya kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Reputasi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Belajar daripada Hashim lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Belajar daripada semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di JSJN, Amir menerima laporan terbaru."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Beberapa halaman."
    },
    {
      "type": "paragraph",
      "text": "Beberapa nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu carta."
    },
    {
      "type": "paragraph",
      "text": "**HASHIM**"
    },
    {
      "type": "paragraph",
      "text": "Garis."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Amir melihatnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kali ini tidak ada tanda soal."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Menarik satu garis antara kedua-dua nama."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai masuk."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita dah dapat cukup untuk buka siasatan lebih mendalam.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Buat.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu teragak-agak."
    },
    {
      "type": "paragraph",
      "text": "“Termasuk Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Amir terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu keluar."
    },
    {
      "type": "paragraph",
      "text": "Amir duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka telefon."
    },
    {
      "type": "paragraph",
      "text": "Nama Rizal masih ada."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menelefon."
    },
    {
      "type": "paragraph",
      "text": "Sebaliknya dia membuka gambar lama."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersama Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Bayi."
    },
    {
      "type": "paragraph",
      "text": "Amir menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau, Zal?”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke pejabatnya."
    },
    {
      "type": "paragraph",
      "text": "Farid berdiri di luar."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada orang tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menyerahkan satu kad."
    },
    {
      "type": "paragraph",
      "text": "Tiada nama syarikat."
    },
    {
      "type": "paragraph",
      "text": "Tiada jawatan."
    },
    {
      "type": "paragraph",
      "text": "Hanya satu nama."
    },
    {
      "type": "paragraph",
      "text": "**KHALID.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang kad itu."
    },
    {
      "type": "paragraph",
      "text": "Nama yang pernah muncul ketika ancaman terhadap Hashim bermula."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Dia datang seorang?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Suruh masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki masuk."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bersalaman."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya duduk."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Kau cari aku?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya datang bukan untuk kerja.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya datang untuk beri amaran.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Amaran tentang apa?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan orang yang kau patut anggap sudah kalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia hidup?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Bukan masalah sama ada dia hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya ialah siapa yang masih setia kepada dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Khalid bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Awak baru ambil empayar seorang lelaki.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti di pintu."
    },
    {
      "type": "paragraph",
      "text": "“Jangan lupa…”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berpaling."
    },
    {
      "type": "paragraph",
      "text": "“…empayar itu datang bersama musuhnya.”"
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "Daripada nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "**“Tahniah atas empayar baru.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "**“Sekarang kita tengok berapa lama kau boleh simpan.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka fail di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "**PELABURAN.**"
    },
    {
      "type": "paragraph",
      "text": "Dia menulis satu angka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Dan satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Empayar itu baru bermula."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sesuatu sudah jelas."
    },
    {
      "type": "paragraph",
      "text": "Semakin besar empayar itu…"
    },
    {
      "type": "paragraph",
      "text": "semakin ramai orang akan mahu sebahagiannya."
    },
    {
      "type": "paragraph",
      "text": "Dan semakin ramai orang mahu sebahagiannya…"
    },
    {
      "type": "paragraph",
      "text": "semakin banyak yang Rizal sanggup lakukan untuk mempertahankannya."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam di tangannya."
    },
    {
      "type": "paragraph",
      "text": "Hadiah daripada Roy."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat gambar keluarganya di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Dia berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Untuk kamu.”"
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini, tiada siapa yang mendengar."
    },
    {
      "type": "paragraph",
      "text": "Dan mungkin itu masalah sebenar."
    },
    {
      "type": "paragraph",
      "text": "Kerana setiap kali Rizal berkata **“untuk keluarga”**, dia semakin kurang pasti sama ada dia sedang bercakap benar—"
    },
    {
      "type": "paragraph",
      "text": "atau sekadar mencari alasan untuk terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 1 — SEASON 3**"
    }
  ],
