{
  "series": "Separuh Hayat",
  "season": 3,
  "episode": 12,
  "title": "S3 E12",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 3 — EPISODE 12\n## THE NAME"
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal masih berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah pergi."
    },
    {
      "type": "paragraph",
      "text": "Rumah itu tiba-tiba terasa terlalu besar."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia mahu rumah besar supaya keluarganya mempunyai ruang."
    },
    {
      "type": "paragraph",
      "text": "Sekarang ruang itu hanya menunjukkan betapa kosongnya rumah tersebut."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal berjalan ke bilik Roy."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Katil masih bersepah."
    },
    {
      "type": "paragraph",
      "text": "Buku sekolah di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Satu kerusi roda di tepi."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia nampak sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Jam tangan."
    },
    {
      "type": "paragraph",
      "text": "Bukan jam yang berada di pergelangan tangannya."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Jam murah yang pernah Roy gunakan sebelum ini."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Zal, kita perlu jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Pukul 11 malam."
    },
    {
      "type": "paragraph",
      "text": "Adam sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "Farid berada di situ."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam meletakkan satu fail di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka."
    },
    {
      "type": "paragraph",
      "text": "Beberapa dokumen."
    },
    {
      "type": "paragraph",
      "text": "Beberapa gambar."
    },
    {
      "type": "paragraph",
      "text": "Nama."
    },
    {
      "type": "paragraph",
      "text": "Lokasi."
    },
    {
      "type": "paragraph",
      "text": "Hubungan."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Berapa jauh?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Lebih jauh daripada yang kita sangka.”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Dia belum ada semua.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kita masih ada masa.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia abang ipar Bos…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Bos betul-betul nak lawan dia?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Itulah soalan yang dia sendiri tidak mahu jawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Rizal mula muncul lebih banyak di khalayak."
    },
    {
      "type": "paragraph",
      "text": "Dia menghadiri satu forum perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Di pentas, dia duduk bersama beberapa tokoh korporat."
    },
    {
      "type": "paragraph",
      "text": "Moderator bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal, bagaimana seorang guru boleh berubah menjadi usahawan dengan begitu cepat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Disiplin.”"
    },
    {
      "type": "paragraph",
      "text": "Penonton ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Moderator turut tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Serius?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Saya percaya semua perkara ada sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Moderator bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk kejayaan?”"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk kejayaan.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kegagalan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Terutamanya kegagalan.”"
    },
    {
      "type": "paragraph",
      "text": "Tepukan kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Kamera mengambil gambarnya."
    },
    {
      "type": "paragraph",
      "text": "Dia kelihatan tenang."
    },
    {
      "type": "paragraph",
      "text": "Yakin."
    },
    {
      "type": "paragraph",
      "text": "Berjaya."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada siapa di dalam dewan itu tahu bahawa beberapa jam sebelumnya isterinya meninggalkan rumah."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada siapa tahu adik iparnya sedang menyiasatnya."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada siapa tahu bahawa lelaki di atas pentas itu sedang berdiri di atas sesuatu yang boleh runtuh pada bila-bila masa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, sebuah artikel diterbitkan."
    },
    {
      "type": "paragraph",
      "text": "**“Rizal: Daripada Guru Kepada Tokoh Perniagaan.”**"
    },
    {
      "type": "paragraph",
      "text": "Gambar Rizal berada di muka hadapan."
    },
    {
      "type": "paragraph",
      "text": "Artikel itu memuji perjalanan hidupnya."
    },
    {
      "type": "paragraph",
      "text": "Guru."
    },
    {
      "type": "paragraph",
      "text": "Usahawan."
    },
    {
      "type": "paragraph",
      "text": "Bapa."
    },
    {
      "type": "paragraph",
      "text": "Dermawan."
    },
    {
      "type": "paragraph",
      "text": "Inspirasi."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca semuanya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berhenti pada satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**“Beliau membuktikan bahawa seseorang boleh mengubah hidupnya apabila berani mengambil peluang.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Ironi."
    },
    {
      "type": "paragraph",
      "text": "Dia memang mengambil peluang."
    },
    {
      "type": "paragraph",
      "text": "Cuma bukan peluang yang orang sangka."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di pejabat JSJN, Amir membaca artikel yang sama."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian fail di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Dua versi manusia yang sama."
    },
    {
      "type": "paragraph",
      "text": "Satu di media."
    },
    {
      "type": "paragraph",
      "text": "Satu dalam fail siasatan."
    },
    {
      "type": "paragraph",
      "text": "Amir menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana kau boleh jadi dua orang, Zal?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai di sebelahnya menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin sebab selama ni kita cuma kenal satu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Amir datang ke rumah Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kali ini Rizal sendiri membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Mereka saling memandang."
    },
    {
      "type": "paragraph",
      "text": "“Masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Amir masuk."
    },
    {
      "type": "paragraph",
      "text": "Rumah itu sunyi."
    },
    {
      "type": "paragraph",
      "text": "“Linda?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk."
    },
    {
      "type": "paragraph",
      "text": "Tiada kopi."
    },
    {
      "type": "paragraph",
      "text": "Tiada gurauan."
    },
    {
      "type": "paragraph",
      "text": "Tiada perbualan biasa."
    },
    {
      "type": "paragraph",
      "text": "Amir memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tanya kau satu soalan.”"
    },
    {
      "type": "paragraph",
      "text": "“Tanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau tahu seseorang yang kau sayang buat benda yang salah…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“...kau akan buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Amir."
    },
    {
      "type": "paragraph",
      "text": "“Bergantung.”"
    },
    {
      "type": "paragraph",
      "text": "“Pada apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sejauh mana salahnya.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kesalahan itu dah menyakiti ramai orang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Amir menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau orang itu keluarga sendiri?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang tepat ke mata Amir."
    },
    {
      "type": "paragraph",
      "text": "“Kau sedang bercakap tentang siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Tak penting.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tahu."
    },
    {
      "type": "paragraph",
      "text": "Amir tahu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kedua-duanya tidak mengatakannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Amir bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia berhenti di pintu."
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau ada masalah…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Beritahu aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku masih keluarga kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Amir keluar."
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berbisik,"
    },
    {
      "type": "paragraph",
      "text": "“Maaf.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pergi ke Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Adam menunggunya."
    },
    {
      "type": "paragraph",
      "text": "“Apa jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir datang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa dia tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berjalan ke bilik kawalan."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat seluruh operasi dari atas."
    },
    {
      "type": "paragraph",
      "text": "Orang bergerak."
    },
    {
      "type": "paragraph",
      "text": "Telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Mesin berjalan."
    },
    {
      "type": "paragraph",
      "text": "Laporan masuk."
    },
    {
      "type": "paragraph",
      "text": "Semuanya bergerak."
    },
    {
      "type": "paragraph",
      "text": "Sistem yang dahulu kecil."
    },
    {
      "type": "paragraph",
      "text": "Kini menjadi sesuatu yang jauh lebih besar daripada dirinya."
    },
    {
      "type": "paragraph",
      "text": "Adam berdiri di belakang."
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang kita buat sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal akhirnya berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Kita bina sempadan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Sempadan?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Antara apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Antara keluarga dan empayar.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Mulai sekarang, sesiapa yang datang kepada keluarga…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…tak boleh sampai kepada kita.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memahami."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak lagi bercakap seperti seorang guru."
    },
    {
      "type": "paragraph",
      "text": "Dia bercakap seperti seorang pemilik empayar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minggu berlalu."
    },
    {
      "type": "paragraph",
      "text": "Rizal semakin kuat."
    },
    {
      "type": "paragraph",
      "text": "Lebih banyak syarikat."
    },
    {
      "type": "paragraph",
      "text": "Lebih banyak aset."
    },
    {
      "type": "paragraph",
      "text": "Lebih banyak hubungan."
    },
    {
      "type": "paragraph",
      "text": "Nama Rizal semakin dikenali."
    },
    {
      "type": "paragraph",
      "text": "Tetapi di rumah, Linda masih belum pulang."
    },
    {
      "type": "paragraph",
      "text": "Roy tinggal bersama Linda."
    },
    {
      "type": "paragraph",
      "text": "Rizal bertemu anaknya sekali-sekala."
    },
    {
      "type": "paragraph",
      "text": "Pada satu pertemuan, Roy bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah nak balik?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bila-bila masa.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tak balik sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tahu jawapannya."
    },
    {
      "type": "paragraph",
      "text": "Roy berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah selalu kata keluarga penting.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi baliklah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menahan nafas."
    },
    {
      "type": "paragraph",
      "text": "Dia memeluk Roy."
    },
    {
      "type": "paragraph",
      "text": "“Maaf.”"
    },
    {
