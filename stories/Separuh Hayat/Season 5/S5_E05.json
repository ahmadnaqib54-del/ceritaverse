{
  "series": "Separuh Hayat",
  "season": 5,
  "episode": 5,
  "title": "S5 E5",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 5\n## PRISON"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tidur malam itu."
    },
    {
      "type": "paragraph",
      "text": "Mesej masih berada di skrin."
    },
    {
      "type": "paragraph",
      "text": "**KALAU KAU SERAH, ADAM MATI.**"
    },
    {
      "type": "paragraph",
      "text": "Dia membacanya berkali-kali."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia memadam mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana percaya ia palsu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia tidak mahu mesej itu menentukan fikirannya."
    },
    {
      "type": "paragraph",
      "text": "Pukul 4:18 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di meja makan."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada tiga benda."
    },
    {
      "type": "paragraph",
      "text": "Jam pemberian Roy."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia lama."
    },
    {
      "type": "paragraph",
      "text": "Dan telefon."
    },
    {
      "type": "paragraph",
      "text": "Dulu, tiga benda itu mewakili tiga kehidupan."
    },
    {
      "type": "paragraph",
      "text": "Jam—"
    },
    {
      "type": "paragraph",
      "text": "keluarga."
    },
    {
      "type": "paragraph",
      "text": "Buku—"
    },
    {
      "type": "paragraph",
      "text": "guru."
    },
    {
      "type": "paragraph",
      "text": "Telefon—"
    },
    {
      "type": "paragraph",
      "text": "empayar."
    },
    {
      "type": "paragraph",
      "text": "Sekarang ketiga-tiganya terasa seperti beban."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal pergi berjumpa peguam."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tahu keadaan Adam.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Dia masih ditahan.”"
    },
    {
      "type": "paragraph",
      "text": "“Pertuduhan?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum selesai.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan keselamatannya?”"
    },
    {
      "type": "paragraph",
      "text": "Peguam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Itu yang sukar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ada ancaman?”"
    },
    {
      "type": "paragraph",
      "text": "“Tiada ancaman rasmi.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam tahanan, kita tak boleh jamin apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Peguam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Tetapi ada satu perkara yang pelik.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa pihak berminat dengan Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Pihak mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak jelas.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat?”"
    },
    {
      "type": "paragraph",
      "text": "Peguam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu sesuatu?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Itu bukan jawapan yang benar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak juga sepenuhnya bohong."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Adam berada dalam bilik tahanan."
    },
    {
      "type": "paragraph",
      "text": "Hari-hari mula terasa sama."
    },
    {
      "type": "paragraph",
      "text": "Bangun."
    },
    {
      "type": "paragraph",
      "text": "Makan."
    },
    {
      "type": "paragraph",
      "text": "Soal siasat."
    },
    {
      "type": "paragraph",
      "text": "Tidur."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ulang."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak lagi tahu hari apa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Semakin lama dia berada di situ, semakin banyak orang mahu dia bercakap."
    },
    {
      "type": "paragraph",
      "text": "Hari itu seorang pegawai masuk."
    },
    {
      "type": "paragraph",
      "text": "“Kami perlukan satu kenyataan tambahan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Pasal apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Lagi?”"
    },
    {
      "type": "paragraph",
      "text": "“Hubungan dia dengan Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Kami ada bukti.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kenapa tanya aku?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab kami mahu dengar daripada kau.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Awak mahu kebenaran atau pengesahan?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Dua benda berbeza.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, Adam dibawa ke bilik lain."
    },
    {
      "type": "paragraph",
      "text": "Kali ini bukan pegawai biasa."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai kanan."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di hadapan Adam."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir pernah siasat Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia percaya Rizal terlibat.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi dia juga percaya ada sesuatu yang lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Amir pernah menulis bahawa Rizal mungkin bukan titik permulaan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab Amir pandai.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan kau?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum hambar."
    },
    {
      "type": "paragraph",
      "text": "“Aku lambat.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar, Rizal mula menjual beberapa aset."
    },
    {
      "type": "paragraph",
      "text": "Kereta."
    },
    {
      "type": "paragraph",
      "text": "Rumah kedua."
    },
    {
      "type": "paragraph",
      "text": "Pelaburan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat kecil."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana mahu kaya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia mahu memutuskan hubungan dengan sistem yang dibinanya."
    },
    {
      "type": "paragraph",
      "text": "Namun setiap kali satu aset hilang—"
    },
    {
      "type": "paragraph",
      "text": "satu lagi masalah muncul."
    },
    {
      "type": "paragraph",
      "text": "Satu akaun dibekukan."
    },
    {
      "type": "paragraph",
      "text": "Satu kontrak dibatalkan."
    },
    {
      "type": "paragraph",
      "text": "Satu rakan kongsi menghilang."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi telefon tidak dijawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula sedar."
    },
    {
      "type": "paragraph",
      "text": "Empayar bukan runtuh seperti bangunan."
    },
    {
      "type": "paragraph",
      "text": "Ia runtuh seperti kepercayaan."
    },
    {
      "type": "paragraph",
      "text": "Sedikit demi sedikit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tiba-tiba—"
    },
    {
      "type": "paragraph",
      "text": "tiada apa-apa lagi."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Maya datang bertemu Rizal buat kali terakhir."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk di sebuah kedai kopi."
    },
    {
      "type": "paragraph",
      "text": "Maya kelihatan tenang."
    },
    {
      "type": "paragraph",
      "text": "“Awak dah mula lepaskan aset?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau gembira?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya tahu awak tak buat semua ini kerana awak berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak buat kerana dah tak ada pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Maya menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Itu bukan sama dengan berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengambil satu fail kecil."
    },
    {
      "type": "paragraph",
      "text": "“Saya nak pulangkan ini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membukanya."
    },
    {
      "type": "paragraph",
      "text": "Beberapa dokumen lama."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak mahu simpan.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukti?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebahagian.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kau akan beri kepada pihak berkuasa?”"
    },
    {
      "type": "paragraph",
      "text": "Maya diam."
    },
    {
      "type": "paragraph",
      "text": "“Saya belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau rasa perlu, buat.”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak betul-betul dah berubah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum nipis."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Maya bangun."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin itu jawapan paling jujur yang awak pernah bagi.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya masih ada di luar.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya boleh pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Jauh.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab kalau kau lari, mereka akan fikir kau ada sesuatu untuk disembunyikan.”"
    },
    {
      "type": "paragraph",
      "text": "Farid ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya memang ada banyak benda untuk disembunyikan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Pergi kepada peguam.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Serah diri.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Bos serius?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau saya ditangkap?”"
    },
    {
      "type": "paragraph",
      "text": "“Hadap.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Macam bos?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang kosong ke hadapan."
    },
    {
      "type": "paragraph",
      "text": "“Macam aku.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di dalam tahanan, Adam mendapat seorang pelawat."
    },
    {
      "type": "paragraph",
      "text": "Bukan peguam."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki yang tidak dikenalinya."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk."
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya meletakkan satu gambar di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Roy."
    },
    {
      "type": "paragraph",
      "text": "Adam terus serius."
    },
    {
      "type": "paragraph",
      "text": "“Jangan libatkan mereka.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih fikir kau boleh melindungi mereka?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Rizal akan jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau juga.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu kelihatan sedikit terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Kau tak takut?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku takut.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma dah penat.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum pergi, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau bercakap tentang Project Hayat…”"
    },
    {
      "type": "paragraph",
      "text": "Adam mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“…bukan kau seorang yang akan jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Adam melihat gambar Rizal yang masih berada di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Kemudian perlahan-lahan berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku dah agak.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal datang ke rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia tidak masuk."
    },
    {
      "type": "paragraph",
      "text": "Roy keluar."
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Ayah nak pergi?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat yang Ayah perlu pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Penjara?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Roy sudah tahu."
    },
    {
      "type": "paragraph",
      "text": "Mungkin daripada berita."
    },
    {
      "type": "paragraph",
      "text": "Mungkin daripada orang lain."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Roy menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Ayah buat salah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Besar?”"
    },
    {
      "type": "paragraph",
      "text": "“Besar.”"
    },
    {
      "type": "paragraph",
      "text": "Roy diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi Ayah masih Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Air matanya jatuh."
    },
    {
      "type": "paragraph",
      "text": "Roy melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa Ayah menangis?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab Ayah sayang kau.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Linda berdiri di pintu."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan serah diri.”"
    },
    {
      "type": "paragraph",
      "text": "Linda diam."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak lama lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menelan air liur."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak harap kau maafkan aku.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya kita setuju sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda hampir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Hampir."
    },
    {
      "type": "paragraph",
      "text": "Kemudian wajahnya kembali serius."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat ini kerana kami.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Buat kerana kau tahu ia betul.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Buat.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Farid menyerah diri."
    },
    {
      "type": "paragraph",
      "text": "Berita itu sampai kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca mesej peguam."
    },
    {
      "type": "paragraph",
      "text": "**FARID SUDAH MENYERAH.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi perkara selesai."
    },
    {
      "type": "paragraph",
      "text": "Tetapi belum selesai."
    },
    {
      "type": "paragraph",
      "text": "Adam masih dalam tahanan."
    },
    {
      "type": "paragraph",
      "text": "Dan Rizal masih belum menyerah."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada petang yang sama, pihak berkuasa menerima satu fail."
    },
    {
      "type": "paragraph",
      "text": "Tanpa nama pengirim."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya terdapat dokumen kewangan."
    },
    {
      "type": "paragraph",
      "text": "Struktur syarikat."
    },
    {
      "type": "paragraph",
      "text": "Gambar."
    },
    {
      "type": "paragraph",
      "text": "Hubungan."
    },
    {
      "type": "paragraph",
      "text": "Dan satu fail khas."
    },
    {
      "type": "paragraph",
      "text": "**AMIR — LAST INVESTIGATION**"
    },
    {
      "type": "paragraph",
      "text": "Pegawai yang menerimanya membuka halaman pertama."
    },
    {
      "type": "paragraph",
      "text": "Ada tulisan Amir."
    },
    {
      "type": "paragraph",
      "text": "**“Jika saya hilang, jangan berhenti pada Rizal.”**"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu membaca lagi."
    },
    {
      "type": "paragraph",
      "text": "**“Cari siapa yang mahu kita percaya bahawa Rizal ialah permulaan.”**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal menerima panggilan daripada peguam."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Adam akan menjadi saksi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dia akan beri keterangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan…”"
    },
    {
      "type": "paragraph",
      "text": "Peguam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Ada kemungkinan dia akan mendapat perlindungan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Encik tidak marah?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Adam patut hidup.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, Adam duduk di dalam sel."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka buku nota kecil."
    },
    {
      "type": "paragraph",
      "text": "Di halaman pertama tertulis:"
    },
    {
      "type": "paragraph",
      "text": "**RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**“Mula kerana takut.”**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**“Terus kerana pilihan.”**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**“Jatuh kerana akibat.”**"
    },
    {
      "type": "paragraph",
      "text": "Adam menutup buku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menulis satu ayat terakhir:"
    },
    {
      "type": "paragraph",
      "text": "**“Kalau aku mati, jangan biarkan dia fikir semuanya salah dia seorang.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadam ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Menulis semula:"
    },
    {
      "type": "paragraph",
      "text": "**“Jangan biarkan sesiapa fikir mereka tidak mempunyai pilihan.”**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar tahanan, seseorang berdiri di dalam sebuah kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "“Adam akan bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Suara di hujung talian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih di luar.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Suara itu menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Kerana selagi dia masih di luar, dia masih boleh membuat satu kesilapan terakhir.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka almari."
    },
    {
      "type": "paragraph",
      "text": "Mengambil beg kecil."
    },
    {
      "type": "paragraph",
      "text": "Tidak banyak barang."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pakaian."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Jam pemberian Roy."
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan semuanya di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**ADAM AKAN MATI JIKA KAU SERAH DIRI.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej kedua:"
    },
    {
      "type": "paragraph",
      "text": "**KAU MASIH BOLEH SELAMATKAN DIA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian dia memadam kedua-dua mesej."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil beg."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali—"
    },
    {
      "type": "paragraph",
      "text": "dia tidak mengikut arahan sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan keluar rumah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bukan untuk melarikan diri."
    },
    {
      "type": "paragraph",
      "text": "Dia pergi kepada peguam."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu menyerah."
    },
    {
      "type": "paragraph",
      "text": "Walaupun dia tahu seseorang mungkin cuba menggunakan Adam sebagai umpan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Sementara itu, di dalam tahanan—"
    },
    {
      "type": "paragraph",
      "text": "Adam dibawa keluar dari sel."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada mesyuarat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Encik.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang ke arah kamera keselamatan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau sesuatu berlaku kepada saya…”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Jangan percaya fail pertama yang kamu jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab:"
    },
    {
      "type": "paragraph",
      "text": "“Kerana orang yang menulis cerita ini sudah lama menunggu kita membacanya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Pintu besi tertutup di belakangnya."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 5**"
    }
