      "text": "Mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Masalah."
    },
    {
      "type": "paragraph",
      "text": "Hari ini—"
    },
    {
      "type": "paragraph",
      "text": "sunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan beg di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat kerusi di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Kerusi Adam."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Sudah dua hari."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "Menaip:"
    },
    {
      "type": "paragraph",
      "text": "**Mana kau?**"
    },
    {
      "type": "paragraph",
      "text": "Dia tidak hantar."
    },
    {
      "type": "paragraph",
      "text": "Dia padam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya dengar Adam tak datang.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu dia di mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Maya diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Pihak berkuasa mula tanya tentang dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus duduk tegak."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka sedang cari orang yang boleh menjelaskan struktur lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memahami."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 9:10."
    },
    {
      "type": "paragraph",
      "text": "Rizal menerima satu dokumen."
    },
    {
      "type": "paragraph",
      "text": "Bukan daripada Maya."
    },
    {
      "type": "paragraph",
      "text": "Bukan daripada Adam."
    },
    {
      "type": "paragraph",
      "text": "Daripada seseorang yang tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Dokumen itu mengandungi senarai akses sistem."
    },
    {
      "type": "paragraph",
      "text": "Nama."
    },
    {
      "type": "paragraph",
      "text": "Tarikh."
    },
    {
      "type": "paragraph",
      "text": "Fail yang dibuka."
    },
    {
      "type": "paragraph",
      "text": "Beberapa kali."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "**ADAM.**"
    },
    {
      "type": "paragraph",
      "text": "Akses terakhirnya berlaku dua hari lalu."
    },
    {
      "type": "paragraph",
      "text": "Pada waktu yang sama, satu salinan data dikeluarkan daripada sistem."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus menelefon Adam."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia jawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau ambil data.”"
    },
    {
      "type": "paragraph",
      "text": "Senyap."
    },
    {
      "type": "paragraph",
      "text": "“Apa kau ambil?”"
    },
    {
      "type": "paragraph",
      "text": "“Benda yang aku perlukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk berjaga-jaga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Jaga-jaga daripada siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk aku?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengetap rahang."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku akan jumpa kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan di pejabat.”"
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memberikan satu lokasi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian talian tamat."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Mereka bertemu di sebuah tempat sunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam kelihatan berbeza."
    },
    {
      "type": "paragraph",
      "text": "Tidak seperti Adam yang Rizal kenal."
    },
    {
      "type": "paragraph",
      "text": "Lebih berhati-hati."
    },
    {
      "type": "paragraph",
      "text": "Lebih letih."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kau ambil data.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau semuanya runtuh, aku perlukan bukti.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukti untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Untuk pastikan aku tak mati bersama semua ini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kau simpan insurans.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Terhadap aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Terhadap semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mendekat."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu apa masalahnya?”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Bila seseorang simpan rahsia daripada orang yang paling dekat dengan dia, itu bukan lagi insurans.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Itu pengkhianatan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "“Apa yang ada dalam data itu?”"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Semua?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebahagian.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang kau tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Belum cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss?”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal memahami."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu namanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau tak pernah cerita?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku tak pasti.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku pasti dia bukan orang paling atas.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Adam…”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuba cari.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kau tak beritahu aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu sama ada aku boleh percaya kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu lebih sakit daripada yang dia jangka."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Adam mengeluarkan satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Ini untuk kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya ada gambar."
    },
    {
      "type": "paragraph",
      "text": "Satu gambar lama Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Khalid."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seseorang yang tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa muka dia kabur?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan kabur.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menunjuk gambar."
    },
    {
      "type": "paragraph",
      "text": "“Memang gambar itu diambil dari jauh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia ada dalam banyak tempat.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk membuat aku fikir dia bukan pemerhati biasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka halaman lain."
    },
    {
      "type": "paragraph",
      "text": "Nama syarikat."
    },
    {
      "type": "paragraph",
      "text": "Tarikh."
    },
    {
      "type": "paragraph",
      "text": "Hubungan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu perkara membuatnya berhenti."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL — SUBJECT 01**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa Subject 01?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ada Subject 02?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Buka.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Fail itu.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Data rosak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum hambar."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang tak.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Adam menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih simpan fail?”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang tahu apa yang kau ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cuba jual.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak jual.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan cuba beri kepada Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus diam."
    },
    {
      "type": "paragraph",
      "text": "“Sudah terlambat.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Adam melihat pemacu data di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang fail Project Hayat."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu seseorang sedang menunggu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Rizal menerima berita."
    },
    {
      "type": "paragraph",
      "text": "Satu operasi dijalankan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa individu ditahan."
    },
    {
      "type": "paragraph",
      "text": "Nama Adam disebut."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Adam?”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk melalui telefon."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Pagi tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus keluar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Adam berada dalam bilik soal siasat."
    },
    {
      "type": "paragraph",
      "text": "Dua pegawai duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kami tahu tentang struktur lama.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Kami tahu tentang Bumi Perdana.”"
    },
    {
      "type": "paragraph",
      "text": "Diam."
    },
    {
      "type": "paragraph",
      "text": "“Kami tahu tentang Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang mereka."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kami mahu tahu siapa yang mengawal semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya tahu, saya tak akan duduk di sini.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu meletakkan satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Kami ada bukti bahawa anda menyimpan salinan data.”"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat fail itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Daripada siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu diam."
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kamu pun tak tahu siapa yang beri maklumat.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar, Rizal menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "Seorang peguam."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Adam sudah ditahan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia ada hak untuk peguam.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku mahu jumpa dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dan satu lagi.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
