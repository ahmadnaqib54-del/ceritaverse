    {
      "type": "paragraph",
      "text": "Dulu, waktu begini sudah ada orang menunggu."
    },
    {
      "type": "paragraph",
      "text": "Pengurus."
    },
    {
      "type": "paragraph",
      "text": "Penyelia."
    },
    {
      "type": "paragraph",
      "text": "Pekerja."
    },
    {
      "type": "paragraph",
      "text": "Telefon."
