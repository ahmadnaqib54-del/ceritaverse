    {
      "type": "paragraph",
      "text": "Kemudian berdiri di hadapan pintu."
    },
    {
      "type": "paragraph",
      "text": "Esok dia akan menyerah."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia percaya sistem akan mengampuninya."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia percaya dirinya tidak bersalah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia akhirnya faham—"
