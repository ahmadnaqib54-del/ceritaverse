    {
      "type": "paragraph",
      "text": "Rizal terus berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan itu soalan penting.”"
