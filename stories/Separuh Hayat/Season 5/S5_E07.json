    {
      "type": "paragraph",
      "text": "dia tidak rasa takut."
    },
    {
      "type": "paragraph",
      "text": "Dia cuma penat."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil beg kecilnya."
