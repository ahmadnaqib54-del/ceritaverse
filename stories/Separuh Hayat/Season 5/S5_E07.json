    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum masa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengetap gigi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa telefon aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk beritahu satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat belum selesai.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu mesej masuk."
    },
    {
      "type": "paragraph",
      "text": "**PHASE 5 — SUBJECT STILL ACTIVE.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang jam Roy."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali—"
