  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 7\n## LAST EMPIRE"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak pergi menyerah diri pagi itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia mahu lari."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana Daniel Voss meninggalkan terlalu banyak persoalan."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di dalam kereta di hadapan rumah."
    },
    {
      "type": "paragraph",
      "text": "Enjin dimatikan."
    },
    {
      "type": "paragraph",
      "text": "Telefon di tangannya."
    },
    {
      "type": "paragraph",
      "text": "Nama Daniel masih tertera dalam sejarah panggilan."
    },
    {
      "type": "paragraph",
      "text": "Rizal menekan nombor itu."
    },
    {
      "type": "paragraph",
      "text": "Tidak berjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia cuba sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Masih sama."
    },
    {
      "type": "paragraph",
      "text": "Rizal akhirnya meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "“Takut sangat ke nak bercakap?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa menjawab."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Empayar Rizal tinggal nama."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat telah dibekukan."
    },
    {
      "type": "paragraph",
      "text": "Akaun diperiksa."
    },
    {
      "type": "paragraph",
      "text": "Rakan kongsi menjauh."
    },
    {
      "type": "paragraph",
      "text": "Premis ditutup satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Orang yang dulu menunggu panggilannya sekarang tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal memeriksa satu fail terakhir."
    },
    {
      "type": "paragraph",
      "text": "Aset."
    },
    {
      "type": "paragraph",
      "text": "Liabiliti."
    },
    {
      "type": "paragraph",
      "text": "Kontrak."
    },
    {
      "type": "paragraph",
      "text": "Hutang."
    },
    {
      "type": "paragraph",
      "text": "Semua angka yang dahulu membuatnya rasa berkuasa kini hanya kelihatan seperti bukti bahawa dia telah membina terlalu banyak benda yang tidak boleh dibawa ke mana-mana."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis di atas kertas:"
    },
    {
      "type": "paragraph",
      "text": "**APA YANG MASIH ADA?**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian menyenaraikan:"
    },
    {
      "type": "paragraph",
      "text": "Rumah."
    },
    {
      "type": "paragraph",
      "text": "Sedikit wang."
    },
    {
      "type": "paragraph",
      "text": "Kereta."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Jam Roy."
    },
    {
      "type": "paragraph",
      "text": "Dan—"
    },
    {
      "type": "paragraph",
      "text": "dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti menulis."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat senarai itu lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menambah:"
    },
    {
      "type": "paragraph",
      "text": "**Keluarga?**"
    },
    {
      "type": "paragraph",
      "text": "Dia tidak pasti."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di satu tempat lain, Maya duduk di hadapan dua pegawai."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada beberapa fail."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu keseluruhan sistem,” katanya."
    },
    {
      "type": "paragraph",
      "text": "“Kami tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma nampak bahagian kewangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Bahagian yang cukup besar.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya mahu keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Keluar daripada apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menolak satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Saya akan beri apa yang saya ada.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan sebagai balasan?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya mahu hidup saya kembali.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Maya menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Saya bukan macam mereka.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa mereka?”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandang fail itu."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang percaya mereka masih boleh kawal akibat.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang."
    },
    {
      "type": "paragraph",
      "text": "Rizal menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "Kali ini Daniel menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita perlu bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita sedang bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Bersemuka.”"
    },
    {
      "type": "paragraph",
      "text": "Diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Daniel berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Hotel lama di pusat bandar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tahu tempat itu."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Daniel duduk di sebuah meja."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada pengawal."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada fail."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada komputer."
    },
    {
      "type": "paragraph",
      "text": "Cuma dua cawan kopi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Adam mati.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau cakap itu macam biasa.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagi saya, kematian tidak pernah biasa.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan main dengan ayat.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mencondongkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Siapa mula?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak semudah itu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jawapan mudah.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat bukan organisasi seperti yang awak fikir.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Satu projek.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Untuk melihat apa yang manusia lakukan apabila mereka berada di bawah tekanan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Eksperimen?”"
    },
    {
      "type": "paragraph",
      "text": "“Lebih kurang.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan aku?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak salah satu contoh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Salah satu?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa ramai?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal memahami."
    },
    {
      "type": "paragraph",
      "text": "“Ramai.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang cawannya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi semua ini dirancang?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia membuat pilihannya sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "“Malik?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia juga.”"
    },
    {
      "type": "paragraph",
      "text": "“Adam?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Adam?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel akhirnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Adam masuk kerana dia mahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengetap gigi."
    },
    {
      "type": "paragraph",
      "text": "“Dan aku?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Awak masuk kerana awak fikir awak perlu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Itu bukan pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu tetap pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu membuatkannya teringat suara Adam."
    },
    {
      "type": "paragraph",
      "text": "**Dia bukan mangsa.**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Daniel mengeluarkan satu fail nipis."
    },
    {
      "type": "paragraph",
      "text": "Dia menolaknya ke arah Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Buka.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka."
    },
    {
      "type": "paragraph",
      "text": "Beberapa halaman."
    },
    {
      "type": "paragraph",
      "text": "Nama."
    },
    {
      "type": "paragraph",
      "text": "Tarikh."
    },
    {
      "type": "paragraph",
      "text": "Profil."
    },
    {
      "type": "paragraph",
      "text": "Tekanan hidup."
    },
    {
      "type": "paragraph",
      "text": "Keputusan."
    },
    {
      "type": "paragraph",
      "text": "Akibat."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada formula."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada rancangan jenayah."
    },
    {
      "type": "paragraph",
      "text": "Cuma manusia."
    },
    {
      "type": "paragraph",
      "text": "Dan pilihan mereka."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat satu halaman."
    },
    {
      "type": "paragraph",
      "text": "Nama:"
    },
    {
      "type": "paragraph",
      "text": "**RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**Umur: 50**"
    },
    {
      "type": "paragraph",
      "text": "**Keadaan: Kanser**"
    },
    {
      "type": "paragraph",
      "text": "**Tekanan utama: Keluarga**"
    },
    {
      "type": "paragraph",
      "text": "**Keutamaan: Masa**"
    },
    {
      "type": "paragraph",
      "text": "**Kekuatan: Sistem pemikiran**"
    },
    {
      "type": "paragraph",
      "text": "**Kelemahan: Tanggungjawab**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Lama sebelum awak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebahagian.”"
    },
    {
      "type": "paragraph",
      "text": "“Malik?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Adam?”"
    },
    {
      "type": "paragraph",
      "text": "“Belakangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Jadi aku hanya eksperimen.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa beza?”"
    },
    {
      "type": "paragraph",
      "text": "“Eksperimen boleh dikawal.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak tidak.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar dari hotel."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di tepi jalan."
    },
    {
      "type": "paragraph",
      "text": "Kereta lalu-lalang."
    },
    {
      "type": "paragraph",
      "text": "Orang berjalan."
    },
    {
      "type": "paragraph",
      "text": "Bandar terus hidup."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa peduli siapa dia."
    },
    {
      "type": "paragraph",
      "text": "Dulu, sebuah panggilan daripadanya boleh mengubah seluruh operasi."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia berdiri di kaki lima sambil menunggu lampu isyarat."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki tua melintas di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Tidak mengenali Rizal."
    },
    {
      "type": "paragraph",
      "text": "Itu terasa aneh."
    },
    {
      "type": "paragraph",
      "text": "Dan melegakan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka almari."
    },
    {
      "type": "paragraph",
      "text": "Masih ada beberapa barang lama."
    },
    {
      "type": "paragraph",
      "text": "Baju guru."
    },
    {
      "type": "paragraph",
      "text": "Fail sekolah."
    },
    {
      "type": "paragraph",
      "text": "Kad pengenalan staf."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil satu kemeja lama."
    },
    {
      "type": "paragraph",
      "text": "Memegangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Sudah lama tiada siapa memanggilnya begitu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Daniel."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Saya ada satu tawaran.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak berminat.”"
    },
    {
      "type": "paragraph",
      "text": "“Dengar dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Awak boleh hilang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Semua identiti awak boleh diubah.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak perlu tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan sebagai balasan?”"
    },
    {
      "type": "paragraph",
      "text": "“Tiada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Tiada?”"
    },
    {
      "type": "paragraph",
      "text": "“Cuma satu syarat.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan kembali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau nak aku hilang?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana sistem sudah tamat untuk awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Daniel menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Awak sudah kehilangan semua yang penting.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jam Roy."
    },
    {
      "type": "paragraph",
      "text": "Tidak."
    },
    {
      "type": "paragraph",
      "text": "Belum semua."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, Rizal pergi ke rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Linda membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Dia terkejut melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Linda keluar ke halaman."
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku ada peluang untuk hilang.”"
    },
    {
      "type": "paragraph",
      "text": "Linda diam."
    },
    {
      "type": "paragraph",
      "text": "“Pergi jauh. Mulakan hidup baru.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau beritahu aku?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab jujur."
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku tak tahu apa yang patut aku buat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kau nak aku suruh kau lari?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau nak aku suruh kau menyerah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Linda berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak boleh pilih untuk kau lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau kata semua yang kau buat kerana kami.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku tahu itu cuma separuh benar.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "“Pada mulanya aku memang takut mati.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Tapi selepas itu…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Aku suka kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku suka bila orang perlukan aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku suka bila aku boleh kawal sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan aku guna keluarga sebagai alasan untuk terus buat semua itu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak menangis."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang paling menyakitkan."
    },
    {
      "type": "paragraph",
      "text": "Dia cuma berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya sekarang kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka telefon."
    },
    {
      "type": "paragraph",
      "text": "Mesej daripada Daniel."
    },
    {
      "type": "paragraph",
      "text": "**MASIH BOLEH HILANG.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menaip:"
    },
    {
      "type": "paragraph",
      "text": "**TIDAK.**"
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian jawapan muncul."
    },
    {
      "type": "paragraph",
      "text": "**KENAPA?**"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "Dia menaip perlahan."
    },
    {
      "type": "paragraph",
      "text": "**SEBAB AKU NAK HADAP.**"
    },
    {
      "type": "paragraph",
      "text": "Tidak ada jawapan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 9 malam."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di meja makan."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka halaman pertama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menulis sesuatu."
    },
    {
      "type": "paragraph",
      "text": "**Saya tidak dipaksa.**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Padam."
    },
    {
      "type": "paragraph",
      "text": "Tulis semula."
    },
    {
      "type": "paragraph",
      "text": "**Saya pernah dipaksa oleh keadaan.**"
    },
    {
      "type": "paragraph",
      "text": "Berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**Tetapi selepas itu, saya memilih.**"
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan pen."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar rumah, sebuah kereta berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dua pegawai turun."
    },
    {
      "type": "paragraph",
      "text": "Mereka tidak terus datang ke pintu."
    },
    {
      "type": "paragraph",
      "text": "Salah seorang memeriksa telefon."
    },
    {
      "type": "paragraph",
      "text": "“Dia masih di sini.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Esok?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka kembali ke kereta."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tahu mereka berada di luar."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di dapur."
    },
    {
      "type": "paragraph",
      "text": "Membuka peti sejuk."
    },
    {
      "type": "paragraph",
      "text": "Ada susu."
    },
    {
      "type": "paragraph",
      "text": "Beberapa telur."
    },
    {
      "type": "paragraph",
      "text": "Sedikit sayur."
    },
    {
      "type": "paragraph",
      "text": "Kehidupan biasa."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia mahu memastikan keluarganya tidak pernah kekurangan apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya—"
    },
    {
      "type": "paragraph",
      "text": "dia kehilangan keluarga kerana cuba memastikan mereka tidak kekurangan."
    },
    {
      "type": "paragraph",
      "text": "Ironi itu terlalu besar untuk ditertawakan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 11:30 malam."
    },
    {
      "type": "paragraph",
      "text": "Telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Suara di hujung talian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Daniel tawarkan awak jalan keluar?”"
