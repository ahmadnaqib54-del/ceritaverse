      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Awak terlibat dengan sistem ini bertahun-tahun.”"
