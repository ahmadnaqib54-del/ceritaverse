    {
      "type": "paragraph",
      "text": "“Jangan bagi alasan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak nak bagi alasan.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau begitu, jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
