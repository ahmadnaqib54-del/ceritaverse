      "type": "paragraph",
      "text": "Dulu dia mengajar pelajar bahawa setiap proses menghasilkan akibat."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia sendiri berdiri di dalam eksperimen yang dia tidak tahu cara menghentikannya."
    },
    {
      "type": "paragraph",
      "text": "Dia memadam semuanya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, satu fail tiba di tangan pihak berkuasa."
    },
    {
      "type": "paragraph",
      "text": "Bukan melalui Adam."
    },
    {
      "type": "paragraph",
      "text": "Bukan melalui Maya."
    },
    {
      "type": "paragraph",
      "text": "Bukan melalui Rizal."
    },
    {
      "type": "paragraph",
      "text": "Seseorang menghantar salinan."
    },
    {
      "type": "paragraph",
      "text": "Nama fail:"
    },
    {
      "type": "paragraph",
      "text": "**HAYAT_01**"
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya terdapat sejarah yang lebih lama."
    },
    {
      "type": "paragraph",
      "text": "Sebelum Hashim."
    },
    {
      "type": "paragraph",
      "text": "Sebelum Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Sebelum Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dan satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki muda berdiri di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengenali lelaki itu."
    },
    {
      "type": "paragraph",
      "text": "Daniel Voss."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tarikh pada gambar membuatkan Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Gambar itu diambil bertahun-tahun sebelum dia pernah bertemu Hashim."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Peguam menelefonnya."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak patut lihat ini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka gambar yang dihantar."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bercakap."
    },
    {
      "type": "paragraph",
      "text": "“Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku kenal mereka.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Malik.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak pernah jumpa Daniel sebelum ini?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat tarikh."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi mereka dah kenal satu sama lain lama sebelum aku.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin lewat."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia lama di tangannya."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka halaman pertama."
    },
    {
      "type": "paragraph",
      "text": "Tulisan tangannya ketika muda."
    },
    {
      "type": "paragraph",
      "text": "**“Setiap tindak balas memerlukan syarat.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia teringat sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Malik."
    },
    {
      "type": "paragraph",
      "text": "Daniel."
    },
    {
      "type": "paragraph",
      "text": "Project Hayat."
    },
    {
      "type": "paragraph",
      "text": "Semua itu bukan bermula apabila Rizal membuat keputusan pertama."
    },
    {
      "type": "paragraph",
      "text": "Mungkin keputusan pertama cuma membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Dan ada seseorang yang sudah lama berdiri di belakang pintu itu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 2:13 pagi."
    },
    {
      "type": "paragraph",
      "text": "Telefon Rizal berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada suara."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu rakaman dimainkan."
    },
    {
      "type": "paragraph",
      "text": "Suara Adam."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus duduk tegak."
    },
    {
      "type": "paragraph",
      "text": "> “Kalau kau dengar ini, aku mungkin dah tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "Rakaman diteruskan."
    },
    {
      "type": "paragraph",
      "text": "> “Aku tak tahu siapa yang akan sampai kepada fail ini.”"
    },
    {
      "type": "paragraph",
      "text": "> “Tapi aku tahu satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "> “Rizal bukan pemula.”"
    },
    {
      "type": "paragraph",
      "text": "Rakaman berhenti seketika."
    },
    {
      "type": "paragraph",
      "text": "Kemudian suara Adam kembali."
    },
    {
      "type": "paragraph",
      "text": "> “Tapi dia juga bukan mangsa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "> “Dia buat pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "> “Aku pun.”"
    },
    {
      "type": "paragraph",
      "text": "> “Hashim pun.”"
    },
    {
      "type": "paragraph",
      "text": "> “Malik pun.”"
    },
    {
      "type": "paragraph",
      "text": "> “Dan mungkin semua orang yang terlibat dalam sistem ini.”"
    },
    {
      "type": "paragraph",
      "text": "Rakaman berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ayat terakhir."
    },
    {
      "type": "paragraph",
      "text": "> “Kalau kau mahu tahu siapa yang mula…”"
    },
    {
      "type": "paragraph",
      "text": "Adam menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "> “Jangan cari orang.”"
    },
    {
      "type": "paragraph",
      "text": "> “Cari sebab.”"
    },
    {
      "type": "paragraph",
      "text": "Rakaman tamat."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Rizal sepatutnya menyerah diri."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum dia keluar rumah—"
    },
    {
      "type": "paragraph",
      "text": "sebuah kereta berhenti di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki turun."
    },
    {
      "type": "paragraph",
      "text": "Daniel Voss."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya dari balik pintu."
    },
    {
      "type": "paragraph",
      "text": "Daniel tidak masuk."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya berdiri di luar pagar."
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar."
    },
    {
      "type": "paragraph",
      "text": "Mereka saling berpandangan."
    },
    {
      "type": "paragraph",
      "text": "“Adam dah mati,” kata Rizal."
    },
    {
      "type": "paragraph",
      "text": "Daniel mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu dia akan mati?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal semakin hampir."
    },
    {
      "type": "paragraph",
      "text": "“Jawab.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel akhirnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu dia berada dalam bahaya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kau tak buat apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya dengan marah."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel menjawab tenang."
    },
    {
      "type": "paragraph",
      "text": "“Kerana pada satu tahap, semua orang dalam sistem ini perlu membuat keputusan sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Pahit."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang suka cakap macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tapi awak masih belum faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Adam bukan ujian terakhir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel melihat jam tangannya."
    },
    {
      "type": "paragraph",
      "text": "“Awak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berpaling."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya pergi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon di tangannya berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**ADAM MATI. FAIL KELUAR.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL BUKAN PEMULA.**"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "Daniel sudah hilang dari pandangan."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di hadapan rumah."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali sejak semuanya bermula—"
    },
    {
      "type": "paragraph",
      "text": "dia benar-benar keseorangan."
    },
    {
      "type": "paragraph",
      "text": "Dan dia akhirnya faham sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Adam sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "Hashim sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "Amir sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah pergi."
    },
    {
      "type": "paragraph",
      "text": "Roy semakin jauh."
    },
    {
      "type": "paragraph",
      "text": "Empayar sudah runtuh."
    },
    {
      "type": "paragraph",
      "text": "Tetapi akibat daripada semua pilihan itu masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Dan sekarang—"
    },
    {
      "type": "paragraph",
      "text": "ia datang untuk menuntut bayaran."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 6**"
    }
  ],
