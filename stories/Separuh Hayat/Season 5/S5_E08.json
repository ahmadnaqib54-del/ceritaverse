{
  "series": "Separuh Hayat",
  "season": 5,
  "episode": 8,
  "title": "S5 E8",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 8\n## THE FUGITIVE"
    },
    {
      "type": "paragraph",
      "text": "Lampu kereta di hujung jalan masih menyala."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di muka pintu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Kereta itu juga tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat berlalu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kereta itu pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat lampu belakangnya hilang di selekoh."
    },
    {
      "type": "paragraph",
      "text": "Dia menutup pintu."
    },
    {
      "type": "paragraph",
      "text": "Esok."
    },
    {
      "type": "paragraph",
      "text": "Dia akan menyerah."
    },
    {
      "type": "paragraph",
      "text": "Itu keputusan terakhirnya."
    },
    {
      "type": "paragraph",
      "text": "Sekurang-kurangnya itulah yang dia fikir."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 7:10 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "Dia memakai kemeja biasa."
    },
    {
      "type": "paragraph",
      "text": "Seluar hitam."
    },
    {
      "type": "paragraph",
      "text": "Jam Roy."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia dimasukkan ke dalam beg."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di hadapan cermin."
    },
    {
      "type": "paragraph",
      "text": "Lelaki dalam cermin itu kelihatan tua."
    },
    {
      "type": "paragraph",
      "text": "Lebih tua daripada umurnya."
    },
    {
      "type": "paragraph",
      "text": "Dia menyentuh rambutnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Peguam."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus diam."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan datang ke pejabat.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Waran sudah keluar.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan itu.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Nama awak sudah tersebar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "“Media?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat keputusan bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya, saya dah buat terlalu banyak keputusan bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Telefon terus berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Mesej masuk."
    },
    {
      "type": "paragraph",
      "text": "Berita pertama."
    },
    {
      "type": "paragraph",
      "text": "**BEKAS GURU DISYAKI KETUA RANGKAIAN DADAH.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "**POLIS CARI RIZAL.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian gambar."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya."
    },
    {
      "type": "paragraph",
      "text": "Rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Sekolahnya."
    },
    {
      "type": "paragraph",
      "text": "Ayam Gepuk Hut."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Semua sudah keluar."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca satu komen."
    },
    {
      "type": "paragraph",
      "text": "> “Tak sangka cikgu boleh jadi macam ni.”"
    },
    {
      "type": "paragraph",
      "text": "Satu lagi."
    },
    {
      "type": "paragraph",
      "text": "> “Nampak baik sangat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup telefon."
    },
    {
      "type": "paragraph",
      "text": "Ayat kedua lebih sakit."
    },
    {
      "type": "paragraph",
      "text": "Kerana dia sendiri pernah percaya perkara yang sama."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 10 pagi."
    },
    {
      "type": "paragraph",
      "text": "Sebuah kereta berhenti di hadapan rumah."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat dari tingkap."
    },
    {
      "type": "paragraph",
      "text": "Pegawai datang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi rumah sudah kosong."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah keluar melalui pintu belakang."
    },
    {
      "type": "paragraph",
      "text": "Bukan untuk melarikan diri selamanya."
    },
    {
      "type": "paragraph",
      "text": "Cuma untuk membeli masa."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan tanpa arah tertentu."
    },
    {
      "type": "paragraph",
      "text": "Topi menutup sebahagian wajah."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak membawa banyak barang."
    },
    {
      "type": "paragraph",
      "text": "Tiada wang tunai berlebihan."
    },
    {
      "type": "paragraph",
      "text": "Tiada beg besar."
    },
    {
      "type": "paragraph",
      "text": "Tiada rancangan hebat."
    },
    {
      "type": "paragraph",
      "text": "Cuma telefon dan buku kimia."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di sebuah motel kecil di pinggir bandar, Rizal duduk di atas katil."
    },
    {
      "type": "paragraph",
      "text": "Televisyen sedang memainkan berita."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya muncul."
    },
    {
      "type": "paragraph",
      "text": "**“Polis kini sedang memburu seorang bekas guru yang dipercayai mempunyai hubungan dengan rangkaian jenayah terancang.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "“Bekas guru.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Itu sahaja identiti yang masih terasa miliknya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan panggil aku begitu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau dekat mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam tahanan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bos…”"
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau bunuh Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Diam."
    },
    {
      "type": "paragraph",
      "text": "Lama."
    },
    {
      "type": "paragraph",
      "text": "“Saya fikir saya lindungi bos.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak pernah suruh kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu yang buat aku lebih susah terima.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan lindungi aku lagi.”"
    },
    {
      "type": "paragraph",
      "text": "“Bos—”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal menukar saluran."
    },
    {
      "type": "paragraph",
      "text": "Berita lain."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang keluar dari sebuah bangunan."
    },
    {
      "type": "paragraph",
      "text": "Seorang wartawan bertanya:"
    },
    {
      "type": "paragraph",
      "text": "“Puan Linda, adakah puan tahu mengenai kegiatan suami puan?”"
    },
    {
      "type": "paragraph",
      "text": "Linda berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Puan Linda, adakah puan akan menyokong suami puan?”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang kamera."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya menyokong anak-anak saya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup televisyen."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam."
    },
    {
      "type": "paragraph",
      "text": "Rizal berjalan seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke sebuah restoran kecil."
    },
    {
      "type": "paragraph",
      "text": "Duduk di sudut."
    },
    {
      "type": "paragraph",
      "text": "Pesan kopi."
    },
    {
      "type": "paragraph",
      "text": "Pelayan tidak mengenalinya."
    },
    {
      "type": "paragraph",
      "text": "Itu terasa pelik."
    },
    {
      "type": "paragraph",
      "text": "Rizal minum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seseorang duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Rizal terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Kau buat apa di sini?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari awak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya dengar awak melarikan diri.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak lari.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Awak berada di motel, tukar tempat, telefon guna nombor lain dan elak polis.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Awak nak saya panggil apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Baiklah.”"
    },
    {
      "type": "paragraph",
      "text": "Maya duduk."
    },
    {
      "type": "paragraph",
      "text": "“Saya beri kenyataan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya beri semua yang saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya tidak beri semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab ada benda yang saya sendiri tak faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat?”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengeluarkan satu kertas."
    },
    {
      "type": "paragraph",
      "text": "“D.V.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang."
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "Maya menunjuk beberapa nota."
    },
    {
      "type": "paragraph",
      "text": "“Dia muncul dalam beberapa struktur lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan sekadar pelabur.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa dia?”"
    },
    {
      "type": "paragraph",
      "text": "Maya menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal mendapat mesej."
    },
    {
      "type": "paragraph",
      "text": "Daripada nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "**JANGAN PERCAYA MAYA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat Maya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefonnya berbunyi lagi."
    },
    {
      "type": "paragraph",
      "text": "**DIA SUDAH PILIH PIHAK.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menunjukkan mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memasukkan telefon ke poket."
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ada apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tiada.”"
    },
    {
      "type": "paragraph",
      "text": "Maya tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awak masih menipu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dah jadi tabiat.”"
    },
    {
      "type": "paragraph",
      "text": "“Malangnya.”"
    },
    {
      "type": "paragraph",
      "text": "Maya bangun."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Serah diri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau awak terus lari, semua orang akan fikir awak memang seperti yang mereka kata.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau awak tak kembali…”"
    },
    {
      "type": "paragraph",
      "text": "Maya berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Linda mungkin tak akan pernah benarkan Roy jumpa awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Itu cukup."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin lewat."
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar dari restoran."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seseorang muncul dari belakang."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kau?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Mana kau selama ini?”"
    },
    {
      "type": "paragraph",
      "text": "“Hilang.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa muncul sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau hampir habis.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang suka cakap macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Daniel bukan orang terakhir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Tipu.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu nama.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan seorang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Khalid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat lebih besar daripada Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa besar?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup besar untuk buat orang macam Daniel pun takut.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Khalid menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dan sekarang mereka tak mahu kau mati.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab kau masih berguna.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Adam pun berguna.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menambah,"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang dia mati.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi jangan jadi Adam.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia memandu."
    },
    {
      "type": "paragraph",
      "text": "Tidak laju."
    },
    {
      "type": "paragraph",
      "text": "Tidak panik."
    },
    {
      "type": "paragraph",
      "text": "Cuma terus ke satu tempat."
    },
    {
      "type": "paragraph",
      "text": "Sekolah Menengah Bukit Salam."
    },
    {
      "type": "paragraph",
      "text": "Pagar sekolah sudah tutup."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti di luar."
    },
    {
      "type": "paragraph",
      "text": "Melihat bangunan itu dari dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia teringat hari pertama dia mengajar."
    },
    {
      "type": "paragraph",
      "text": "Pelajar bising."
    },
    {
      "type": "paragraph",
      "text": "Makmal bersepah."
    },
    {
      "type": "paragraph",
      "text": "Seorang murid bertanya soalan yang langsung tidak berkaitan dengan kimia."
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa sendiri."
    },
    {
      "type": "paragraph",
      "text": "Kemudian air matanya jatuh."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa aku buat semua ni?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada jawapan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Rizal hampir tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia tekan."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "“Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Ayah dekat mana?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Roy ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Ayah memang tak pandai menipu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ayah minta maaf.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua.”"
    },
    {
      "type": "paragraph",
      "text": "Roy diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Baliklah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "“Ayah tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab Ayah kena selesaikan sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Roy diam lagi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "“Kalau Ayah nak minta maaf…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "“…baliklah.”"
    },
    {
      "type": "paragraph",
      "text": "Talian tamat."
    },
    {
      "type": "paragraph",
      "text": "Rizal menangis."
    },
    {
      "type": "paragraph",
      "text": "Tidak lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menghidupkan enjin."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 3 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali ke motel."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka beg."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Jam."
    },
    {
      "type": "paragraph",
      "text": "Beberapa dokumen."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat semuanya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengambil sehelai kertas."
    },
    {
      "type": "paragraph",
      "text": "Menulis:"
    },
    {
      "type": "paragraph",
      "text": "**SAYA AKAN SERAH DIRI.**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menambah:"
    },
    {
      "type": "paragraph",
      "text": "**TAPI BUKAN SEBAB MEREKA MENANG.**"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadam perkataan terakhir."
    },
    {
      "type": "paragraph",
      "text": "Tulis semula:"
    },
    {
      "type": "paragraph",
      "text": "**SEBAB SAYA DAH TAK NAK LARI.**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar dari motel."
    },
    {
      "type": "paragraph",
      "text": "Di tempat letak kereta, dia nampak dua kereta polis di kejauhan."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak berlari."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum dia sempat mendekati mereka—"
    },
    {
      "type": "paragraph",
      "text": "sebuah kereta lain berhenti di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Pintu terbuka."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Siapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang boleh bawa kau keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau akan dipenjarakan.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Keluarga kau akan terus dihukum.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau akan kehilangan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku dah kehilangan.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal berpaling."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berjalan ke arah polis."
    },
    {
      "type": "paragraph",
      "text": "Namun sebelum sampai—"
    },
    {
      "type": "paragraph",
      "text": "telefon dalam poketnya berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**KAMI TAHU DI MANA LINDA DAN ROY BERADA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "**KALAU KAU SERAH DIRI HARI INI, MEREKA AKAN JADI SASARAN.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memejamkan mata."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian, dia membuka mata semula."
    },
    {
      "type": "paragraph",
      "text": "Kali ini wajahnya tidak lagi marah."
    },
    {
      "type": "paragraph",
      "text": "Tidak takut."
    },
    {
      "type": "paragraph",
      "text": "Cuma letih."
    },
    {
      "type": "paragraph",
      "text": "Dia mengeluarkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Membaca mesej sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadamnya."
    },
    {
      "type": "paragraph",
      "text": "Dia terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai mengangkat senjata."
    },
    {
      "type": "paragraph",
      "text": "“Rizal!”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kedua-dua tangan."
    },
    {
      "type": "paragraph",
      "text": "“Saya menyerah.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya mahu bercakap dengan keluarga saya dahulu.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mendekat."
    },
    {
      "type": "paragraph",
      "text": "“Turunkan telefon.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyerahkannya."
    },
    {
      "type": "paragraph",
      "text": "Borgol dipasang."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak melawan."
    },
    {
      "type": "paragraph",
      "text": "Sebelum masuk ke kenderaan polis, Rizal menoleh sekali lagi ke arah jalan."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu seseorang sedang memerhatikannya."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu Project Hayat masih ada."
    },
    {
      "type": "paragraph",
      "text": "Tetapi buat pertama kali—"
    },
    {
      "type": "paragraph",
      "text": "dia tidak cuba menang."
    },
    {
      "type": "paragraph",
      "text": "Dia cuma mahu pulang."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 8**"
    }
  ],
