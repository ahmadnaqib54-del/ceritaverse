{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 2,
  "episode": 7,
  "title": "MELAKA",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Aku masih ingat malam itu."
    },
    {
      "type": "paragraph",
      "text": "Malam ketika seluruh Melaka menunggu untuk diserang."
    },
    {
      "type": "paragraph",
      "text": "Kami berdiri di atas tembok."
    },
    {
      "type": "paragraph",
      "text": "Aku di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Miguel di sebelah aku."
    },
    {
      "type": "paragraph",
      "text": "Di belakang kami, kota yang kami pertahankan."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan kami, ribuan cahaya bergerak dalam kegelapan."
    },
    {
      "type": "paragraph",
      "text": "Obor."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Semakin dekat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bunyi pertama kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Tanduk."
    },
    {
      "type": "paragraph",
      "text": "Panjang."
    },
    {
      "type": "paragraph",
      "text": "Berat."
    },
    {
      "type": "paragraph",
      "text": "Diikuti jeritan manusia yang bergema dari luar tembok."
    },
    {
      "type": "paragraph",
      "text": "“Bersedia!”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat pedang."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tembak sebelum aku arahkan!”"
    },
    {
      "type": "paragraph",
      "text": "Mereka semakin dekat."
    },
    {
      "type": "paragraph",
      "text": "Aku dapat melihat bayang-bayang manusia."
    },
    {
      "type": "paragraph",
      "text": "Kemudian—"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang!”"
    },
    {
      "type": "paragraph",
      "text": "Meriam meletup."
    },
    {
      "type": "paragraph",
      "text": "Malam berubah menjadi siang."
    },
    {
      "type": "paragraph",
      "text": "Api menyambar dari atas tembok."
    },
    {
      "type": "paragraph",
      "text": "Jeritan kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Kemudian anak panah."
    },
    {
      "type": "paragraph",
      "text": "Batu."
    },
    {
      "type": "paragraph",
      "text": "Peluru."
    },
    {
      "type": "paragraph",
      "text": "Segalanya datang serentak."
    },
    {
      "type": "paragraph",
      "text": "Aku menunduk."
    },
    {
      "type": "paragraph",
      "text": "Sesuatu melintas di atas kepala aku."
    },
    {
      "type": "paragraph",
      "text": "“Isi semula!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menjerit."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang aku bergerak."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa sempat berfikir."
    },
    {
      "type": "paragraph",
      "text": "Kami hanya melakukan apa yang telah kami lakukan sepanjang hidup kami."
    },
    {
      "type": "paragraph",
      "text": "Bertahan."
    },
    {
      "type": "paragraph",
      "text": "Malam itu berlangsung terlalu lama."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu berapa kali mereka menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu berapa kali mereka berundur."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tahu setiap kali kami fikir mereka sudah berhenti—"
    },
    {
      "type": "paragraph",
      "text": "mereka datang lagi."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tembok itu masih berdiri."
    },
    {
      "type": "paragraph",
      "text": "Dan kami masih di atasnya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Menjelang subuh, suara perang mula perlahan."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di atas tembok dan melihat ke luar."
    },
    {
      "type": "paragraph",
      "text": "Kabut pagi menutupi tanah."
    },
    {
      "type": "paragraph",
      "text": "Beberapa api masih menyala."
    },
    {
      "type": "paragraph",
      "text": "Tiada lagi obor."
    },
    {
      "type": "paragraph",
      "text": "Tiada lagi jeritan."
    },
    {
      "type": "paragraph",
      "text": "Hanya bunyi manusia yang keletihan."
    },
    {
      "type": "paragraph",
      "text": "Miguel datang kepada aku."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku juga tidak bertanya."
    },
    {
      "type": "paragraph",
      "text": "Kami hanya berdiri."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seorang askar datang berlari."
    },
    {
      "type": "paragraph",
      "text": "“Captain!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Mereka berundur.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Miguel."
    },
    {
      "type": "paragraph",
      "text": "“Semua?”"
    },
    {
      "type": "paragraph",
      "text": "“Setakat yang kami nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tidak tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Aku sudah belajar."
    },
    {
      "type": "paragraph",
      "text": "Dalam perang, jangan terlalu cepat percaya kepada berita baik."
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, berita itu disahkan."
    },
    {
      "type": "paragraph",
      "text": "Pasukan Sultan Mahmud telah berundur."
    },
    {
      "type": "paragraph",
      "text": "Melaka masih berada di tangan Portugis."
    },
    {
      "type": "paragraph",
      "text": "Aku turun dari tembok."
    },
    {
      "type": "paragraph",
      "text": "Langkah aku terasa berat."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak berasa seperti pemenang."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma berasa penat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Aku pulang ke rumah ketika matahari mula naik."
    },
    {
      "type": "paragraph",
      "text": "Alya sedang duduk di hadapan pintu."
    },
    {
      "type": "paragraph",
      "text": "Anak kami berada di sisinya."
    },
    {
      "type": "paragraph",
      "text": "Sebaik sahaja dia melihat aku, dia bangun."
    },
    {
      "type": "paragraph",
      "text": "Aku berjalan kepadanya."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bertanya siapa yang menang."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bertanya berapa ramai yang mati."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandang muka aku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menyentuh pipi aku."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Masih.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Aku duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Anak kami datang kepada aku."
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkatnya."
    },
    {
      "type": "paragraph",
      "text": "Dia semakin berat sekarang."
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Aku rasa dia makin besar.”"
    },
    {
      "type": "paragraph",
      "text": "Alya menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Memanglah.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak ada di rumah hampir setiap masa.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu bukan alasan untuk tidak perasan.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang mereka berdua."
    },
    {
      "type": "paragraph",
      "text": "Selama beberapa saat, dunia terasa normal."
    },
    {
      "type": "paragraph",
      "text": "Tiada perang."
    },
    {
      "type": "paragraph",
      "text": "Tiada meriam."
    },
    {
      "type": "paragraph",
      "text": "Tiada musuh."
    },
    {
      "type": "paragraph",
      "text": "Hanya aku."
    },
    {
      "type": "paragraph",
      "text": "Alya."
    },
    {
      "type": "paragraph",
      "text": "Anak kami."
    },
    {
      "type": "paragraph",
      "text": "Rumah kami."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tahu kedamaian itu tidak akan kekal selamanya."
    },
    {
      "type": "paragraph",
      "text": "Perang jarang memberi hadiah seperti itu."
    },
    {
      "type": "paragraph",
      "text": "Ia cuma memberi masa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minggu berlalu."
    },
    {
      "type": "paragraph",
      "text": "Melaka mula bernafas semula."
    },
    {
      "type": "paragraph",
      "text": "Pasar dibuka."
    },
    {
      "type": "paragraph",
      "text": "Kapal kembali datang."
    },
    {
      "type": "paragraph",
      "text": "Pedagang kembali menawar harga."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang membaiki rumah."
    },
    {
      "type": "paragraph",
      "text": "Kedai dibuka semula."
    },
    {
      "type": "paragraph",
      "text": "Anak-anak kembali bermain di jalan."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah melihat Melaka sebelum Portugis datang."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah melihatnya ketika kami menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah melihatnya ketika kota ini jatuh."
    },
    {
      "type": "paragraph",
      "text": "Dan sekarang aku melihatnya bangkit semula."
    },
    {
      "type": "paragraph",
      "text": "Tidak sama."
    },
    {
      "type": "paragraph",
      "text": "Tetapi masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Aku berjalan melalui pasar bersama Miguel."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Kau perasan sesuatu?”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau tak boleh bercakap dengan orang sini.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku masih tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang seorang pedagang yang sedang bercakap dengan pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma tahu beberapa perkataan.”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa?”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk tawar harga.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa lagi."
    },
    {
      "type": "paragraph",
      "text": "Kami terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku lama."
    },
    {
      "type": "paragraph",
      "text": "“Kalau seseorang beritahu kau sepuluh tahun lalu yang kau akan tinggal di Melaka…”"
    },
    {
      "type": "paragraph",
      "text": "Aku memotong."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan ketawa.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia kata kau akan berkahwin dengan perempuan Melaka?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku akan ketawa lebih kuat.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia kata kau akan ada anak?”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Aku mungkin akan lari.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Dan sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat pasar."
    },
    {
      "type": "paragraph",
      "text": "Orang ramai."
    },
    {
      "type": "paragraph",
      "text": "Kapal."
    },
    {
      "type": "paragraph",
      "text": "Rumah."
    },
    {
      "type": "paragraph",
      "text": "Jalan-jalan yang pernah aku lalui dengan pedang di tangan."
    },
    {
      "type": "paragraph",
      "text": "Aku menjawab perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku tak mahu pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Dia cuma mengangguk."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa bulan selepas serangan itu, aku menerima berita."
    },
    {
      "type": "paragraph",
      "text": "Sultan Mahmud masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Masih mempunyai pengikut."
    },
    {
      "type": "paragraph",
      "text": "Masih mempunyai kuasa."
    },
    {
      "type": "paragraph",
      "text": "Masih ada orang yang mahu melihat Portugis keluar dari Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku membaca laporan itu perlahan-lahan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku melipatnya."
    },
    {
      "type": "paragraph",
      "text": "Dulu berita seperti itu akan membuatkan aku terus mengambil pedang."
    },
    {
      "type": "paragraph",
      "text": "Sekarang tidak."
    },
    {
      "type": "paragraph",
      "text": "Aku tetap bersedia."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tidak lagi melihat perang sebagai satu-satunya perkara dalam hidup aku."
    },
    {
      "type": "paragraph",
      "text": "Aku ada rumah."
    },
    {
      "type": "paragraph",
      "text": "Aku ada keluarga."
    },
    {
      "type": "paragraph",
      "text": "Aku ada orang yang bergantung kepada aku."
    },
    {
      "type": "paragraph",
      "text": "Dan mungkin itulah perkara yang paling menakutkan."
    },
    {
      "type": "paragraph",
      "text": "Kerana seorang lelaki boleh mati untuk dirinya sendiri tanpa banyak berfikir."
    },
    {
      "type": "paragraph",
      "text": "Tetapi apabila ada orang yang dia cintai—"
    },
    {
      "type": "paragraph",
      "text": "kematian menjadi sesuatu yang lain."
    },
    {
      "type": "paragraph",
      "text": "Ia mempunyai wajah."
    },
    {
      "type": "paragraph",
      "text": "Nama."
    },
    {
      "type": "paragraph",
      "text": "Suara."
    },
    {
      "type": "paragraph",
      "text": "Kenangan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak mahu anak aku mengenali aku melalui cerita orang lain."
    },
    {
      "type": "paragraph",
      "text": "Aku mahu dia mengenali suara aku."
    },
    {
      "type": "paragraph",
      "text": "Tangan aku."
    },
    {
      "type": "paragraph",
      "text": "Ketawa aku."
    },
    {
      "type": "paragraph",
      "text": "Kesilapan aku."
    },
    {
      "type": "paragraph",
      "text": "Aku mahu dia tahu bapanya bukan seorang wira."
    },
    {
      "type": "paragraph",
      "text": "Cuma seorang lelaki yang cuba pulang setiap kali perang memanggilnya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, aku berdiri di hadapan tembok Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu kenapa aku datang ke situ."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kerana di situlah aku paling jelas memahami apa yang telah berubah dalam diri aku."
    },
    {
      "type": "paragraph",
      "text": "Dulu aku berdiri di atas tembok yang sama untuk memastikan orang lain tidak masuk."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku berdiri di situ kerana aku tahu siapa yang akan berada di dalam jika mereka berjaya masuk."
    },
    {
      "type": "paragraph",
      "text": "Alya."
    },
    {
      "type": "paragraph",
      "text": "Anak kami."
    },
    {
      "type": "paragraph",
      "text": "Jiran-jiran kami."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang yang aku kenal."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang yang pernah membantu aku ketika aku hampir mati."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku terdengar suara di belakang."
    },
    {
      "type": "paragraph",
      "text": "“Captain.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai Portugis berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "Dia menyerahkan sepucuk surat."
    },
    {
      "type": "paragraph",
      "text": "“Dari Goa.”"
    },
    {
      "type": "paragraph",
      "text": "Aku membukanya."
    },
    {
      "type": "paragraph",
      "text": "Aku membaca perlahan."
    },
    {
      "type": "paragraph",
      "text": "Arahan."
    },
    {
      "type": "paragraph",
      "text": "Pergerakan pasukan."
    },
    {
      "type": "paragraph",
      "text": "Kemungkinan operasi seterusnya."
    },
    {
      "type": "paragraph",
      "text": "Dan satu ayat yang membuatkan aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "**Melaka mesti dipertahankan walau apa pun harganya.**"
    },
    {
      "type": "paragraph",
      "text": "Aku membaca ayat itu sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Dulu aku akan menerimanya tanpa berfikir."
    },
    {
      "type": "paragraph",
      "text": "Arahan ialah arahan."
    },
    {
      "type": "paragraph",
      "text": "Raja ialah raja."
    },
    {
      "type": "paragraph",
      "text": "Portugal ialah Portugal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sekarang aku bertanya sesuatu yang tidak pernah aku tanya sepanjang hidup aku."
    },
    {
      "type": "paragraph",
      "text": "**Untuk siapa aku mempertahankan Melaka?**"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat ke arah kota."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku teringat Pedro."
    },
    {
      "type": "paragraph",
      "text": "Tentera-tentera yang mati pada hari pertama."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang yang aku bunuh."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang yang cuba membunuh aku."
    },
    {
      "type": "paragraph",
      "text": "Alya."
    },
    {
      "type": "paragraph",
      "text": "Anak kami."
    },
    {
      "type": "paragraph",
      "text": "Dan akhirnya aku sedar."
    },
    {
      "type": "paragraph",
      "text": "Jawapannya bukan Portugal."
    },
    {
      "type": "paragraph",
      "text": "Bukan raja."
    },
    {
      "type": "paragraph",
      "text": "Bukan aku."
    },
    {
      "type": "paragraph",
      "text": "**Mereka.**"
    },
    {
      "type": "paragraph",
      "text": "Orang-orang yang hidup di dalam kota ini."
    },
    {
      "type": "paragraph",
      "text": "Orang yang telah menjadi keluarga aku."
    },
    {
      "type": "paragraph",
      "text": "Aku melipat surat itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku menyimpannya."
    },
    {
      "type": "paragraph",
      "text": "“Captain?”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang pegawai itu."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah kita akan ikut arahan?”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat sekali lagi ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan pertahankan Melaka.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Bukan kerana surat itu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia kelihatan hairan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak menerangkan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak perlu."
    },
    {
      "type": "paragraph",
      "text": "Kerana buat pertama kali dalam hidup aku—"
    },
    {
      "type": "paragraph",
      "text": "aku memilih sendiri sebab aku mahu berperang."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu aku pulang."
    },
    {
      "type": "paragraph",
      "text": "Alya sedang membasuh pakaian."
    },
    {
      "type": "paragraph",
      "text": "Anak kami bermain di halaman."
    },
    {
      "type": "paragraph",
      "text": "Aku duduk di tangga."
    },
    {
      "type": "paragraph",
      "text": "Matahari perlahan-lahan turun."
    },
    {
      "type": "paragraph",
      "text": "Cahaya keemasan memenuhi Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang jauh."
    },
    {
      "type": "paragraph",
      "text": "Dulu, kali pertama aku melihat kota ini, aku berdiri di atas kapal."
    },
    {
      "type": "paragraph",
      "text": "Aku masih muda."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku hanya tahu kami datang untuk menawan sebuah kota."
    },
    {
      "type": "paragraph",
      "text": "Aku melihat tembok."
    },
    {
      "type": "paragraph",
      "text": "Menara."
    },
    {
      "type": "paragraph",
      "text": "Rumah."
    },
    {
      "type": "paragraph",
      "text": "Kapal."
    },
    {
      "type": "paragraph",
      "text": "Dan manusia yang aku anggap hanya sebagai sebahagian daripada tempat yang akan kami ambil."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu bahawa bertahun-tahun kemudian aku akan duduk di dalam salah satu rumah itu."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu aku akan belajar bahasa mereka."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu aku akan berkahwin dengan salah seorang daripada mereka."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu seorang anak akan memanggil aku ayah."
    },
    {
      "type": "paragraph",
      "text": "Dan aku paling tidak tahu…"
    },
    {
      "type": "paragraph",
      "text": "aku akan mula memanggil tempat ini rumah."
    },
    {
      "type": "paragraph",
      "text": "Alya datang dan duduk di sebelah aku."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang kau fikir?”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Melaka.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kau memang pelik.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menyandarkan kepala pada bahu aku."
    },
    {
      "type": "paragraph",
      "text": "Kami duduk begitu."
    },
    {
      "type": "paragraph",
      "text": "Tidak bercakap."
    },
    {
      "type": "paragraph",
      "text": "Tidak perlu."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan kami, anak kami berlari mengejar sesuatu yang tidak dapat aku lihat."
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku teringat sesuatu."
    },
    {
      "type": "paragraph",
      "text": "“Dulu aku pernah fikir sejarah dibuat oleh orang seperti raja.”"
    },
    {
      "type": "paragraph",
      "text": "Alya memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat anak kami."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kota."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku rasa sejarah juga dibuat oleh orang yang membina semula rumah selepas perang.”"
    },
    {
      "type": "paragraph",
      "text": "Alya diam."
    },
    {
      "type": "paragraph",
      "text": "Aku menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang membuka kedai semula. Orang yang menanam makanan. Orang yang membesarkan anak. Orang yang memilih untuk terus tinggal walaupun mereka pernah kehilangan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang tanganku."
    },
    {
      "type": "paragraph",
      "text": "Tangan yang pernah memegang pedang."
    },
    {
      "type": "paragraph",
      "text": "Kini memegang tangan anak sendiri."
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Orang macam kita.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam turun perlahan."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di hadapan rumah sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Melaka masih bising."
    },
    {
      "type": "paragraph",
      "text": "Kapal masih datang."
    },
    {
      "type": "paragraph",
      "text": "Pasar masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Orang masih bercakap dalam pelbagai bahasa."
    },
    {
      "type": "paragraph",
      "text": "Kota ini masih menjadi tempat yang diperebutkan manusia."
    },
    {
      "type": "paragraph",
      "text": "Mungkin suatu hari nanti akan datang perang lagi."
    },
    {
      "type": "paragraph",
      "text": "Mungkin nama-nama lain akan mengambil tempat nama kami."
    },
    {
      "type": "paragraph",
      "text": "Mungkin satu hari nanti tiada siapa akan mengingati seorang askar Portugis bernama Jose."
    },
    {
      "type": "paragraph",
      "text": "Dan tidak mengapa."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah meminta sejarah mengingati aku."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma mahu mereka yang aku sayang mengingati bahawa aku pernah ada."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "Tempat semuanya bermula."
    },
    {
      "type": "paragraph",
      "text": "Dulu, aku melihat Melaka dari kapal."
    },
    {
      "type": "paragraph",
      "text": "Sebagai seorang askar yang datang untuk menawan."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku melihatnya dari rumah."
    },
    {
      "type": "paragraph",
      "text": "Sebagai seorang suami."
    },
    {
      "type": "paragraph",
      "text": "Sebagai seorang bapa."
    },
    {
      "type": "paragraph",
      "text": "Sebagai seorang lelaki yang akhirnya tahu di mana dia mahu berada."
    },
    {
      "type": "paragraph",
      "text": "Alya memanggil dari dalam."
    },
    {
      "type": "paragraph",
      "text": "“Jose!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Makan!”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Aku datang!”"
    },
    {
      "type": "paragraph",
      "text": "Aku melangkah masuk."
    },
    {
      "type": "paragraph",
      "text": "Pintu rumah tertutup di belakang aku."
    },
    {
      "type": "paragraph",
      "text": "Di luar, Melaka terus hidup."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali sejak aku mengenali kota ini—"
    },
    {
      "type": "paragraph",
      "text": "aku tidak melihatnya sebagai tempat yang perlu ditawan."
    },
    {
      "type": "paragraph",
      "text": "Aku melihatnya sebagai tempat yang perlu dijaga."
    },
    {
      "type": "paragraph",
      "text": "**Melaka.**"
    },
    {
      "type": "paragraph",
      "text": "**Rumah aku.**"
    }
  ],
  "access": "premium"
}