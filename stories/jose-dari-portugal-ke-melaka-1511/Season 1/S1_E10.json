{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 10,
  "title": "Kami Menang",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Melaka jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku masih ingat pagi itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana bunyi meriam."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana jeritan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana tiada apa-apa bunyi."
    },
    {
      "type": "paragraph",
      "text": "Selepas berhari-hari mendengar perang, kesunyian terasa lebih pelik daripada pertempuran."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di sebuah jalan yang masih dipenuhi kesan pertempuran."
    },
    {
      "type": "paragraph",
      "text": "Cahaya matahari mula masuk di antara bangunan."
    },
    {
      "type": "paragraph",
      "text": "Debu terapung di udara."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang askar Portugis berjalan sambil membawa senjata."
    },
    {
      "type": "paragraph",
      "text": "Sebahagian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Sebahagian ketawa."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berpelukan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang menangis."
    },
    {
      "type": "paragraph",
      "text": "Mereka sudah lama menunggu saat ini."
    },
    {
      "type": "paragraph",
      "text": "Aku sepatutnya rasa perkara yang sama."
    },
    {
      "type": "paragraph",
      "text": "Kami menang."
    },
    {
      "type": "paragraph",
      "text": "Kami benar-benar menang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tidak tahu kenapa aku tidak mampu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Miguel datang dari belakang."
    },
    {
      "type": "paragraph",
      "text": "Dia menepuk bahuku."
    },
    {
      "type": "paragraph",
      "text": "“Kita masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Itu sahaja?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk hari ini, itu sudah cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Adakah kasut kau masih ada?”"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat ke bawah."
    },
    {
      "type": "paragraph",
      "text": "“Masih.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku hampir mati untuk kasut ini.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau hampir mati sebab kau berdiri di tempat yang salah.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu juga.”"
    },
    {
      "type": "paragraph",
      "text": "Kami berjalan bersama."
    },
    {
      "type": "paragraph",
      "text": "Di sekeliling kami, tentera Portugis mula menguasai kota."
    },
    {
      "type": "paragraph",
      "text": "Arahan diberi."
    },
    {
      "type": "paragraph",
      "text": "Kawasan diperiksa."
    },
    {
      "type": "paragraph",
      "text": "Bangunan diperiksa."
    },
    {
      "type": "paragraph",
      "text": "Bekalan dikumpulkan."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang kami mula menetapkan kedudukan."
    },
    {
      "type": "paragraph",
      "text": "Melaka bukan lagi kota yang kami lihat dari laut."
    },
    {
      "type": "paragraph",
      "text": "Ia kini kota yang kami duduki."
    },
    {
      "type": "paragraph",
      "text": "Dan aku mula sedar bahawa menawan sebuah kota tidak berakhir apabila bendera dinaikkan."
    },
    {
      "type": "paragraph",
      "text": "Sebenarnya, itulah ketika kerja sebenar bermula."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, keadaan mula berubah."
    },
    {
      "type": "paragraph",
      "text": "Pasar yang sunyi perlahan-lahan kembali hidup."
    },
    {
      "type": "paragraph",
      "text": "Tidak seperti dahulu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi hidup."
    },
    {
      "type": "paragraph",
      "text": "Orang mula keluar."
    },
    {
      "type": "paragraph",
      "text": "Pedagang mula muncul."
    },
    {
      "type": "paragraph",
      "text": "Kapal masih berada di pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang memandang kami dengan takut."
    },
    {
      "type": "paragraph",
      "text": "Ada yang kelihatan marah."
    },
    {
      "type": "paragraph",
      "text": "Ada yang tidak peduli."
    },
    {
      "type": "paragraph",
      "text": "Mereka cuma mahu berniaga."
    },
    {
      "type": "paragraph",
      "text": "Aku melihat semua itu dari tepi jalan."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki tua membuka kedainya."
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat pintu kayu yang rosak."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menyapu lantai."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "Kami tidak bercakap."
    },
    {
      "type": "paragraph",
      "text": "Dia kembali menyapu."
    },
    {
      "type": "paragraph",
      "text": "Aku terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Entah kenapa, perkara kecil itu membuat aku rasa lebih lega daripada melihat bendera Portugis."
    },
    {
      "type": "paragraph",
      "text": "Sebuah kedai dibuka."
    },
    {
      "type": "paragraph",
      "text": "Sebuah pasar kembali berniaga."
    },
    {
      "type": "paragraph",
      "text": "Seorang ibu membawa anaknya keluar."
    },
    {
      "type": "paragraph",
      "text": "Sebuah kota cuba hidup semula."
    },
    {
      "type": "paragraph",
      "text": "Mungkin itu yang manusia lakukan selepas perang."
    },
    {
      "type": "paragraph",
      "text": "Kami boleh menghancurkan sesuatu dalam sehari."
    },
    {
      "type": "paragraph",
      "text": "Tetapi manusia akan cuba membinanya semula pada keesokan pagi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Braz menemui aku petang itu."
    },
    {
      "type": "paragraph",
      "text": "Dia membawa beberapa helaian kertas."
    },
    {
      "type": "paragraph",
      "text": "Aku sudah tahu apa maksudnya."
    },
    {
      "type": "paragraph",
      "text": "“Masih membaca?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tidak penat?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak seperti kau.”"
    },
    {
      "type": "paragraph",
      "text": "Aku duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang kau baca?”"
    },
    {
      "type": "paragraph",
      "text": "“Laporan.”"
    },
    {
      "type": "paragraph",
      "text": "“Laporan apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Keadaan kota.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak perkara perlu dilakukan.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Bukankah kita sudah menang?”"
    },
    {
      "type": "paragraph",
      "text": "Braz memandangku."
    },
    {
      "type": "paragraph",
      "text": "“Itulah masalahnya.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah kota."
    },
    {
      "type": "paragraph",
      "text": "“Menang perang tidak bermakna semuanya selesai.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu dia betul."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ada sesuatu yang lain bermain dalam fikiran aku."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Melaka."
    },
    {
      "type": "paragraph",
      "text": "“Kau rasa mereka akan terima kita?”"
    },
    {
      "type": "paragraph",
      "text": "Braz diam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Aku tidak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau mereka tidak terima?”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Kau mahu buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Braz ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Bagus. Sekurang-kurangnya kali ini kau jujur.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, kami duduk di tepi pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Air laut bergerak perlahan."
    },
    {
      "type": "paragraph",
      "text": "Kapal-kapal Portugis kelihatan di kejauhan."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang kapal-kapal itu."
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba aku teringat perjalanan kami ke sini."
    },
    {
      "type": "paragraph",
      "text": "Aku masih boleh merasakan goyangan kapal."
    },
    {
      "type": "paragraph",
      "text": "Aku masih boleh dengar Miguel mengadu tentang makanan."
    },
    {
      "type": "paragraph",
      "text": "Aku masih boleh nampak Braz membaca sementara aku cuba tidur."
    },
    {
      "type": "paragraph",
      "text": "Ketika itu, kami tidak tahu apa yang menunggu."
    },
    {
      "type": "paragraph",
      "text": "Kami cuma tahu kami mahu Melaka."
    },
    {
      "type": "paragraph",
      "text": "Sekarang kami sudah memilikinya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi peliknya, aku tidak rasa seperti orang yang sama."
    },
    {
      "type": "paragraph",
      "text": "Miguel duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang laut."
    },
    {
      "type": "paragraph",
      "text": "“Kau rindu Portugal?”"
    },
    {
      "type": "paragraph",
      "text": "Aku berfikir."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Rindu keluarga?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Rindu makanan?”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Yang itu paling aku rindu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia diam."
    },
    {
      "type": "paragraph",
      "text": "“Aku rasa aku akan balik suatu hari nanti.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ke Portugal?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat laut."
    },
    {
      "type": "paragraph",
      "text": "“Aku pun.”"
    },
    {
      "type": "paragraph",
      "text": "Tetapi ketika aku mengatakannya, aku sendiri tidak pasti."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari selepas itu, aku terdengar sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Pada mulanya hanya khabar angin."
    },
    {
      "type": "paragraph",
      "text": "Kemudian orang lain mula bercakap."
    },
    {
      "type": "paragraph",
      "text": "Sultan telah meninggalkan Melaka."
    },
    {
      "type": "paragraph",
      "text": "Baginda masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Baginda tidak ditangkap."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berkata baginda melarikan diri ke arah selatan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berkata baginda akan mengumpulkan semula orangnya."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berkata baginda akan kembali."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu mana yang benar."
    },
    {
      "type": "paragraph",
      "text": "Aku bertanya kepada Braz."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Belum ada kepastian.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi baginda hidup?”"
    },
    {
      "type": "paragraph",
      "text": "“Begitu khabar yang kita dengar.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang kota."
    },
    {
      "type": "paragraph",
      "text": "Melaka sudah jatuh."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sultannya belum."
    },
    {
      "type": "paragraph",
      "text": "Dan tiba-tiba aku teringat semua yang aku pelajari sejak datang ke sini."
    },
    {
      "type": "paragraph",
      "text": "Kota ini tidak pernah benar-benar milik satu bangsa."
    },
    {
      "type": "paragraph",
      "text": "Pedagang datang dan pergi."
    },
    {
      "type": "paragraph",
      "text": "Tentera datang dan pergi."
    },
    {
      "type": "paragraph",
      "text": "Raja berubah."
    },
    {
      "type": "paragraph",
      "text": "Bendera berubah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Melaka terus berdiri."
    },
    {
      "type": "paragraph",
      "text": "Mungkin itu sebabnya kota ini begitu sukar ditundukkan."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana temboknya."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana senjatanya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana terlalu ramai manusia mempunyai sebab untuk mempertahankannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada suatu pagi, aku berjalan sendirian."
    },
    {
      "type": "paragraph",
      "text": "Aku sampai di kawasan yang pernah menjadi tempat pertempuran."
    },
    {
      "type": "paragraph",
      "text": "Rumput mula tumbuh di celah tanah."
    },
    {
      "type": "paragraph",
      "text": "Darah sudah hilang."
    },
    {
      "type": "paragraph",
      "text": "Asap sudah hilang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kesannya masih ada."
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat hari pertama."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat kapal."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat jambatan."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat Pedro."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat lelaki tua."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat budak lelaki yang memandang pedangku."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat semua orang yang aku tidak kenal tetapi pernah aku lihat selama beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku terfikir tentang satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Sejarah mungkin akan menulis bahawa Portugis menawan Melaka pada tahun 1511."
    },
    {
      "type": "paragraph",
      "text": "Mungkin nama Afonso de Albuquerque akan disebut."
    },
    {
      "type": "paragraph",
      "text": "Mungkin nama Sultan akan disebut."
    },
    {
      "type": "paragraph",
      "text": "Mungkin nama orang-orang besar akan dicatat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak ada siapa akan menulis nama Pedro."
    },
    {
      "type": "paragraph",
      "text": "Atau lelaki yang terbaring di jambatan."
    },
    {
      "type": "paragraph",
      "text": "Atau orang yang kehilangan rumah."
    },
    {
      "type": "paragraph",
      "text": "Atau askar yang pulang dengan luka yang tidak pernah dilihat sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang tangan sendiri."
    },
    {
      "type": "paragraph",
      "text": "Tangan seorang askar biasa."
    },
    {
      "type": "paragraph",
      "text": "Aku tiba di sini tanpa nama."
    },
    {
      "type": "paragraph",
      "text": "Aku menang tanpa menjadi sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Dan mungkin begitulah kebanyakan perang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Orang besar membuat keputusan."
    },
    {
      "type": "paragraph",
      "text": "Orang kecil hidup dengan akibatnya."
    },
    {
      "type": "paragraph",
      "text": "Aku menarik nafas panjang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku berkata kepada diri sendiri,"
    },
    {
      "type": "paragraph",
      "text": "“Nama aku Jose.”"
    },
    {
      "type": "paragraph",
      "text": "Tidak ada siapa mendengar."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak kisah."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma mahu mengingatinya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Miguel datang mencariku."
    },
    {
      "type": "paragraph",
      "text": "“Jose!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti di hadapanku."
    },
    {
      "type": "paragraph",
      "text": "“Ada berita.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Mereka kata Sultan sedang mengumpulkan orang.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "“Jauh?”"
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Banyak betul kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya aku tahu dia masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "Angin bertiup perlahan."
    },
    {
      "type": "paragraph",
      "text": "Di belakang kami, Melaka mula hidup semula."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan kami, laut terbentang luas."
    },
    {
      "type": "paragraph",
      "text": "Aku datang ke sini untuk mengambil sebuah kota."
    },
    {
      "type": "paragraph",
      "text": "Kami berjaya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sekarang aku tahu satu perkara yang aku tidak faham ketika berada di atas kapal."
    },
    {
      "type": "paragraph",
      "text": "Menawan Melaka bukan pengakhiran."
    },
    {
      "type": "paragraph",
      "text": "Ia hanya permulaan."
    },
    {
      "type": "paragraph",
      "text": "Kerana seorang raja yang kehilangan kota tidak semestinya kehilangan perang."
    },
    {
      "type": "paragraph",
      "text": "Dan seorang askar yang fikir dia sudah selesai berperang mungkin belum tahu bahawa perang boleh datang mencarinya semula."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang bendera Portugis yang berkibar di atas kota."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku memandang ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "Entah di mana Sultan berada."
    },
    {
      "type": "paragraph",
      "text": "Entah bila dia akan kembali."
    },
    {
      "type": "paragraph",
      "text": "Entah berapa ramai yang akan mengikutnya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi buat pertama kali sejak aku tiba di Timur, aku tidak lagi bertanya,"
    },
    {
      "type": "paragraph",
      "text": "**“Bilakah aku boleh pulang?”**"
    },
    {
      "type": "paragraph",
      "text": "Aku bertanya sesuatu yang lain."
    },
    {
      "type": "paragraph",
      "text": "**“Apa yang akan berlaku kepada Melaka selepas ini?”**"
    },
    {
      "type": "paragraph",
      "text": "Dan jauh di dalam hati aku, aku sudah tahu jawapannya."
    },
    {
      "type": "paragraph",
      "text": "Cerita ini belum berakhir."
    },
    {
      "type": "paragraph",
      "text": "**Season 1 tamat.**"
    }
  ],
  "access": "premium"
}