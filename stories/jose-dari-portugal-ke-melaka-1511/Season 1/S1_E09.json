{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 9,
  "title": "Kota Yang Jatuh",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Malam pertama kami di dalam Melaka terasa lebih panjang daripada perjalanan kami dari India."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tidur."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana takut diserang."
    },
    {
      "type": "paragraph",
      "text": "Aku sudah terlalu letih untuk takut."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tidur kerana kota itu masih berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Dari jauh, kedengaran jeritan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bunyi sesuatu jatuh."
    },
    {
      "type": "paragraph",
      "text": "Kemudian senyap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian jeritan lagi."
    },
    {
      "type": "paragraph",
      "text": "Kami sudah menyeberangi jambatan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Melaka belum menyerah."
    },
    {
      "type": "paragraph",
      "text": "Beberapa kawasan masih dikuasai orang-orangnya."
    },
    {
      "type": "paragraph",
      "text": "Beberapa jalan masih berbahaya."
    },
    {
      "type": "paragraph",
      "text": "Dan setiap kali bunyi langkah kedengaran, kami akan mencapai pedang."
    },
    {
      "type": "paragraph",
      "text": "Aku duduk di hadapan sebuah bangunan yang kami jadikan tempat berlindung."
    },
    {
      "type": "paragraph",
      "text": "Miguel tidur di sebelah dinding."
    },
    {
      "type": "paragraph",
      "text": "Atau sekurang-kurangnya cuba tidur."
    },
    {
      "type": "paragraph",
      "text": "Braz pula masih berjaga."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau tak tidur?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau fikir terlalu banyak.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu masalah orang yang boleh membaca.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus. Aku tak boleh membaca.”"
    },
    {
      "type": "paragraph",
      "text": "“Jelas sekali.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menjelingnya."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kami kembali diam."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan kami, sebuah rumah masih mempunyai lampu."
    },
    {
      "type": "paragraph",
      "text": "Kecil."
    },
    {
      "type": "paragraph",
      "text": "Kuning."
    },
    {
      "type": "paragraph",
      "text": "Tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Aku tertanya-tanya siapa di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian lampu itu padam."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pagi datang perlahan-lahan."
    },
    {
      "type": "paragraph",
      "text": "Aku berharap apabila matahari terbit, semuanya akan berakhir."
    },
    {
      "type": "paragraph",
      "text": "Ia tidak."
    },
    {
      "type": "paragraph",
      "text": "Pertempuran bersambung."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini berbeza."
    },
    {
      "type": "paragraph",
      "text": "Kami tidak lagi menyerang sebuah kota dari luar."
    },
    {
      "type": "paragraph",
      "text": "Kami sudah berada di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Dan itu membuatkan setiap lorong menjadi perangkap."
    },
    {
      "type": "paragraph",
      "text": "Aku bergerak bersama satu kumpulan kecil menuju ke kawasan yang belum kami kuasai."
    },
    {
      "type": "paragraph",
      "text": "Kami berjalan perlahan."
    },
    {
      "type": "paragraph",
      "text": "Senjata diangkat."
    },
    {
      "type": "paragraph",
      "text": "Setiap tingkap kami perhatikan."
    },
    {
      "type": "paragraph",
      "text": "Setiap pintu boleh menyimpan seseorang."
    },
    {
      "type": "paragraph",
      "text": "Setiap bumbung boleh menjadi tempat anak panah datang."
    },
    {
      "type": "paragraph",
      "text": "Kami sampai di satu simpang."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "Berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kami berhenti."
    },
    {
      "type": "paragraph",
      "text": "Tiada apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke kiri."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ke kanan."
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba seorang lelaki muncul dari sebuah lorong."
    },
    {
      "type": "paragraph",
      "text": "Dia berlari."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar di sebelahku terus mengangkat pedang."
    },
    {
      "type": "paragraph",
      "text": "“Jangan!”"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu kenapa aku menjerit."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia bukan askar."
    },
    {
      "type": "paragraph",
      "text": "Dia seorang lelaki tua."
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat kedua-dua tangan."
    },
    {
      "type": "paragraph",
      "text": "Mulutnya bergerak."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak memahami apa yang dikatakannya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku faham gerakannya."
    },
    {
      "type": "paragraph",
      "text": "Dia meminta kami berhenti."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar menarik pedangnya."
    },
    {
      "type": "paragraph",
      "text": "Aku memegang lengannya."
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan tentera.”"
    },
    {
      "type": "paragraph",
      "text": "“Mana kau tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tahu."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu memandang kami dengan wajah yang aku pernah lihat sebelum ini."
    },
    {
      "type": "paragraph",
      "text": "Takut."
    },
    {
      "type": "paragraph",
      "text": "Sama seperti wajah kami sebelum menyerang jambatan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai datang."
    },
    {
      "type": "paragraph",
      "text": "Dia bercakap dengan lelaki itu."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak faham semuanya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi selepas beberapa ketika, lelaki itu menunjuk ke arah sebuah bangunan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Kami meneruskan perjalanan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu apa yang berlaku kepadanya."
    },
    {
      "type": "paragraph",
      "text": "Dan aku tidak pernah tahu."
    },
    {
      "type": "paragraph",
      "text": "Itulah perkara tentang perang."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang manusia masuk ke dalam hidup kau selama sepuluh saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian hilang selama-lamanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Menjelang tengah hari, berita mula tersebar."
    },
    {
      "type": "paragraph",
      "text": "Kota semakin banyak jatuh ke tangan kami."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang penting telah berundur."
    },
    {
      "type": "paragraph",
      "text": "Tentangan semakin lemah di beberapa kawasan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berkata Sultan sudah meninggalkan kota."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berkata baginda masih berada di dalam."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berkata tentera kami sudah menang."
    },
    {
      "type": "paragraph",
      "text": "Ada juga yang berkata perang belum selesai."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu mana yang benar."
    },
    {
      "type": "paragraph",
      "text": "Jadi aku memilih untuk tidak percaya semuanya."
    },
    {
      "type": "paragraph",
      "text": "Miguel datang membawa makanan."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "“Roti.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menggigit bahagian hujung."
    },
    {
      "type": "paragraph",
      "text": "“Ini keras.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menggigit."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan roti.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku rasa ini batu.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa."
    },
    {
      "type": "paragraph",
      "text": "Buat pertama kali sejak kami mendarat, aku dengar dia ketawa tanpa dipaksa."
    },
    {
      "type": "paragraph",
      "text": "Kami makan dalam diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "“Hm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita menang…”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita akan dapat apa?”"
    },
    {
      "type": "paragraph",
      "text": "Aku berfikir."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tak mahu emas?”"
    },
    {
      "type": "paragraph",
      "text": "“Sudah tentu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau mahu rumah?”"
    },
    {
      "type": "paragraph",
      "text": "“Sudah tentu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau mahu balik Portugal?”"
    },
    {
      "type": "paragraph",
      "text": "Aku terdiam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu sepatutnya mudah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi entah kenapa aku tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dua tahun lalu, aku datang ke Timur kerana mahu melihat dunia."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku melihat Melaka."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku sudah berada di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat jalan-jalan yang penuh manusia."
    },
    {
      "type": "paragraph",
      "text": "Pasar."
    },
    {
      "type": "paragraph",
      "text": "Kapal."
    },
    {
      "type": "paragraph",
      "text": "Bahasa yang aku tidak faham."
    },
    {
      "type": "paragraph",
      "text": "Bau rempah."
    },
    {
      "type": "paragraph",
      "text": "Bunyi orang berniaga."
    },
    {
      "type": "paragraph",
      "text": "Semuanya terasa jauh walaupun baru beberapa hari berlalu."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu,” jawabku."
    },
    {
      "type": "paragraph",
      "text": "Miguel mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bertanya lagi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, kami terdengar bunyi yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Gendang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bukan dari arah musuh."
    },
    {
      "type": "paragraph",
      "text": "Dari arah pasukan kami."
    },
    {
      "type": "paragraph",
      "text": "Orang mula bergerak."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri."
    },
    {
      "type": "paragraph",
      "text": "Braz muncul dari belakang."
    },
    {
      "type": "paragraph",
      "text": "“Pergi.”"
    },
    {
      "type": "paragraph",
      "text": "“Ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Dataran.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ikut."
    },
    {
      "type": "paragraph",
      "text": "Semakin ramai askar berkumpul."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membawa senjata."
    },
    {
      "type": "paragraph",
      "text": "Ada yang cedera."
    },
    {
      "type": "paragraph",
      "text": "Ada yang sudah tidak mempunyai perisai."
    },
    {
      "type": "paragraph",
      "text": "Tetapi mereka semua memandang ke satu arah."
    },
    {
      "type": "paragraph",
      "text": "Aku turut memandang."
    },
    {
      "type": "paragraph",
      "text": "Bendera Portugis kelihatan."
    },
    {
      "type": "paragraph",
      "text": "Ia berkibar di udara."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah membayangkan saat itu."
    },
    {
      "type": "paragraph",
      "text": "Ketika aku masih di atas kapal."
    },
    {
      "type": "paragraph",
      "text": "Ketika aku masih memikirkan Melaka sebagai sebuah kota yang jauh."
    },
    {
      "type": "paragraph",
      "text": "Dalam bayanganku, aku akan berasa bangga."
    },
    {
      "type": "paragraph",
      "text": "Aku akan tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Mungkin aku akan menjerit."
    },
    {
      "type": "paragraph",
      "text": "Tetapi apabila saat itu tiba, aku hanya berdiri."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat semua orang yang tidak ada bersama kami."
    },
    {
      "type": "paragraph",
      "text": "Pedro."
    },
    {
      "type": "paragraph",
      "text": "Askar yang jatuh di jambatan."
    },
    {
      "type": "paragraph",
      "text": "Orang yang mati sebelum sempat melihat bendera itu."
    },
    {
      "type": "paragraph",
      "text": "Miguel berdiri di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku juga tidak."
    },
    {
      "type": "paragraph",
      "text": "Bendera itu terus berkibar."
    },
    {
      "type": "paragraph",
      "text": "Dan akhirnya aku sedar."
    },
    {
      "type": "paragraph",
      "text": "Kami memang menang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kemenangan itu mempunyai wajah yang berbeza daripada apa yang aku bayangkan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Tidak lama kemudian, kami diberi arahan untuk terus berjaga."
    },
    {
      "type": "paragraph",
      "text": "Masih ada kemungkinan serangan."
    },
    {
      "type": "paragraph",
      "text": "Masih ada kawasan yang belum sepenuhnya selamat."
    },
    {
      "type": "paragraph",
      "text": "Jadi kami terus bergerak."
    },
    {
      "type": "paragraph",
      "text": "Ketika berjalan, aku melihat lebih banyak kesan pertempuran."
    },
    {
      "type": "paragraph",
      "text": "Rumah yang rosak."
    },
    {
      "type": "paragraph",
      "text": "Barang dagangan berselerak."
    },
    {
      "type": "paragraph",
      "text": "Pintu yang pecah."
    },
    {
      "type": "paragraph",
      "text": "Pasar yang sunyi."
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti di hadapan sebuah kedai."
    },
    {
      "type": "paragraph",
      "text": "Ada bekas rempah yang pecah di tanah."
    },
    {
      "type": "paragraph",
      "text": "Bau kayu manis masih kuat."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat kali pertama aku datang ke Melaka."
    },
    {
      "type": "paragraph",
      "text": "Ketika itu aku kagum melihat kapal dari pelbagai tempat."
    },
    {
      "type": "paragraph",
      "text": "Pedagang dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Bahasa yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Barang yang tidak pernah aku lihat."
    },
    {
      "type": "paragraph",
      "text": "Melaka terasa seperti seluruh dunia berkumpul di satu tempat."
    },
    {
      "type": "paragraph",
      "text": "Sekarang jalan itu kosong."
    },
    {
      "type": "paragraph",
      "text": "Aku memungut sedikit rempah dari tanah."
    },
    {
      "type": "paragraph",
      "text": "Aku gosok di antara jari."
    },
    {
      "type": "paragraph",
      "text": "Bau itu masih sama."
    },
    {
      "type": "paragraph",
      "text": "Kota itu yang berubah."
    },
    {
      "type": "paragraph",
      "text": "Bukan rempahnya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, aku akhirnya tidur."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu berapa lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku terjaga kerana bunyi seseorang berjalan."
    },
    {
      "type": "paragraph",
      "text": "Aku terus mencapai pedang."
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "Suara Braz."
    },
    {
      "type": "paragraph",
      "text": "Aku melepaskan nafas."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bangun.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku baru tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "“Esok mungkin ada arahan baru.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menggosok mata."
    },
    {
      "type": "paragraph",
      "text": "“Arahan apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tidak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
