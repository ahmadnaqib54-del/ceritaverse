{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 5,
  "title": "ARMADA",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Aku pernah fikir armada besar akan kelihatan mengagumkan."
    },
    {
      "type": "paragraph",
      "text": "Aku silap."
    },
    {
      "type": "paragraph",
      "text": "Ia kelihatan menyusahkan."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak kapal."
    },
    {
      "type": "paragraph",
      "text": "Terlalu ramai manusia."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak tali."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak barang."
    },
    {
      "type": "paragraph",
      "text": "Dan terlalu banyak orang yang yakin mereka tahu apa yang mereka sedang lakukan."
    },
    {
      "type": "paragraph",
      "text": "Aku sedang berdiri di atas geladak apabila sebuah tong hampir jatuh menimpa seorang kelasi."
    },
    {
      "type": "paragraph",
      "text": "Dia melompat ke tepi."
    },
    {
      "type": "paragraph",
      "text": "Tong itu bergolek."
    },
    {
      "type": "paragraph",
      "text": "Kemudian jatuh ke laut."
    },
    {
      "type": "paragraph",
      "text": "Semua orang berhenti."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai menjerit."
    },
    {
      "type": "paragraph",
      "text": "\"Siapa yang lepaskan tong itu?\""
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa menjawab."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Miguel."
    },
    {
      "type": "paragraph",
      "text": "Miguel memandang aku."
    },
    {
      "type": "paragraph",
      "text": "Kami berdua perlahan-lahan berpaling ke arah yang bertentangan."
    },
    {
      "type": "paragraph",
      "text": "\"Aku nampak kau,\" katanya."
    },
    {
      "type": "paragraph",
      "text": "\"Aku pun nampak kau.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku tak buat.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku pun.\""
    },
    {
      "type": "paragraph",
      "text": "Tong itu tenggelam."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengeluh."
    },
    {
      "type": "paragraph",
      "text": "\"Teruskan kerja!\""
    },
    {
      "type": "paragraph",
      "text": "Semua orang bergerak semula."
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Beginilah rupa perang sebelum perang bermula."
    },
    {
      "type": "paragraph",
      "text": "Tidak seperti cerita."
    },
    {
      "type": "paragraph",
      "text": "Tiada muzik."
    },
    {
      "type": "paragraph",
      "text": "Tiada ucapan hebat."
    },
    {
      "type": "paragraph",
      "text": "Hanya lelaki yang membawa tong dan pegawai yang marah kerana tong itu hilang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi di antara semua kekacauan itu, ada sesuatu yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Kami semua tahu ke mana kami pergi."
    },
    {
      "type": "paragraph",
      "text": "**Melaka.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Armada Afonso de Albuquerque bergerak ke timur."
    },
    {
      "type": "paragraph",
      "text": "Semakin lama kami belayar, semakin jauh dunia yang aku kenal."
    },
    {
      "type": "paragraph",
      "text": "Portugal sudah lama hilang dari fikiran."
    },
    {
      "type": "paragraph",
      "text": "India juga semakin jauh."
    },
    {
      "type": "paragraph",
      "text": "Di sekeliling kami hanya laut."
    },
    {
      "type": "paragraph",
      "text": "Dan kapal."
    },
    {
      "type": "paragraph",
      "text": "Hari demi hari."
    },
    {
      "type": "paragraph",
      "text": "Minggu demi minggu."
    },
    {
      "type": "paragraph",
      "text": "Aku mula memahami mengapa ramai lelaki menjadi gila di atas kapal."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada banyak perkara untuk dilakukan."
    },
    {
      "type": "paragraph",
      "text": "Makan."
    },
    {
      "type": "paragraph",
      "text": "Tidur."
    },
    {
      "type": "paragraph",
      "text": "Bekerja."
    },
    {
      "type": "paragraph",
      "text": "Berdoa."
    },
    {
      "type": "paragraph",
      "text": "Bertengkar."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ulang semula."
    },
    {
      "type": "paragraph",
      "text": "Miguel mempunyai cara sendiri untuk menghabiskan masa."
    },
    {
      "type": "paragraph",
      "text": "Dia mengganggu aku."
    },
    {
      "type": "paragraph",
      "text": "\"Jose.\""
    },
    {
      "type": "paragraph",
      "text": "\"Hm?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kau boleh pilih satu benda untuk bawa ke Melaka, apa?\""
    },
    {
      "type": "paragraph",
      "text": "Aku sedang mengasah pedang."
    },
    {
      "type": "paragraph",
      "text": "\"Air.\""
    },
    {
      "type": "paragraph",
      "text": "\"Serius.\""
    },
    {
      "type": "paragraph",
      "text": "\"Air itu serius.\""
    },
    {
      "type": "paragraph",
      "text": "\"Selain air.\""
    },
    {
      "type": "paragraph",
      "text": "\"Makanan.\""
    },
    {
      "type": "paragraph",
      "text": "\"Selain makanan.\""
    },
    {
      "type": "paragraph",
      "text": "\"Tilam.\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengeluh."
    },
    {
      "type": "paragraph",
      "text": "\"Kau sangat membosankan.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku askar.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kalau aku?\""
    },
    {
      "type": "paragraph",
      "text": "\"Apa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kalau aku boleh pilih?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Senjata.\""
    },
    {
      "type": "paragraph",
      "text": "Dia menggeleng."
    },
    {
      "type": "paragraph",
      "text": "\"Perempuan.\""
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "\"Bagus. Sekarang aku tahu apa yang kau fikirkan sepanjang perjalanan.\""
    },
    {
      "type": "paragraph",
      "text": "Dia tersengih."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seorang askar tua yang duduk tidak jauh dari kami menyampuk."
    },
    {
      "type": "paragraph",
      "text": "\"Budak.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel menoleh."
    },
    {
      "type": "paragraph",
      "text": "\"Ya?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kau selamat sampai Melaka, baru kau fikir pasal perempuan.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa?\""
    },
    {
      "type": "paragraph",
      "text": "Lelaki tua itu menunjukkan laut."
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kau mati sebelum sampai, sekurang-kurangnya kau mati dengan cita-cita.\""
    },
    {
      "type": "paragraph",
      "text": "Kami ketawa."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tidak."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya kembali tidur."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, aku dipanggil."
    },
    {
      "type": "paragraph",
      "text": "Braz."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di bahagian belakang kapal bersama beberapa orang pegawai."
    },
    {
      "type": "paragraph",
      "text": "Aku menghampiri."
    },
    {
      "type": "paragraph",
      "text": "\"Kau panggil aku?\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Aku mahu tunjuk sesuatu.\""
    },
    {
      "type": "paragraph",
      "text": "Dia membuka sekeping peta."
    },
    {
      "type": "paragraph",
      "text": "Aku melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Melaka."
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk beberapa tempat."
    },
    {
      "type": "paragraph",
      "text": "\"Ini muara.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Ini kota.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk lagi."
    },
    {
      "type": "paragraph",
      "text": "\"Ini jambatan.\""
    },
    {
      "type": "paragraph",
      "text": "Aku melihatnya lebih lama."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah melihatnya dua tahun lalu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi hanya sekali."
    },
    {
      "type": "paragraph",
      "text": "Dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Braz menunjuk lagi."
    },
    {
      "type": "paragraph",
      "text": "\"Ayah aku fikir jambatan ini penting.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kerana ia menghubungkan bahagian kota.\""
    },
    {
      "type": "paragraph",
      "text": "Aku melihatnya."
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kita ambil?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kita boleh memotong laluan.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku sedar sesuatu."
    },
    {
      "type": "paragraph",
      "text": "\"Kau tahu banyak.\""
    },
    {
      "type": "paragraph",
      "text": "Braz menutup peta."
    },
    {
      "type": "paragraph",
      "text": "\"Aku membaca.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku pula bergaduh.\""
    },
    {
      "type": "paragraph",
      "text": "\"Itu sebabnya kita kawan.\""
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "\"Jadi kau membaca untuk aku?\""
    },
    {
      "type": "paragraph",
      "text": "\"Dan kau bergaduh untuk aku.\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Jangan terlalu selesa.\""
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu berapa lama persahabatan kami akan bertahan."
    },
    {
      "type": "paragraph",
      "text": "Dalam perang, masa tidak pernah menjanjikan apa-apa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu aku duduk seorang diri di geladak."
    },
    {
      "type": "paragraph",
      "text": "Laut tenang."
    },
    {
      "type": "paragraph",
      "text": "Bintang memenuhi langit."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat kali pertama aku melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat lelaki tua yang pernah berkata:"
    },
    {
      "type": "paragraph",
      "text": "*\"Semua orang kata begitu.\"*"
    },
    {
      "type": "paragraph",
      "text": "Aku teringat Rui."
    },
    {
      "type": "paragraph",
      "text": "Aku tertanya-tanya di mana dia sekarang."
    },
    {
      "type": "paragraph",
      "text": "Adakah dia masih hidup?"
    },
    {
      "type": "paragraph",
      "text": "Adakah dia masih menunggu?"
    },
    {
      "type": "paragraph",
      "text": "Adakah dia tahu bahawa kami sedang datang?"
    },
    {
      "type": "paragraph",
      "text": "Aku juga teringat Sequeira."
    },
    {
      "type": "paragraph",
      "text": "Dia pernah berkata:"
    },
    {
      "type": "paragraph",
      "text": "*\"Jangan tertipu dengan pelabuhannya.\"*"
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku faham."
    },
    {
      "type": "paragraph",
      "text": "Melaka bukan sekadar kota."
    },
    {
      "type": "paragraph",
      "text": "Ia tempat di mana ban"
    }
  ],
