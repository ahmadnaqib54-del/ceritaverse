{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 2,
  "title": "KOTA YANG TIDAK PERNAH TIDUR",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Perkara pertama yang aku ingat tentang Melaka ialah bunyinya."
    },
    {
      "type": "paragraph",
      "text": "Bukan rupanya."
    },
    {
      "type": "paragraph",
      "text": "Bukan baunya."
    },
    {
      "type": "paragraph",
      "text": "Bunyinya."
    },
    {
      "type": "paragraph",
      "text": "Kapal kami belum pun berlabuh dengan sempurna apabila bunyi manusia sudah memenuhi udara."
    },
    {
      "type": "paragraph",
      "text": "Orang menjerit dari jeti."
    },
    {
      "type": "paragraph",
      "text": "Pedagang memanggil pekerja."
    },
    {
      "type": "paragraph",
      "text": "Kelasi menarik tali."
    },
    {
      "type": "paragraph",
      "text": "Seseorang menjerit dalam bahasa yang aku tidak faham."
    },
    {
      "type": "paragraph",
      "text": "Kemudian orang lain menjawab dalam bahasa yang aku juga tidak faham."
    },
    {
      "type": "paragraph",
      "text": "Di belakang semuanya, bunyi tukul memukul kayu."
    },
    {
      "type": "paragraph",
      "text": "Tok."
    },
    {
      "type": "paragraph",
      "text": "Tok."
    },
    {
      "type": "paragraph",
      "text": "Tok."
    },
    {
      "type": "paragraph",
      "text": "Tok."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di tepi kapal dan memandang pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "\"Ini gila,\" kata Miguel."
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Ramai betul orang.\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Semua mereka tinggal di sini?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Mungkin.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel menggaru kepala."
    },
    {
      "type": "paragraph",
      "text": "\"Macam mana mereka tahu siapa kawan siapa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Mereka mungkin tak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "Dia memandangku."
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Itu yang buat aku risau.\""
    },
    {
      "type": "paragraph",
      "text": "Melaka bukan seperti mana-mana tempat yang pernah aku lihat."
    },
    {
      "type": "paragraph",
      "text": "Di Portugal, aku pernah melihat pelabuhan yang sibuk."
    },
    {
      "type": "paragraph",
      "text": "Di India, aku sudah melihat kota yang penuh manusia."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Melaka berbeza."
    },
    {
      "type": "paragraph",
      "text": "Di sini, semua benda seolah-olah bertembung."
    },
    {
      "type": "paragraph",
      "text": "Kapal besar."
    },
    {
      "type": "paragraph",
      "text": "Perahu kecil."
    },
    {
      "type": "paragraph",
      "text": "Pedagang."
    },
    {
      "type": "paragraph",
      "text": "Pekerja."
    },
    {
      "type": "paragraph",
      "text": "Tentera."
    },
    {
      "type": "paragraph",
      "text": "Pelaut."
    },
    {
      "type": "paragraph",
      "text": "Pengemis."
    },
    {
      "type": "paragraph",
      "text": "Orang kaya."
    },
    {
      "type": "paragraph",
      "text": "Orang yang kelihatan kaya tetapi mungkin tidak mempunyai wang sesen pun."
    },
    {
      "type": "paragraph",
      "text": "Semuanya bercampur."
    },
    {
      "type": "paragraph",
      "text": "Dan semuanya bergerak."
    },
    {
      "type": "paragraph",
      "text": "Aku turun bersama rombongan Portugis."
    },
    {
      "type": "paragraph",
      "text": "Sebaik sahaja kaki mencecah jeti, aku terhidu sesuatu yang aku tidak dapat kenal pasti."
    },
    {
      "type": "paragraph",
      "text": "Rempah."
    },
    {
      "type": "paragraph",
      "text": "Ikan."
    },
    {
      "type": "paragraph",
      "text": "Asap."
    },
    {
      "type": "paragraph",
      "text": "Peluh."
    },
    {
      "type": "paragraph",
      "text": "Kayu basah."
    },
    {
      "type": "paragraph",
      "text": "Dan sesuatu yang manis."
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh kepada Miguel."
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kau muntah sekarang, aku takkan salahkan kau.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku dah berhenti muntah.\""
    },
    {
      "type": "paragraph",
      "text": "\"Bagus.\""
    },
    {
      "type": "paragraph",
      "text": "\"Perut aku dah kosong.\""
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "Kami bergerak mengikuti rombongan."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan kami, Diogo Lopes de Sequeira berjalan bersama pegawai-pegawainya."
    },
    {
      "type": "paragraph",
      "text": "Dia kelihatan tenang."
    },
    {
      "type": "paragraph",
      "text": "Terlalu tenang, pada pendapatku."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah melihat wajahnya ketika dia marah."
    },
    {
      "type": "paragraph",
      "text": "Lebih baik jangan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi pagi itu dia kelihatan seperti seorang pedagang."
    },
    {
      "type": "paragraph",
      "text": "Bukan komander."
    },
    {
      "type": "paragraph",
      "text": "Itulah tujuan kami datang."
    },
    {
      "type": "paragraph",
      "text": "Perdagangan."
    },
    {
      "type": "paragraph",
      "text": "Setidak-tidaknya begitu yang kami diberitahu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Melaka membuat aku sedar betapa kecilnya dunia yang aku kenal."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah menganggap Portugal luas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku melihat India."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku melihat Melaka."
    },
    {
      "type": "paragraph",
      "text": "Di sini, aku mendengar bahasa yang tidak pernah aku dengar sepanjang hidup."
    },
    {
      "type": "paragraph",
      "text": "Ada orang bercakap Melayu."
    },
    {
      "type": "paragraph",
      "text": "Ada bahasa dari India."
    },
    {
      "type": "paragraph",
      "text": "Ada bahasa Jawa."
    },
    {
      "type": "paragraph",
      "text": "Ada bahasa yang kedengaran seperti orang sedang bertengkar walaupun sebenarnya mereka sedang membeli ikan."
    },
    {
      "type": "paragraph",
      "text": "Miguel berjalan di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang seorang lelaki yang sedang berunding dengan pedagang."
    },
    {
      "type": "paragraph",
      "text": "\"Apa dia cakap?\""
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "\"Tak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Dia marah?\""
    },
    {
      "type": "paragraph",
      "text": "\"Tak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Dia nak bunuh lelaki itu?\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku kata aku tak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian dia berkata:"
    },
    {
      "type": "paragraph",
      "text": "\"Kalau dia bunuh lelaki itu, kau rasa kita perlu lari?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Kita lari dulu. Fikir kemudian.\""
    },
    {
      "type": "paragraph",
      "text": "Itulah satu-satunya nasihat yang aku tahu."
    },
    {
      "type": "paragraph",
      "text": "Kami terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku nampak sesuatu yang membuat aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Meriam."
    },
    {
      "type": "paragraph",
      "text": "Bukan meriam kami."
    },
    {
      "type": "paragraph",
      "text": "Meriam yang ditempatkan untuk mempertahankan kota."
    },
    {
      "type": "paragraph",
      "text": "Tidak semuanya besar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk membuat aku mengubah pendapat tentang Melaka."
    },
    {
      "type": "paragraph",
      "text": "Ini bukan kota yang tidak bersedia."
    },
    {
      "type": "paragraph",
      "text": "Orang di sini tahu bahawa kekayaan membawa musuh."
    },
    {
      "type": "paragraph",
      "text": "Dan mereka sudah lama belajar cara menjaganya."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke arah tembok dan pertahanan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ke arah pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Melaka tidak kelihatan seperti kota yang perlu diselamatkan."
    },
    {
      "type": "paragraph",
      "text": "Ia kelihatan seperti kota yang sudah tahu bagaimana hendak hidup."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hari-hari pertama berjalan lancar."
    },
    {
      "type": "paragraph",
      "text": "Sekurang-kurangnya dari apa yang dapat aku lihat."
    },
    {
      "type": "paragraph",
      "text": "Orang Portugis mula berurusan dengan pedagang tempatan."
    },
    {
      "type": "paragraph",
      "text": "Sequeira dan pegawai lain bertemu dengan pihak Melaka."
    },
    {
      "type": "paragraph",
      "text": "Ada perbincangan."
    },
    {
      "type": "paragraph",
      "text": "Ada hadiah."
    },
    {
      "type": "paragraph",
      "text": "Ada urusan perdagangan."
    },
    {
      "type": "paragraph",
      "text": "Kami menunggu."
    },
    {
      "type": "paragraph",
      "text": "Aku sebenarnya suka bahagian itu."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada pertempuran."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada darah."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada orang cuba menikam aku."
    },
    {
      "type": "paragraph",
      "text": "Hari yang baik."
    },
    {
      "type": "paragraph",
      "text": "Aku duduk di satu sudut pelabuhan sambil melihat orang bekerja."
    },
    {
      "type": "paragraph",
      "text": "Miguel berada di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "Dia memegang buah yang dia beli daripada seorang pedagang."
    },
    {
      "type": "paragraph",
      "text": "\"Apa ini?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandang."
    },
    {
      "type": "paragraph",
      "text": "\"Entah.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kau beli?\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kau tak tahu apa?\""
    },
    {
      "type": "paragraph",
      "text": "Dia menggigit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "\"Masam.\""
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "\"Bagus.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Sebab sekarang kau tahu.\""
    },
    {
      "type": "paragraph",
      "text": "Dia melempar buah itu kepada aku."
    },
    {
      "type": "paragraph",
      "text": "Aku sempat mengelak."
    },
    {
      "type": "paragraph",
      "text": "Buah itu terkena seorang lelaki di belakang kami."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu berpaling."
    },
    {
      "type": "paragraph",
      "text": "Miguel terus duduk tegak."
    },
    {
      "type": "paragraph",
      "text": "Aku menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "\"Kau kenal dia?\" bisik Miguel."
    },
    {
      "type": "paragraph",
      "text": "\"Tak.\""
    },
    {
      "type": "paragraph",
      "text": "\"Bagus.\""
    },
    {
      "type": "paragraph",
      "text": "Kami bangun dan pergi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian aku mula mengenali wajah-wajah tertentu di pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Salah seorang yang selalu aku nampak ialah lelaki yang kemudian aku tahu bernama **Nina Chatu**."
    },
    {
      "type": "paragraph",
      "text": "Dia bukan askar."
    },
    {
      "type": "paragraph",
      "text": "Bukan bangsawan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu ramai orang."
    },
    {
      "type": "paragraph",
      "text": "Pedagang mengenalinya."
    },
    {
      "type": "paragraph",
      "text": "Pekerja mengenalinya."
    },
    {
      "type": "paragraph",
      "text": "Orang yang datang dari luar kota juga mengenalinya."
    },
    {
      "type": "paragraph",
      "text": "Dia boleh bercakap dengan ramai orang."
    },
    {
      "type": "paragraph",
      "text": "Dan yang lebih menarik, ramai orang mahu bercakap dengannya."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah melihat dia berbincang dengan seorang pedagang Gujerat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dengan orang tempatan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dengan seseorang dari kapal asing."
    },
    {
      "type": "paragraph",
      "text": "Dalam masa beberapa minit, dia berpindah dari satu kumpulan ke kumpulan lain seperti orang yang memang dilahirkan untuk berada di tengah-tengah pasar."
    },
    {
      "type": "paragraph",
      "text": "Miguel memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Siapa dia?\""
    },
    {
      "type": "paragraph",
      "text": "\"Nina Chatu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kau kenal?\""
    },
    {
      "type": "paragraph",
      "text": "\"Tak.\""
    },
    {
      "type": "paragraph",
      "text": "\"Jadi kenapa kau tahu namanya?\""
    },
    {
      "type": "paragraph",
      "text": "Aku menunjuk kepadanya."
    },
    {
      "type": "paragraph",
      "text": "\"Semua orang tahu namanya.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel memandang Nina sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "\"Aku tak suka orang yang semua orang kenal.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Biasanya mereka tahu terlalu banyak.\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kali ini aku tidak ketawa."
    },
    {
      "type": "paragraph",
      "text": "Mungkin dia betul."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Tetapi orang yang paling penting bagi kami ketika itu ialah **Rui de Araújo**."
    },
    {
      "type": "paragraph",
      "text": "Araújo mempunyai tugas menguruskan urusan Portugis di Melaka."
    },
    {
      "type": "paragraph",
      "text": "Dia lebih banyak bercakap dengan orang tempatan daripada kami."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu bagaimana untuk mendapatkan maklumat."
    },
    {
      "type": "paragraph",
      "text": "Siapa yang berdagang."
    },
    {
      "type": "paragraph",
      "text": "Siapa yang marah."
    },
    {
      "type": "paragraph",
      "text": "Siapa yang menyokong siapa."
    },
    {
      "type": "paragraph",
      "text": "Siapa yang patut dielakkan."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah bertanya kepadanya tentang kota itu."
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa semua orang di sini nampak macam mereka tahu sesuatu yang kita tak tahu?\""
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa."
    },
    {
      "type": "paragraph",
      "text": "\"Kerana mereka memang tahu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Apa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Melaka.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "\"Kau nampak semua itu?\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Setiap kapal membawa berita.\""
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk kepada pedagang lain."
    },
    {
      "type": "paragraph",
      "text": "\"Setiap pedagang membawa kepentingan.\""
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menunjuk ke arah istana."
    },
    {
      "type": "paragraph",
      "text": "\"Dan setiap orang di sana membawa ketakutan.\""
    },
    {
      "type": "paragraph",
      "text": "Aku tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Araújo tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Jangan terlalu risau, José.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku tidak risau.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kau selalu risau.\""
    },
    {
      "type": "paragraph",
      "text": "\"Itu sebab aku masih hidup.\""
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu ketika itu bahawa beberapa bulan kemudian, lelaki yang sedang ketawa di hadapanku akan berada di dalam penjara."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Perubahan pertama datang perlahan."
    },
    {
      "type": "paragraph",
      "text": "Sangat perlahan."
    },
    {
      "type": "paragraph",
      "text": "Sampai pada mulanya kami tidak sedar."
    },
    {
      "type": "paragraph",
      "text": "Ada pedagang yang berhenti bercakap apabila kami datang."
    },
    {
      "type": "paragraph",
      "text": "Ada orang yang melihat kami terlalu lama."
    },
    {
      "type": "paragraph",
      "text": "Ada kapal yang tiba tetapi tidak mahu berurusan dengan kami."
    },
    {
      "type": "paragraph",
      "text": "Kemudian beberapa orang mula bertanya soalan."
    },
    {
      "type": "paragraph",
      "text": "Soalan yang sama."
    },
    {
      "type": "paragraph",
      "text": "Berapa ramai orang Portugis?"
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak kapal?"
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak meriam?"
    },
    {
      "type": "paragraph",
      "text": "Bila kami akan berangkat?"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak suka soalan terakhir."
    },
    {
      "type": "paragraph",
      "text": "Aku memberitahu Araújo."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Bagus.\""
    },
    {
      "type": "paragraph",
      "text": "\"Bagus?\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa bagus?\""
    },
    {
      "type": "paragraph",
      "text": "\"Sekurang-kurangnya sekarang kita tahu mereka bertanya.\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Dan kalau mereka berhenti bertanya?\""
    },
    {
      "type": "paragraph",
      "text": "Araújo tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Itu yang lebih aku takutkan.\""
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada suatu petang, aku berjalan di sekitar pelabuhan ketika aku terdengar suara seseorang memanggil."
    },
    {
      "type": "paragraph",
      "text": "\"Portugis.\""
    },
    {
      "type": "paragraph",
      "text": "Aku berpaling."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki tua berdiri tidak jauh dari aku."
    },
    {
      "type": "paragraph",
      "text": "Dia memegang kain yang kelihatan mahal."
    },
    {
      "type": "paragraph",
      "text": "Dia bercakap dalam bahasa yang aku faham sedikit."
    },
    {
      "type": "paragraph",
      "text": "\"Ya?\""
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah kapal Portugis."
    },
    {
      "type": "paragraph",
      "text": "\"Kamu datang untuk berdagang?\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Semua orang kata begitu.\""
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu hendak menjawab apa."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang belakangnya."
    },
    {
      "type": "paragraph",
      "text": "Entah kenapa, kata-kata itu melekat di kepala aku."
    },
    {
      "type": "paragraph",
      "text": "**Semua orang kata begitu.**"
    },
    {
      "type": "paragraph",
      "text": "Malam itu aku memberitahu Miguel."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang membersihkan pedangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Apa maksudnya?\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "\"Mungkin dia tidak percaya kita.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel berhenti menggosok pedang."
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa?\""
    },
    {
      "type": "paragraph",
      "text": "Aku tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Sebab aku sendiri tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Atau mungkin aku tahu."
    },
    {
      "type": "paragraph",
      "text": "Kami datang dengan kapal bersenjata."
    },
    {
      "type": "paragraph",
      "text": "Kami datang dengan meriam."
    },
    {
      "type": "paragraph",
      "text": "Kami datang dari tempat yang sangat jauh."
    },
    {
      "type": "paragraph",
      "text": "Dan kami memberitahu semua orang bahawa kami hanya mahu berdagang."
    },
    {
      "type": "paragraph",
      "text": "Mungkin dari luar, ia kedengaran bodoh."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari selepas itu, suasana berubah lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini lebih jelas."
    },
    {
      "type": "paragraph",
      "text": "Arahan diberikan kepada kami supaya lebih berhati-hati."
    },
    {
      "type": "paragraph",
      "text": "Jangan berjalan seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Jangan meninggalkan kawasan rombongan."
    },
    {
      "type": "paragraph",
      "text": "Jangan masuk ke tempat yang tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Jangan mencetuskan masalah."
    },
    {
      "type": "paragraph",
      "text": "Aku suka arahan terakhir."
    },
    {
      "type": "paragraph",
      "text": "Masalahnya, masalah biasanya tidak perlu dijemput."
    },
    {
      "type": "paragraph",
      "text": "Ia akan datang sendiri."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di luar tempat penginapan apabila Sequeira keluar."
    },
    {
      "type": "paragraph",
      "text": "Dia bercakap dengan beberapa pegawai."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya serius."
    },
    {
      "type": "paragraph",
      "text": "Aku cuba mendengar."
    },
    {
      "type": "paragraph",
      "text": "Aku hanya menangkap beberapa perkataan."
    },
    {
      "type": "paragraph",
      "text": "\"Pedagang...\""
    },
    {
      "type": "paragraph",
      "text": "\"...istana...\""
    },
    {
      "type": "paragraph",
      "text": "\"...perubahan...\""
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia melihat aku."
    },
    {
      "type": "paragraph",
      "text": "\"José.\""
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri tegak."
    },
    {
      "type": "paragraph",
      "text": "\"Sir.\""
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan mendekati aku."
    },
    {
      "type": "paragraph",
      "text": "\"Kau sudah lama di Melaka.\""
    },
    {
      "type": "paragraph",
      "text": "\"Beberapa minggu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Apa pendapat kau?\""
    },
    {
      "type": "paragraph",
      "text": "Aku berfikir."
    },
    {
      "type": "paragraph",
      "text": "\"Ramai orang.\""
    },
    {
      "type": "paragraph",
      "text": "Dia memandangku."
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Itu pendapat saya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Dan?\""
    },
    {
      "type": "paragraph",
      "text": "Aku melihat ke arah pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "\"Orang di sini tidak suka kita.\""
    },
    {
      "type": "paragraph",
      "text": "Sequeira diam."
    },
    {
      "type": "paragraph",
      "text": "Aku menyesal bercakap terlalu terus."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kemudian dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "\"Akhirnya kau nampak juga.\""
    },
    {
      "type": "paragraph",
      "text": "\"Jadi betul?\""
    },
    {
      "type": "paragraph",
      "text": "\"Belum tentu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Dan kalau betul?\""
    },
    {
      "type": "paragraph",
      "text": "Dia memandang ke arah kapal kami."
    },
    {
      "type": "paragraph",
      "text": "\"Kita pastikan kita tidak memberi mereka sebab.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Sequeira berlalu pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "Aku melihat pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Ratusan manusia bergerak seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Pedagang masih menjual barang."
    },
    {
      "type": "paragraph",
      "text": "Kapal masih berlabuh."
    },
    {
      "type": "paragraph",
      "text": "Kanak-kanak masih berlari."
    },
    {
      "type": "paragraph",
      "text": "Orang masih ketawa."
    },
    {
      "type": "paragraph",
      "text": "Melaka masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sesuatu telah berubah."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma belum tahu apa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, aku tidak dapat tidur."
    },
    {
      "type": "paragraph",
      "text": "Aku keluar."
    },
    {
      "type": "paragraph",
      "text": "Pelabuhan jauh lebih sunyi."
    },
    {
      "type": "paragraph",
      "text": "Lampu-lampu kecil kelihatan di sepanjang kawasan kota."
    },
    {
      "type": "paragraph",
      "text": "Aku mendengar bunyi air."
    },
    {
      "type": "paragraph",
      "text": "Bunyi tali kapal bergerak."
    },
    {
      "type": "paragraph",
      "text": "Bunyi orang bercakap perlahan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku nampak sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Di seberang pelabuhan, seorang lelaki sedang memerhatikan kapal Portugis."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri lama."
    },
    {
      "type": "paragraph",
      "text": "Tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Aku memerhatikannya."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang kapal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak mengejarnya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu siapa dia."
    },
    {
      "type": "paragraph",
      "text": "Mungkin pedagang."
    },
    {
      "type": "paragraph",
      "text": "Mungkin askar."
    },
    {
      "type": "paragraph",
      "text": "Mungkin tiada apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku kembali ke tempat tidur."
    },
    {
      "type": "paragraph",
      "text": "Pada waktu itu, aku masih percaya semuanya boleh diselesaikan."
    },
    {
      "type": "paragraph",
      "text": "Kami akan berdagang."
    },
    {
      "type": "paragraph",
      "text": "Kami akan pergi."
    },
    {
      "type": "paragraph",
      "text": "Semua orang akan pulang ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Dan Melaka akan terus menjadi Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku salah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku belum tahu betapa salahnya aku."
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, orang Portugis mula ditangkap."
    },
    {
      "type": "paragraph",
      "text": "Dan kali ini, tiada siapa yang ketawa."
    }
