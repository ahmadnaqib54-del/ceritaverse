  "title": "SURAT DARI MELAKA",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Ada perkara yang lebih berbahaya daripada pedang."
    },
    {
      "type": "paragraph",
      "text": "Maklumat."
    },
    {
      "type": "paragraph",
      "text": "Pedang hanya membunuh orang yang berada di hadapan kau."
    },
    {
      "type": "paragraph",
      "text": "Maklumat boleh membunuh orang yang belum tahu mereka sedang dalam bahaya."
    },
    {
      "type": "paragraph",
      "text": "Aku belajar perkara itu daripada Rui de Araújo."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia pernah mengajar aku."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak pernah."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma melihat apa yang berlaku kepadanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada awal 1510, nama Melaka masih disebut setiap hari."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini bukan kerana rempah."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana perdagangan."
    },
    {
      "type": "paragraph",
      "text": "Kerana seorang tawanan."
    },
    {
      "type": "paragraph",
      "text": "Rui de Araújo."
    },
    {
      "type": "paragraph",
      "text": "Kami tahu dia masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Itu sudah cukup untuk membuat ramai orang bercakap."
    },
    {
      "type": "paragraph",
      "text": "Ada yang mengatakan dia akan dibunuh."
    },
    {
      "type": "paragraph",
      "text": "Ada yang mengatakan dia akan dijual."
    },
    {
      "type": "paragraph",
      "text": "Ada yang mengatakan dia akan dibebaskan."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa tahu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berita sampai."
    },
    {
      "type": "paragraph",
      "text": "Araújo berjaya menghantar surat."
    },
    {
      "type": "paragraph",
      "text": "Aku sedang membersihkan senjata ketika Miguel datang."
    },
    {
      "type": "paragraph",
      "text": "\"Surat.\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Surat apa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Daripada Melaka.\""
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "\"Siapa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Rui.\""
    },
    {
      "type": "paragraph",
      "text": "Aku meletakkan kain."
    },
    {
      "type": "paragraph",
      "text": "\"Mana kau dengar?\""
    },
    {
      "type": "paragraph",
      "text": "\"Seorang pegawai bercakap.\""
    },
    {
      "type": "paragraph",
      "text": "\"Dan kau percaya?\""
