    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Lebih besar daripada Lisbon?\""
    },
    {
      "type": "paragraph",
