{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 8,
  "title": "Jambatan Api",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Aku pernah dengar orang berkata bahawa perang bermula dengan bunyi trompet."
    },
    {
      "type": "paragraph",
      "text": "Itu tidak benar."
    },
    {
      "type": "paragraph",
      "text": "Perang bermula dengan menunggu."
    },
    {
      "type": "paragraph",
      "text": "Kau berdiri dalam barisan."
    },
    {
      "type": "paragraph",
      "text": "Tangan berpeluh di atas pemegang pedang."
    },
    {
      "type": "paragraph",
      "text": "Mulut kering."
    },
    {
      "type": "paragraph",
      "text": "Jantung berdegup terlalu kuat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kau menunggu."
    },
    {
      "type": "paragraph",
      "text": "Dan menunggu."
    },
    {
      "type": "paragraph",
      "text": "Sehingga seseorang di hadapan kau menjerit,"
    },
    {
      "type": "paragraph",
      "text": "“MAJU!”"
    },
    {
      "type": "paragraph",
      "text": "Barulah kau sedar bahawa kau mungkin akan mati."
    },
    {
      "type": "paragraph",
      "text": "Kami bergerak pagi itu."
    },
    {
      "type": "paragraph",
      "text": "Langkah demi langkah."
    },
    {
      "type": "paragraph",
      "text": "Perisai diangkat."
    },
    {
      "type": "paragraph",
      "text": "Senjata di tangan."
    },
    {
      "type": "paragraph",
      "text": "Meriam mula melepaskan tembakan dari belakang kami."
    },
    {
      "type": "paragraph",
      "text": "Bunyi letupan bergema ke seluruh kawasan."
    },
    {
      "type": "paragraph",
      "text": "Asap memenuhi udara."
    },
    {
      "type": "paragraph",
      "text": "Aku hampir tidak nampak Miguel yang berjalan beberapa langkah di hadapan."
    },
    {
      "type": "paragraph",
      "text": "“Jangan jauh!” aku menjerit."
    },
    {
      "type": "paragraph",
      "text": "Dia menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak pergi mana-mana!”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian sebatang anak panah melintas di antara kami."
    },
    {
      "type": "paragraph",
      "text": "Miguel terus menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Baik,” katanya. “Mungkin aku patut dekat sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mahu menjawab."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kami sudah terlalu hampir."
    },
    {
      "type": "paragraph",
      "text": "Bunyi dari kota semakin kuat."
    },
    {
      "type": "paragraph",
      "text": "Gendang."
    },
    {
      "type": "paragraph",
      "text": "Jeritan."
    },
    {
      "type": "paragraph",
      "text": "Teriakan arahan."
    },
    {
      "type": "paragraph",
      "text": "Dan bunyi sesuatu yang aku tidak dapat kenal pasti dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku nampak jambatan."
    },
    {
      "type": "paragraph",
      "text": "Itulah sasaran kami."
    },
    {
      "type": "paragraph",
      "text": "Jambatan yang menghubungkan kami dengan kota."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah melihatnya sebelum ini."
    },
    {
      "type": "paragraph",
      "text": "Hari itu, ia kelihatan lebih kecil."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kerana aku tahu apa yang menunggu di seberangnya."
    },
    {
      "type": "paragraph",
      "text": "Kami terus mara."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang askar di hadapan jatuh."
    },
    {
      "type": "paragraph",
      "text": "Yang lain melangkah melewati mereka."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak mahu melihat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tetap nampak."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki terbaring dengan tangan menekan perutnya."
    },
    {
      "type": "paragraph",
      "text": "Seorang lagi cuba bangun."
    },
    {
      "type": "paragraph",
      "text": "Tidak berjaya."
    },
    {
      "type": "paragraph",
      "text": "Aku terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Itulah perkara pelik tentang perang."
    },
    {
      "type": "paragraph",
      "text": "Kau boleh rasa kasihan kepada seseorang dan tetap meninggalkannya."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana kau kejam."
    },
    {
      "type": "paragraph",
      "text": "Kerana kalau kau berhenti, mungkin kau pula yang akan terbaring di situ."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Apabila kami sampai berhampiran jambatan, serangan dari kota menjadi lebih sengit."
    },
    {
      "type": "paragraph",
      "text": "Batu dilemparkan."
    },
    {
      "type": "paragraph",
      "text": "Anak panah turun."
    },
    {
      "type": "paragraph",
      "text": "Tembakan kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Kami mengangkat perisai."
    },
    {
      "type": "paragraph",
      "text": "Aku mendengar seseorang menjerit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian sesuatu menghentam perisaiku."
    },
    {
      "type": "paragraph",
      "text": "Aku terundur."
    },
    {
      "type": "paragraph",
      "text": "“Jose!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Miguel menarik aku."
    },
    {
      "type": "paragraph",
      "text": "“Berhenti berdiri macam tiang!”"
    },
    {
      "type": "paragraph",
      "text": "“Aku sedang fikir!”"
    },
    {
      "type": "paragraph",
      "text": "“Fikir kemudian!”"
    },
    {
      "type": "paragraph",
      "text": "Kami bergerak lagi."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan, beberapa orang cuba mencapai jambatan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi pertahanan di seberang sangat kuat."
    },
    {
      "type": "paragraph",
      "text": "Orang Melaka sudah bersedia."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak lelaki membawa tombak."
    },
    {
      "type": "paragraph",
      "text": "Ada yang menggunakan senjata yang belum pernah aku lihat."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berdiri di belakang perlindungan kayu."
    },
    {
      "type": "paragraph",
      "text": "Dan mereka tidak berundur."
    },
    {
      "type": "paragraph",
      "text": "Mereka menunggu kami."
    },
    {
      "type": "paragraph",
      "text": "Aku tiba-tiba faham sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Mereka tahu kami akan datang."
    },
    {
      "type": "paragraph",
      "text": "Sudah tentu mereka tahu."
    },
    {
      "type": "paragraph",
      "text": "Ini rumah mereka."
    },
    {
      "type": "paragraph",
      "text": "Kami yang datang dari laut."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Kami sampai ke jambatan."
    },
    {
      "type": "paragraph",
      "text": "Seseorang menjerit arahan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak dengar dengan jelas."
    },
    {
      "type": "paragraph",
      "text": "Semua bunyi bercampur."
    },
    {
      "type": "paragraph",
      "text": "Jeritan."
    },
    {
      "type": "paragraph",
      "text": "Meriam."
    },
    {
      "type": "paragraph",
      "text": "Logam."
    },
    {
      "type": "paragraph",
      "text": "Kayu."
    },
    {
      "type": "paragraph",
      "text": "Air."
    },
    {
      "type": "paragraph",
      "text": "Darah."
    },
    {
      "type": "paragraph",
      "text": "Aku hanya tahu bahawa kami perlu menyeberang."
    },
    {
      "type": "paragraph",
      "text": "Aku melangkah."
    },
    {
      "type": "paragraph",
      "text": "Satu kaki."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar di sebelahku terkena sesuatu dan jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku teruskan."
    },
    {
      "type": "paragraph",
      "text": "Jambatan itu terasa sempit."
    },
    {
      "type": "paragraph",
      "text": "Terlalu sempit untuk begitu ramai manusia."
    },
    {
      "type": "paragraph",
      "text": "Kami berhimpit."
    },
    {
      "type": "paragraph",
      "text": "Aku boleh menghidu peluh orang di depan."
    },
    {
      "type": "paragraph",
      "text": "Bau asap."
    },
    {
      "type": "paragraph",
      "text": "Bau sungai."
    },
    {
      "type": "paragraph",
      "text": "Bau darah."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seseorang di hadapan menjerit,"
    },
    {
      "type": "paragraph",
      "text": "“Mereka datang!”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat pedang."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki muncul di seberang."
    },
    {
      "type": "paragraph",
      "text": "Dia membawa tombak."
    },
    {
      "type": "paragraph",
      "text": "Kami bertembung."
    },
    {
      "type": "paragraph",
      "text": "Pedangnya menepis seranganku."
    },
    {
      "type": "paragraph",
      "text": "Aku menolak."
    },
    {
      "type": "paragraph",
      "text": "Dia menolak kembali."
    },
    {
      "type": "paragraph",
      "text": "Aku hampir tergelincir."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu siapa yang lebih takut."
    },
    {
      "type": "paragraph",
      "text": "Aku."
    },
    {
      "type": "paragraph",
      "text": "Atau dia."
    },
    {
      "type": "paragraph",
      "text": "Aku menikam."
    },
    {
      "type": "paragraph",
      "text": "Dia mengelak."
    },
    {
      "type": "paragraph",
      "text": "Aku menghayun lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak berhenti."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak sempat."
    },
    {
      "type": "paragraph",
      "text": "Orang lain datang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seorang lagi."
    },
    {
      "type": "paragraph",
      "text": "Aku hanya terus bergerak."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang perang ajarkan kepadaku."
    },
    {
      "type": "paragraph",
      "text": "Jangan fikir terlalu banyak."
    },
    {
      "type": "paragraph",
      "text": "Bernafas."
    },
    {
      "type": "paragraph",
      "text": "Serang."
    },
    {
      "type": "paragraph",
      "text": "Bertahan."
    },
    {
      "type": "paragraph",
      "text": "Bergerak."
    },
    {
      "type": "paragraph",
      "text": "Hidup."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "“JOSE!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Miguel berada beberapa langkah di belakang."
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak darah pada bahunya."
    },
    {
      "type": "paragraph",
      "text": "“Kau kena?”"
    },
    {
      "type": "paragraph",
      "text": "“Sedikit!”"
    },
    {
      "type": "paragraph",
      "text": "“Sedikit?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau banyak, aku dah mati!”"
    },
    {
      "type": "paragraph",
      "text": "Dia masih sempat bergurau."
    },
    {
      "type": "paragraph",
      "text": "Aku hampir ketawa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu letupan kuat berlaku di sebelah kami."
    },
    {
      "type": "paragraph",
      "text": "Aku jatuh."
    },
    {
      "type": "paragraph",
      "text": "Telingaku berdengung."
    },
    {
      "type": "paragraph",
      "text": "Dunia menjadi senyap."
    },
    {
      "type": "paragraph",
      "text": "Aku membuka mata."
    },
    {
      "type": "paragraph",
      "text": "Asap memenuhi pandangan."
    },
    {
      "type": "paragraph",
      "text": "Aku cuba berdiri."
    },
    {
      "type": "paragraph",
      "text": "Kaki aku menggigil."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu berapa lama aku berada di tanah."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat?"
    },
    {
      "type": "paragraph",
      "text": "Satu minit?"
    },
    {
      "type": "paragraph",
      "text": "Kemudian seseorang menarik bahuku."
    },
    {
      "type": "paragraph",
      "text": "Braz."
    },
    {
      "type": "paragraph",
      "text": "“Bangun!”"
    },
    {
      "type": "paragraph",
      "text": "Aku cuba bercakap."
    },
    {
      "type": "paragraph",
      "text": "Tidak keluar suara."
    },
    {
      "type": "paragraph",
      "text": "Braz menarik aku sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "“Jose!”"
    },
    {
      "type": "paragraph",
      "text": "Aku bangun."
    },
    {
      "type": "paragraph",
      "text": "“Mana Miguel?”"
    },
    {
      "type": "paragraph",
      "text": "Braz menunjuk ke belakang."
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Miguel sedang berdiri."
    },
    {
      "type": "paragraph",
      "text": "Masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Aku menarik nafas lega."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku nampak sesuatu di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Orang Portugis sudah sampai ke seberang jambatan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu bagaimana."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu bila."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kami sudah menyeberang."
    },
    {
      "type": "paragraph",
      "text": "Dan tiba-tiba semuanya berubah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pertempuran tidak menjadi lebih mudah."
    },
    {
      "type": "paragraph",
      "text": "Ia menjadi lebih dekat."
    },
    {
      "type": "paragraph",
      "text": "Kami kini bertempur di jalan-jalan kota."
    },
    {
      "type": "paragraph",
      "text": "Bangunan di kiri dan kanan."
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Tingkap ditutup."
    },
    {
      "type": "paragraph",
      "text": "Asap memenuhi udara."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak penduduk berlari."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membawa anak."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membawa barang."
    },
    {
      "type": "paragraph",
      "text": "Ada yang hanya berlari tanpa membawa apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat lelaki tua yang aku lihat beberapa hari lalu."
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba aku tertanya-tanya apakah keluarganya berada di salah satu rumah itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku terpaksa menepis fikiran itu."
    },
    {
      "type": "paragraph",
      "text": "Seorang musuh menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku menangkis."
    },
    {
      "type": "paragraph",
      "text": "Aku menikam."
    },
    {
      "type": "paragraph",
      "text": "Dia jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku terus bergerak."
    },
    {
      "type": "paragraph",
      "text": "Kami mula menolak masuk lebih jauh."
    },
    {
      "type": "paragraph",
      "text": "Setiap jalan yang kami ambil terasa seperti jalan yang belum pernah disentuh kaki Portugis."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu ke mana kami pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku hanya ikut orang di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Di satu simpang, kami berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Ke mana?” aku bertanya."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa menjawab."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai menjerit sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Kami bergerak ke kanan."
    },
    {
      "type": "paragraph",
      "text": "Aku mengikut."
    },
    {
      "type": "paragraph",
      "text": "Itulah realiti askar seperti aku."
    },
    {
      "type": "paragraph",
      "text": "Jeneral mungkin tahu ke mana tentera hendak pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tahu ke mana orang di depan aku pergi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Menjelang petang, pertempuran masih berlaku."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sesuatu telah berubah."
    },
    {
      "type": "paragraph",
      "text": "Kami semakin jauh masuk ke kota."
    },
    {
      "type": "paragraph",
      "text": "Tentangan masih ada."
    },
    {
      "type": "paragraph",
      "text": "Namun barisan pertahanan mereka mula berpecah."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu apa yang berlaku di tempat lain."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma nampak apa yang ada di hadapan mata."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu jalan yang kami lalui jatuh ke tangan kami."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu kawasan ditinggalkan."
    },
    {
      "type": "paragraph",
      "text": "Dan akhirnya aku berdiri di sebuah jalan yang sunyi."
    },
    {
      "type": "paragraph",
      "text": "Terlalu sunyi."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang sekeliling."
    },
    {
      "type": "paragraph",
      "text": "Rumah-rumah tertutup."
    },
    {
      "type": "paragraph",
      "text": "Barang-barang berselerak."
    },
    {
      "type": "paragraph",
      "text": "Sebuah bakul terbalik di jalan."
    },
    {
      "type": "paragraph",
      "text": "Nasi bertaburan di tanah."
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Nasi?”"
    },
    {
      "type": "paragraph",
      "text": "Miguel berdiri di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "“Mereka mungkin pergi tergesa-gesa.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang nasi itu."
    },
    {
      "type": "paragraph",
      "text": "Entah kenapa, benda kecil itu membuatkan perang terasa lebih nyata daripada semua darah yang aku lihat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam lalu seseorang mungkin sedang makan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kami datang."
    },
    {
      "type": "paragraph",
      "text": "Sekarang rumah itu kosong."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu kenapa aku memikirkan perkara itu."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kerana perang selalu diceritakan dengan angka."
    },
    {
      "type": "paragraph",
      "text": "Berapa ramai mati."
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak kapal."
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak meriam."
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak askar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tiada siapa mengira berapa banyak mangkuk nasi yang ditinggalkan di atas meja."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Matahari mula turun."
    },
    {
      "type": "paragraph",
      "text": "Aku duduk di tepi sebuah bangunan."
    },
    {
      "type": "paragraph",
      "text": "Kakiku sakit."
    },
    {
      "type": "paragraph",
      "text": "Tanganku berlumur darah."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu darah siapa."
    },
    {
      "type": "paragraph",
      "text": "Miguel duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih hidup,” katanya."
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Malangnya.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Braz datang tidak lama kemudian."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di hadapan kami."
    },
    {
      "type": "paragraph",
      "text": "“Kita berjaya masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Masuk ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "Braz melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Melaka.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang jalan yang sunyi."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak rasa seperti kami sudah menang."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kerana di sekeliling kami masih ada terlalu banyak bunyi pertempuran."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak orang yang masih melawan."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak perkara yang belum selesai."
    },
    {
      "type": "paragraph",
      "text": "Namun sesuatu memang telah berubah."
    },
    {
      "type": "paragraph",
      "text": "Pagi tadi, kami berada di luar kota."
    },
    {
      "type": "paragraph",
      "text": "Sekarang kami berada di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat malam pertama kami melihat Melaka dari laut."
    },
    {
      "type": "paragraph",
      "text": "Ketika itu aku fikir kota ini kelihatan indah."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku berdiri di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Dan aku hanya nampak kesan perang."
    },
    {
      "type": "paragraph",
      "text": "Braz duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "“Hm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau pernah fikir kita akan sampai sejauh ini?”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Aku pun.”"
    },
    {
      "type": "paragraph",
      "text": "Kami duduk diam."
    },
    {
      "type": "paragraph",
      "text": "Di kejauhan, bunyi pertempuran masih kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu ini belum berakhir."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "Tetapi hari itu kami telah menyeberangi jambatan."
    },
    {
      "type": "paragraph",
      "text": "Dan selepas jambatan itu, tidak ada jalan untuk kembali seperti dahulu."
    },
    {
      "type": "paragraph",
      "text": "Aku datang ke Melaka sebagai seorang askar yang mahu menakluk sebuah kota."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku sudah berada di dalam kota itu."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali, aku mula tertanya-tanya—"
    },
    {
      "type": "paragraph",
      "text": "**kalau kami berjaya mengambil Melaka, apa yang akan berlaku kepada orang-orang yang sudah tinggal di dalamnya?**"
    }
  ]
}