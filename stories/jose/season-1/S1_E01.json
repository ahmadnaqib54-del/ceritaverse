{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 1,
  "title": "KOTA DI HUJUNG DUNIA",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Aku benci laut."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana ombak."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana angin."
    },
    {
      "type": "paragraph",
      "text": "Aku benci kerana di laut, tidak ada tempat untuk lari."
    },
    {
      "type": "paragraph",
      "text": "Kalau kau jatuh sakit, kau muntah di situ juga."
    },
    {
      "type": "paragraph",
      "text": "Kalau kau takut, kau takut di situ juga."
    },
    {
      "type": "paragraph",
      "text": "Dan kalau kapal itu tenggelam, kau boleh berdoa sebanyak mana pun. Laut tidak peduli."
    },
    {
      "type": "paragraph",
      "text": "Aku sedang bersandar pada tiang kapal apabila Miguel duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "Dia memegang perut."
    },
    {
      "type": "paragraph",
      "text": "Mukanya pucat."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Jangan.\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "\"Aku belum buat apa-apa.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku tahu muka itu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Muka apa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Muka orang yang akan muntah.\""
    },
    {
      "type": "paragraph",
      "text": "Dia belum sempat menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia berpaling ke laut."
    },
    {
      "type": "paragraph",
      "text": "Kemudian muntah."
    },
    {
      "type": "paragraph",
      "text": "Aku mengeluh."
    },
    {
      "type": "paragraph",
      "text": "\"Terima kasih kerana tidak mengecewakan aku.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel mengangkat tangan tanpa menoleh."
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Dia baru berumur sekitar dua puluh tahun. Mungkin kurang."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah bertanya."
    },
    {
      "type": "paragraph",
      "text": "Di dalam tentera, umur bukan soalan yang penting."
    },
    {
      "type": "paragraph",
      "text": "Selagi kau cukup besar untuk mengangkat pedang, kau dianggap cukup besar untuk mati."
    },
    {
      "type": "paragraph",
      "text": "Sudah beberapa minggu kami berada di atas kapal."
    },
    {
      "type": "paragraph",
      "text": "Kami meninggalkan India dan sekarang menuju ke timur."
    },
    {
      "type": "paragraph",
      "text": "Ke Melaka."
    },
    {
      "type": "paragraph",
      "text": "Nama itu sudah berhari-hari disebut di atas kapal."
    },
    {
      "type": "paragraph",
      "text": "Melaka."
    },
    {
      "type": "paragraph",
      "text": "Ada yang menyebutnya seperti sebuah kota emas."
    },
    {
      "type": "paragraph",
      "text": "Ada yang mengatakan pelabuhannya dipenuhi kapal dari seluruh dunia."
    },
    {
      "type": "paragraph",
      "text": "Ada yang kata di sana ada rempah yang cukup untuk membuat seorang pedagang kaya seumur hidup."
    },
    {
      "type": "paragraph",
      "text": "Ada juga yang kata penduduknya ganas."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu mana yang betul."
    },
    {
      "type": "paragraph",
      "text": "Mungkin semuanya."
    },
    {
      "type": "paragraph",
      "text": "Mungkin tiada satu pun."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Aku belum pernah ke sana."
    },
    {
      "type": "paragraph",
      "text": "Miguel mengelap mulutnya dengan lengan baju."
    },
    {
      "type": "paragraph",
      "text": "\"Jose.\""
    },
    {
      "type": "paragraph",
      "text": "\"Hm?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa kita serang Melaka?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia serius kali ini."
    },
    {
      "type": "paragraph",
      "text": "\"Siapa kata kita menyerang?\""
    },
    {
      "type": "paragraph",
      "text": "Dia menunjukkan kapal-kapal di sekeliling kami."
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa seluruh armada ini menuju ke sana?\""
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Untuk bercuti.\""
    },
    {
      "type": "paragraph",
      "text": "Dia menjeling."
    },
    {
      "type": "paragraph",
      "text": "\"Aku serius.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku pun.\""
    },
    {
      "type": "paragraph",
      "text": "Dia menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "Aku membiarkan dia beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku memandang laut."
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kau betul-betul mahu tahu, ceritanya bermula sebelum kau menyertai kami.\""
    },
    {
      "type": "paragraph",
      "text": "\"Berapa lama?\""
    },
    {
      "type": "paragraph",
      "text": "\"Dua tahun.\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengerutkan muka."
    },
    {
      "type": "paragraph",
      "text": "\"Dua tahun?\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Dan kau tahu?\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku tahu sedikit.\""
    },
    {
      "type": "paragraph",
      "text": "\"Bagaimana?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Aku kenal Diogo Lopes de Sequeira.\""
    },
    {
      "type": "paragraph",
      "text": "Mata Miguel terus terbuka."
    },
    {
      "type": "paragraph",
      "text": "\"Kapten itu?\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Betul?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kau mahu, aku boleh panggil dia.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel melihat ke arah bahagian hadapan kapal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kembali memandangku."
    },
    {
      "type": "paragraph",
      "text": "\"Dia akan pukul kau.\""
    },
    {
      "type": "paragraph",
      "text": "\"Bagus. Sekurang-kurangnya dia masih ingat aku.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa."
    },
    {
      "type": "paragraph",
      "text": "Aku senyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku mula bercerita."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada tahun 1509, sebelum Afonso de Albuquerque memimpin armada besar ini, orang Portugis sudah pun cuba pergi ke Melaka."
    },
    {
      "type": "paragraph",
      "text": "Bukan untuk perang."
    },
    {
      "type": "paragraph",
      "text": "Sekurang-kurangnya bukan pada awalnya."
    },
    {
      "type": "paragraph",
      "text": "Diogo Lopes de Sequeira membawa rombongan Portugis ke sana atas arahan Raja Manuel."
    },
    {
      "type": "paragraph",
      "text": "Tujuannya mudah."
    },
    {
      "type": "paragraph",
      "text": "Perdagangan."
    },
    {
      "type": "paragraph",
      "text": "Melaka terkenal sebagai pelabuhan besar."
    },
    {
      "type": "paragraph",
      "text": "Orang datang dari banyak tempat."
    },
    {
      "type": "paragraph",
      "text": "Gujerat."
    },
    {
      "type": "paragraph",
      "text": "Jawa."
    },
    {
      "type": "paragraph",
      "text": "India."
    },
    {
      "type": "paragraph",
      "text": "China."
    },
    {
      "type": "paragraph",
      "text": "Dan tempat-tempat yang aku sendiri tidak pernah dengar namanya."
    },
    {
      "type": "paragraph",
      "text": "Barang bergerak masuk."
    },
    {
      "type": "paragraph",
      "text": "Barang bergerak keluar."
    },
    {
      "type": "paragraph",
      "text": "Emas, kain, rempah, logam, makanan."
    },
    {
      "type": "paragraph",
      "text": "Apa sahaja yang mempunyai harga akan menemui pembelinya."
    },
    {
      "type": "paragraph",
      "text": "Dan apabila terlalu banyak pedagang berkumpul di satu tempat, semua orang akan tersenyum kepada semua orang."
    },
    {
      "type": "paragraph",
      "text": "Sambil mengira keuntungan masing-masing."
    },
    {
      "type": "paragraph",
      "text": "Portugis datang dengan harapan yang sama."
    },
    {
      "type": "paragraph",
      "text": "Kami mahu berdagang."
    },
    {
      "type": "paragraph",
      "text": "Kami mahu membuka jalan."
    },
    {
      "type": "paragraph",
      "text": "Kami mahu tahu bagaimana pelabuhan itu berfungsi."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ada satu masalah."
    },
    {
      "type": "paragraph",
      "text": "Kami bukan orang pertama yang berdagang di sana."
    },
    {
      "type": "paragraph",
      "text": "Pedagang Gujerat sudah lama berada di Melaka."
    },
    {
      "type": "paragraph",
      "text": "Orang Jawa juga."
    },
    {
      "type": "paragraph",
      "text": "Mereka mempunyai kapal."
    },
    {
      "type": "paragraph",
      "text": "Mereka mempunyai hubungan."
    },
    {
      "type": "paragraph",
      "text": "Mereka mempunyai pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian datang orang Portugis."
    },
    {
      "type": "paragraph",
      "text": "Dengan kapal besar."
    },
    {
      "type": "paragraph",
      "text": "Dengan meriam."
    },
    {
      "type": "paragraph",
      "text": "Dengan niat untuk mendapatkan tempat di tengah-tengah perdagangan yang sudah lama berjalan."
    },
    {
      "type": "paragraph",
      "text": "Kalau kau seorang pedagang yang sudah mendapat keuntungan daripada satu pelabuhan selama bertahun-tahun, apa yang kau fikir apabila sekumpulan orang asing muncul dan mengatakan mereka juga mahu bahagian?"
    },
    {
      "type": "paragraph",
      "text": "Kau mungkin tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kau mula mengira."
    },
    {
      "type": "paragraph",
      "text": "Berapa ramai mereka?"
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak kapal?"
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak senjata?"
    },
    {
      "type": "paragraph",
      "text": "Siapa yang menyokong mereka?"
    },
    {
      "type": "paragraph",
      "text": "Dan yang paling penting—"
    },
    {
      "type": "paragraph",
      "text": "berapa lama sebelum mereka mengambil lebih daripada yang mereka minta?"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sequeira tiba di Melaka pada September 1509."
    },
    {
      "type": "paragraph",
      "text": "Pada awalnya, semuanya kelihatan baik."
    },
    {
      "type": "paragraph",
      "text": "Kami diterima."
    },
    {
      "type": "paragraph",
      "text": "Ada perbincangan."
    },
    {
      "type": "paragraph",
      "text": "Ada urusan perdagangan."
    },
    {
      "type": "paragraph",
      "text": "Ada orang tempatan yang datang melihat kapal Portugis."
    },
    {
      "type": "paragraph",
      "text": "Ada pedagang yang ingin tahu tentang kami."
    },
    {
      "type": "paragraph",
      "text": "Kami fikir semuanya akan berjalan lancar."
    },
    {
      "type": "paragraph",
      "text": "Itulah kesilapan pertama."
    },
    {
      "type": "paragraph",
      "text": "Kami terlalu cepat percaya."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah mendengar Sequeira sendiri bercakap tentang Melaka."
    },
    {
      "type": "paragraph",
      "text": "Dia kagum dengan kota itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana istananya."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana tenteranya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana manusia yang datang ke pelabuhannya."
    },
    {
      "type": "paragraph",
      "text": "Kapal demi kapal."
    },
    {
      "type": "paragraph",
      "text": "Pedagang demi pedagang."
    },
    {
      "type": "paragraph",
      "text": "Bahasa yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Wajah yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Duit yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Melaka seperti sebuah simpang jalan yang tidak pernah sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dan di situlah masalahnya bermula."
    },
    {
      "type": "paragraph",
      "text": "Sebab apabila semua orang mahu menggunakan jalan yang sama, tidak semua orang mahu berkongsi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "\"Jadi pedagang Gujerat yang mulakan?\" Miguel bertanya."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Aku tidak kata begitu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Tapi kau sebut mereka.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku sebut banyak orang.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa kau sebut mereka dulu?\""
    },
    {
      "type": "paragraph",
      "text": "Aku terdiam."
    },
    {
      "type": "paragraph",
      "text": "Budak ini rupanya lebih banyak berfikir daripada yang aku sangka."
    },
    {
      "type": "paragraph",
      "text": "\"Kerana mereka mempunyai banyak kepentingan di Melaka.\""
    },
    {
      "type": "paragraph",
      "text": "\"Itu bukan jawapan.\""
    },
    {
      "type": "paragraph",
      "text": "\"Jawapan yang sebenar?\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Aku tidak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel kelihatan kecewa."
    },
    {
      "type": "paragraph",
      "text": "\"Jadi kau sebenarnya tidak tahu?\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku askar, Miguel. Bukan Tuhan.\""
    },
    {
      "type": "paragraph",
      "text": "Dia tersengih."
    },
    {
      "type": "paragraph",
      "text": "Aku sambung."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang orang selalu lupa tentang perang."
    },
    {
      "type": "paragraph",
      "text": "Apabila perang bermula, semua orang akan mencari satu sebab."
    },
    {
      "type": "paragraph",
      "text": "Satu orang untuk dipersalahkan."
    },
    {
      "type": "paragraph",
      "text": "Satu peristiwa untuk ditunjukkan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum pedang pertama dihunus, sudah ada berpuluh-puluh perkara berlaku."
    },
    {
      "type": "paragraph",
      "text": "Pedagang takut kehilangan keuntungan."
    },
    {
      "type": "paragraph",
      "text": "Orang istana takut kehilangan kuasa."
    },
    {
      "type": "paragraph",
      "text": "Orang Portugis mahu mendapatkan tempat."
    },
    {
      "type": "paragraph",
      "text": "Dan Sultan Mahmud Shah perlu memikirkan siapa sebenarnya yang datang ke pelabuhannya."
    },
    {
      "type": "paragraph",
      "text": "Pedagang?"
    },
    {
      "type": "paragraph",
      "text": "Atau sesuatu yang lebih besar?"
    },
    {
      "type": "paragraph",
      "text": "Akhirnya, berita tentang Portugis sampai ke istana."
    },
    {
      "type": "paragraph",
      "text": "Dan apabila berita sampai kepada istana, ia tidak lagi hanya tentang perdagangan."
    },
    {
      "type": "paragraph",
      "text": "Ia menjadi soal keselamatan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Aku masih ingat apa yang berlaku selepas itu."
    },
    {
      "type": "paragraph",
      "text": "Sikap orang berubah."
    },
    {
      "type": "paragraph",
      "text": "Bukan semua."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk kami perasan."
    },
    {
      "type": "paragraph",
      "text": "Orang yang sebelum ini bercakap dengan kami mula mengelak."
    },
    {
      "type": "paragraph",
      "text": "Ada yang memerhatikan kapal."
    },
    {
      "type": "paragraph",
      "text": "Ada yang bertanya terlalu banyak soalan."
    },
    {
      "type": "paragraph",
      "text": "Berapa ramai askar?"
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak meriam?"
    },
    {
      "type": "paragraph",
      "text": "Berapa banyak kapal?"
    },
    {
      "type": "paragraph",
      "text": "Soalan-soalan kecil."
    },
    {
      "type": "paragraph",
      "text": "Tetapi apabila soalan yang sama datang daripada terlalu ramai orang, kau mula faham."
    },
    {
      "type": "paragraph",
      "text": "Ada sesuatu yang tidak kena."
    },
    {
      "type": "paragraph",
      "text": "Rui de Araújo juga mula menyedarinya."
    },
    {
      "type": "paragraph",
      "text": "Dia bukan orang yang mudah panik."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini keadaan berbeza."
    },
    {
      "type": "paragraph",
      "text": "Kami berada di sebuah kota asing."
    },
    {
      "type": "paragraph",
      "text": "Jauh dari Goa."
    },
    {
      "type": "paragraph",
      "text": "Jauh dari Portugal."
    },
    {
      "type": "paragraph",
      "text": "Jauh daripada bantuan."
    },
    {
      "type": "paragraph",
      "text": "Kalau sesuatu berlaku, kami tidak mempunyai banyak tempat untuk berlari."
    },
    {
      "type": "paragraph",
      "text": "Dan sesuatu memang berlaku."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak berada di tengah-tengah semua kejadian itu."
    },
    {
      "type": "paragraph",
      "text": "Aku perlu mengakuinya."
    },
    {
      "type": "paragraph",
      "text": "Ada bahagian yang aku dengar daripada Sequeira."
    },
    {
      "type": "paragraph",
      "text": "Ada yang aku dengar daripada lelaki yang berjaya melarikan diri."
    },
    {
      "type": "paragraph",
      "text": "Ada yang aku tahu hanya selepas semuanya berlaku."
    },
    {
      "type": "paragraph",
      "text": "Tetapi hasilnya sama."
    },
    {
      "type": "paragraph",
      "text": "Orang Portugis diserang."
    },
    {
      "type": "paragraph",
      "text": "Sebahagian dibunuh."
    },
    {
      "type": "paragraph",
      "text": "Sebahagian ditangkap."
    },
    {
      "type": "paragraph",
      "text": "Rui de Araújo menjadi tawanan."
    },
    {
      "type": "paragraph",
      "text": "Sequeira berjaya berundur."
    },
    {
      "type": "paragraph",
      "text": "Kami meninggalkan Melaka."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak semua orang berjaya keluar bersama kami."
    },
    {
      "type": "paragraph",
      "text": "Miguel diam."
    },
    {
      "type": "paragraph",
      "text": "\"Rui masih hidup?\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Macam mana kau tahu?\""
    },
    {
      "type": "paragraph",
      "text": "\"Dia menulis.\""
    },
    {
      "type": "paragraph",
      "text": "\"Menulis?\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Araújo berada dalam tahanan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia masih berjaya menghantar surat kepada pihak Portugis di India."
    },
    {
      "type": "paragraph",
      "text": "Surat itu membawa berita dari dalam Melaka."
    },
    {
      "type": "paragraph",
      "text": "Tentang kota."
    },
    {
      "type": "paragraph",
      "text": "Tentang pertahanan."
    },
    {
      "type": "paragraph",
      "text": "Tentang keadaan politik."
    },
    {
      "type": "paragraph",
      "text": "Tentang apa yang kami tidak tahu ketika kami datang dahulu."
    },
    {
      "type": "paragraph",
      "text": "Dan berita itu bergerak."
    },
    {
      "type": "paragraph",
      "text": "Dari Melaka."
    },
    {
      "type": "paragraph",
      "text": "Ke India."
    },
    {
      "type": "paragraph",
      "text": "Kemudian semakin jauh."
    },
    {
      "type": "paragraph",
      "text": "Sampai kepada orang yang mempunyai kuasa untuk melakukan sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Afonso de Albuquerque."
    },
    {
      "type": "paragraph",
      "text": "Nama itu sudah cukup untuk membuat ramai orang diam."
    },
    {
      "type": "paragraph",
      "text": "Miguel memandangku."
    },
    {
      "type": "paragraph",
      "text": "\"Jadi Afonso datang untuk membalas dendam?\""
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kau fikir begitu, kau belum faham Melaka.\""
    },
    {
      "type": "paragraph",
      "text": "\"Habis?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "\"Melaka terlalu penting untuk sekadar membalas dendam.\""
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Angin berubah."
    },
    {
      "type": "paragraph",
      "text": "Kapal bergerak perlahan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang mula berkumpul di hadapan geladak."
    },
    {
      "type": "paragraph",
      "text": "Aku bangun."
    },
    {
      "type": "paragraph",
      "text": "Miguel ikut."
    },
    {
      "type": "paragraph",
      "text": "Seorang kelasi menjerit dari atas."
    },
    {
      "type": "paragraph",
      "text": "\"Tanah!\""
    },
    {
      "type": "paragraph",
      "text": "Semua kepala berpaling."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di tepi kapal."
    },
    {
      "type": "paragraph",
      "text": "Pada mulanya aku tidak nampak apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian, perlahan-lahan, sesuatu muncul di kaki langit."
    },
    {
      "type": "paragraph",
      "text": "Gelap."
    },
    {
      "type": "paragraph",
      "text": "Kabur."
    },
    {
      "type": "paragraph",
      "text": "Tetapi semakin besar."
    },
    {
      "type": "paragraph",
      "text": "Tanah."
    },
    {
      "type": "paragraph",
      "text": "Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma melihat."
    },
    {
      "type": "paragraph",
      "text": "Selama bertahun-tahun aku mendengar namanya."
    },
    {
      "type": "paragraph",
      "text": "Sekarang kota itu berada di hadapan aku."
    },
    {
      "type": "paragraph",
      "text": "Aku cuba membayangkan bagaimana rupanya."
    },
    {
      "type": "paragraph",
      "text": "Aku gagal."
    },
    {
      "type": "paragraph",
      "text": "Melaka lebih besar daripada yang aku bayangkan."
    },
    {
      "type": "paragraph",
      "text": "Kapal-kapal memenuhi pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Asap naik dari kota."
    },
    {
      "type": "paragraph",
      "text": "Tembok dan bangunan muncul di antara cahaya pagi."
    },
    {
      "type": "paragraph",
      "text": "Dan jauh di belakang semuanya, bukit-bukit berdiri seperti mereka sudah berada di situ sebelum sesiapa pun mengenali nama Melaka."
    },
    {
      "type": "paragraph",
      "text": "Miguel berdiri di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "\"Cantik.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Jadi kita nak hancurkan semua itu?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak lagi tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Aku juga tidak."
    },
    {
      "type": "paragraph",
      "text": "\"Aku tidak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "Itulah jawapan paling jujur yang aku mampu beri."
    },
    {
      "type": "paragraph",
      "text": "Aku seorang askar."
    },
    {
      "type": "paragraph",
      "text": "Aku akan mengikut arahan."
    },
    {
      "type": "paragraph",
      "text": "Aku akan mengangkat pedang apabila disuruh."
    },
    {
      "type": "paragraph",
      "text": "Aku akan bergerak apabila mereka menjerit maju."
    },
    {
      "type": "paragraph",
      "text": "Tetapi melihat Melaka dari laut membuat aku sedar sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Tempat ini bukan sekadar sebuah pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Ia sebuah kota."
    },
    {
      "type": "paragraph",
      "text": "Orang tinggal di sini."
    },
    {
      "type": "paragraph",
      "text": "Orang berniaga di sini."
    },
    {
      "type": "paragraph",
      "text": "Orang membesarkan anak di sini."
    },
    {
      "type": "paragraph",
      "text": "Orang mati di sini."
    },
    {
      "type": "paragraph",
      "text": "Dan sebentar lagi, kami akan datang dengan senjata."
    },
    {
      "type": "paragraph",
      "text": "Aku memegang pedang di pinggang."
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba ia terasa lebih berat daripada biasa."
    },
    {
      "type": "paragraph",
      "text": "Miguel menepuk bahuku."
    },
    {
      "type": "paragraph",
      "text": "\"Jose.\""
    },
    {
      "type": "paragraph",
      "text": "\"Hm?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kau kata kau tahu cerita tentang Melaka.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku tahu sedikit.\""
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah kota."
    },
    {
      "type": "paragraph",
      "text": "\"Kalau begitu, apa yang akan berlaku?\""
    },
    {
      "type": "paragraph",
      "text": "Aku melihat Melaka untuk kali terakhir sebelum berpaling."
    },
    {
      "type": "paragraph",
      "text": "\"Entahlah.\""
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Tapi kalau kau muntah lagi, aku tinggalkan kau di kapal.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa."
    },
    {
      "type": "paragraph",
      "text": "Aku turut ketawa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak lama."
    },
    {
      "type": "paragraph",
      "text": "Kerana di hadapan kami, Melaka semakin dekat."
    },
    {
      "type": "paragraph",
      "text": "Dan jauh di dalam hati, aku tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Kami bukan lagi datang sebagai pedagang."
    },
    {
      "type": "paragraph",
      "text": "Kali ini kami datang sebagai tentera."
    },
    {
      "type": "paragraph",
      "text": "Dan kota itu belum tahu apa yang sedang menuju ke arahnya."
    }
  ]
}