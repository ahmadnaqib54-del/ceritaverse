{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 7,
  "title": "Kota yang Melawan",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Aku pernah fikir bahagian paling susah dalam perang ialah menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku silap."
    },
    {
      "type": "paragraph",
      "text": "Bahagian paling susah ialah duduk diam selepas kau sedar orang di sebelah kau mungkin tidak akan bangun lagi."
    },
    {
      "type": "paragraph",
      "text": "Malam itu, kem kami tidak seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Tiada banyak gurauan."
    },
    {
      "type": "paragraph",
      "text": "Tiada nyanyian."
    },
    {
      "type": "paragraph",
      "text": "Tiada suara orang mabuk yang cuba melupakan ketakutan mereka dengan arak."
    },
    {
      "type": "paragraph",
      "text": "Yang ada cuma bunyi orang berjalan perlahan, bunyi kain dikoyakkan untuk membalut luka, dan sesekali jeritan seorang askar yang terlalu sakit untuk tidur."
    },
    {
      "type": "paragraph",
      "text": "Aku duduk di atas tanah dengan belakang bersandar pada peti kayu."
    },
    {
      "type": "paragraph",
      "text": "Pedangku masih di pinggang."
    },
    {
      "type": "paragraph",
      "text": "Aku belum membersihkannya."
    },
    {
      "type": "paragraph",
      "text": "Ada darah melekat pada bilahnya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu darah siapa."
    },
    {
      "type": "paragraph",
      "text": "Miguel duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang tangannya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Ada calar panjang di lengannya."
    },
    {
      "type": "paragraph",
      "text": "“Cuma calar,” katanya."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau sudah cakap itu tiga kali.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku cakap empat kali, mungkin ia akan sembuh.”"
    },
    {
      "type": "paragraph",
      "text": "Aku hampir ketawa."
    },
    {
      "type": "paragraph",
      "text": "Hampir."
    },
    {
      "type": "paragraph",
      "text": "“Jangan mati,” kataku."
    },
    {
      "type": "paragraph",
      "text": "Miguel memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Aku belum bercadang.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak mahu cari kawan baru.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum sedikit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kami diam."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan kami, beberapa orang askar sedang mengangkat tubuh yang terkorban."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki berhenti tidak jauh dari kami."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang sekeliling seperti mencari seseorang."
    },
    {
      "type": "paragraph",
      "text": "“Pedro!”"
    },
    {
      "type": "paragraph",
      "text": "Tiada jawapan."
    },
    {
      "type": "paragraph",
      "text": "“Pedro!”"
    },
    {
      "type": "paragraph",
      "text": "Masih tiada."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak kenal Pedro."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tahu cara lelaki itu memanggil namanya."
    },
    {
      "type": "paragraph",
      "text": "Itu bukan panggilan kepada seorang askar."
    },
    {
      "type": "paragraph",
      "text": "Itu panggilan kepada seorang kawan."
    },
    {
      "type": "paragraph",
      "text": "Dia akhirnya berjalan pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Miguel menarik nafas panjang."
    },
    {
      "type": "paragraph",
      "text": "“Berapa ramai?”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak mahu tahu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi keesokan paginya, kami mula tahu sedikit demi sedikit."
    },
    {
      "type": "paragraph",
      "text": "Ramai yang cedera."
    },
    {
      "type": "paragraph",
      "text": "Ramai yang terbunuh."
    },
    {
      "type": "paragraph",
      "text": "Dan lebih ramai daripada yang aku mahu percaya mula bercakap tentang apa yang berlaku di kota."
    },
    {
      "type": "paragraph",
      "text": "Tentang tembok."
    },
    {
      "type": "paragraph",
      "text": "Tentang meriam."
    },
    {
      "type": "paragraph",
      "text": "Tentang orang Melaka yang menyerang dari arah yang kami tidak jangka."
    },
    {
      "type": "paragraph",
      "text": "Tentang sungai."
    },
    {
      "type": "paragraph",
      "text": "Tentang jambatan."
    },
    {
      "type": "paragraph",
      "text": "Tentang betapa mudahnya sesuatu yang kelihatan kecil menjadi tempat paling berbahaya di dunia."
    },
    {
      "type": "paragraph",
      "text": "Aku mula faham satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Kami datang ke sini dengan kapal besar, meriam besar dan senjata yang lebih baik."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Melaka mempunyai sesuatu yang kami tidak ada."
    },
    {
      "type": "paragraph",
      "text": "Ia adalah rumah mereka."
    },
    {
      "type": "paragraph",
      "text": "Mereka tahu setiap lorong."
    },
    {
      "type": "paragraph",
      "text": "Setiap jalan."
    },
    {
      "type": "paragraph",
      "text": "Setiap selekoh."
    },
    {
      "type": "paragraph",
      "text": "Setiap tempat yang boleh dijadikan perlindungan."
    },
    {
      "type": "paragraph",
      "text": "Kami pula baru tiba."
    },
    {
      "type": "paragraph",
      "text": "Kami bahkan belum tahu di mana hendak membuang air tanpa tersesat."
    },
    {
      "type": "paragraph",
      "text": "Miguel mungkin membaca fikiranku."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita hidup cukup lama,” katanya, “aku mahu lukis peta tandas Melaka.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Supaya tentera seterusnya tidak tersesat.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "Kali ini betul-betul."
    },
    {
      "type": "paragraph",
      "text": "Tidak lama."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Braz datang."
    },
    {
      "type": "paragraph",
      "text": "Dia membawa sekeping kain di tangannya dan duduk di sebelah kami."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya kelihatan letih."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih hidup,” katanya kepadaku."
    },
    {
      "type": "paragraph",
      "text": "“Malangnya.”"
    },
    {
      "type": "paragraph",
      "text": "Braz tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus. Aku perlukan seseorang untuk membawa barang aku.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel menunjuk kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan pembantu kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia askar.”"
    },
    {
      "type": "paragraph",
      "text": "“Lebih teruk lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menjeling mereka berdua."
    },
    {
      "type": "paragraph",
      "text": "“Aku boleh pergi cari kawan lain.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak,” kata Braz. “Aku sudah kenal kau terlalu lama.”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat tangannya."
    },
    {
      "type": "paragraph",
      "text": "Ada darah pada kain yang dibawanya."
    },
    {
      "type": "paragraph",
      "text": "“Luka?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan aku.”"
    },
    {
      "type": "paragraph",
      "text": "Dia membuka kain itu."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya ada beberapa helaian kertas."
    },
    {
      "type": "paragraph",
      "text": "Aku mengenalinya."
    },
    {
      "type": "paragraph",
      "text": "Peta."
    },
    {
      "type": "paragraph",
      "text": "“Masih membaca?” tanyaku."
    },
    {
      "type": "paragraph",
      "text": "“Masih.”"
    },
    {
      "type": "paragraph",
      "text": "“Selepas tadi?”"
    },
    {
      "type": "paragraph",
      "text": "Braz memandang ke arah kota."
    },
    {
      "type": "paragraph",
      "text": "“Terutamanya selepas tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka salah satu peta."
    },
    {
      "type": "paragraph",
      "text": "Kami bertiga melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pandai membaca peta seperti Braz."
    },
    {
      "type": "paragraph",
      "text": "Bagiku, peta cuma garis."
    },
    {
      "type": "paragraph",
      "text": "Sungai."
    },
    {
      "type": "paragraph",
      "text": "Jalan."
    },
    {
      "type": "paragraph",
      "text": "Bangunan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Braz melihat sesuatu yang lain."
    },
    {
      "type": "paragraph",
      "text": "“Serangan pertama gagal kerana kita terlalu dekat dengan kota sebelum sempat menyusun semula barisan.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel menunjuk satu tempat."
    },
    {
      "type": "paragraph",
      "text": "“Jambatan?”"
    },
    {
      "type": "paragraph",
      "text": "Braz mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke arah kota."
    },
    {
      "type": "paragraph",
      "text": "Dari jauh, Melaka kelihatan tenang."
    },
    {
      "type": "paragraph",
      "text": "Itulah perkara yang paling membuat aku tidak selesa."
    },
    {
      "type": "paragraph",
      "text": "Selepas semua yang berlaku, kota itu masih berdiri."
    },
    {
      "type": "paragraph",
      "text": "Asap dari beberapa tempat masih kelihatan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Melaka tidak runtuh."
    },
    {
      "type": "paragraph",
      "text": "Tidak menangis."
    },
    {
      "type": "paragraph",
      "text": "Tidak meminta belas kasihan."
    },
    {
      "type": "paragraph",
      "text": "Ia cuma menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?” aku bertanya."
    },
    {
      "type": "paragraph",
      "text": "Braz mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk serangan seterusnya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandangku."
    },
    {
      "type": "paragraph",
      "text": "“Kau takut?”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Braz menunggu."
    },
    {
      "type": "paragraph",
      "text": "Aku mengeluh."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Aku juga.”"
    },
    {
      "type": "paragraph",
      "text": "Itulah pertama kali aku mendengar Braz mengaku takut."
    },
    {
      "type": "paragraph",
      "text": "Entah kenapa, ia membuatkan aku rasa sedikit lebih baik."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari berikutnya kami gunakan untuk bersiap."
    },
    {
      "type": "paragraph",
      "text": "Senjata diperiksa."
    },
    {
      "type": "paragraph",
      "text": "Meriam disusun."
    },
    {
      "type": "paragraph",
      "text": "Bekalan dipindahkan."
    },
    {
      "type": "paragraph",
      "text": "Luka dirawat."
    },
    {
      "type": "paragraph",
      "text": "Mayat dikebumikan."
    },
    {
      "type": "paragraph",
      "text": "Ada juga yang cuba tidur sebanyak mungkin."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak berjaya."
    },
    {
      "type": "paragraph",
      "text": "Setiap kali aku menutup mata, aku nampak asap."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak orang berlari."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak seorang askar jatuh di hadapanku."
    },
    {
      "type": "paragraph",
      "text": "Dan aku teringat suara Pedro."
    },
    {
      "type": "paragraph",
      "text": "Walaupun aku tidak pernah mengenalinya."
    },
    {
      "type": "paragraph",
      "text": "Pada suatu petang, aku berjalan di sepanjang kem."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak beberapa penduduk tempatan yang ditahan."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk dalam diam."
    },
    {
      "type": "paragraph",
      "text": "Ada yang memandang kami."
    },
    {
      "type": "paragraph",
      "text": "Ada yang cepat-cepat mengalihkan pandangan."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki tua memandang tepat ke arahku."
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia berkata sesuatu dalam bahasa yang aku tidak faham."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia mengulanginya."
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak faham.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah kota."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menunjuk kepadaku."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu maksudnya."
    },
    {
      "type": "paragraph",
      "text": "Mungkin dia mengutuk aku."
    },
    {
      "type": "paragraph",
      "text": "Mungkin dia bertanya sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Mungkin dia cuma mahu aku pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku memilih pilihan terakhir."
    },
    {
      "type": "paragraph",
      "text": "Aku berjalan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kata-katanya kekal dalam kepala."
    },
    {
      "type": "paragraph",
      "text": "Hari itu aku mula melihat sesuatu yang tidak aku fikirkan sebelum ini."
    },
    {
      "type": "paragraph",
      "text": "Kami melihat Melaka sebagai kota yang perlu ditawan."
    },
    {
      "type": "paragraph",
      "text": "Mereka melihat kami sebagai orang asing yang datang untuk mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Kedua-duanya mungkin benar."
    },
    {
      "type": "paragraph",
      "text": "Dan itulah masalahnya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam sebelum serangan seterusnya, Miguel datang kepadaku."
    },
    {
      "type": "paragraph",
      "text": "Dia membawa dua cawan kecil."
    },
    {
      "type": "paragraph",
      "text": "“Ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menghidu."
    },
    {
      "type": "paragraph",
      "text": "“Arak?”"
    },
    {
      "type": "paragraph",
      "text": "“Sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Aku minum."
    },
    {
      "type": "paragraph",
      "text": "Terus aku terbatuk."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan arak.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ini racun.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau begitu jangan minum.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang cawannya."
    },
    {
      "type": "paragraph",
      "text": "“Kau sudah minum?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tunggu kau mati dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menolak bahunya."
    },
    {
      "type": "paragraph",
      "text": "Dia ketawa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kami duduk di bawah langit yang gelap."
    },
    {
      "type": "paragraph",
      "text": "Buat pertama kali sejak kami tiba, aku cuba membayangkan bagaimana semuanya akan berakhir."
    },
    {
      "type": "paragraph",
      "text": "Aku bayangkan kami masuk ke kota."
    },
    {
      "type": "paragraph",
      "text": "Aku bayangkan bendera Portugis berkibar."
    },
    {
      "type": "paragraph",
      "text": "Aku bayangkan orang Melaka melarikan diri."
    },
    {
      "type": "paragraph",
      "text": "Aku bayangkan kami menang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi selepas apa yang berlaku, semua bayangan itu terasa terlalu mudah."
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Miguel memandang ke hadapan."
    },
    {
      "type": "paragraph",
      "text": "“Kalau esok aku tak balik…”"
    },
    {
      "type": "paragraph",
      "text": "Aku terus mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma nak cakap—”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat berlalu."
    },
    {
      "type": "paragraph",
      "text": "“Aku tetap akan cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengeluh."
    },
    {
      "type": "paragraph",
      "text": "“Cepat.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku mati, kau ambil kasut aku.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang kasutnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih elok.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Kau memang bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kami diam lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini lebih lama."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan kami, Melaka masih bercahaya."
    },
    {
      "type": "paragraph",
      "text": "Ribuan cahaya kecil."
    },
    {
      "type": "paragraph",
      "text": "Orang memasak."
    },
    {
      "type": "paragraph",
      "text": "Orang bercakap."
    },
    {
      "type": "paragraph",
      "text": "Orang berjalan."
    },
    {
      "type": "paragraph",
      "text": "Mungkin ada anak-anak yang sedang tidur."
    },
    {
      "type": "paragraph",
      "text": "Mungkin ada keluarga yang sedang makan malam."
    },
    {
      "type": "paragraph",
      "text": "Mungkin ada lelaki yang sedang mengasah senjata kerana tahu esok kami akan datang lagi."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali, aku sedar sesuatu yang membuat dada aku terasa berat."
    },
    {
      "type": "paragraph",
      "text": "Orang di dalam kota itu juga mungkin takut kepada kami."
    },
    {
      "type": "paragraph",
      "text": "Sama seperti kami takut kepada mereka."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya, bunyi gendang kedengaran lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini lebih kuat."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri dan mengambil pedang."
    },
    {
      "type": "paragraph",
      "text": "Miguel muncul di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "“Kasut aku,” katanya."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum tentu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau menyusahkan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Braz datang tidak lama kemudian."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya serius."
    },
    {
      "type": "paragraph",
      "text": "Tiada gurauan."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu sudah tiba masanya."
    },
    {
      "type": "paragraph",
      "text": "Di kejauhan, tentera Portugis mula bergerak."
    },
    {
      "type": "paragraph",
      "text": "Kami mengangkat senjata."
    },
    {
      "type": "paragraph",
      "text": "Barisan mula terbentuk."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Melaka sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Dua tahun lalu, aku datang ke sini sebagai seorang anak muda yang tidak tahu apa-apa tentang kota ini."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku berdiri di hadapannya dengan pedang di tangan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku masih tidak tahu apa yang menunggu di sebalik tembok itu."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Serangan pertama telah mengajar kami bahawa Melaka boleh melawan."
    },
    {
      "type": "paragraph",
      "text": "Serangan kedua akan mengajar kami berapa banyak yang sanggup kami korbankan untuk menewaskannya."
    },
    {
      "type": "paragraph",
      "text": "Aku menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kami mula berjalan."
    }
  ]
}