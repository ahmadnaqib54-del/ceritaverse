    {
      "type": "paragraph",
      "text": "Aku tidak tahu apa yang akan berlaku kepada mereka yang ditangkap."
    },
    {
      "type": "paragraph",
      "text": "Dan aku tidak tahu apa yang akan berlaku kepada Rui de Araújo."
    },
    {
      "type": "paragraph",
      "text": "Aku mencari wajahnya."
    },
    {
      "type": "paragraph",
      "text": "Tiada."
    },
    {
      "type": "paragraph",
      "text": "Aku bertanya kepada seorang pegawai."
    },
    {
      "type": "paragraph",
      "text": "\"Rui?\""
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Aku bertanya lagi."
    },
    {
      "type": "paragraph",
      "text": "\"Di mana Rui de Araújo?\""
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "\"Dia ditangkap.\""
    },
    {
      "type": "paragraph",
      "text": "Aku diam."
    },
    {
      "type": "paragraph",
      "text": "\"Masih hidup?\""
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "\"Aku tidak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "Itu jawapan yang aku tidak mahu dengar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu kapal bergerak menjauhi Melaka."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa bercakap banyak."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang duduk memegang luka."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berdoa."
    },
    {
      "type": "paragraph",
      "text": "Ada yang minum."
    },
    {
      "type": "paragraph",
      "text": "Ada yang hanya memandang laut."
    },
    {
      "type": "paragraph",
      "text": "Aku duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Miguel datang dan duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit kemudian dia bertanya:"
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Apa?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa mereka buat begitu?\""
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "\"Aku tidak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kita datang untuk berdagang.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku tahu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kita tidak serang mereka.\""
    },
    {
      "type": "paragraph",
      "text": "\"Belum.\""
    },
    {
      "type": "paragraph",
      "text": "Miguel memandangku."
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum sedikit."
    },
    {
      "type": "paragraph",
      "text": "\"Maaf.\""
    },
    {
      "type": "paragraph",
      "text": "Dia diam."
    },
    {
      "type": "paragraph",
      "text": "Aku juga."
    },
    {
      "type": "paragraph",
      "text": "Sebenarnya aku sedang memikirkan perkara yang sama."
    },
    {
      "type": "paragraph",
      "text": "Kenapa?"
    },
    {
      "type": "paragraph",
      "text": "Apa yang membuatkan keadaan berubah?"
    },
    {
      "type": "paragraph",
      "text": "Adakah kerana pedagang Gujerat?"
    },
    {
      "type": "paragraph",
      "text": "Adakah kerana orang Jawa?"
    },
    {
      "type": "paragraph",
      "text": "Adakah kerana istana?"
    },
    {
      "type": "paragraph",
      "text": "Adakah kerana Portugis sendiri?"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Dan mungkin tidak akan pernah tahu sepenuhnya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ada satu perkara yang aku tahu."
    },
    {
      "type": "paragraph",
      "text": "Kami telah gagal."
    },
    {
      "type": "paragraph",
      "text": "Melaka masih di belakang kami."
    },
    {
      "type": "paragraph",
      "text": "Dan Rui de Araújo masih berada di sana."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian kami sampai ke India."
    },
    {
      "type": "paragraph",
      "text": "Berita tentang apa yang berlaku di Melaka mula tersebar."
    },
    {
      "type": "paragraph",
      "text": "Orang bercakap."
    },
    {
      "type": "paragraph",
      "text": "Pegawai bercakap."
    },
    {
      "type": "paragraph",
      "text": "Pedagang bercakap."
    },
    {
      "type": "paragraph",
      "text": "Semua orang mempunyai versi sendiri."
    },
    {
      "type": "paragraph",
      "text": "Ada yang kata orang Melaka merancang untuk membunuh semua Portugis."
    },
    {
      "type": "paragraph",
      "text": "Ada yang kata pedagang asing menghasut Sultan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang kata kami sendiri terlalu sombong."
    },
    {
      "type": "paragraph",
      "text": "Ada yang kata Melaka memang dari awal mahu menyingkirkan kami."
    },
    {
      "type": "paragraph",
      "text": "Aku mendengar semuanya."
    },
    {
      "type": "paragraph",
      "text": "Tiada satu pun membuat aku lebih faham."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku mendengar nama Afonso de Albuquerque."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah mengetahui apa yang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Dan dia tidak gembira."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah melihatnya ketika itu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku mendengar cerita daripada orang yang pernah berada bersamanya."
    },
    {
      "type": "paragraph",
      "text": "Afonso mahu tahu apa yang berlaku di Melaka."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu tahu pertahanan kota."
    },
    {
      "type": "paragraph",
      "text": "Jumlah meriam."
    },
    {
      "type": "paragraph",
      "text": "Kekuatan tentera."
    },
    {
      "type": "paragraph",
      "text": "Pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Sungai."
    },
    {
      "type": "paragraph",
      "text": "Jalan masuk."
    },
    {
      "type": "paragraph",
      "text": "Semua."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berita lain sampai."
    },
    {
      "type": "paragraph",
      "text": "Rui de Araújo masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Dan lebih penting—"
    },
    {
      "type": "paragraph",
      "text": "dia berjaya menghantar surat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Surat itu menjadi sesuatu yang lebih berharga daripada emas."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah membacanya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku mendengar kandungannya daripada orang lain."
    },
    {
      "type": "paragraph",
      "text": "Araújo berada dalam tahanan."
    },
    {
      "type": "paragraph",
      "text": "Namun dia masih berjaya menghantar maklumat tentang Melaka."
    },
    {
      "type": "paragraph",
      "text": "Tentang apa yang dia lihat."
    },
    {
      "type": "paragraph",
      "text": "Tentang pertahanan."
    },
    {
      "type": "paragraph",
      "text": "Tentang keadaan di dalam kota."
    },
    {
      "type": "paragraph",
      "text": "Tentang apa yang berlaku selepas kami berundur."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak hanya menulis:"
    },
    {
      "type": "paragraph",
      "text": "*\"Tolong selamatkan aku.\"*"
    },
    {
      "type": "paragraph",
      "text": "Dia memberi mereka sebab untuk kembali."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat wajahnya sebelum kami berpisah."
    },
    {
      "type": "paragraph",
      "text": "Dia selalu nampak tenang."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku faham kenapa."
    },
    {
      "type": "paragraph",
      "text": "Mungkin dia tahu sesuatu yang kami semua tidak faham."
    },
    {
      "type": "paragraph",
      "text": "Melaka bukan pengakhiran."
    },
    {
      "type": "paragraph",
      "text": "Melaka adalah sasaran."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa bulan berlalu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertahun."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak kembali ke Melaka dengan serta-merta."
    },
    {
      "type": "paragraph",
      "text": "Tetapi nama kota itu tidak pernah hilang."
    },
    {
      "type": "paragraph",
      "text": "Setiap kali orang bercakap tentang perdagangan, Melaka muncul."
    },
    {
      "type": "paragraph",
      "text": "Setiap kali orang bercakap tentang rempah, Melaka muncul."
    },
    {
      "type": "paragraph",
      "text": "Setiap kali orang bercakap tentang Portugis dan Timur, Melaka muncul."
    },
    {
      "type": "paragraph",
      "text": "Dan setiap kali nama itu disebut, aku teringat bunyi pedang."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat Miguel berlari."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat lelaki yang aku tikam."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat Rui."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat kota itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian suatu hari, aku mendengar sesuatu yang mengubah semuanya."
    },
    {
      "type": "paragraph",
      "text": "Afonso de Albuquerque akan belayar ke Melaka."
    },
    {
      "type": "paragraph",
      "text": "Bukan untuk berdagang."
    },
    {
      "type": "paragraph",
      "text": "Bukan untuk berbincang."
    },
    {
      "type": "paragraph",
      "text": "Untuk menakluk."
    },
    {
      "type": "paragraph",
      "text": "Aku sedang duduk di sebuah kedai apabila berita itu sampai."
    },
    {
      "type": "paragraph",
      "text": "Miguel berada di hadapanku."
    },
    {
      "type": "paragraph",
      "text": "Dia hampir tercekik minuman."
    },
    {
      "type": "paragraph",
      "text": "\"Dia serius?\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Berapa banyak kapal?\""
    },
    {
      "type": "paragraph",
      "text": "\"Tak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Berapa ramai orang?\""
    },
    {
      "type": "paragraph",
      "text": "\"Tak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "\"Dan kita ikut?\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah tahu jawapannya."
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengeluh."
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa kita?\""
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "\"Kerana kau belum cukup bijak untuk lari.\""
    },
    {
      "type": "paragraph",
      "text": "Dia menuding jari kepadaku."
    },
    {
      "type": "paragraph",
      "text": "\"Kau pun ikut.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku memang bodoh.\""
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Persiapan bermula."
    },
    {
      "type": "paragraph",
      "text": "Kapal dikumpulkan."
    },
    {
      "type": "paragraph",
      "text": "Senjata diperiksa."
    },
    {
      "type": "paragraph",
      "text": "Bekalan dimuatkan."
    },
    {
      "type": "paragraph",
      "text": "Askar datang dari pelbagai tempat."
    },
    {
      "type": "paragraph",
      "text": "Dan kali ini suasananya berbeza."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa bercakap tentang perdagangan."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa bercakap tentang membuka hubungan."
    },
    {
      "type": "paragraph",
      "text": "Kami tahu kenapa kami pergi."
    },
    {
      "type": "paragraph",
      "text": "Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku mendengar nama itu setiap hari."
    },
    {
      "type": "paragraph",
      "text": "Dalam arahan."
    },
    {
      "type": "paragraph",
      "text": "Dalam perbualan."
    },
    {
      "type": "paragraph",
      "text": "Dalam doa."
    },
    {
      "type": "paragraph",
      "text": "Dalam sumpah."
    },
    {
      "type": "paragraph",
      "text": "Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku mula tertanya-tanya bagaimana rupanya sekarang."
    },
    {
      "type": "paragraph",
      "text": "Adakah kota itu masih sama?"
    },
    {
      "type": "paragraph",
      "text": "Adakah orang di sana masih mengingati kami?"
    },
    {
      "type": "paragraph",
      "text": "Adakah Rui masih hidup?"
    },
    {
      "type": "paragraph",
      "text": "Adakah mereka bersedia?"
    },
    {
      "type": "paragraph",
      "text": "Dan yang paling penting—"
    },
    {
      "type": "paragraph",
      "text": "adakah kami bersedia?"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sebelum berangkat, aku bertemu Sequeira."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di tepi kapal."
    },
    {
      "type": "paragraph",
      "text": "Aku menghampirinya."
    },
    {
      "type": "paragraph",
      "text": "\"Sir.\""
    },
    {
      "type": "paragraph",
      "text": "Dia menoleh."
    },
    {
      "type": "paragraph",
      "text": "\"José.\""
    },
    {
      "type": "paragraph",
      "text": "Kami berdiri beberapa ketika tanpa bercakap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku bertanya:"
    },
    {
      "type": "paragraph",
      "text": "\"Adakah kali ini akan berbeza?\""
    },
    {
      "type": "paragraph",
      "text": "Dia memandang laut."
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa?\""
    },
    {
      "type": "paragraph",
      "text": "Dia tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata:"
    },
    {
      "type": "paragraph",
      "text": "\"Kerana kali ini kita tahu apa yang kita mahu.\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Dan mereka tahu kita akan datang.\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak suka jawapan itu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tahu dia benar."
    },
    {
      "type": "paragraph",
      "text": "Pada tahun 1509, kami datang tanpa benar-benar memahami Melaka."
    },
    {
      "type": "paragraph",
      "text": "Kami datang sebagai orang luar yang fikir kami boleh masuk, berdagang dan pergi."
    },
    {
      "type": "paragraph",
      "text": "Kami salah."
    },
    {
      "type": "paragraph",
      "text": "Sekarang kami datang dengan tentera."
    },
    {
      "type": "paragraph",
      "text": "Dengan meriam."
    },
    {
      "type": "paragraph",
      "text": "Dengan pengalaman."
    },
    {
      "type": "paragraph",
      "text": "Dengan kemarahan."
    },
    {
      "type": "paragraph",
      "text": "Dan dengan maklumat yang dikumpulkan daripada orang yang masih berada di sana."
    },
    {
      "type": "paragraph",
      "text": "Termasuk Rui de Araújo."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang kapal-kapal di hadapan kami."
    },
    {
      "type": "paragraph",
      "text": "Puluhan."
    },
    {
      "type": "paragraph",
      "text": "Mungkin lebih."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak mengira."
    },
    {
      "type": "paragraph",
      "text": "Aku hanya tahu jumlahnya cukup untuk membuat pelabuhan kelihatan kecil."
    },
    {
      "type": "paragraph",
      "text": "Miguel datang dari belakang."
    },
    {
      "type": "paragraph",
      "text": "\"Jose.\""
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Dia memegang topinya."
    },
    {
      "type": "paragraph",
      "text": "\"Kau rasa kali ini kita akan menang?\""
    },
    {
      "type": "paragraph",
      "text": "Aku melihat kapal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian laut."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ke arah timur."
    },
    {
      "type": "paragraph",
      "text": "Ke arah Melaka."
    },
    {
      "type": "paragraph",
      "text": "\"Aku tidak tahu.\""
    },
    {
      "type": "paragraph",
      "text": "Dia mengeluh."
    },
    {
      "type": "paragraph",
      "text": "\"Kau selalu jawab begitu.\""
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "\"Dan kau masih tanya.\""
    },
    {
      "type": "paragraph",
      "text": "Kami ketawa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian loceng berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Orang mula bergerak."
    },
    {
      "type": "paragraph",
      "text": "Kapal bersedia untuk berangkat."
    },
    {
      "type": "paragraph",
      "text": "Aku naik ke atas kapal."
    },
    {
      "type": "paragraph",
      "text": "Kali ini aku tidak muntah."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kerana aku sudah biasa."
    },
    {
      "type": "paragraph",
      "text": "Atau mungkin kerana aku tahu apa yang menunggu di hujung perjalanan."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di geladak ketika Portugal semakin jauh di belakang kami."
    },
    {
      "type": "paragraph",
      "text": "Melaka berada di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Dua tahun lalu, kami datang sebagai tetamu."
    },
    {
      "type": "paragraph",
      "text": "Kali ini kami datang sebagai musuh."
    },
    {
      "type": "paragraph",
      "text": "Dan jauh di dalam hati, aku tahu sesuatu yang belum mampu aku katakan kepada sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak lagi mahu tahu sama ada Melaka akan jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma mahu tahu—"
    },
    {
      "type": "paragraph",
      "text": "**berapa ramai antara kami yang akan hidup untuk melihatnya.**"
    }
  ]
}