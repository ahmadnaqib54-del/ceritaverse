    {
      "type": "paragraph",
      "text": "Loceng kecemasan."
    },
    {
      "type": "paragraph",
      "text": "Aku terus duduk."
    },
    {
      "type": "paragraph",
      "text": "Di luar, orang sudah berlari."
    },
    {
      "type": "paragraph",
      "text": "Aku mencapai pedang sebelum sempat memakai kasut dengan betul."
    },
    {
      "type": "paragraph",
      "text": "Miguel muncul di pintu."
    },
    {
      "type": "paragraph",
      "text": "Mukanya pucat."
    },
    {
      "type": "paragraph",
      "text": "\"Kita diserang?\""
    },
    {
