    {
      "type": "paragraph",
      "text": "Ramai."
    },
    {
      "type": "paragraph",
      "text": "Mereka datang dari arah kota."
    },
    {
      "type": "paragraph",
      "text": "Aku menarik pedang."
    },
    {
      "type": "paragraph",
      "text": "Miguel melakukan perkara yang sama."
    },
    {
      "type": "paragraph",
      "text": "\"Berapa ramai?\" dia bertanya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Sebab aku sendiri tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Dan itulah kali pertama aku benar-benar faham bahawa semua perkara yang kami anggap pelik sejak beberapa minggu lalu bukan kebetulan."
    },
    {
      "type": "paragraph",
      "text": "Mereka memang datang untuk kami."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Semuanya berlaku terlalu cepat."
    },
    {
      "type": "paragraph",
      "text": "Aku masih tidak tahu siapa yang memberi arahan pertama."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma ingat jeritan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bunyi logam bertembung."
    },
    {
      "type": "paragraph",
      "text": "Seseorang jatuh di hadapanku."
    },
    {
      "type": "paragraph",
      "text": "Aku menolak Miguel ke tepi."
    },
    {
      "type": "paragraph",
      "text": "Satu bilah pedang melintas di tempat kepalanya berada tadi."
    },
    {
      "type": "paragraph",
      "text": "Dia memandangku."
    },
    {
      "type": "paragraph",
      "text": "\"Terima kasih.\""
    },
    {
      "type": "paragraph",
      "text": "\"Belanja aku makan nanti.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kalau kita hidup.\""
    },
    {
      "type": "paragraph",
      "text": "\"Betul.\""
    },
    {
      "type": "paragraph",
      "text": "Aku menangkis satu lagi serangan."
    },
    {
      "type": "paragraph",
      "text": "Lelaki di hadapanku tidak kelihatan seperti pedagang."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu menggunakan pedang."
    },
    {
      "type": "paragraph",
      "text": "Aku menebas."
    },
    {
      "type": "paragraph",
      "text": "Dia mengelak."
    },
    {
      "type": "paragraph",
      "text": "Aku menyerang lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini pedangku mengenai bahunya."
    },
    {
      "type": "paragraph",
      "text": "Dia jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku berundur."
    },
    {
      "type": "paragraph",
      "text": "Tangan aku menggigil."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah berlatih."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah bertarung."
    },
    {
      "type": "paragraph",
      "text": "Tetapi latihan tidak pernah mengajar kau bagaimana rasanya apabila orang yang kau bunuh memandang kau sebelum dia jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak sempat berfikir."
    },
    {
      "type": "paragraph",
      "text": "Seseorang menjerit."
    },
    {
      "type": "paragraph",
      "text": "\"Ke kapal!\""
    },
    {
      "type": "paragraph",
      "text": "Kami mula berundur."
    },
    {
      "type": "paragraph",
      "text": "Tetapi jalan yang kami lalui beberapa hari lalu untuk masuk ke kota kini terasa seperti perangkap."
    },
    {
      "type": "paragraph",
      "text": "Orang ramai berlari."
    },
    {
      "type": "paragraph",
      "text": "Ada yang menjerit."
    },
    {
      "type": "paragraph",
      "text": "Ada yang menutup pintu."
    },
    {
      "type": "paragraph",
      "text": "Ada yang hanya berdiri melihat."
    },
    {
      "type": "paragraph",
      "text": "Aku cuba mencari wajah yang aku kenal."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak pedagang yang pernah bercakap dengan kami."
    },
    {
      "type": "paragraph",
      "text": "Dia menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Tidak mahu melihat."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu sama ada dia takut."
    },
    {
      "type": "paragraph",
      "text": "Atau gembira."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kedua-duanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Kami sampai ke kawasan berhampiran kapal."
    },
    {
      "type": "paragraph",
      "text": "Sequeira sudah berada di sana."
    },
    {
      "type": "paragraph",
      "text": "Dia menjerit arahan."
    },
    {
      "type": "paragraph",
      "text": "\"Naik!\""
    },
    {
      "type": "paragraph",
      "text": "Aku membantu seorang askar yang cedera menaiki kapal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku kembali."
    },
    {
      "type": "paragraph",
      "text": "Miguel masih di bawah."
    },
    {
      "type": "paragraph",
      "text": "Aku menjerit."
    },
    {
      "type": "paragraph",
      "text": "\"Naik!\""
    },
    {
      "type": "paragraph",
      "text": "Dia menoleh."
    },
    {
      "type": "paragraph",
      "text": "\"Aku sedang cuba!\""
    },
    {
      "type": "paragraph",
      "text": "Aku nampak dua orang lelaki mengejarnya."
    },
    {
      "type": "paragraph",
      "text": "Aku turun semula."
    },
    {
      "type": "paragraph",
      "text": "\"Jose!\""
    },
    {
      "type": "paragraph",
      "text": "Aku tidak peduli."
    },
    {
      "type": "paragraph",
      "text": "Aku berlari."
    },
    {
      "type": "paragraph",
      "text": "Satu lelaki menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku menangkis."
    },
    {
      "type": "paragraph",
      "text": "Miguel menendang lututnya."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu jatuh."
    },
    {
      "type": "paragraph",
      "text": "Kami berlari semula."
    },
    {
      "type": "paragraph",
      "text": "Kali ini kami berjaya naik."
    },
    {
      "type": "paragraph",
      "text": "Sejurus sahaja kaki aku berada di atas kapal, seseorang menarik aku."
    },
    {
      "type": "paragraph",
      "text": "Aku jatuh."
    },
    {
      "type": "paragraph",
      "text": "\"Dasar bodoh!\""
    },
    {
      "type": "paragraph",
      "text": "Aku kenal suara itu."
    },
    {
      "type": "paragraph",
      "text": "Sequeira."
    },
    {
      "type": "paragraph",
      "text": "Aku bangun."
    },
    {
      "type": "paragraph",
      "text": "\"Sir.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kau turun semula untuk apa?\""
    },
    {
      "type": "paragraph",
      "text": "Aku menunjuk Miguel."
    },
    {
      "type": "paragraph",
      "text": "\"Dia masih di bawah.\""
    },
    {
      "type": "paragraph",
      "text": "Sequeira memandang Miguel."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang aku."
    },
    {
      "type": "paragraph",
      "text": "\"Jangan buat lagi.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Miguel menoleh kepadaku."
    },
    {
      "type": "paragraph",
      "text": "\"Kau dengar?\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Dia marah.\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kita patut dengar.\""
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kami berdua ketawa."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana lucu."
    },
    {
      "type": "paragraph",
      "text": "Kerana kami masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang itu sahaja yang mampu kau lakukan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Kami tidak tahu berapa ramai yang hilang."
    },
    {
      "type": "paragraph",
      "text": "Pada awalnya, tiada siapa bercakap tentang mereka."
    },
    {
      "type": "paragraph",
      "text": "Semua orang sibuk memastikan kapal bersedia."
    },
    {
      "type": "paragraph",
      "text": "Tali ditarik."
    },
    {
      "type": "paragraph",
      "text": "Barang dipindahkan."
    },
    {
      "type": "paragraph",
      "text": "Senjata diperiksa."
    },
    {
      "type": "paragraph",
      "text": "Arahan diberikan."
    },
    {
      "type": "paragraph",
      "text": "Kapal bergerak."
    },
    {
      "type": "paragraph",
      "text": "Melaka semakin jauh."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di belakang kapal dan melihat kota itu."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu apa yang akan berlaku kepada orang yang kami tinggalkan."
