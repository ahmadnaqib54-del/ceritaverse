    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "\"Kau semakin bijak.\""
    },
    {
      "type": "paragraph",
      "text": "\"Aku belajar daripada kau.\""
    },
    {
      "type": "paragraph",
      "text": "\"Itu berita buruk.\""
    },
    {
      "type": "paragraph",
      "text": "Kami keluar."
    },
    {
      "type": "paragraph",
      "text": "Di jalan, orang Portugis berlari ke arah kapal."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pegawai menjerit memberi arahan."
    },
    {
      "type": "paragraph",
      "text": "Aku cuba memahami apa yang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku nampak mereka."
    },
    {
      "type": "paragraph",
      "text": "Orang bersenjata."
    },
    {
      "type": "paragraph",
      "text": "Bukan seorang."
    },
    {
      "type": "paragraph",
      "text": "Bukan dua."
