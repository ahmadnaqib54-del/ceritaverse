{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 1,
  "episode": 6,
  "title": "DI HADAPAN KOTA",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Melaka kelihatan lebih kecil dari dekat."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu itu tidak masuk akal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi apabila kau melihat sebuah kota dari laut, ia kelihatan seperti dunia."
    },
    {
      "type": "paragraph",
      "text": "Apabila kau semakin dekat, kau mula nampak tembok."
    },
    {
      "type": "paragraph",
      "text": "Rumah."
    },
    {
      "type": "paragraph",
      "text": "Pokok."
    },
    {
      "type": "paragraph",
      "text": "Kapal."
    },
    {
      "type": "paragraph",
      "text": "Manusia."
    },
    {
      "type": "paragraph",
      "text": "Dan tiba-tiba semuanya kelihatan boleh disentuh."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang membuatkan aku takut."
    },
    {
      "type": "paragraph",
      "text": "Dari jauh, Melaka ialah sebuah nama."
    },
    {
      "type": "paragraph",
      "text": "Dari sini, ia menjadi tempat yang mempunyai orang."
    },
    {
      "type": "paragraph",
      "text": "Dan kami datang untuk menyerang mereka."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di tepi kapal sambil memandang kota."
    },
    {
      "type": "paragraph",
      "text": "Miguel muncul di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "\"Kau pernah tengok dari sini?\""
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "\"Masih sama?\""
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "\"Tak.\""
    },
    {
      "type": "paragraph",
      "text": "\"Apa yang berubah?\""
    },
    {
      "type": "paragraph",
      "text": "Aku menunjuk ke arah pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "\"Lebih banyak kapal.\""
    },
    {
      "type": "paragraph",
      "text": "Dia melihat."
    },
    {
      "type": "paragraph",
      "text": "\"Bagus.\""
    },
    {
      "type": "paragraph",
      "text": "\"Kenapa bagus?\""
    },
    {
      "type": "paragraph",
      "text": "\"Kalau ramai orang, mungkin mereka tidak perasan kita.\""
    },
    {
      "type": "paragraph",
      "text": "Aku memandang armada kami."
    },
    {
      "type": "paragraph",
      "text": "Puluhan kapal bergerak masuk ke arah muara."
    },
    {
      "type": "paragraph",
      "text": "\"Ya.\""
    },
    {
      "type": "paragraph",
      "text": "Aku menepuk bahunya."
    },
    {
      "type": "paragraph",
      "text": "\"Strategi yang hebat.\""
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Kami tidak terus menyerang."
    },
    {
      "type": "paragraph",
      "text": "Itulah perkara pertama yang membuat aku sedar perang tidak semudah yang orang fikir."
    },
    {
      "type": "paragraph",
      "text": "Kami perlu mencari tempat untuk mendarat."
    },
    {
      "type": "paragraph",
      "text": "Mengatur kapal."
    },
    {
      "type": "paragraph",
      "text": "Memastikan senjata sampai."
    },
    {
      "type": "paragraph",
      "text": "Membawa bekalan."
    },
    {
      "type": "paragraph",
      "text": "Membina kedudukan."
    },
    {
      "type": "paragraph",
      "text": "Menunggu arahan."
    },
    {
      "type": "paragraph",
      "text": "Menunggu."
    },
    {
      "type": "paragraph",
      "text": "Menunggu."
    },
    {
      "type": "paragraph",
      "text": "Dan menunggu lagi."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah suka menunggu."
    },
    {
      "type": "paragraph",
      "text": "Lebih-lebih lagi apabila orang di seberang sana tahu kau sedang menunggu mereka."
    },
    {
      "type": "paragraph",
      "text": "Melaka juga tahu kami sudah datang."
    },
    {
      "type": "paragraph",
      "text": "Tidak mungkin mereka tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Asap dari kapal kami kelihatan dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Bendera Portugis berkibar."
    },
    {
      "type": "paragraph",
      "text": "Kapal kami memenuhi laut."
    },
    {
      "type": "paragraph",
      "text": "Kalau ada sesiapa di Melaka yang tidak tahu kami datang, mungkin dia sedang tidur."
    },
    {
      "type": "paragraph",
      "text": "Dan aku berharap dia terus tidur."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Kami mula be"
    }
  ]
}