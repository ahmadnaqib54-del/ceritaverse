{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 2,
  "episode": 4,
  "title": "Mereka Datang",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Mereka datang sebelum matahari naik."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu kerana pengawal di menara membunyikan loceng."
    },
    {
      "type": "paragraph",
      "text": "Sekali."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dua kali."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkali-kali."
    },
    {
      "type": "paragraph",
      "text": "Aku terjaga di atas lantai sebelum sempat memahami apa yang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Alya sudah bangun."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang memeluk anak kami."
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mencapai pedang."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Di luar rumah, orang berlari."
    },
    {
      "type": "paragraph",
      "text": "Suara arahan kedengaran dari jalan."
    },
    {
      "type": "paragraph",
      "text": "Aku membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "“Kapten!”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka dilihat di sungai.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Berapa ramai?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Itulah jawapan yang paling aku benci."
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh kepada Alya."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di pintu."
    },
    {
      "type": "paragraph",
      "text": "Kami saling memandang."
    },
    {
      "type": "paragraph",
      "text": "Aku mahu berkata semuanya akan baik."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku sudah belajar satu perkara tentang perang."
    },
    {
      "type": "paragraph",
      "text": "Jangan menjanjikan sesuatu yang kau sendiri tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan kembali.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Aku berlari."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Melaka berubah dalam beberapa minit."
    },
    {
      "type": "paragraph",
      "text": "Pasar yang biasanya penuh manusia kosong."
    },
    {
      "type": "paragraph",
      "text": "Pintu-pintu ditutup."
    },
    {
      "type": "paragraph",
      "text": "Askar memenuhi jalan."
    },
    {
      "type": "paragraph",
      "text": "Penduduk diarahkan masuk ke kawasan yang lebih selamat."
    },
    {
      "type": "paragraph",
      "text": "Aku sampai di tembok ketika langit masih gelap."
    },
    {
      "type": "paragraph",
      "text": "Di luar kota, kabus menutup sebahagian sungai."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak nampak tentera."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku dapat dengar mereka."
    },
    {
      "type": "paragraph",
      "text": "Dayung."
    },
    {
      "type": "paragraph",
      "text": "Kayu."
    },
    {
      "type": "paragraph",
      "text": "Suara manusia."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu bayang muncul dari kabus."
    },
    {
      "type": "paragraph",
      "text": "Perahu."
    },
    {
      "type": "paragraph",
      "text": "Satu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dua."
    },
    {
      "type": "paragraph",
      "text": "Kemudian lebih banyak."
    },
    {
      "type": "paragraph",
      "text": "“Bersedia!”"
    },
    {
      "type": "paragraph",
      "text": "Askar di atas tembok mengangkat senjata."
    },
    {
      "type": "paragraph",
      "text": "Aku menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah berdiri di tempat ini bertahun-tahun dahulu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ketika itu aku berada di bawah."
    },
    {
      "type": "paragraph",
      "text": "Aku yang menyerang."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku berada di atas."
    },
    {
      "type": "paragraph",
      "text": "Aku yang menunggu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Perahu-perahu itu semakin dekat."
    },
    {
      "type": "paragraph",
      "text": "Aku dapat melihat lelaki di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membawa perisai."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membawa tombak."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membawa panah."
    },
    {
      "type": "paragraph",
      "text": "Mereka bergerak perlahan."
    },
    {
      "type": "paragraph",
      "text": "Tidak tergesa-gesa."
    },
    {
      "type": "paragraph",
      "text": "Mereka tahu apa yang mereka lakukan."
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tembak.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel memandangku."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum cukup dekat.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau mereka terus datang?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Perahu pertama hampir sampai."
    },
    {
      "type": "paragraph",
      "text": "Aku boleh nampak wajah seorang lelaki."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang ke arah tembok."
    },
    {
      "type": "paragraph",
      "text": "Aku tertanya-tanya apakah dia pernah berada di Melaka sebelum ini."
    },
    {
      "type": "paragraph",
      "text": "Mungkin."
    },
    {
      "type": "paragraph",
      "text": "Mungkin dia pernah tinggal di sini."
    },
    {
      "type": "paragraph",
      "text": "Mungkin keluarganya pernah tinggal di sini."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia datang membawa tombak."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tahu dia sedang menuju ke arah kami."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menurunkan tangan."
    },
    {
      "type": "paragraph",
      "text": "Meriam meletup."
    },
    {
      "type": "paragraph",
      "text": "Bunyi itu membuat seluruh tubuhku bergetar."
    },
    {
      "type": "paragraph",
      "text": "Perahu pertama terbalik."
    },
    {
      "type": "paragraph",
      "text": "Orang jatuh ke dalam air."
    },
    {
      "type": "paragraph",
      "text": "Perahu kedua cuba berpatah balik."
    },
    {
      "type": "paragraph",
      "text": "Meriam kedua ditembak."
    },
    {
      "type": "paragraph",
      "text": "Air sungai meletup."
    },
    {
      "type": "paragraph",
      "text": "Jeritan kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Askar di tembok bersorak."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah berada di bawah meriam."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu bunyi itu."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu apa yang berlaku kepada manusia apabila mereka terkena."
    },
    {
      "type": "paragraph",
      "text": "“Jangan berhenti!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menjerit."
    },
    {
      "type": "paragraph",
      "text": "“Teruskan!”"
    },
    {
      "type": "paragraph",
      "text": "Meriam ditembak lagi."
    },
    {
      "type": "paragraph",
      "text": "Dan lagi."
    },
    {
      "type": "paragraph",
      "text": "Sungai berubah menjadi asap."
    },
    {
      "type": "paragraph",
      "text": "Tetapi mereka tidak berhenti."
    },
    {
      "type": "paragraph",
      "text": "Perahu lain terus datang."
    },
    {
      "type": "paragraph",
      "text": "Lebih banyak."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Miguel."
    },
    {
      "type": "paragraph",
      "text": "Dia juga nampak perkara yang sama."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan serangan kecil,” katanya."
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Menjelang tengah hari, pertempuran sudah merebak ke beberapa kawasan."
    },
    {
      "type": "paragraph",
      "text": "Serangan dari sungai bukan satu-satunya masalah."
    },
    {
      "type": "paragraph",
      "text": "Beberapa kumpulan kecil cuba memasuki kota dari kawasan lain."
    },
    {
      "type": "paragraph",
      "text": "Ada yang datang melalui jalan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang cuba mendekati pintu belakang."
    },
    {
      "type": "paragraph",
      "text": "Ada yang cuba menyamar sebagai penduduk."
    },
    {
      "type": "paragraph",
      "text": "Aku mula sedar bahawa ini bukan satu pertempuran."
    },
    {
      "type": "paragraph",
      "text": "Ini adalah cubaan untuk membuat kami melihat terlalu banyak tempat pada masa yang sama."
    },
    {
      "type": "paragraph",
      "text": "Aku mengarahkan separuh askarku ke kawasan selatan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian sebahagian lagi ke pintu sungai."
    },
    {
      "type": "paragraph",
      "text": "Aku sendiri bergerak antara kedua-duanya."
    },
    {
      "type": "paragraph",
      "text": "“Kapten!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar berlari kepadaku."
    },
    {
      "type": "paragraph",
      "text": "“Ada serangan di bahagian timur!”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa ramai?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Aku hampir ketawa."
    },
    {
      "type": "paragraph",
      "text": "Semua orang hari itu tidak tahu apa-apa."
    },
    {
      "type": "paragraph",
      "text": "“Bawa dua puluh orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Dua puluh?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau cukup, dua puluh. Kalau tidak, bawa semua yang kau ada.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk dan berlari."
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh kepada Miguel."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tinggalkan pintu sungai.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagaimana dengan kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku ke timur.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku ikut.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau semua orang ikut aku, siapa jaga tempat ini?”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandangku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Aku berlari."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali aku benar-benar memahami apa maksud menjadi ketua."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang kau perlu pergi ke tempat paling bahaya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kadang-kadang kau perlu mempercayai orang lain untuk pergi ke tempat yang sama bahayanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di bahagian timur, keadaan lebih buruk daripada yang aku jangka."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang sudah berjaya sampai ke kawasan luar tembok."
    },
    {
      "type": "paragraph",
      "text": "Pertempuran berlaku di antara rumah."
    },
    {
      "type": "paragraph",
      "text": "Aku mengarahkan askar menyerang."
    },
    {
      "type": "paragraph",
      "text": "Kami menolak mereka kembali."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Aku bertempur di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak suka melakukannya."
    },
    {
      "type": "paragraph",
      "text": "Seorang captain sepatutnya berada di belakang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi askar lebih berani apabila mereka melihat pemimpin mereka di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu itu."
    },
    {
      "type": "paragraph",
      "text": "Jadi aku bertempur."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku menangkis."
    },
    {
      "type": "paragraph",
      "text": "Seorang lagi datang."
    },
    {
      "type": "paragraph",
      "text": "Aku menendang lututnya."
    },
    {
      "type": "paragraph",
      "text": "Aku menghayun pedang."
    },
    {
      "type": "paragraph",
      "text": "Dia jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku bergerak lagi."
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba aku dengar jeritan."
    },
    {
      "type": "paragraph",
      "text": "“Captain!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar muda terbaring di tanah."
    },
    {
      "type": "paragraph",
      "text": "Anak panah tertanam di bahunya."
    },
    {
      "type": "paragraph",
      "text": "Aku menariknya ke tempat perlindungan."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma… penat.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kita semua.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memanggil dua orang askar untuk membawanya pergi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku kembali berdiri."
    },
    {
      "type": "paragraph",
      "text": "Perang tidak memberi kau masa untuk berkabung."
    },
    {
      "type": "paragraph",
      "text": "Kau boleh berkabung kemudian."
    },
    {
      "type": "paragraph",
      "text": "Kalau kau masih hidup."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Menjelang petang, serangan mula reda."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana mereka kalah."
    },
    {
      "type": "paragraph",
      "text": "Mereka berundur."
    },
    {
      "type": "paragraph",
      "text": "Itu berbeza."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di atas tembok."
    },
    {
      "type": "paragraph",
      "text": "Di luar, perahu-perahu yang rosak terapung di sungai."
    },
    {
      "type": "paragraph",
      "text": "Beberapa mayat masih berada di air."
    },
    {
      "type": "paragraph",
      "text": "Askar kami mengumpulkan senjata yang ditinggalkan."
    },
    {
      "type": "paragraph",
      "text": "Miguel datang."
    },
    {
      "type": "paragraph",
      "text": "Dia kelihatan letih."
    },
    {
      "type": "paragraph",
      "text": "“Pintu sungai masih selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Timur?”"
    },
    {
      "type": "paragraph",
      "text": "“Selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kita berjaya.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang ke arah sungai."
    },
    {
      "type": "paragraph",
      "text": "“Kau rasa mereka akan datang lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat perahu-perahu itu."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya kau konsisten.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dalam hati aku, sesuatu terasa tidak kena."
    },
    {
      "type": "paragraph",
      "text": "Serangan tadi terlalu teratur."
    },
    {
      "type": "paragraph",
      "text": "Mereka bukan datang untuk menang hari ini."
    },
    {
      "type": "paragraph",
      "text": "Mereka datang untuk melihat bagaimana kami bertindak."
    },
    {
      "type": "paragraph",
      "text": "Untuk mencari kelemahan."
    },
    {
      "type": "paragraph",
      "text": "Untuk mengukur pertahanan."
    },
    {
      "type": "paragraph",
      "text": "Dan sekarang mereka sudah tahu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Aku pulang selepas matahari terbenam."
    },
    {
      "type": "paragraph",
      "text": "Rumah kami masih berdiri."
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti di hadapan pintu."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak sedar aku sedang menahan nafas sehingga pintu dibuka."
    },
    {
      "type": "paragraph",
      "text": "Alya berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandangku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat darah pada pakaianku."
    },
    {
      "type": "paragraph",
      "text": "“Bukan darah aku.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Anak kami tidur di dalam."
    },
    {
      "type": "paragraph",
      "text": "Aku masuk."
    },
    {
      "type": "paragraph",
      "text": "Duduk."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat aku hanya diam."
    },
    {
      "type": "paragraph",
      "text": "Alya duduk di sebelahku."
    },
    {
      "type": "paragraph",
      "text": "“Mereka datang?”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Ramai?”"
    },
    {
      "type": "paragraph",
      "text": "“Ramai.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang anak kami."
    },
    {
      "type": "paragraph",
      "text": "“Kau menang?”"
    },
    {
      "type": "paragraph",
      "text": "Aku terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kami bertahan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandangku."
    },
    {
      "type": "paragraph",
      "text": "“Itu bukan jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kalau begitu… ya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia bersandar pada bahuku."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang anak kami."
    },
    {
      "type": "paragraph",
      "text": "Dia masih tidur."
    },
    {
      "type": "paragraph",
      "text": "Tidak tahu apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Tidak tahu bahawa beberapa jalan dari sini, manusia baru sahaja mati."
    },
    {
      "type": "paragraph",
      "text": "Tidak tahu bahawa beberapa orang cuba mengambil kembali kota ini."
    },
    {
      "type": "paragraph",
      "text": "Tidak tahu bahawa ayahnya baru pulang daripada perang."
    },
    {
      "type": "paragraph",
      "text": "Aku berharap dia boleh terus begitu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, aku kembali ke tembok."
    },
    {
      "type": "paragraph",
      "text": "Kami mula membaiki kerosakan."
    },
    {
      "type": "paragraph",
      "text": "Mengira senjata."
    },
    {
      "type": "paragraph",
      "text": "Mengumpulkan mayat."
    },
    {
      "type": "paragraph",
      "text": "Membersihkan sungai."
    },
    {
      "type": "paragraph",
      "text": "Memeriksa pintu."
    },
    {
      "type": "paragraph",
      "text": "Semua orang sibuk."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar datang membawa satu barang."
    },
    {
      "type": "paragraph",
      "text": "“Captain.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia menyerahkan sehelai kain."
    },
    {
      "type": "paragraph",
      "text": "Di atasnya terdapat lambang yang pernah aku lihat sebelum ini."
    },
    {
      "type": "paragraph",
      "text": "Lambang Sultan."
    },
    {
      "type": "paragraph",
      "text": "“Ditemui pada salah seorang yang mati.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memegangnya."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada surat."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada nama."
    },
    {
      "type": "paragraph",
      "text": "Hanya lambang."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat lelaki yang melarikan diri beberapa tahun lalu."
    },
    {
      "type": "paragraph",
      "text": "**Sultan akan kembali.**"
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia sudah kembali."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku mula memahami sesuatu yang lebih menakutkan."
    },
    {
      "type": "paragraph",
      "text": "Serangan ini bukan pengakhiran."
    },
    {
      "type": "paragraph",
      "text": "Ia adalah permulaan."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang sungai."
    },
    {
      "type": "paragraph",
      "text": "Di seberang sana, tiada apa-apa kelihatan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tahu mereka berada di luar sana."
    },
    {
      "type": "paragraph",
      "text": "Menunggu."
    },
    {
      "type": "paragraph",
      "text": "Menyusun semula."
    },
    {
      "type": "paragraph",
      "text": "Mencari cara untuk datang lagi."
    },
    {
      "type": "paragraph",
      "text": "Aku memegang kain itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku memandang ke arah kota."
    },
    {
      "type": "paragraph",
      "text": "Ke arah rumahku."
    },
    {
      "type": "paragraph",
      "text": "Alya."
    },
    {
      "type": "paragraph",
      "text": "Anakku."
    },
    {
      "type": "paragraph",
      "text": "Dan semua orang yang kini bergantung kepada kami untuk mempertahankan tempat ini."
    },
    {
      "type": "paragraph",
      "text": "Dulu, apabila aku datang ke Melaka, aku fikir musuh berada di seberang tembok."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku tahu perkara yang lebih buruk."
    },
    {
      "type": "paragraph",
      "text": "**Musuh boleh berada di mana-mana.**"
    },
    {
      "type": "paragraph",
      "text": "Dan aku tidak boleh menjaga setiap pintu."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak boleh melindungi setiap rumah."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak boleh menyelamatkan semua orang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku boleh berdiri di sini."
    },
    {
      "type": "paragraph",
      "text": "Aku boleh memastikan apabila mereka datang lagi—"
    },
    {
      "type": "paragraph",
      "text": "kami masih berdiri."
    },
    {
      "type": "paragraph",
      "text": "Aku memasukkan kain itu ke dalam poket."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku kembali kepada askar-askarku."
    },
    {
      "type": "paragraph",
      "text": "“Periksa semua pintu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya, Captain.”"
    },
    {
      "type": "paragraph",
      "text": "“Periksa sungai.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya, Captain.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan jangan anggap mereka sudah selesai.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada kapal."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada tentera."
    },
    {
      "type": "paragraph",
      "text": "Hanya air yang tenang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku sudah belajar sesuatu tentang ketenangan."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang ia bukan tanda perang sudah berakhir."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang—"
    },
    {
      "type": "paragraph",
      "text": "ia cuma tanda musuh sedang menarik nafas."
    }
  ]
}