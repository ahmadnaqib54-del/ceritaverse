{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 2,
  "episode": 2,
  "title": "Rumah",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Tahun pertama selepas Melaka jatuh mengajar aku satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Kota boleh berubah lebih cepat daripada manusia."
    },
    {
      "type": "paragraph",
      "text": "Pada awalnya, orang masih takut kepada kami."
    },
    {
      "type": "paragraph",
      "text": "Mereka bercakap perlahan apabila askar Portugis lalu."
    },
    {
      "type": "paragraph",
      "text": "Pintu ditutup lebih awal."
    },
    {
      "type": "paragraph",
      "text": "Pasar menjadi sunyi apabila berlaku khabar angin."
    },
    {
      "type": "paragraph",
      "text": "Tetapi masa mempunyai cara untuk mengubah perkara yang tidak dapat diubah oleh pedang."
    },
    {
      "type": "paragraph",
      "text": "Sedikit demi sedikit, orang mula terbiasa dengan kami."
    },
    {
      "type": "paragraph",
      "text": "Pedagang mula membuka kedai seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Nelayan kembali ke sungai."
    },
    {
      "type": "paragraph",
      "text": "Kapal datang dari pelbagai tempat."
    },
    {
      "type": "paragraph",
      "text": "Kanak-kanak yang dahulu lari apabila melihat kami mula berhenti untuk melihat senjata kami."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berani mendekat."
    },
    {
      "type": "paragraph",
      "text": "Ada yang terlalu berani."
    },
    {
      "type": "paragraph",
      "text": "Seorang pernah cuba menyentuh pedangku."
    },
    {
      "type": "paragraph",
      "text": "Aku menepuk tangannya."
    },
    {
      "type": "paragraph",
      "text": "Dia terus lari."
    },
    {
      "type": "paragraph",
      "text": "Miguel ketawa sampai terpaksa duduk."
    },
    {
      "type": "paragraph",
      "text": "“Budak itu berani.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia hampir kehilangan jari.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mula belajar beberapa perkataan dalam bahasa tempatan."
    },
    {
      "type": "paragraph",
      "text": "Tidak banyak."
    },
    {
      "type": "paragraph",
      "text": "Cukup untuk membeli makanan."
    },
    {
      "type": "paragraph",
      "text": "Cukup untuk bertanya arah."
    },
    {
      "type": "paragraph",
      "text": "Cukup untuk mengetahui apabila seseorang sedang memaki aku."
    },
    {
      "type": "paragraph",
      "text": "Itu sangat berguna."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ada seorang wanita yang mengajar aku lebih banyak daripada semua orang."
    },
    {
      "type": "paragraph",
      "text": "Namanya **Alya**."
    },
    {
      "type": "paragraph",
      "text": "Pada mulanya, kami hanya bertukar beberapa perkataan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian beberapa ayat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian perbualan."
    },
    {
      "type": "paragraph",
      "text": "Dan akhirnya, aku mula menunggu waktu aku akan melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah merancang perkara itu."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma sedar suatu hari bahawa apabila aku melalui pasar dan dia tidak ada, aku akan mencarinya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak suka hakikat itu."
    },
    {
      "type": "paragraph",
      "text": "Miguel sangat suka."
    },
    {
      "type": "paragraph",
      "text": "“Kau mencari seseorang?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau sudah melihat tempat yang sama tiga kali.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku mencari kedai.”"
    },
    {
      "type": "paragraph",
      "text": "“Kedai yang sama?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Yang menjual kain?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau mahu beli kain?”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tahu dia akan menyebut perkara itu selama bertahun-tahun."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hubungan kami tidak bermula dengan sesuatu yang besar."
    },
    {
      "type": "paragraph",
      "text": "Tiada muzik."
    },
    {
      "type": "paragraph",
      "text": "Tiada hujan."
    },
    {
      "type": "paragraph",
      "text": "Tiada aku menyelamatkannya daripada bahaya."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang kami cuma duduk."
    },
    {
      "type": "paragraph",
      "text": "Dia bercakap."
    },
    {
      "type": "paragraph",
      "text": "Aku cuba memahami."
    },
    {
      "type": "paragraph",
      "text": "Aku bercakap."
    },
    {
      "type": "paragraph",
      "text": "Dia cuba memahami."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang kami salah faham."
    },
    {
      "type": "paragraph",
      "text": "Banyak kali."
    },
    {
      "type": "paragraph",
      "text": "Suatu hari aku memberitahunya bahawa makanan Portugis lebih baik."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku seperti aku baru menghina keluarganya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk makanan di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menunjuk aku."
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia bangun dan pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Miguel."
    },
    {
      "type": "paragraph",
      "text": "“Apa aku buat?”"
    },
    {
      "type": "paragraph",
      "text": "Miguel sedang menahan ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Kau menghina makanan dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma berkata makanan Portugis lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Itulah masalahnya.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengejarnya."
    },
    {
      "type": "paragraph",
      "text": "“Alya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tidak berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Alya, tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "“Aku tarik balik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Makanan Melaka lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berpaling."
    },
    {
      "type": "paragraph",
      "text": "Masih marah."
    },
    {
      "type": "paragraph",
      "text": "Aku menambah,"
    },
    {
      "type": "paragraph",
      "text": "“Sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Dia akhirnya ketawa."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu aku sudah kalah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Aku mula mengenali keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Ayahnya seorang lelaki yang pendiam."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak pernah benar-benar mempercayai aku."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak menyalahkannya."
    },
    {
      "type": "paragraph",
      "text": "Aku ialah askar Portugis."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah datang ke kotanya dengan pedang."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah bertempur di jalan-jalannya."
    },
    {
      "type": "paragraph",
      "text": "Kalau aku mempunyai seorang anak perempuan, aku juga mungkin tidak suka melihat dia berkawan dengan lelaki seperti aku."
    },
    {
      "type": "paragraph",
      "text": "Ibunya lebih mudah didekati."
    },
    {
      "type": "paragraph",
      "text": "Dia sering memberiku makanan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah menolak."
    },
    {
      "type": "paragraph",
      "text": "Itulah cara aku memenangi hatinya."
    },
    {
      "type": "paragraph",
      "text": "Bukan dengan kata-kata."
    },
    {
      "type": "paragraph",
      "text": "Dengan makan."
    },
    {
      "type": "paragraph",
      "text": "Suatu malam, ketika aku sedang makan di rumah mereka, ayah Alya duduk di hadapanku."
    },
    {
      "type": "paragraph",
      "text": "Dia bercakap dalam bahasa tempatan."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Alya."
    },
    {
      "type": "paragraph",
      "text": "Dia menterjemahkan."
    },
    {
      "type": "paragraph",
      "text": "“Dia tanya apa niat kau.”"
    },
    {
      "type": "paragraph",
      "text": "Aku hampir tersedak."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Alya memandangku."
    },
    {
      "type": "paragraph",
      "text": "“Dia tanya niat kau terhadap aku.”"
    },
    {
      "type": "paragraph",
      "text": "Aku meletakkan makanan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah takut menghadapi lelaki dengan pedang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi seorang ayah yang bertanya soalan seperti itu?"
    },
    {
      "type": "paragraph",
      "text": "Itu berbeza."
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang Alya."
    },
    {
      "type": "paragraph",
      "text": "“Aku…”"
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu jawapannya."
    },
    {
      "type": "paragraph",
      "text": "Alya menunggu."
    },
    {
      "type": "paragraph",
      "text": "Aku akhirnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku mahu dia selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Alya menterjemahkan."
    },
    {
      "type": "paragraph",
      "text": "Ayahnya diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata sesuatu."
    },
    {
      "type": "paragraph",
      "text": "“Apa katanya?”"
    },
    {
      "type": "paragraph",
      "text": "Alya tersenyum sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Dia kata itu bukan jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengeluh."
    },
    {
      "type": "paragraph",
      "text": "“Aku patut lawan dia?”"
    },
    {
      "type": "paragraph",
      "text": "Alya ketawa."
    },
    {
      "type": "paragraph",
      "text": "Ayahnya tidak."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada tahun kedua, sesuatu berubah dalam hidup aku."
    },
    {
      "type": "paragraph",
      "text": "Aku mendapat tanggungjawab yang lebih besar."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana aku istimewa."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma sudah terlalu lama hidup dalam perang."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu cara membaca kawasan."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu cara mengawal sekumpulan askar."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu bagaimana orang bertindak apabila takut."
    },
    {
      "type": "paragraph",
      "text": "Dan yang paling penting—"
    },
    {
      "type": "paragraph",
      "text": "aku masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Dalam perang, kadang-kadang itu sudah cukup untuk membuat orang menganggap kau tahu apa yang kau lakukan."
    },
    {
      "type": "paragraph",
      "text": "Aku mula mengetuai kumpulan kecil."
    },
    {
      "type": "paragraph",
      "text": "Pada awalnya, hanya beberapa orang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian lebih ramai."
    },
    {
      "type": "paragraph",
      "text": "Miguel masih bersama aku."
    },
    {
      "type": "paragraph",
      "text": "Dia menjadi orang yang paling aku percayai."
    },
    {
      "type": "paragraph",
      "text": "Suatu hari, selepas satu rondaan, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kau sudah berubah.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagaimana?”"
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau ikut orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang orang ikut kau.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Itu masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku tersesat, semua orang akan ikut.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Itu memang masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Kami ketawa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi malam itu aku terfikir tentang kata-katanya."
    },
    {
      "type": "paragraph",
      "text": "Dulu aku hanya perlu menjaga diri sendiri."
    },
    {
      "type": "paragraph",
      "text": "Sekarang ada orang lain yang bergantung kepada aku."
    },
    {
      "type": "paragraph",
      "text": "Itu membuatkan pedang terasa lebih berat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Khabar tentang Sultan Mahmud masih datang dari semasa ke semasa."
    },
    {
      "type": "paragraph",
      "text": "Baginda masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Baginda masih mempunyai pengikut."
    },
    {
      "type": "paragraph",
      "text": "Baginda masih berusaha membina kekuatan."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang khabar itu tidak lebih daripada cerita pedagang."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang ia datang daripada orang yang pernah berkhidmat di bawah pemerintah lama."
    },
    {
      "type": "paragraph",
      "text": "Tetapi satu perkara semakin jelas."
    },
    {
      "type": "paragraph",
      "text": "Sultan belum melupakan Melaka."
    },
    {
      "type": "paragraph",
      "text": "Dan Melaka belum melupakan Sultan."
    },
    {
      "type": "paragraph",
      "text": "Aku mula memahami bahawa perang boleh berhenti tanpa benar-benar berakhir."
    },
    {
      "type": "paragraph",
      "text": "Ia cuma menunggu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada suatu petang, aku pulang ke rumah Alya."
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti di hadapan pintu."
    },
    {
      "type": "paragraph",
      "text": "Ada sesuatu yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Ayahnya sedang duduk di luar."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia memandang pedangku."
    },
    {
      "type": "paragraph",
      "text": "Aku menunggu."
    },
    {
      "type": "paragraph",
      "text": "Dia bangun."
    },
    {
      "type": "paragraph",
      "text": "Masuk ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Kemudian keluar semula membawa sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Sebilah pisau pendek."
    },
    {
      "type": "paragraph",
      "text": "Dia menghulurkannya kepadaku."
    },
    {
      "type": "paragraph",
      "text": "Aku terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Apa ini?”"
    },
    {
      "type": "paragraph",
      "text": "Alya keluar."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang ayahnya."
    },
    {
      "type": "paragraph",
      "text": "Dia berkata sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Alya menterjemahkan."
    },
    {
      "type": "paragraph",
      "text": "“Dia kata seorang lelaki yang mahu menjaga keluarganya mesti boleh menjaga dirinya sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat pisau itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Aku mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Itulah kali pertama dia memberiku sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana aku Portugis."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana aku askar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia mula melihat aku sebagai lelaki yang mungkin akan berada dalam kehidupan anaknya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah lupa hari itu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa bulan kemudian, aku berdiri di rumah yang sama."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini suasananya berbeza."
    },
    {
      "type": "paragraph",
      "text": "Alya berdiri di sebelah keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di hadapan mereka."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak akan menceritakan semuanya."
    },
    {
      "type": "paragraph",
      "text": "Tidak kerana aku tidak ingat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana ada perkara dalam hidup yang tidak perlu dijadikan cerita perang."
    },
    {
      "type": "paragraph",
      "text": "Cukuplah aku katakan—"
    },
    {
      "type": "paragraph",
      "text": "hari itu, aku berkahwin."
    },
    {
      "type": "paragraph",
      "text": "Dengan seorang wanita Melaka."
    },
    {
      "type": "paragraph",
      "text": "Seorang wanita yang pada hari pertama aku kenal, hampir tidak boleh bercakap dengan aku."
    },
    {
      "type": "paragraph",
      "text": "Dan yang beberapa tahun kemudian menjadi orang yang paling aku mahu dengar suaranya."
    },
    {
      "type": "paragraph",
      "text": "Aku masih orang Portugis."
    },
    {
      "type": "paragraph",
      "text": "Dia masih orang Melaka."
    },
    {
      "type": "paragraph",
      "text": "Dunia kami tidak berubah kerana perkahwinan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kehidupan kami berubah."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali sejak aku meninggalkan Portugal, aku mempunyai sesuatu yang boleh aku panggil rumah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rumah kami tidak besar."
    },
    {
      "type": "paragraph",
      "text": "Satu ruang utama."
    },
    {
      "type": "paragraph",
      "text": "Tempat memasak."
    },
    {
      "type": "paragraph",
      "text": "Tempat tidur."
    },
    {
      "type": "paragraph",
      "text": "Beberapa barang yang aku beli dari pelabuhan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa kain milik Alya."
    },
    {
      "type": "paragraph",
      "text": "Pedangku tergantung di dinding."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak suka melihatnya di situ."
    },
    {
      "type": "paragraph",
      "text": "“Aku perlu pedang.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau ada serangan?”"
    },
    {
      "type": "paragraph",
      "text": "“Letak di luar.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Di luar?”"
    },
    {
      "type": "paragraph",
      "text": "“Jauh daripada aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu pedang aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu rumah aku.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Rumah kita.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menang."
    },
    {
      "type": "paragraph",
      "text": "Atau mungkin dia sengaja membiarkan aku menang."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah tahu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa waktu kemudian, kami mendapat berita bahawa seorang anak akan lahir."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu bagaimana untuk bersedia menghadapi perang."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu bagaimana untuk membersihkan pedang."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu bagaimana untuk mengawal askar."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu bagaimana untuk membaca ancaman."
    },
    {
      "type": "paragraph",
      "text": "Tetapi aku tidak tahu bagaimana untuk menjadi seorang ayah."
    },
    {
      "type": "paragraph",
      "text": "Aku memberitahu Miguel."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Aku tidak tahu kenapa kau beritahu aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku perlukan nasihat.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau ada pengalaman?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Jadi diam.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu nasihat aku.”"
    },
    {
      "type": "paragraph",
      "text": "Aku ketawa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi apabila dia pergi, aku duduk lama di luar rumah."
    },
    {
      "type": "paragraph",
      "text": "Aku meletakkan tangan di atas perut Alya."
    },
    {
      "type": "paragraph",
      "text": "Ada kehidupan kecil di situ."
    },
    {
      "type": "paragraph",
      "text": "Seseorang yang belum pernah melihat Portugal."
    },
    {
      "type": "paragraph",
      "text": "Belum pernah melihat laut seperti aku."
    },
    {
      "type": "paragraph",
      "text": "Belum pernah mendengar bunyi meriam."
    },
    {
      "type": "paragraph",
      "text": "Belum pernah tahu apa itu perang."
    },
    {
      "type": "paragraph",
      "text": "Dan aku tiba-tiba berharap dia tidak perlu mengetahuinya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada suatu malam, aku terjaga kerana bunyi ketukan."
    },
    {
      "type": "paragraph",
      "text": "Tiga kali."
    },
    {
      "type": "paragraph",
      "text": "Tok."
    },
    {
      "type": "paragraph",
      "text": "Tok."
    },
    {
      "type": "paragraph",
      "text": "Tok."
    },
    {
      "type": "paragraph",
      "text": "Aku terus bangun."
    },
    {
      "type": "paragraph",
      "text": "Tangan mencari pedang."
    },
    {
      "type": "paragraph",
      "text": "Alya masih tidur."
    },
    {
      "type": "paragraph",
      "text": "Aku membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar berdiri di luar."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya serius."
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Braz mahu jumpa kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Aku melihat langit."
    },
    {
      "type": "paragraph",
      "text": "Masih gelap."
    },
    {
      "type": "paragraph",
      "text": "Aku mengambil pedang."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, aku menoleh kepada Alya."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah terjaga."
    },
    {
      "type": "paragraph",
      "text": "“Apa berlaku?”"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan kembali.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandangku."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Aku keluar."
    },
    {
      "type": "paragraph",
      "text": "Braz menunggu di hujung jalan."
    },
    {
      "type": "paragraph",
      "text": "Di tangannya ada satu surat."
    },
    {
      "type": "paragraph",
      "text": "Aku sudah tahu daripada wajahnya bahawa berita itu tidak baik."
    },
    {
      "type": "paragraph",
      "text": "“Dari mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Utara.”"
    },
    {
      "type": "paragraph",
      "text": "Aku mengambil surat itu."
    },
    {
      "type": "paragraph",
      "text": "Aku membacanya perlahan."
    },
    {
      "type": "paragraph",
      "text": "Tidak banyak yang aku faham."
    },
    {
      "type": "paragraph",
      "text": "Tetapi satu nama cukup."
    },
    {
      "type": "paragraph",
      "text": "**Sultan Mahmud Shah.**"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Braz."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang berlaku?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Orang-orang baginda semakin ramai.”"
    },
    {
      "type": "paragraph",
      "text": "Aku diam."
    },
    {
      "type": "paragraph",
      "text": "“Dan mereka bukan lagi sekadar mengumpulkan orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Braz memandang ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "“Mereka sedang bersiap untuk menyerang.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menggenggam surat itu."
    },
    {
      "type": "paragraph",
      "text": "Beberapa tahun lalu, aku berdiri di atas kapal menuju Melaka."
    },
    {
      "type": "paragraph",
      "text": "Aku takut kerana aku tidak tahu apa yang menunggu."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku berdiri di kota yang sama."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini berbeza."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu apa yang aku mahu lindungi."
    },
    {
      "type": "paragraph",
      "text": "Aku teringat rumah."
    },
    {
      "type": "paragraph",
      "text": "Alya."
    },
    {
      "type": "paragraph",
      "text": "Anak yang belum lahir."
    },
    {
      "type": "paragraph",
      "text": "Dan tiba-tiba aku faham sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Dulu, aku masuk perang dengan hanya satu kehidupan untuk dipertahankan."
    },
    {
      "type": "paragraph",
      "text": "Sekarang aku mempunyai tiga."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang langit yang masih gelap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku kembali berjalan pulang."
    },
    {
      "type": "paragraph",
      "text": "Kali ini, aku tidak bertanya bila perang akan datang."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu ia akan datang."
    },
    {
      "type": "paragraph",
      "text": "Soalannya cuma—"
    },
    {
      "type": "paragraph",
      "text": "**adakah Melaka akan mampu bertahan?**"
    }
  ]
}