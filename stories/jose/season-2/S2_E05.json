{
  "series": "Jose: Dari Portugal ke Melaka 1511",
  "season": 2,
  "episode": 5,
  "title": "KOTA YANG MENUNGGU",
  "language": "ms",
  "content": [
    {
      "type": "paragraph",
      "text": "Loceng berbunyi sebelum matahari naik tinggi."
    },
    {
      "type": "paragraph",
      "text": "Sekali."
    },
    {
      "type": "paragraph",
      "text": "Dua kali."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tanpa henti."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di atas tembok Melaka dan memandang ke laut."
    },
    {
      "type": "paragraph",
      "text": "Kali ini aku tidak perlu bertanya apa yang sedang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Aku sudah nampak."
    },
    {
      "type": "paragraph",
      "text": "Kapal."
    },
    {
      "type": "paragraph",
      "text": "Bukan lima."
    },
    {
      "type": "paragraph",
      "text": "Bukan sepuluh."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak untuk aku kira dari tempat aku berdiri."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu muncul dari balik ufuk, memenuhi garis laut seperti bayang-bayang hitam yang bergerak perlahan menuju kota."
    },
    {
      "type": "paragraph",
      "text": "Miguel berdiri di sebelah aku."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "Aku menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Jawapan yang sangat meyakinkan, Captain.”"
    },
    {
      "type": "paragraph",
      "text": "Aku hampir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Hampir."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku nampak anak kapal pertama mula menurunkan layar."
    },
    {
      "type": "paragraph",
      "text": "Dan aku tahu mereka bukan datang untuk berdagang."
    },
    {
      "type": "paragraph",
      "text": "“Panggil semua orang,” kataku."
    },
    {
      "type": "paragraph",
      "text": "Miguel terus bergerak."
    },
    {
      "type": "paragraph",
      "text": "Aku turun dari tembok dan berlari menuju kawasan pertahanan."
    },
    {
      "type": "paragraph",
      "text": "Di sepanjang jalan, orang-orang berlari membawa senjata. Ada yang membawa busur. Ada yang membawa tombak. Ada yang mengangkat tong serbuk. Ada yang masih memakai pakaian tidur."
    },
    {
      "type": "paragraph",
      "text": "Melaka baru bangun."
    },
    {
      "type": "paragraph",
      "text": "Tetapi perang sudah menunggu di hadapan pintunya."
    },
    {
      "type": "paragraph",
      "text": "Aku sampai di kawasan pertahanan timur."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang ke tempat masing-masing!”"
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang memandang aku."
    },
    {
      "type": "paragraph",
      "text": "Mereka tahu apa yang perlu dilakukan."
    },
    {
      "type": "paragraph",
      "text": "Itu perkara pertama yang aku pelajari tentang menjadi pemimpin."
    },
    {
      "type": "paragraph",
      "text": "Kau tidak perlu tahu semua jawapan."
    },
    {
      "type": "paragraph",
      "text": "Kau cuma perlu memastikan orang di sekeliling kau tahu apa yang perlu dilakukan seterusnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tembak sebelum aku beri arahan!”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat ke arah laut."
    },
    {
      "type": "paragraph",
      "text": "Kapal-kapal itu semakin dekat."
    },
    {
      "type": "paragraph",
      "text": "Di belakang aku, bunyi roda meriam ditarik kedudukan."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan aku, laut semakin penuh."
    },
    {
      "type": "paragraph",
      "text": "Dan di tengah semua itu, aku teringat rumah."
    },
    {
      "type": "paragraph",
      "text": "Alya."
    },
    {
      "type": "paragraph",
      "text": "Anak kami."
    },
    {
      "type": "paragraph",
      "text": "Aku memaksa diri berhenti berfikir tentang mereka."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana aku tidak sayang."
    },
    {
      "type": "paragraph",
      "text": "Justru kerana aku terlalu sayang."
    },
    {
      "type": "paragraph",
      "text": "Kalau aku membiarkan fikiran aku pergi kepada mereka sekarang, tangan aku mungkin tidak lagi mampu memegang pedang."
    },
    {
      "type": "paragraph",
      "text": "“Captain!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menoleh."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar menunjuk ke arah selatan."
    },
    {
      "type": "paragraph",
      "text": "Aku nampak beberapa kapal kecil bergerak menjauhi armada utama."
    },
    {
      "type": "paragraph",
      "text": "“Mereka berpecah,” katanya."
    },
    {
      "type": "paragraph",
      "text": "Aku mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk."
    },
    {
      "type": "paragraph",
      "text": "Aku melihat."
    },
    {
      "type": "paragraph",
      "text": "Satu kumpulan menuju ke arah sungai."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi bergerak ke bahagian selatan kota."
    },
    {
      "type": "paragraph",
      "text": "Aku diam beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Mereka tidak akan menyerang dari satu tempat."
    },
    {
      "type": "paragraph",
      "text": "Mereka mahu kita membahagikan pertahanan."
    },
    {
      "type": "paragraph",
      "text": "“Beritahu bahagian selatan supaya jangan bergerak tanpa arahan,” kataku."
    },
    {
      "type": "paragraph",
      "text": "“Ya, Captain!”"
    },
    {
      "type": "paragraph",
      "text": "Aku berpaling kepada Miguel."
    },
    {
      "type": "paragraph",
      "text": "“Bawa dua puluh orang ke sungai.”"
    },
    {
      "type": "paragraph",
      "text": "“Dua puluh?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau mereka cuba masuk dari sana, tahan mereka.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau mereka datang dengan lebih ramai?”"
    },
    {
      "type": "paragraph",
      "text": "Aku menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Jangan jadi wira.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang itu arahan yang aku suka.”"
    },
    {
      "type": "paragraph",
      "text": "Dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku kembali memandang laut."
    },
    {
      "type": "paragraph",
      "text": "Sebuah kapal besar berada paling hadapan."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu siapa yang berada di atasnya."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu siapa yang memberi arahan."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Mereka datang untuk mengambil Melaka."
    },
    {
      "type": "paragraph",
      "text": "Dan kali ini, aku tidak lagi berdiri di luar kota sebagai orang yang datang menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku berdiri di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Sebagai orang yang perlu mempertahankannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Letupan pertama menggegarkan udara."
    },
    {
      "type": "paragraph",
      "text": "BOOM!"
    },
    {
      "type": "paragraph",
      "text": "Meriam kami melepaskan tembakan."
    },
    {
      "type": "paragraph",
      "text": "Aku melihat asap putih berkembang di hadapan tembok."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "BOOM!"
    },
    {
      "type": "paragraph",
      "text": "Kapal di hadapan bergegar."
    },
    {
      "type": "paragraph",
      "text": "Orang-orang di atasnya berlari."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kapal itu terus bergerak."
    },
    {
      "type": "paragraph",
      "text": "“Teruskan!”"
    },
    {
      "type": "paragraph",
      "text": "Meriam kedua dilepaskan."
    },
    {
      "type": "paragraph",
      "text": "Ketiga."
    },
    {
      "type": "paragraph",
      "text": "Keempat."
    },
    {
      "type": "paragraph",
      "text": "Laut mula dipenuhi asap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian balasan datang."
    },
    {
      "type": "paragraph",
      "text": "Sesuatu melintas di atas kepala aku."
    },
    {
      "type": "paragraph",
      "text": "Aku sempat tunduk."
    },
    {
      "type": "paragraph",
      "text": "BOOM!"
    },
    {
      "type": "paragraph",
      "text": "Batu atau serpihan menghentam tembok tidak jauh dari tempat aku berdiri."
    },
    {
      "type": "paragraph",
      "text": "Debu memenuhi udara."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang jatuh."
    },
    {
      "type": "paragraph",
      "text": "“Berlindung!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menarik seorang askar yang masih terpinga-pinga."
    },
    {
      "type": "paragraph",
      "text": "“Bangun!”"
    },
    {
      "type": "paragraph",
      "text": "Dia bangun."
    },
    {
      "type": "paragraph",
      "text": "Matanya terbuka luas."
    },
    {
      "type": "paragraph",
      "text": "“Captain…”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan tengok aku. Tengok depan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu dia takut."
    },
    {
      "type": "paragraph",
      "text": "Aku juga takut."
    },
    {
      "type": "paragraph",
      "text": "Cuma aku sudah belajar menyembunyikannya."
    },
    {
      "type": "paragraph",
      "text": "Serangan pertama datang dari laut."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kemudian aku terdengar bunyi dari arah lain."
    },
    {
      "type": "paragraph",
      "text": "Jeritan."
    },
    {
      "type": "paragraph",
      "text": "Aku berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Timur!”"
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang berlari menuju kami."
    },
    {
      "type": "paragraph",
      "text": "“Mereka mendarat!”"
    },
    {
      "type": "paragraph",
      "text": "Aku terus turun dari tembok."
    },
    {
      "type": "paragraph",
      "text": "“Berapa ramai?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu!”"
    },
    {
      "type": "paragraph",
      "text": "Jawapan itu sudah cukup."
    },
    {
      "type": "paragraph",
      "text": "Aku berlari."
    },
    {
      "type": "paragraph",
      "text": "Miguel muncul dari arah bertentangan."
    },
    {
      "type": "paragraph",
      "text": "“Mereka juga cuba masuk dari sungai!”"
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, aku hanya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku faham."
    },
    {
      "type": "paragraph",
      "text": "Ini bukan serangan biasa."
    },
    {
      "type": "paragraph",
      "text": "Mereka mahu kita melihat laut."
    },
    {
      "type": "paragraph",
      "text": "Sementara orang lain masuk melalui tempat yang kita abaikan."
    },
    {
      "type": "paragraph",
      "text": "“Bawa separuh orang ke sungai.”"
    },
    {
      "type": "paragraph",
      "text": "Miguel mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan kau?”"
    },
    {
      "type": "paragraph",
      "text": "Aku melihat ke arah timur."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahan yang ini.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menepuk bahu aku."
    },
    {
      "type": "paragraph",
      "text": "“Jangan mati.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum nipis."
    },
    {
      "type": "paragraph",
      "text": "“Kau pun.”"
    },
    {
      "type": "paragraph",
      "text": "Kami berpisah."
    },
    {
      "type": "paragraph",
      "text": "Aku berlari ke arah timur."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Aku tidak pernah lupa bunyi orang berlari ketika mereka tahu musuh sudah berada di dalam kota."
    },
    {
      "type": "paragraph",
      "text": "Tapak kaki."
    },
    {
      "type": "paragraph",
      "text": "Jeritan."
    },
    {
      "type": "paragraph",
      "text": "Arahan yang bertindih."
    },
    {
      "type": "paragraph",
      "text": "Bunyi besi."
    },
    {
      "type": "paragraph",
      "text": "Bunyi kayu pecah."
    },
    {
      "type": "paragraph",
      "text": "Bau asap."
    },
    {
      "type": "paragraph",
      "text": "Dan bau darah."
    },
    {
      "type": "paragraph",
      "text": "Aku sampai di sebuah jalan sempit dan melihat mereka."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang sudah berada di dalam."
    },
    {
      "type": "paragraph",
      "text": "Mereka bergerak pantas."
    },
    {
      "type": "paragraph",
      "text": "Tidak seperti pasukan besar."
    },
    {
      "type": "paragraph",
      "text": "Mereka seperti orang yang tahu tepat ke mana mereka mahu pergi."
    },
    {
      "type": "paragraph",
      "text": "Aku mengangkat pedang."
    },
    {
      "type": "paragraph",
      "text": "“Jangan biarkan mereka masuk lebih jauh!”"
    },
    {
      "type": "paragraph",
      "text": "Kami menyerang."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu berapa lama pertempuran itu berlangsung."
    },
    {
      "type": "paragraph",
      "text": "Mungkin sepuluh minit."
    },
    {
      "type": "paragraph",
      "text": "Mungkin setengah jam."
    },
    {
      "type": "paragraph",
      "text": "Dalam perang, masa tidak bergerak seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang satu minit terasa seperti sejam."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang satu jam hilang tanpa kau sedar."
    },
    {
      "type": "paragraph",
      "text": "Aku hanya ingat satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki datang ke arah aku."
    },
    {
      "type": "paragraph",
      "text": "Aku menangkis."
    },
    {
      "type": "paragraph",
      "text": "Dia menyerang lagi."
    },
    {
      "type": "paragraph",
      "text": "Aku menunduk."
    },
    {
      "type": "paragraph",
      "text": "Pedangnya hampir mengenai kepala aku."
    },
    {
      "type": "paragraph",
      "text": "Aku menikam."
    },
    {
      "type": "paragraph",
      "text": "Dia jatuh."
    },
    {
      "type": "paragraph",
      "text": "Aku menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian orang lain muncul."
    },
    {
      "type": "paragraph",
      "text": "Aku menyerang."
    },
    {
      "type": "paragraph",
      "text": "Menangkis."
    },
    {
      "type": "paragraph",
      "text": "Berundur."
    },
    {
      "type": "paragraph",
      "text": "Maju."
    },
    {
      "type": "paragraph",
      "text": "Jerit."
    },
    {
      "type": "paragraph",
      "text": "Bernafas."
    },
    {
      "type": "paragraph",
      "text": "Ulang."
    },
    {
      "type": "paragraph",
      "text": "Sampai akhirnya mereka berundur."
    },
    {
      "type": "paragraph",
      "text": "“Jangan kejar!”"
    },
    {
      "type": "paragraph",
      "text": "Aku menjerit kepada orang-orang aku."
    },
    {
      "type": "paragraph",
      "text": "Mereka berhenti."
    },
    {
      "type": "paragraph",
      "text": "Aku pernah belajar satu perkara daripada medan perang."
    },
    {
      "type": "paragraph",
      "text": "Musuh yang melarikan diri tidak semestinya kalah."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang mereka cuma mahu kau mengejar mereka ke tempat yang mereka sudah pilih."
    },
    {
      "type": "paragraph",
      "text": "Aku melihat jalan di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Terlalu kosong."
    },
    {
      "type": "paragraph",
      "text": "“Captain!”"
    },
    {
      "type": "paragraph",
      "text": "Aku berpaling."
    },
    {
      "type": "paragraph",
      "text": "Seorang askar datang berlari."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka berjaya masuk di bahagian selatan.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menutup mata sekejap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku buka semula."
    },
    {
      "type": "paragraph",
      "text": "“Berapa jauh?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Pergi ke tembok. Dapatkan berita.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berlari."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang orang-orang aku."
    },
    {
      "type": "paragraph",
      "text": "Mereka menunggu arahan."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu mereka sedang melihat aku seperti aku mempunyai jawapan."
    },
    {
      "type": "paragraph",
      "text": "Hakikatnya aku tidak."
    },
    {
      "type": "paragraph",
      "text": "Aku cuma tidak boleh membiarkan mereka tahu."
    },
    {
      "type": "paragraph",
      "text": "“Bersedia,” kataku."
    },
    {
      "type": "paragraph",
      "text": "Kami bergerak semula."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Menjelang tengah hari, Melaka sudah berubah."
    },
    {
      "type": "paragraph",
      "text": "Jalan yang biasanya dipenuhi manusia kini dipenuhi serpihan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa kedai ditutup."
    },
    {
      "type": "paragraph",
      "text": "Orang awam bersembunyi."
    },
    {
      "type": "paragraph",
      "text": "Asap naik dari beberapa tempat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi yang paling menakutkan bukan apa yang aku nampak."
    },
    {
      "type": "paragraph",
      "text": "Ia adalah apa yang aku tidak nampak."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu berapa ramai musuh yang sudah masuk."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu di mana Miguel berada."
    },
    {
      "type": "paragraph",
      "text": "Aku tidak tahu sama ada keluarga aku selamat."
    },
    {
      "type": "paragraph",
      "text": "Dan aku tidak tahu sama ada kami masih mengawal kota ini."
    },
    {
      "type": "paragraph",
      "text": "Aku akhirnya sampai berhampiran rumah."
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Pintu rumah kami terbuka."
    },
    {
      "type": "paragraph",
      "text": "Jantung aku seperti berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Alya?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada jawapan."
    },
    {
      "type": "paragraph",
      "text": "Aku berlari masuk."
    },
    {
      "type": "paragraph",
      "text": "“Alya!”"
    },
    {
      "type": "paragraph",
      "text": "Aku terdengar suara dari belakang."
    },
    {
      "type": "paragraph",
      "text": "“Jose!”"
    },
    {
      "type": "paragraph",
      "text": "Aku berpaling."
    },
    {
      "type": "paragraph",
      "text": "Alya berdiri di lorong."
    },
    {
      "type": "paragraph",
      "text": "Anak kami berada dalam pelukannya."
    },
    {
      "type": "paragraph",
      "text": "Aku hampir tidak mampu berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Aku berjalan kepada mereka."
    },
    {
      "type": "paragraph",
      "text": "Aku menyentuh kepala anak kami."
    },
    {
      "type": "paragraph",
      "text": "Kemudian wajah Alya."
    },
    {
      "type": "paragraph",
      "text": "“Kamu selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Alya memandang aku."
    },
    {
      "type": "paragraph",
      "text": "“Sudah tentu.”"
    },
    {
      "type": "paragraph",
      "text": "Aku menghela nafas panjang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jose…”"
    },
    {
      "type": "paragraph",
      "text": "Aku tahu daripada wajahnya bahawa ada sesuatu yang tidak kena."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah luar."
    },
    {
      "type": "paragraph",
      "text": "“Ada orang datang tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Aku terus memegang pedang."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Alya menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa orang?”"
    },
    {
      "type": "paragraph",
      "text": "“Ramai.”"
    },
    {
      "type": "paragraph",
      "text": "Aku memandang pintu."
    },
    {
      "type": "paragraph",
      "text": "“Ke mana mereka pergi?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah jalan utama."
    },
    {
      "type": "paragraph",
      "text": "“Mereka menuju ke pusat kota.”"
    },
    {
      "type": "paragraph",
      "text": "Aku terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian aku mendengar bunyi loceng."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini bukan dari tembok."
    },
    {
      "type": "paragraph",
      "text": "Dari pusat Melaka."
    },
    {
      "type": "paragraph",
      "text": "Satu."
    },
    {
      "type": "paragraph",
      "text": "Dua."
    },
    {
      "type": "paragraph",
      "text": "Tiga."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bunyi jeritan."
    },
    {
      "type": "paragraph",
      "text": "Aku memandang Alya."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang aku."
    },
    {
      "type": "paragraph",
      "text": "Aku tahu apa yang perlu aku lakukan."
    },
    {
      "type": "paragraph",
      "text": "Aku mencium dahi anak kami."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan kembali.”"
    },
    {
      "type": "paragraph",
      "text": "Alya memegang tangan aku."
    },
    {
      "type": "paragraph",
      "text": "“Jose.”"
    },
    {
      "type": "paragraph",
      "text": "Aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cuba jadi wira.”"
    },
    {
      "type": "paragraph",
      "text": "Aku tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak pernah pandai jadi wira.”"
    },
    {
      "type": "paragraph",
      "text": "Aku keluar."
    },
    {
      "type": "paragraph",
      "text": "Dan ketika aku sampai di jalan, aku nampak sesuatu yang membuatkan aku berhenti."
    },
    {
      "type": "paragraph",
      "text": "Di hujung jalan, orang-orang aku sedang berlari ke arah aku."
    },
    {
      "type": "paragraph",
      "text": "Tetapi mereka bukan datang untuk menyerang."
    },
    {
      "type": "paragraph",
      "text": "Mereka sedang melarikan diri."
    },
    {
      "type": "paragraph",
      "text": "Di belakang mereka—"
    },
    {
      "type": "paragraph",
      "text": "aku nampak asap."
    },
    {
      "type": "paragraph",
      "text": "Banyak asap."
    },
    {
      "type": "paragraph",
      "text": "Dan di tengah asap itu, muncul satu barisan tentera yang panjang."
    },
    {
      "type": "paragraph",
      "text": "Bukan beberapa orang."
    },
    {
      "type": "paragraph",
      "text": "Bukan puluhan."
    },
    {
      "type": "paragraph",
      "text": "Ratusan."
    },
    {
      "type": "paragraph",
      "text": "Aku menggenggam pedang."
    },
    {
      "type": "paragraph",
      "text": "Hari itu baru bermula."
    },
    {
      "type": "paragraph",
      "text": "Dan aku tiba-tiba sedar—"
    },
    {
      "type": "paragraph",
      "text": "serangan tadi bukan untuk menawan tembok."
    },
    {
      "type": "paragraph",
      "text": "Mereka mahu membuka jalan."
    },
    {
      "type": "paragraph",
      "text": "Dan sekarang…"
    },
    {
      "type": "paragraph",
      "text": "**mereka sudah berada di dalam Melaka.**"
    }
  ]
}