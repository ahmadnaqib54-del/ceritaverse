{
  "series": "Separuh Hayat",
  "season": 5,
  "episode": 1,
  "title": "S5 E1",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 1\n## COLLAPSE"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6:12 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah berada di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Tiada sesiapa memanggilnya."
    },
    {
      "type": "paragraph",
      "text": "Tiada mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Tiada kecemasan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tetap datang."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tidur malam tadi."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja terdapat tiga fail."
    },
    {
      "type": "paragraph",
      "text": "Satu daripada Maya."
    },
    {
      "type": "paragraph",
      "text": "Satu daripada Adam."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi tanpa nama."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail pertama."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat yang selama ini kelihatan stabil mula menghadapi masalah."
    },
    {
      "type": "paragraph",
      "text": "Satu pelabur menarik diri."
    },
    {
      "type": "paragraph",
      "text": "Satu kontrak dibatalkan."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi syarikat menerima notis rasmi."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca semuanya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka fail kedua."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Beberapa maklumat lama."
    },
    {
      "type": "paragraph",
      "text": "Project Hayat."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Daniel Voss."
    },
    {
      "type": "paragraph",
      "text": "Rizal masih belum faham keseluruhan gambar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi satu perkara sudah jelas."
    },
    {
      "type": "paragraph",
      "text": "Empayarnya tidak lagi bergerak mengikut kehendaknya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 7:03."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Datang.”"
    },
    {
      "type": "paragraph",
      "text": "Empat puluh minit kemudian, Maya masuk."
    },
    {
      "type": "paragraph",
      "text": "Dia membawa satu fail tebal."
    },
    {
      "type": "paragraph",
      "text": "“Saya rasa kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum hambar."
    },
    {
      "type": "paragraph",
      "text": "“Kau selalu cakap macam itu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kali ini serius.”"
    },
    {
      "type": "paragraph",
      "text": "Maya meletakkan fail."
    },
    {
      "type": "paragraph",
      "text": "“Beberapa pihak luar sudah mula bertanya tentang struktur kumpulan.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Pelabur. Bank. Rakan kongsi.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab orang mula nampak apa yang saya nampak.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Struktur ini terlalu besar untuk bergerak tanpa seseorang di belakangnya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Maya membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Dan mereka mula bertanya siapa sebenarnya pemilik kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Nama aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Secara rasmi.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan secara tidak rasmi?”"
    },
    {
      "type": "paragraph",
      "text": "Maya menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Itulah masalahnya.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada pukul 8:20, telefon Rizal berbunyi lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini salah seorang pengurus."
    },
    {
      "type": "paragraph",
      "text": "“Bos, kita ada masalah di pusat operasi.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa pekerja tak datang.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk ganggu operasi.”"
    },
    {
      "type": "paragraph",
      "text": "“Ganti.”"
    },
    {
      "type": "paragraph",
      "text": "“Kami cuba.”"
    },
    {
      "type": "paragraph",
      "text": "“Cuba lagi.”"
    },
    {
      "type": "paragraph",
      "text": "“Bos…”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang biasanya datang untuk ganti pun tak mahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tahu."
    },
    {
      "type": "paragraph",
      "text": "Ketakutan."
    },
    {
      "type": "paragraph",
      "text": "Bila orang mula rasa kapal sedang tenggelam, mereka tidak tunggu kapten."
    },
    {
      "type": "paragraph",
      "text": "Mereka cari sekoci."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 9:45."
    },
    {
      "type": "paragraph",
      "text": "Ah Len muncul."
    },
    {
      "type": "paragraph",
      "text": "Tidak seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Tiada senyum."
    },
    {
      "type": "paragraph",
      "text": "Tiada gurauan."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke pejabat dan terus duduk."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang lama sedang tarik diri.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ramai.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Takut.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Takut apa?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Nama kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dulu bila orang dengar nama kau, mereka fikir duit.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang mereka fikir polis.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang mula?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Kalau Khalid yang buat, kita dah tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Itu yang aku tak suka.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Rizal menerima satu lagi berita."
    },
    {
      "type": "paragraph",
      "text": "Salah satu syarikatnya sedang disiasat."
    },
    {
      "type": "paragraph",
      "text": "Belum ada pertuduhan."
    },
    {
      "type": "paragraph",
      "text": "Belum ada tangkapan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi nama Rizal sudah muncul dalam pertanyaan."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca laporan itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menutupnya."
    },
    {
      "type": "paragraph",
      "text": "Telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat nama itu lama."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Aku okay.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tipu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Aku nampak berita.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum ada apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan itu yang aku tanya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih buat semua ini?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat fail di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Aku sedang cuba selesaikan.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tak faham.”"
    },
    {
      "type": "paragraph",
      "text": "Linda berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Semua yang kau cuba selesaikan sekarang bermula kerana kau tak pernah berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan datang kepada kami.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Aku bukan cakap sebab aku benci kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku tak mahu Roy nampak kau dibawa pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Talian tamat."
    },
    {
      "type": "paragraph",
      "text": "Rizal masih memegang telefon."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal pergi menemui Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu jawapan."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik sedang duduk di taman kecil."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "Seolah-olah dunia tidak sedang runtuh."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Empayar aku sedang runtuh.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana empayar selalu runtuh dengan cara yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "“Orang?”"
    },
    {
      "type": "paragraph",
      "text": "“Kepercayaan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Bila orang tidak lagi percaya sistem akan melindungi mereka, mereka mula melindungi diri sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kau tahu ini akan berlaku?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tak beritahu aku?”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau takkan dengar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Itu benar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin gelap."
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Adam masih tiada."
    },
    {
      "type": "paragraph",
      "text": "Farid juga tidak muncul."
    },
    {
      "type": "paragraph",
      "text": "Maya sudah pulang."
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak menjawab telefon."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka sistem dalaman."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Nama."
    },
    {
      "type": "paragraph",
      "text": "Akaun."
    },
    {
      "type": "paragraph",
      "text": "Operasi."
    },
    {
      "type": "paragraph",
      "text": "Syarikat."
    },
    {
      "type": "paragraph",
      "text": "Hubungan."
    },
    {
      "type": "paragraph",
      "text": "Semuanya kelihatan seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu sesuatu telah berubah."
    },
    {
      "type": "paragraph",
      "text": "Sistem itu masih bergerak."
    },
    {
      "type": "paragraph",
      "text": "Cuma bukan untuknya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 11:14 malam."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**KAU KEHILANGAN SATU.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak faham."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua."
    },
    {
      "type": "paragraph",
      "text": "**SEKARANG DUA.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian gambar."
    },
    {
      "type": "paragraph",
      "text": "Salah seorang pengurusnya sedang bercakap dengan seorang pegawai."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang gambar itu."
    },
    {
      "type": "paragraph",
      "text": "Mesej ketiga:"
    },
    {
      "type": "paragraph",
      "text": "**TIGA.**"
    },
    {
      "type": "paragraph",
      "text": "Gambar lain."
    },
    {
      "type": "paragraph",
      "text": "Satu fail diserahkan kepada pihak berkuasa."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula faham."
    },
    {
      "type": "paragraph",
      "text": "Mereka bukan sekadar memerhatikannya."
    },
    {
      "type": "paragraph",
      "text": "Mereka sedang memecahkan sistemnya satu bahagian demi satu."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi lagi."
    },
    {
      "type": "paragraph",
      "text": "**EMPAT.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Mesej terakhir masuk."
    },
    {
      "type": "paragraph",
      "text": "**KAU TAK PERLU JATUH SEKALI.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**KAMI CUMA PERLU BUAT SEMUA ORANG BERHENTI BERPEGANG PADA KAU.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, berita mula keluar."
    },
    {
      "type": "paragraph",
      "text": "Seorang individu yang pernah bekerja dengan rangkaian Rizal ditahan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seorang lagi."
    },
    {
      "type": "paragraph",
      "text": "Nama sebuah syarikat disebut."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Media mula mengaitkan beberapa perniagaan dengan satu rangkaian yang lebih besar."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat televisyen tanpa suara."
    },
    {
      "type": "paragraph",
      "text": "Paparan wajahnya muncul."
    },
    {
      "type": "paragraph",
      "text": "**BEKAS GURU JADI TAUKE PERNIAGAAN DISIASAT.**"
    },
    {
      "type": "paragraph",
      "text": "Dia mematikan televisyen."
    },
    {
      "type": "paragraph",
      "text": "Telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya dah buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kau takut?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Jawapan itu jujur."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak mahu berakhir macam orang lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk walaupun Maya tidak dapat melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak marah?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat sekeliling pejabat."
    },
    {
      "type": "paragraph",
      "text": "Kerusi kosong."
    },
    {
      "type": "paragraph",
      "text": "Meja kosong."
    },
    {
      "type": "paragraph",
      "text": "Fail bertimbun."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak boleh paksa orang tinggal dalam kapal yang tenggelam.”"
    },
    {
      "type": "paragraph",
      "text": "Maya terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Rizal…”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya harap awak masih boleh keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Talian tamat."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, Ah Len akhirnya menelefon."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang aku dah tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh bina semula.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan macam dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dulu kita takut orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita takut satu sama lain.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi kerusi kosong."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Farid datang."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di pintu."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak cakap sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak serah diri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus bangun."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku dah buat terlalu banyak.”"
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku bunuh Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan bos lindungi aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya tak mahu bos terus rosak kerana saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mendekat."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau menyerah sekarang, semua orang akan tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Memang patut tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Linda akan tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia dah tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Roy?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat keputusan kerana rasa bersalah.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Bos pernah ajar saya bahawa semua keputusan ada harga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya nak bayar.”"
    },
    {
      "type": "paragraph",
      "text": "Farid berpaling."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya tak kembali…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Farid menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih sebab pernah percaya saya.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mengejar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal duduk di meja lamanya."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada satu kertas."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**EMPIRE**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu garisan melintasinya."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**FAMILY**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "**MONEY**"
    },
    {
      "type": "paragraph",
      "text": "Garisan."
    },
    {
      "type": "paragraph",
      "text": "**POWER**"
    },
    {
      "type": "paragraph",
      "text": "Garisan."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menulis satu perkataan."
    },
    {
      "type": "paragraph",
      "text": "**WHY?**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Jawapannya dulu mudah."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Kemudian duit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian keselamatan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kuasa."
    },
    {
      "type": "paragraph",
      "text": "Sekarang?"
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "Tiada suara."
    },
    {
      "type": "paragraph",
      "text": "Kemudian sebuah rakaman dimainkan."
    },
    {
      "type": "paragraph",
      "text": "Suara lelaki yang tidak dikenalinya."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kau mencari siapa yang membuka pintu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia terus berdiri."
    },
    {
      "type": "paragraph",
      "text": "Suara itu menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cari lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggenggam telefon."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana kau sudah tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "“Kau cuma belum mahu mengaku.”"
    },
    {
      "type": "paragraph",
      "text": "Rakaman tamat."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Satu fail dihantar."
    },
    {
      "type": "paragraph",
      "text": "Nama fail:"
    },
    {
      "type": "paragraph",
      "text": "**OPERASI RIZAL — EVIDENCE PACKAGE 01**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya terdapat senarai nama."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Dan akhirnya—"
    },
    {
      "type": "paragraph",
      "text": "**RIZAL.**"
    },
    {
      "type": "paragraph",
      "text": "Di bawah semua nama itu terdapat satu ayat:"
    },
    {
      "type": "paragraph",
      "text": "**“SUBJEK SUDAH TERASING DARIPADA SISTEM.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej terakhir muncul."
    },
    {
      "type": "paragraph",
      "text": "**“SEKARANG KITA TUNGGU DIA JATUH.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat pejabat yang selama ini dipenuhi manusia."
    },
    {
      "type": "paragraph",
      "text": "Kini kosong."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali dalam bertahun-tahun—"
    },
    {
      "type": "paragraph",
      "text": "Rizal benar-benar bersendirian."
    },
    {
      "type": "paragraph",
      "text": "Dan di luar sana, dunia sedang bergerak untuk mengambil segala-galanya daripadanya."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 1**"
    }
  ],
