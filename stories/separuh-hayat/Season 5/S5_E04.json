  "title": "S5 E4",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 4\n## DECISION"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun sebelum subuh."
    },
    {
      "type": "paragraph",
      "text": "Sudah lama dia tidak bangun tanpa alarm."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia bangun kerana sekolah."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kerana kilang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kerana empayar."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia bangun kerana tidak boleh tidur."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan ke dapur."
    },
    {
      "type": "paragraph",
      "text": "Membuat kopi."
    },
    {
      "type": "paragraph",
      "text": "Satu cawan."
    },
    {
      "type": "paragraph",
      "text": "Duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Rumah itu masih sama."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak lagi terasa seperti rumah."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada satu gambar keluarga."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Bayi."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil gambar itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Mesej daripada peguam."
    },
    {
      "type": "paragraph",
      "text": "**ADAM SUDAH MEMBERI KENYATAAN.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua:"
    },
    {
      "type": "paragraph",
      "text": "**KES TERHADAP ANDA SEMAKIN KUAT.**"
    },
    {
      "type": "paragraph",
      "text": "Dia letakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengambil satu keputusan."
    },
    {
      "type": "paragraph",
      "text": "Hari ini dia akan berhenti."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana sudah hampir kosong."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat ruang yang pernah menjadi pusat empayarnya."
    },
    {
      "type": "paragraph",
      "text": "Beberapa meja kosong."
    },
    {
      "type": "paragraph",
      "text": "Fail sudah berkurangan."
    },
    {
      "type": "paragraph",
      "text": "Telefon tidak lagi berdering setiap lima minit."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan ke bilik kawalan."
    },
    {
      "type": "paragraph",
      "text": "Sistem masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Skrin masih menyala."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak banyak aktiviti."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di tengah-tengah bilik."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Matikan.”"
    },
    {
      "type": "paragraph",
      "text": "Penyelia yang masih ada memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bos?”"
    },
    {
      "type": "paragraph",
      "text": "“Matikan apa yang boleh dimatikan.”"
    },
    {
      "type": "paragraph",
      "text": "“Semua?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Semua.”"
    },
    {
      "type": "paragraph",
      "text": "Penyelia teragak-agak."
    },
    {
      "type": "paragraph",
      "text": "“Kalau operasi berhenti…”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak orang akan rugi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Lebih baik rugi sekarang daripada hilang semuanya kemudian.”"
    },
    {
      "type": "paragraph",
      "text": "Penyelia itu akhirnya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu sistem mula dihentikan."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat skrin menjadi kosong."
    },
    {
      "type": "paragraph",
      "text": "Empayar yang mengambil bertahun-tahun untuk dibina—"
    },
    {
      "type": "paragraph",
      "text": "mati dalam beberapa minit."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Adam menerima berita itu melalui peguam."
    },
    {
      "type": "paragraph",
      "text": "“Rizal berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Awak terkejut?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya kenal dia.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Awak masih cuba melindungi dia?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang meja."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma mahu dia berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Rizal pergi ke rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak masuk."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya berdiri di luar pagar."
    },
    {
      "type": "paragraph",
      "text": "Linda keluar selepas beberapa minit."
    },
    {
      "type": "paragraph",
      "text": "Mereka berdiri berjauhan."
    },
    {
      "type": "paragraph",
      "text": "“Aku datang nak cakap sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda diam."
    },
    {
      "type": "paragraph",
      "text": "“Aku dah hentikan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Operasi.”"
    },
    {
      "type": "paragraph",
      "text": "Diam."
    },
    {
      "type": "paragraph",
      "text": "“Syarikat yang aku boleh hentikan.”"
    },
    {
      "type": "paragraph",
      "text": "Masih diam."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan lepaskan apa yang aku boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku dah faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada jumlah wang yang cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Aku fikir kalau aku bina cukup besar, kamu semua akan selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda akhirnya bersuara."
    },
    {
      "type": "paragraph",
      "text": "“Dan sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku tahu…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“…aku yang buat kamu tak selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Satu perkataan."
    },
    {
      "type": "paragraph",
      "text": "Tidak marah."
    },
    {
      "type": "paragraph",
      "text": "Tidak tinggi."
    },
    {
      "type": "paragraph",
      "text": "Tetapi lebih sakit daripada jeritan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Roy keluar."
    },
    {
      "type": "paragraph",
      "text": "“Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berpaling."
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Ayah datang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berlutut di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandang wajah ayahnya."
    },
    {
      "type": "paragraph",
      "text": "“Ayah sedih?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal cuba tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak benda Ayah buat salah.”"
    },
    {
      "type": "paragraph",
      "text": "Roy diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi Ayah nak berhenti?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya nak Ayah balik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "“Ayah pun nak balik.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi baliklah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mampu menjawab."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pergi berjumpa Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "“Aku dah berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan kata kau dah tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku memang tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Boleh kau sekali saja cakap sesuatu yang aku tak tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku berhenti, semuanya selesai?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab akibat tidak berhenti apabila manusia berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Orang sudah terluka.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Orang sudah mati.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang lantai."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Adam?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "“Belum?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya itu.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Masih ada satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Masalah terbesar bukan empayar kau.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Masalah terbesar ialah kau masih fikir kau boleh keluar tanpa membayar harga.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, pihak berkuasa mula mengesan beberapa perubahan."
    },
    {
      "type": "paragraph",
      "text": "Aktiviti menurun."
    },
    {
      "type": "paragraph",
      "text": "Beberapa operasi berhenti."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat ditutup."
    },
    {
      "type": "paragraph",
      "text": "Mereka sedar Rizal sedang mengurangkan rangkaiannya."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Dia sedang bersihkan jejak.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai lain menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Atau dia menyerah.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka memandang fail."
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat kesimpulan.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal pergi ke pejabat terakhir yang masih digunakan."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil beberapa barang."
    },
    {
      "type": "paragraph",
      "text": "Gambar Roy."
    },
    {
      "type": "paragraph",
      "text": "Jam lama."
    },
    {
      "type": "paragraph",
      "text": "Satu buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Dan sebuah buku nota."
    },
    {
      "type": "paragraph",
      "text": "Buku yang sama dia gunakan ketika mula mengira sasaran RM500,000."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka halaman pertama."
    },
    {
      "type": "paragraph",
      "text": "**RM500,000**"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat angka itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Dulu jumlah itu kelihatan besar."
    },
    {
      "type": "paragraph",
      "text": "Sekarang—"
    },
    {
      "type": "paragraph",
      "text": "ia kelihatan bodoh."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**BERAPA HARGA SEBENAR?**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian menutup buku."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, telefon Rizal berdering."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau okay?”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Aku dalam tahanan. Tak tahu sama ada perkataan okay sesuai.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Aku dah hentikan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam mana kau tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Berita bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak jumpa kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau datang, mereka akan fikir kau cuba mempengaruhi aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Adam…”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku takkan jatuhkan kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Tapi aku juga takkan tipu untuk kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak minta.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kau serius?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas lega."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian Adam berkata sesuatu yang membuatkan Rizal kembali serius."
    },
    {
      "type": "paragraph",
      "text": "“Ada satu perkara yang kau perlu tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang kita cari…”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…mereka sudah tahu kau mahu berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Dan mereka tak suka.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal kembali ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Rumah kosong."
    },
    {
      "type": "paragraph",
      "text": "Dia menyalakan lampu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian terdengar bunyi telefon."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**BERHENTI?**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua:"
    },
    {
      "type": "paragraph",
      "text": "**TERLAMBAT.**"
    },
    {
      "type": "paragraph",
      "text": "Mesej ketiga:"
    },
    {
      "type": "paragraph",
      "text": "**KAU BOLEH BERHENTI MEMBUAT PRODUK.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**KAU BOLEH BERHENTI MEMBINA SYARIKAT.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**KAU BOLEH BERHENTI MENJADI RAJA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Mesej terakhir muncul."
    },
    {
      "type": "paragraph",
      "text": "**TAPI KAU TAK BOLEH BERHENTI MENJADI SAKSI.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "Telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau dah faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa aku cuba suruh kau keluar dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kau fikir musuh kau mahu empayar.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid menjawab perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Mereka mahu kau hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk kau ceritakan apa yang kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di tengah ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang gambar keluarga."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Kemudian jam pemberian Roy."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah berhenti."
    },
    {
      "type": "paragraph",
      "text": "Tetapi rupanya itu tidak cukup."
    },
    {
      "type": "paragraph",
      "text": "Seseorang mahu dia bercakap."
    },
    {
      "type": "paragraph",
      "text": "Seseorang mahu dia diam."
    },
    {
      "type": "paragraph",
      "text": "Dan seseorang mungkin mahu dia mati sebelum sempat melakukan kedua-duanya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya, Rizal menerima satu dokumen daripada peguam."
    },
    {
      "type": "paragraph",
      "text": "**WARAN TANGKAP.**"
    },
    {
      "type": "paragraph",
      "text": "Dia membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian duduk."
    },
    {
      "type": "paragraph",
      "text": "Tidak lari."
    },
    {
      "type": "paragraph",
      "text": "Tidak panik."
    },
    {
      "type": "paragraph",
      "text": "Hanya menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "Peguam menelefon."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Pihak berkuasa sedang mencari anda.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat keluar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Encik perlu berhati-hati.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam itu diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku dah terlalu lama berhati-hati untuk benda yang salah.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengambil buku nota."
    },
    {
      "type": "paragraph",
      "text": "Menulis satu ayat:"
    },
    {
      "type": "paragraph",
      "text": "**AKU AKAN HADAPI.**"
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum sempat menutup buku—"
    },
    {
      "type": "paragraph",
      "text": "satu mesej masuk."
    },
    {
      "type": "paragraph",
      "text": "**JANGAN SERAH DIRI.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej kedua:"
    },
    {
      "type": "paragraph",
      "text": "**KALAU KAU SERAH, ADAM MATI.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus bangun."
    },
    {
      "type": "paragraph",
      "text": "Dia menggenggam telefon."
    },
    {
      "type": "paragraph",
      "text": "Sekarang pilihan itu menjadi lebih sukar."
    },
    {
      "type": "paragraph",
      "text": "Dia boleh menyerah."
    },
    {
      "type": "paragraph",
      "text": "Atau dia boleh cuba menyelamatkan Adam."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Seseorang sedang menggunakan Adam untuk memastikan dia terus bermain."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ke luar tingkap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Tidak lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil jaket."
    },
    {
      "type": "paragraph",
      "text": "Bukan untuk melarikan diri."
    },
    {
      "type": "paragraph",
      "text": "Tetapi untuk membuat satu keputusan terakhir sebelum menyerah."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 4**"
    }
  ],
