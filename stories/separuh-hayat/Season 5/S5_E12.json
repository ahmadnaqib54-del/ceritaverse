{
  "series": "Separuh Hayat",
  "season": 5,
  "episode": 12,
  "title": "S5 E12",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 12\n## THE FALL"
    },
    {
      "type": "paragraph",
      "text": "Mahkamah penuh."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di kandang tertuduh."
    },
    {
      "type": "paragraph",
      "text": "Hari keputusan."
    },
    {
      "type": "paragraph",
      "text": "Tiada wartawan yang masih terkejut melihat wajahnya."
    },
    {
      "type": "paragraph",
      "text": "Tiada lagi tajuk berita yang boleh mengejutkan orang."
    },
    {
      "type": "paragraph",
      "text": "Semua orang sudah tahu siapa Rizal."
    },
    {
      "type": "paragraph",
      "text": "Atau sekurang-kurangnya mereka fikir mereka tahu."
    },
    {
      "type": "paragraph",
      "text": "Hakim masuk."
    },
    {
      "type": "paragraph",
      "text": "Semua berdiri."
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Kemudian duduk semula."
    },
    {
      "type": "paragraph",
      "text": "Hakim membaca keputusan."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu pertuduhan."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu dapatan."
    },
    {
      "type": "paragraph",
      "text": "Bersalah."
    },
    {
      "type": "paragraph",
      "text": "Bersalah."
    },
    {
      "type": "paragraph",
      "text": "Bersalah."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menunjukkan reaksi."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah menjangka."
    },
    {
      "type": "paragraph",
      "text": "Di galeri, Linda memegang tangan Roy."
    },
    {
      "type": "paragraph",
      "text": "Roy memandang ayahnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal sempat melihat mereka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kembali memandang hakim."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Hukuman dibacakan."
    },
    {
      "type": "paragraph",
      "text": "Panjang."
    },
    {
      "type": "paragraph",
      "text": "Berat."
    },
    {
      "type": "paragraph",
      "text": "Lebih panjang daripada apa yang Rizal pernah bayangkan ketika pertama kali duduk di meja makan dan mengira berapa banyak wang yang diperlukan keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Dulu:"
    },
    {
      "type": "paragraph",
      "text": "**RM500,000.**"
    },
    {
      "type": "paragraph",
      "text": "Itu sasaran pertama."
    },
    {
      "type": "paragraph",
      "text": "Nampak besar."
    },
    {
      "type": "paragraph",
      "text": "Nampak mustahil."
    },
    {
      "type": "paragraph",
      "text": "Sekarang jumlah itu hampir kelihatan seperti angka kecil dalam sebuah kehidupan yang sudah musnah."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "Dia baru sedar sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Dia menghabiskan bertahun-tahun mengejar wang supaya keluarganya mempunyai masa depan."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia menghabiskan masa depan itu untuk mengejar wang."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Selepas keputusan, Rizal dibawa keluar."
    },
    {
      "type": "paragraph",
      "text": "Wartawan menunggu."
    },
    {
      "type": "paragraph",
      "text": "Soalan bertalu-talu."
    },
    {
      "type": "paragraph",
      "text": "“Rizal!”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah anda menyesal?”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah anda mahu rayuan?”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah Project Hayat benar-benar wujud?”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa Daniel Voss?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seseorang bertanya:"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu Rizal!”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Seperti sebelum ini."
    },
    {
      "type": "paragraph",
      "text": "Dia berpaling."
    },
    {
      "type": "paragraph",
      "text": "Wartawan itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau anda boleh kembali ke masa lalu, apa yang anda akan ubah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab:"
    },
    {
      "type": "paragraph",
      "text": "“Saya akan belajar membezakan antara apa yang saya perlukan…”"
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“…dan apa yang saya mahu.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berjalan pergi."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Hari-hari selepas itu menjadi perlahan."
    },
    {
      "type": "paragraph",
      "text": "Terlalu perlahan."
    },
    {
      "type": "paragraph",
      "text": "Rizal dipindahkan."
    },
    {
      "type": "paragraph",
      "text": "Proses undang-undang diteruskan."
    },
    {
      "type": "paragraph",
      "text": "Rayuan dibincangkan."
    },
    {
      "type": "paragraph",
      "text": "Dokumen difailkan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tubuhnya semakin lemah."
    },
    {
      "type": "paragraph",
      "text": "Batuk semakin kerap."
    },
    {
      "type": "paragraph",
      "text": "Nafas semakin pendek."
    },
    {
      "type": "paragraph",
      "text": "Kanser yang dahulu menjadi sebab dia memulakan semuanya kini menjadi sesuatu yang tidak boleh lagi dia lawan dengan wang."
    },
    {
      "type": "paragraph",
      "text": "Seorang doktor memeriksanya."
    },
    {
      "type": "paragraph",
      "text": "“Keadaan awak semakin teruk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "Doktor diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak apa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia sudah lama berhenti takut dengan jawapan itu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Suatu petang, Linda datang."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk berhadapan."
    },
    {
      "type": "paragraph",
      "text": "Tiada kaca kali ini."
    },
    {
      "type": "paragraph",
      "text": "Rizal kelihatan jauh lebih kurus."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jawapan bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "“Masih cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa perlahan."
    },
    {
      "type": "paragraph",
      "text": "Itulah kali pertama mereka ketawa bersama selepas sekian lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian senyap."
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Roy?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia okay.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekolah?”"
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "“Baby?”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia dah mula kenal suara kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak sangka dia akan kenal aku.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dia anak kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Linda.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak minta kau balik.”"
    },
    {
      "type": "paragraph",
      "text": "Linda diam."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Aku harap suatu hari nanti kau boleh ingat aku bukan kerana semua ini.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu boleh atau tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Itu pun cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menghulurkan sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Sepucuk surat."
    },
    {
      "type": "paragraph",
      "text": "“Roy tulis.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak membukanya."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal membaca surat tersebut."
    },
    {
      "type": "paragraph",
      "text": "Tulisan Roy tidak sempurna."
    },
    {
      "type": "paragraph",
      "text": "Beberapa perkataan dicoret."
    },
    {
      "type": "paragraph",
      "text": "Ada ayat yang diubah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia dapat membacanya."
    },
    {
      "type": "paragraph",
      "text": "> **Ayah,**\n>\n> **Saya tak faham kenapa Ayah buat semua benda tu.**\n>\n> **Saya marah.**\n>\n> **Saya sedih.**\n>\n> **Tapi saya masih sayang Ayah.**\n>\n> **Bila Ayah balik nanti, kalau Ayah boleh, kita tengok kimia sama-sama.**\n>\n> **Roy.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca surat itu dua kali."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tiga kali."
    },
    {
      "type": "paragraph",
      "text": "Dia lipat perlahan."
    },
    {
      "type": "paragraph",
      "text": "Dan meletakkannya di bawah bantal."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minggu berlalu."
    },
    {
      "type": "paragraph",
      "text": "Rizal semakin lemah."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak lagi banyak bercakap."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang dia duduk di katil dan membaca buku kimia lama."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang dia hanya melihat dinding."
    },
    {
      "type": "paragraph",
      "text": "Satu pagi, seorang pegawai datang."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada perkembangan mengenai Project Hayat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Daniel?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih belum ditemui.”"
    },
    {
      "type": "paragraph",
      "text": "“Malik?”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam siasatan.”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi kami dah jumpa lebih banyak rekod.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak nak tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berfikir."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab akhirnya saya faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang mula tak lagi penting.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Yang penting ialah apa yang saya buat selepas saya tahu saya boleh berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian—"
    },
    {
      "type": "paragraph",
      "text": "Rizal mendapat berita bahawa beberapa asetnya telah dilucutkan."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana runtuh."
    },
    {
      "type": "paragraph",
      "text": "Rangkaian Hashim pecah."
    },
    {
      "type": "paragraph",
      "text": "Nama Daniel terus diburu."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang didakwa."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang dibebaskan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang hilang."
    },
    {
      "type": "paragraph",
      "text": "Sistem itu terus bergerak."
    },
    {
      "type": "paragraph",
      "text": "Walaupun Rizal sudah tiada di dalamnya."
    },
    {
      "type": "paragraph",
      "text": "Itulah perkara paling pelik."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia fikir dirinya pusat segala-galanya."
    },
    {
      "type": "paragraph",
      "text": "Rupanya tidak."
    },
    {
      "type": "paragraph",
      "text": "Sistem tidak memerlukan seorang manusia."
    },
    {
      "type": "paragraph",
      "text": "Sistem hanya memerlukan manusia yang bersedia mengambil tempat kosong."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Suatu malam, Rizal bertanya kepada pegawai yang menjaganya:"
    },
    {
      "type": "paragraph",
      "text": "“Boleh saya tulis sesuatu?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memberinya kertas."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di meja."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis."
    },
    {
      "type": "paragraph",
      "text": "Bukan pengakuan."
    },
    {
      "type": "paragraph",
      "text": "Bukan manifesto."
    },
    {
      "type": "paragraph",
      "text": "Bukan rahsia."
    },
    {
      "type": "paragraph",
      "text": "Cuma beberapa baris."
    },
    {
      "type": "paragraph",
      "text": "**Untuk Roy.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia mula menulis."
    },
    {
      "type": "paragraph",
      "text": "> “Ayah selalu fikir tugas seorang ayah ialah memastikan anaknya tidak pernah susah.”\n>\n> “Ayah salah.”\n>\n> “Tugas seorang ayah bukan memastikan anaknya tidak pernah jatuh.”\n>\n> “Tugas seorang ayah ialah mengajar anaknya bagaimana untuk berdiri.”\n>\n> “Ayah gagal dalam banyak perkara.”\n>\n> “Jangan jadikan kegagalan Ayah alasan untuk mengulangi kesalahan Ayah.”\n>\n> “Kalau suatu hari nanti kau belajar kimia, ingat satu perkara.”\n>\n> “Jangan hanya belajar bagaimana sesuatu bertindak balas.”\n>\n> “Belajar juga apa akibatnya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menulis lagi."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Hari berikutnya, doktor datang."
    },
    {
      "type": "paragraph",
      "text": "Dia memeriksa Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang pegawai."
    },
    {
      "type": "paragraph",
      "text": "Rizal faham."
    },
    {
      "type": "paragraph",
      "text": "“Dah sampai?”"
    },
    {
      "type": "paragraph",
      "text": "Doktor mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam terakhirnya sunyi."
    },
    {
      "type": "paragraph",
      "text": "Tiada keluarga."
    },
    {
      "type": "paragraph",
      "text": "Tiada wartawan."
    },
    {
      "type": "paragraph",
      "text": "Tiada hakim."
    },
    {
      "type": "paragraph",
      "text": "Tiada Daniel."
    },
    {
      "type": "paragraph",
      "text": "Tiada Hashim."
    },
    {
      "type": "paragraph",
      "text": "Tiada Adam."
    },
    {
      "type": "paragraph",
      "text": "Tiada Amir."
    },
    {
      "type": "paragraph",
      "text": "Tiada sesiapa yang pernah memenuhi hidup keduanya."
    },
    {
      "type": "paragraph",
      "text": "Cuma seorang lelaki."
    },
    {
      "type": "paragraph",
      "text": "Sebuah katil."
    },
    {
      "type": "paragraph",
      "text": "Dan sebuah buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka halaman pertama."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca tulisan lamanya."
    },
    {
      "type": "paragraph",
      "text": "**Setiap tindak balas memerlukan syarat.**"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka halaman lain."
    },
    {
      "type": "paragraph",
      "text": "Ada satu nota lama tentang separuh hayat."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "**HALF-LIFE.**"
    },
    {
      "type": "paragraph",
      "text": "Separuh hayat."
    },
    {
      "type": "paragraph",
      "text": "Dia memikirkan hidupnya."
    },
    {
      "type": "paragraph",
      "text": "Separuh sebagai guru."
    },
    {
      "type": "paragraph",
      "text": "Separuh sebagai penjenayah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sekarang dia sedar—"
    },
    {
      "type": "paragraph",
      "text": "hidup manusia bukan benar-benar terbahagi kepada dua."
    },
    {
      "type": "paragraph",
      "text": "Setiap keputusan membawa sebahagian daripada hidup lama ke dalam hidup yang baru."
    },
    {
      "type": "paragraph",
      "text": "Guru itu masih ada dalam dirinya ketika dia menjadi pengeluar."
    },
    {
      "type": "paragraph",
      "text": "Ayah itu masih ada ketika dia menjadi raja."
    },
    {
      "type": "paragraph",
      "text": "Lelaki yang takut mati itu masih ada ketika dia mula mengejar kuasa."
    },
    {
      "type": "paragraph",
      "text": "Dan manusia yang mahu melindungi keluarganya—"
    },
    {
      "type": "paragraph",
      "text": "masih ada ketika dia akhirnya menghancurkan keluarga itu."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada separuh yang boleh dipadam."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pintu dibuka perlahan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai masuk."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka mata."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Surat daripada Roy.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Letak sini.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu meletakkan surat di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Rizal cuba duduk."
    },
    {
      "type": "paragraph",
      "text": "Tangannya menggigil."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil surat itu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum sempat membukanya—"
    },
    {
      "type": "paragraph",
      "text": "dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Nafasnya menjadi perlahan."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu segera memanggil doktor."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Kemudian surat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian jam pemberian Roy."
    },
    {
      "type": "paragraph",
      "text": "Tiga benda."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Guru."
    },
    {
      "type": "paragraph",
      "text": "Masa."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cantik…”"
    },
    {
      "type": "paragraph",
      "text": "Itu sahaja yang sempat keluar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya—"
    },
    {
      "type": "paragraph",
      "text": "Rizal meninggal dunia."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai raja."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai ahli perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai guru."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai penjenayah."
    },
    {
      "type": "paragraph",
      "text": "Cuma seorang manusia yang akhirnya sampai ke penghujung masa yang dia cuba beli bertahun-tahun dahulu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian."
    },
    {
      "type": "paragraph",
      "text": "Linda dan Roy berdiri di sebuah tanah perkuburan."
    },
    {
      "type": "paragraph",
      "text": "Tiada majlis besar."
    },
    {
      "type": "paragraph",
      "text": "Tiada ucapan panjang."
    },
    {
      "type": "paragraph",
      "text": "Roy memegang surat yang pernah ditulis ayahnya."
    },
    {
      "type": "paragraph",
      "text": "Linda berdiri di sebelah."
    },
    {
      "type": "paragraph",
      "text": "Roy bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Mak.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ayah orang jahat?”"
    },
    {
      "type": "paragraph",
      "text": "Linda diam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu berat."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia menjawab:"
    },
    {
      "type": "paragraph",
      "text": "“Ayah kamu buat perkara yang sangat salah.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Tapi?”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang kubur itu."
    },
    {
      "type": "paragraph",
      "text": "“Tapi dia tetap ayah kamu.”"
    },
    {
      "type": "paragraph",
      "text": "Roy menunduk."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa bulan kemudian—"
    },
    {
      "type": "paragraph",
      "text": "Sekolah Menengah Bukit Salam."
    },
    {
      "type": "paragraph",
      "text": "Makmal kimia."
    },
    {
      "type": "paragraph",
      "text": "Seorang guru muda sedang mengajar."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis di papan putih:"
    },
    {
      "type": "paragraph",
      "text": "**HALF-LIFE**"
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu, kenapa dipanggil separuh hayat?”"
    },
    {
      "type": "paragraph",
      "text": "Guru itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sebab selepas satu tempoh tertentu, jumlah sesuatu tinggal separuh daripada asal.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Guru meneruskan pengajaran."
    },
    {
      "type": "paragraph",
      "text": "Di belakang kelas—"
    },
    {
      "type": "paragraph",
      "text": "sebuah meja kosong."
    },
    {
      "type": "paragraph",
      "text": "Meja lama Rizal."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa duduk di situ."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar sekolah, Roy berdiri di pagar."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah lebih besar."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat ke arah bangunan makmal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka buku yang pernah diberikan ayahnya."
    },
    {
      "type": "paragraph",
      "text": "Di halaman terakhir ada tulisan Rizal."
    },
    {
      "type": "paragraph",
      "text": "**“Setiap tindak balas mempunyai akibat.”**"
    },
    {
      "type": "paragraph",
      "text": "Roy membaca perlahan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menutup buku."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan pulang."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di sebuah tempat lain—"
    },
    {
      "type": "paragraph",
      "text": "sebuah fail lama disimpan dalam arkib."
    },
    {
      "type": "paragraph",
      "text": "**PROJECT HAYAT**"
    },
    {
      "type": "paragraph",
      "text": "Sebahagian besar nama telah ditutup."
    },
    {
      "type": "paragraph",
      "text": "Daniel Voss masih belum ditemui."
    },
    {
      "type": "paragraph",
      "text": "Beberapa rangkaian masih disiasat."
    },
    {
      "type": "paragraph",
      "text": "Project Hayat belum sepenuhnya terjawab."
    },
    {
      "type": "paragraph",
      "text": "Tetapi satu fail mempunyai status akhir."
    },
    {
      "type": "paragraph",
      "text": "**SUBJECT 01 — CLOSED**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya ada satu nota:"
    },
    {
      "type": "paragraph",
      "text": "**SUBJECT DID NOT FAIL BECAUSE OF PRESSURE.**"
    },
    {
      "type": "paragraph",
      "text": "**SUBJECT FAILED BECAUSE HE EVENTUALLY CHOSE POWER OVER PURPOSE.**"
    },
    {
      "type": "paragraph",
      "text": "Fail ditutup."
    },
    {
      "type": "paragraph",
      "text": "Lampu dipadam."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Dan begitulah kisah Rizal berakhir."
    },
    {
      "type": "paragraph",
      "text": "Dia pernah menjadi seorang guru yang mengajar manusia tentang tindak balas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menjadi seorang lelaki yang percaya dia boleh mengawal tindak balas hidupnya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Dia salah."
    },
    {
      "type": "paragraph",
      "text": "Dia fikir wang boleh membeli masa."
    },
    {
      "type": "paragraph",
      "text": "Kuasa boleh membeli keselamatan."
    },
    {
      "type": "paragraph",
      "text": "Sistem boleh membeli kawalan."
    },
    {
      "type": "paragraph",
      "text": "Dan keluarga boleh menjadi alasan untuk apa sahaja."
    },
    {
      "type": "paragraph",
      "text": "Tetapi akhirnya—"
    },
    {
      "type": "paragraph",
      "text": "wang tidak membeli masa."
    },
    {
      "type": "paragraph",
      "text": "Kuasa tidak membeli keluarga."
    },
    {
      "type": "paragraph",
      "text": "Dan kawalan tidak menghapuskan akibat."
    },
    {
      "type": "paragraph",
      "text": "Rizal menghabiskan separuh hidupnya mengajar manusia tentang tindak balas."
    },
    {
      "type": "paragraph",
      "text": "Dia menghabiskan separuh lagi hidupnya belajar bahawa setiap tindak balas mempunyai akibat."
    },
    {
      "type": "paragraph",
      "text": "Dan apabila hidupnya berakhir—"
    },
    {
      "type": "paragraph",
      "text": "yang tinggal bukan empayar."
    },
    {
      "type": "paragraph",
      "text": "Bukan wang."
    },
    {
      "type": "paragraph",
      "text": "Bukan nama."
    },
    {
      "type": "paragraph",
      "text": "Cuma sebuah meja kosong."
    },
    {
      "type": "paragraph",
      "text": "Sebuah buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Sepucuk surat daripada seorang anak."
    },
    {
      "type": "paragraph",
      "text": "Dan seorang lelaki yang terlambat memahami bahawa hidup tidak pernah benar-benar mempunyai “separuh” yang boleh dipisahkan."
    },
    {
      "type": "paragraph",
      "text": "Setiap pilihan membawa pilihan sebelumnya bersamanya."
    },
    {
      "type": "paragraph",
      "text": "Setiap kesalahan meninggalkan jejak."
    },
    {
      "type": "paragraph",
      "text": "Setiap tindakan menghasilkan tindak balas."
    },
    {
      "type": "paragraph",
      "text": "Dan sesetengah akibat—"
    },
    {
      "type": "paragraph",
      "text": "lebih panjang daripada hayat manusia itu sendiri."
    },
    {
      "type": "paragraph",
      "text": "**SEPARUH HAYAT**"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT**"
    }
  ],
