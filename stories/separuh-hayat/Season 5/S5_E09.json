{
  "series": "Separuh Hayat",
  "season": 5,
  "episode": 9,
  "title": "S5 E9",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 9\n## THE HUNT"
    },
    {
      "type": "paragraph",
      "text": "Bunyi pintu besi ditutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam bilik tahanan."
    },
    {
      "type": "paragraph",
      "text": "Tiada meja besar."
    },
    {
      "type": "paragraph",
      "text": "Tiada telefon kedua."
    },
    {
      "type": "paragraph",
      "text": "Tiada orang menunggu arahan."
    },
    {
      "type": "paragraph",
      "text": "Tiada sesiapa memanggilnya bos."
    },
    {
      "type": "paragraph",
      "text": "Cuma sebuah kerusi."
    },
    {
      "type": "paragraph",
      "text": "Sebuah meja."
    },
    {
      "type": "paragraph",
      "text": "Dan dinding putih."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang tangannya."
    },
    {
      "type": "paragraph",
      "text": "Borgol sudah dibuka."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia masih terasa berat."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pintu dibuka."
    },
    {
      "type": "paragraph",
      "text": "Dua pegawai masuk."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Kami akan mulakan soal siasat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai meletakkan fail di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Nama pertama:"
    },
    {
      "type": "paragraph",
      "text": "**AH LEN**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**HASHIM**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**BUMI PERDANA**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**ADAM**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**FARID**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**AMIR**"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat satu nama paling lama."
    },
    {
      "type": "paragraph",
      "text": "Amir."
    },
    {
      "type": "paragraph",
      "text": "Dia diam."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Awak kenal semua nama ini?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Hubungan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Panjang.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak ada masa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang fail itu."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya rasa saya dah habiskan terlalu banyak masa untuk benda yang salah.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Sesi pertama berlangsung berjam-jam."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak cuba menjadi genius."
    },
    {
      "type": "paragraph",
      "text": "Tidak cuba memanipulasi."
    },
    {
      "type": "paragraph",
      "text": "Tidak cuba menipu setiap soalan."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab apa yang dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali sejak bertahun-tahun—"
    },
    {
      "type": "paragraph",
      "text": "dia juga berkata:"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu berhenti menulis."
    },
    {
      "type": "paragraph",
      "text": "“Awak selalu jawab begitu?”"
    },
    {
      "type": "paragraph",
      "text": "“Dulu saya suka nampak macam saya tahu semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya tahu saya tak tahu banyak benda.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar, berita terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL DITAHAN.**"
    },
    {
      "type": "paragraph",
      "text": "**BEKAS GURU DIDAKWA TERLIBAT DALAM RANGKAIAN JENAYAH TERANCANG.**"
    },
    {
      "type": "paragraph",
      "text": "**SIAPA RIZAL SEBENARNYA?**"
    },
    {
      "type": "paragraph",
      "text": "Wartawan mula menggali kehidupannya."
    },
    {
      "type": "paragraph",
      "text": "Bekas pelajar bercakap."
    },
    {
      "type": "paragraph",
      "text": "Bekas rakan guru memberi komen."
    },
    {
      "type": "paragraph",
      "text": "Ada yang mempertahankan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang mengecam."
    },
    {
      "type": "paragraph",
      "text": "Ada yang berkata mereka langsung tidak percaya."
    },
    {
      "type": "paragraph",
      "text": "Seorang bekas pelajar berkata:"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu Rizal memang tegas. Tapi dia selalu ajar kami fikir.”"
    },
    {
      "type": "paragraph",
      "text": "Rakaman itu tersebar."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya dari televisyen di bilik tahanan."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya itu betul.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Maya memberi keterangan."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di hadapan pegawai penyiasat."
    },
    {
      "type": "paragraph",
      "text": "“Rizal memang terlibat.”"
    },
    {
      "type": "paragraph",
      "text": "“Sejauh mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Jauh.”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah dia mengawal semuanya?”"
    },
    {
      "type": "paragraph",
      "text": "Maya berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab orang yang mengawal semuanya tidak akan nampak seperti orang yang sedang kehilangan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Maya menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Saya tidak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat?”"
    },
    {
      "type": "paragraph",
      "text": "Maya diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di dalam tahanan, Rizal menerima berita tentang Farid."
    },
    {
      "type": "paragraph",
      "text": "Farid telah memberikan kenyataan."
    },
    {
      "type": "paragraph",
      "text": "Dia mengaku mengenai hubungannya dengan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dan mengenai kematian Amir."
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Dia kata dia buat kerana mahu lindungi awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak pernah minta.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi awak lindungi dia selepas itu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Itu benar?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya:"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya takut.”"
    },
    {
      "type": "paragraph",
      "text": "“Takut apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Takut kehilangan orang terakhir yang masih setia kepada saya.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menulis."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Walaupun dia membunuh abang ipar awak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memejamkan mata."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka mata."
    },
    {
      "type": "paragraph",
      "text": "“Dan itu kesalahan saya.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Khalid menghilang."
    },
    {
      "type": "paragraph",
      "text": "Pihak berkuasa mencari."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada alamat."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada telefon aktif."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada rekod baharu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum hilang, dia meninggalkan satu mesej."
    },
    {
      "type": "paragraph",
      "text": "Untuk Rizal."
    },
    {
      "type": "paragraph",
      "text": "**KAU DAH TANGKAP DIRI SENDIRI.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej kedua."
    },
    {
      "type": "paragraph",
      "text": "**JANGAN BERHENTI DI SITU.**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia teringat Amir."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai penyiasat."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai ancaman."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebagai adik Linda."
    },
    {
      "type": "paragraph",
      "text": "Sebagai lelaki yang pernah duduk di rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Minum kopi."
    },
    {
      "type": "paragraph",
      "text": "Bercakap tentang kerja."
    },
    {
      "type": "paragraph",
      "text": "Bergurau tentang keluarga."
    },
    {
      "type": "paragraph",
      "text": "Dan pernah memanggilnya—"
    },
    {
      "type": "paragraph",
      "text": "“Abang Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup muka."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak boleh mengubah apa yang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia boleh mengaku."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, seorang pegawai masuk."
    },
    {
      "type": "paragraph",
      "text": "“Awak ada pelawat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak mahu beritahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke bilik lawatan."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Linda duduk di seberang kaca."
    },
    {
      "type": "paragraph",
      "text": "Mereka saling memandang."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada senyuman."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada pelukan."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada kata-kata."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Linda mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil telefon di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Roy okay?”"
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "“Baby?”"
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah dengar?”"
    },
    {
      "type": "paragraph",
      "text": "“Pasal apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Berita.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Semua orang sekarang tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "Linda berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Dulu aku fikir aku boleh kenal suami aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Tapi rupanya aku tak kenal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Aku pun tak kenal diri aku.”"
    },
    {
      "type": "paragraph",
      "text": "Linda terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Roy nak datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Jangan ucap terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia anak kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Linda bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum pergi, dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak maafkan kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi…”"
    },
    {
      "type": "paragraph",
      "text": "Linda berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…aku tak mahu Roy membenci ayah dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Linda pergi."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal mendapat satu lagi berita."
    },
    {
      "type": "paragraph",
      "text": "Khalid ditemui."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bukan oleh pihak berkuasa."
    },
    {
      "type": "paragraph",
      "text": "Seseorang menghantar gambar."
    },
    {
      "type": "paragraph",
      "text": "Khalid berdiri di sebuah tempat yang tidak dikenal pasti."
    },
    {
      "type": "paragraph",
      "text": "Di belakangnya ada sebuah bangunan lama."
    },
    {
      "type": "paragraph",
      "text": "Dan di bawah gambar itu:"
    },
    {
      "type": "paragraph",
      "text": "**DIA TAHU.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyerahkan telefon kepada pegawai."
    },
    {
      "type": "paragraph",
      "text": "“Saya nak beri satu maklumat.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa yang awak tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk gambar."
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan orang yang paling penting.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama, Daniel duduk di dalam sebuah pejabat."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki masuk."
    },
    {
      "type": "paragraph",
      "text": "“Rizal sudah mula bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel tidak terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Dengan siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Pihak berkuasa.”"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Daniel memandang tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Dia akan sampai ke situ.”"
    },
    {
      "type": "paragraph",
      "text": "“Perlu hentikan?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu kelihatan terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Biarkan.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia dedahkan semuanya?”"
    },
    {
      "type": "paragraph",
      "text": "Daniel berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia dedahkan, kita akan tahu apa yang dia fikir benar.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu diam."
    },
    {
      "type": "paragraph",
      "text": "Daniel kembali melihat bandar."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang lebih mudah membiarkan seseorang bercakap daripada cuba menutup mulutnya.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal dibawa ke bilik soal siasat."
    },
    {
      "type": "paragraph",
      "text": "Fail baharu berada di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kami sudah jumpa hubungan antara beberapa syarikat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Kami rasa ini bukan sekadar rangkaian awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa awak tak beritahu dari awal?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya sendiri baru faham.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu membuka satu dokumen."
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat nama itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "**PROJECT HAYAT**"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Apa benda ini?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang dokumen itu lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya tahu siapa yang mungkin tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab:"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang."
    },
    {
      "type": "paragraph",
      "text": "Roy datang."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di hadapan ayahnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dah besar.”"
    },
    {
      "type": "paragraph",
      "text": "Roy ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Ayah dah lama tak tengok saya.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Roy melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Tak best sini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandang ayahnya."
    },
    {
      "type": "paragraph",
      "text": "“Ayah takut?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Takut penjara?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Takut apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Takut Ayah tak sempat betulkan apa yang Ayah rosakkan.”"
    },
    {
      "type": "paragraph",
      "text": "Roy diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah tak boleh betulkan semua.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terkejut."
    },
    {
      "type": "paragraph",
      "text": "Roy menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi Ayah boleh berhenti rosakkan benda lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menahan air mata."
    },
    {
      "type": "paragraph",
      "text": "“Siapa ajar kau cakap macam ni?”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Selepas Roy pergi, Rizal duduk lama."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil buku nota."
    },
    {
      "type": "paragraph",
      "text": "Menulis satu ayat:"
    },
    {
      "type": "paragraph",
      "text": "**Aku sudah lama mencari siapa yang patut dipersalahkan.**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menambah:"
    },
    {
      "type": "paragraph",
      "text": "**Sekarang aku mahu tahu apa yang aku sendiri buat.**"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup buku."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali—"
    },
    {
      "type": "paragraph",
      "text": "dia tidak mahu mencari jalan keluar."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu mencari kebenaran."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, seorang pegawai menerima satu panggilan."
    },
    {
      "type": "paragraph",
      "text": "“Encik.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal minta jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Dengan siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu Malik?”"
    },
    {
      "type": "paragraph",
      "text": "“Katanya Malik tahu siapa yang membentuk semua ini.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu melihat fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Buat permintaan rasmi.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di sebuah tempat yang tidak diketahui—"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik menerima berita itu."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL MAHU BERCERITA.**"
    },
    {
      "type": "paragraph",
      "text": "Malik tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab:"
    },
    {
      "type": "paragraph",
      "text": "**BIARKAN DIA.**"
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Di atas mejanya ada satu fail lama."
    },
    {
      "type": "paragraph",
      "text": "**SUBJECT 01 — RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Malik membuka halaman terakhir."
    },
    {
      "type": "paragraph",
      "text": "Ada satu catatan:"
    },
    {
      "type": "paragraph",
      "text": "**SUBJECT HAS REACHED THE POINT WHERE SURVIVAL IS NO LONGER THE PRIMARY MOTIVATION.**"
    },
    {
      "type": "paragraph",
      "text": "Malik menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang,” katanya perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“kita lihat siapa dia tanpa ketakutan.”"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 9**"
    }
