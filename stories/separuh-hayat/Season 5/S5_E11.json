  "title": "S5 E11",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 11\n## TRIAL"
    },
    {
      "type": "paragraph",
      "text": "Mahkamah penuh."
    },
    {
      "type": "paragraph",
      "text": "Wartawan berdiri di luar."
    },
    {
      "type": "paragraph",
      "text": "Kamera menghala ke pintu."
    },
    {
      "type": "paragraph",
      "text": "Orang ramai bercakap perlahan."
    },
    {
      "type": "paragraph",
      "text": "Nama Rizal sudah menjadi tajuk berita selama berminggu-minggu."
    },
    {
      "type": "paragraph",
      "text": "**BEKAS GURU KIMIA.**"
    },
    {
      "type": "paragraph",
      "text": "**AHLI PERNIAGAAN.**"
    },
    {
      "type": "paragraph",
      "text": "**TOKOH RANGKAIAN JENAYAH.**"
    },
    {
      "type": "paragraph",
      "text": "**BEKAS ORANG KANAN HASHIM.**"
    },
    {
      "type": "paragraph",
      "text": "Tetapi pagi itu, tiada satu pun nama itu penting."
    },
    {
      "type": "paragraph",
      "text": "Yang penting cuma seorang lelaki yang duduk di dalam kandang tertuduh."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pintu mahkamah dibuka."
    },
    {
      "type": "paragraph",
      "text": "Hakim masuk."
    },
    {
      "type": "paragraph",
      "text": "Semua berdiri."
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat ke hadapan."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa raya mula membaca pertuduhan."
    },
    {
      "type": "paragraph",
      "text": "Panjang."
    },
    {
      "type": "paragraph",
      "text": "Terlalu panjang."
    },
    {
      "type": "paragraph",
      "text": "Nama syarikat."
    },
    {
      "type": "paragraph",
      "text": "Transaksi."
    },
    {
      "type": "paragraph",
      "text": "Rangkaian."
    },
    {
      "type": "paragraph",
      "text": "Konspirasi."
    },
    {
      "type": "paragraph",
      "text": "Pengedaran."
    },
    {
      "type": "paragraph",
      "text": "Pengubahan wang."
    },
    {
      "type": "paragraph",
      "text": "Kematian."
    },
    {
      "type": "paragraph",
      "text": "Dan beberapa perkara lain yang membuatkan Rizal sedar betapa besar kehidupan kedua yang pernah dibinanya."
    },
    {
      "type": "paragraph",
      "text": "Dia mendengar semuanya."
    },
    {
      "type": "paragraph",
      "text": "Tanpa membantah."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Peguamnya mencondongkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Saya pernah dengar perkara lebih menakutkan.”"
    },
    {
      "type": "paragraph",
      "text": "“Contohnya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Doktor cakap saya ada kanser.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menambah,"
    },
    {
      "type": "paragraph",
      "text": "“Yang ini cuma akibat selepas itu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Saksi pertama dipanggil."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke mahkamah dengan wajah yang lebih tua daripada kali terakhir Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di kandang saksi."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah anda mengenali tertuduh?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila pertama kali?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyebut tempoh awal."
    },
    {
      "type": "paragraph",
      "text": "Sebelum Hashim."
    },
    {
      "type": "paragraph",
      "text": "Sebelum empayar."
    },
    {
      "type": "paragraph",
      "text": "Sebelum nama Rizal menjadi besar."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Apa yang anda tahu tentang dia?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len diam seketika."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Pada awalnya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia cuma mahu duit.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Dan selepas itu?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandang Rizal lagi."
    },
    {
      "type": "paragraph",
      "text": "“Dia mula mahu lebih daripada duit.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Saksi seterusnya ialah Maya."
    },
    {
      "type": "paragraph",
      "text": "Dia membawa fail."
    },
    {
      "type": "paragraph",
      "text": "Bukan cerita."
    },
    {
      "type": "paragraph",
      "text": "Bukan spekulasi."
    },
    {
      "type": "paragraph",
      "text": "Angka."
    },
    {
      "type": "paragraph",
      "text": "Dokumen."
    },
    {
      "type": "paragraph",
      "text": "Struktur syarikat."
    },
    {
      "type": "paragraph",
      "text": "Hubungan antara beberapa entiti."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah tertuduh terlibat dalam pengurusan struktur ini?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah dia faham apa yang berlaku?”"
    },
    {
      "type": "paragraph",
      "text": "Maya berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Dia sangat faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagaimana anda tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab setiap kali sesuatu tidak masuk akal, dia orang pertama yang nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Jadi anda mengatakan tertuduh mempunyai kebolehan analitik tinggi?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan sekadar dipengaruhi orang lain?”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Mahkamah senyap."
    },
    {
      "type": "paragraph",
      "text": "Maya menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dia membuat keputusan sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak memandangnya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Farid pula muncul."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya masuk."
    },
    {
      "type": "paragraph",
      "text": "Farid kelihatan jauh lebih kurus."
    },
    {
      "type": "paragraph",
      "text": "Lebih tua."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di kandang saksi."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah Rizal pernah mengarahkan anda membunuh Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "Ini penting."
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang di mahkamah mula berbisik."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya lagi,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi mengapa anda membunuh Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Saya fikir saya melindungi Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Siasatan.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang menyuruh anda?”"
    },
    {
      "type": "paragraph",
      "text": "“Tiada siapa.”"
    },
    {
      "type": "paragraph",
      "text": "Pendakwa berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Termasuk Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Adakah tertuduh tahu rancangan anda?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah tertuduh meminta anda melakukan pembunuhan itu?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Tapi selepas itu…”"
    },
    {
      "type": "paragraph",
      "text": "Peguam menunggu."
    },
    {
      "type": "paragraph",
      "text": "Farid memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“…dia lindungi saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Farid menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu saya yang buat.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab dia takut kehilangan orang yang masih setia kepada dia.”"
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Kemudian bukti Adam dibentangkan."
    },
    {
      "type": "paragraph",
      "text": "Fail."
    },
    {
      "type": "paragraph",
      "text": "Rakaman."
    },
    {
      "type": "paragraph",
      "text": "Nota."
    },
    {
      "type": "paragraph",
      "text": "Catatan lama."
    },
    {
      "type": "paragraph",
      "text": "Nama Hashim."
    },
    {
      "type": "paragraph",
      "text": "Nama Malik."
    },
    {
      "type": "paragraph",
      "text": "Nama Daniel Voss."
    },
    {
      "type": "paragraph",
      "text": "Dan satu perkataan yang semakin kerap muncul:"
    },
    {
      "type": "paragraph",
      "text": "**PROJECT HAYAT.**"
    },
    {
      "type": "paragraph",
      "text": "Peguam Rizal memandang dokumen itu."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa mengakui bahawa Project Hayat masih belum dapat dipetakan sepenuhnya."
    },
    {
      "type": "paragraph",
      "text": "Hakim bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah Project Hayat sebahagian daripada pertuduhan?”"
    },
    {
      "type": "paragraph",
      "text": "Pendakwa menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Tidak sepenuhnya, Yang Arif.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kenapa dibawa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana ia memberi konteks terhadap hubungan antara beberapa individu.”"
    },
    {
      "type": "paragraph",
      "text": "Hakim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal mendengar."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu cerita itu masih belum tamat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi mahkamah bukan tempat untuk dia mencari jawapan."
    },
    {
      "type": "paragraph",
      "text": "Mahkamah ialah tempat dia menjawab soalan tentang dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu nama disebut."
    },
    {
      "type": "paragraph",
      "text": "Amir."
    },
    {
      "type": "paragraph",
      "text": "Mahkamah menjadi lebih senyap."
    },
    {
      "type": "paragraph",
      "text": "Beberapa dokumen siasatan lama dibentangkan."
    },
    {
      "type": "paragraph",
      "text": "Catatan Amir."
    },
    {
      "type": "paragraph",
      "text": "Gambar."
    },
    {
      "type": "paragraph",
      "text": "Hubungan antara Rizal, Ah Len, Hashim dan beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Peguam bertanya kepada pegawai penyiasat,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah Amir percaya Rizal ialah orang pertama?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia menulis bahawa kemungkinan ada pihak lain.”"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Tetapi adakah Amir tetap percaya Rizal bersalah?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam menutup fail."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang meja."
    },
    {
      "type": "paragraph",
      "text": "Itulah Amir."
    },
    {
      "type": "paragraph",
      "text": "Walaupun dia percaya ada sesuatu yang lebih besar—"
    },
    {
      "type": "paragraph",
      "text": "dia tidak pernah membiarkan itu menghapuskan kesalahan Rizal."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rehat tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di ruang tahanan."
    },
    {
      "type": "paragraph",
      "text": "Peguam masuk."
    },
    {
      "type": "paragraph",
      "text": "“Awak dengar semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak boleh teruskan perbicaraan seperti biasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak tak perlu cakap apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya nak cakap?”"
    },
    {
      "type": "paragraph",
      "text": "Peguam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Awak nak beri keterangan?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal, itu berisiko.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak perkara boleh memudaratkan awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab selama ini semua orang bercakap tentang saya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kali ini saya nak bercakap sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Hari berikutnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal naik ke kandang saksi."
    },
    {
      "type": "paragraph",
      "text": "Mahkamah senyap."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri."
    },
    {
      "type": "paragraph",
      "text": "Angkat sumpah."
    },
    {
      "type": "paragraph",
      "text": "Kemudian duduk."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bangun."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa anda mula?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu ringkas."
    },
    {
      "type": "paragraph",
      "text": "Tetapi jawapannya membawa lima tahun hidup."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya takut mati.”"
    },
    {
      "type": "paragraph",
      "text": "Pendakwa menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Saya dapat tahu saya menghidap kanser.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya fikir saya perlu tinggalkan sesuatu untuk keluarga saya.”"
    },
    {
      "type": "paragraph",
      "text": "“Wang?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyebut jumlah sasaran asal."
    },
    {
      "type": "paragraph",
      "text": "Mahkamah senyap."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah jumlah itu cukup?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Pada masa itu saya fikir cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan selepas anda mendapat wang?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya mahu lebih.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Kerana saya sudah tahu saya boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi anda teruskan?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Walaupun selepas keluarga anda tidak lagi memerlukan wang sebanyak itu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Satu perkataan."
    },
    {
      "type": "paragraph",
      "text": "Jelas."
    },
    {
      "type": "paragraph",
      "text": "“Awak suka kuasa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak suka kawalan?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak sedar apa yang berlaku kepada orang lain?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak semuanya pada awalnya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kemudian?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Namun anda teruskan.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Peguamnya bangun."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak bertanya soalan panjang."
    },
    {
      "type": "paragraph",
      "text": "Cuma satu."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal, adakah Project Hayat menyebabkan anda melakukan semua ini?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat mungkin mempengaruhi keadaan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang hakim."
    },
    {
      "type": "paragraph",
      "text": "“Tetapi saya membuat pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah anda menyesal?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah penyesalan itu menghapuskan apa yang anda lakukan?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah anda mahu dihukum?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Saya mahu dihukum secara adil.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam duduk."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Hari terakhir keterangan."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Pendakwa memberikan soalan terakhir."
    },
    {
      "type": "paragraph",
      "text": "“Jika anda boleh kembali ke hari pertama anda menerima diagnosis…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Adakah anda akan buat perkara yang sama?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Linda."
    },
    {
      "type": "paragraph",
      "text": "Dia berada di galeri."
    },
    {
      "type": "paragraph",
      "text": "Roy di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat mereka lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Pendakwa bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya fikir saya mula semua ini kerana saya tidak mempunyai pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kemudian saya sedar…”"
    },
    {
      "type": "paragraph",
      "text": "Matanya mula berkaca."
    },
    {
      "type": "paragraph",
      "text": "“…selepas itu saya mempunyai banyak pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "Mahkamah senyap."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung:"
    },
    {
      "type": "paragraph",
      "text": "“Dan saya tetap memilih.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Linda menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Roy memandang ayahnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tidak akan salahkan kanser.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak akan salahkan Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak akan salahkan Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak akan salahkan Project Hayat.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Dan saya tidak akan salahkan keluarga saya.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya buat pilihan saya sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Hakim mengambil masa untuk membaca keputusan dan hujahan."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk semula."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat ke hadapan."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa menunggu dia menang."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa menunggu dia keluar sebagai lelaki yang sama."
    },
    {
      "type": "paragraph",
      "text": "Yang tinggal cuma keputusan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Selepas prosiding hari itu tamat, Rizal dibawa kembali."
    },
    {
      "type": "paragraph",
      "text": "Di dalam kenderaan, dia melihat langit."
    },
    {
      "type": "paragraph",
      "text": "Telefon lama sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "Tiada lagi panggilan."
    },
    {
      "type": "paragraph",
      "text": "Tiada lagi mesej."
    },
    {
      "type": "paragraph",
      "text": "Tiada lagi arahan."
    },
    {
      "type": "paragraph",
      "text": "Hanya sunyi."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di satu tempat lain—"
    },
    {
      "type": "paragraph",
      "text": "seseorang membuka komputer."
    },
    {
      "type": "paragraph",
      "text": "Satu fail Project Hayat dibuka."
    },
    {
      "type": "paragraph",
      "text": "Nama:"
    },
    {
      "type": "paragraph",
      "text": "**RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Status:"
    },
    {
      "type": "paragraph",
      "text": "**CAPTURED**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**TRIAL COMPLETED — PENDING VERDICT**"
    },
    {
      "type": "paragraph",
      "text": "Seseorang menaip:"
    },
    {
      "type": "paragraph",
      "text": "**SUBJECT ACCEPTED RESPONSIBILITY.**"
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian, satu jawapan muncul:"
    },
    {
      "type": "paragraph",
      "text": "**THEN THE PROJECT WORKED.**"
    },
    {
      "type": "paragraph",
      "text": "Kursor bergerak ke fail seterusnya."
    },
    {
      "type": "paragraph",
      "text": "**SUBJECT 02**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian skrin menjadi hitam."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali ke sel."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di atas katil."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia berada di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Membuka halaman pertama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menulis satu perkataan."
    },
    {
      "type": "paragraph",
      "text": "**AKIBAT.**"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup buku."
    },
    {
      "type": "paragraph",
      "text": "Di luar, bunyi pintu besi bergema."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Keputusan mahkamah akan datang."
    },
    {
      "type": "paragraph",
      "text": "Dan bersama keputusan itu—"
    },
    {
      "type": "paragraph",
      "text": "hidup yang tinggal akan ditentukan."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 11**"
    }
