  "title": "S5 E10",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 10\n## CAPTURE"
    },
    {
      "type": "paragraph",
      "text": "Pintu bilik soal siasat dibuka."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai berdiri di pintu."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Permintaan awak diluluskan.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk?”"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu hampir keluar."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak masih boleh tarik balik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya dah terlalu lama diam.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu Rizal tidak tidur."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di atas katil tahanan."
    },
    {
      "type": "paragraph",
      "text": "Buku kimia masih bersamanya."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka satu halaman rawak."
    },
    {
      "type": "paragraph",
      "text": "Ada nota lama."
    },
    {
      "type": "paragraph",
      "text": "**Kadar tindak balas bergantung kepada keadaan.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup buku."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia fikir manusia sama."
    },
    {
      "type": "paragraph",
      "text": "Beri tekanan."
    },
    {
      "type": "paragraph",
      "text": "Dapat tindak balas."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia tahu manusia lebih rumit."
    },
    {
      "type": "paragraph",
      "text": "Ada yang pecah."
    },
    {
      "type": "paragraph",
      "text": "Ada yang melawan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang menipu."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membunuh."
    },
    {
      "type": "paragraph",
      "text": "Ada yang menyerah."
    },
    {
      "type": "paragraph",
      "text": "Dan ada yang seperti dirinya—"
    },
    {
      "type": "paragraph",
      "text": "terus bergerak walaupun sudah tahu arah akhirnya salah."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal dibawa ke bilik pertemuan."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "Lebih tua daripada yang Rizal ingat."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "Tidak tergesa-gesa."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk berhadapan."
    },
    {
      "type": "paragraph",
      "text": "Tiada kaca."
    },
    {
      "type": "paragraph",
      "text": "Tiada borgol."
    },
    {
      "type": "paragraph",
      "text": "Hanya dua orang lelaki."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik.”"
    },
    {
      "type": "paragraph",
      "text": "Malik tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Awak akhirnya sampai.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Adam mati.”"
    },
    {
      "type": "paragraph",
      "text": "Malik mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir mati.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim mati.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengetap gigi."
    },
    {
      "type": "paragraph",
      "text": "“Linda pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Malik tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Roy membesar tanpa saya.”"
    },
    {
      "type": "paragraph",
      "text": "Malik masih diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal mencondongkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Semua ini masih eksperimen bagi kau?”"
    },
    {
      "type": "paragraph",
      "text": "Malik memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Akibat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Lucu.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa yang lucu?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua orang dalam sistem ini suka cakap tentang pilihan dan akibat.”"
    },
    {
      "type": "paragraph",
      "text": "Malik mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sebab itu perkara yang paling sukar diterima.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang mula?”"
    },
    {
      "type": "paragraph",
      "text": "Malik diam lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bukan saya.”"
    },
    {
      "type": "paragraph",
      "text": "“Daniel?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Malik menjawab:"
    },
    {
      "type": "paragraph",
      "text": "“Tiada seorang pun.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat bukan dibina oleh seorang.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang.”"
    },
    {
      "type": "paragraph",
      "text": "Malik menarik satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Pelabur.”"
    },
    {
      "type": "paragraph",
      "text": "“Penyelidik.”"
    },
    {
      "type": "paragraph",
      "text": "“Perniagaan.”"
    },
    {
      "type": "paragraph",
      "text": "“Institusi.”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang mahu tahu bagaimana manusia bertindak apabila diberi tekanan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang fail itu."
    },
    {
      "type": "paragraph",
      "text": "“Dan aku?”"
    },
    {
      "type": "paragraph",
      "text": "Malik berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Awak contoh yang paling jauh.”"
    },
    {
      "type": "paragraph",
      "text": "“Jauh daripada apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada lelaki yang mula-mula kita kenal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Malik menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Pada awalnya awak cuma mahu wang untuk keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Selepas itu awak mahu lebih banyak wang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Selepas itu kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Diam."
    },
    {
      "type": "paragraph",
      "text": "“Selepas itu kawalan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "Malik berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Dan akhirnya…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Awak mahu menang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "Malik menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Itulah yang Project Hayat mahu lihat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adakah kau rasa semua yang berlaku kepada aku disebabkan projek itu?”"
    },
    {
      "type": "paragraph",
      "text": "Malik menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Project Hayat membuka pintu.”"
    },
    {
      "type": "paragraph",
      "text": "Malik memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak yang masuk.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Selepas pertemuan itu, Rizal dibawa kembali."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini fikirannya lebih jelas."
    },
    {
      "type": "paragraph",
      "text": "Project Hayat bukan dalang tunggal."
    },
    {
      "type": "paragraph",
      "text": "Bukan satu organisasi dengan seorang ketua yang duduk di bilik gelap."
    },
    {
      "type": "paragraph",
      "text": "Ia lebih buruk."
    },
    {
      "type": "paragraph",
      "text": "Ia sistem manusia."
    },
    {
      "type": "paragraph",
      "text": "Orang yang mencari peluang."
    },
    {
      "type": "paragraph",
      "text": "Orang yang memberi tekanan."
    },
    {
      "type": "paragraph",
      "text": "Orang yang mengambil keuntungan."
    },
    {
      "type": "paragraph",
      "text": "Orang yang membuat keputusan."
    },
    {
      "type": "paragraph",
      "text": "Dan manusia lain yang memilih untuk terus bermain."
    },
    {
      "type": "paragraph",
      "text": "Termasuk dirinya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang."
    },
    {
      "type": "paragraph",
      "text": "Peguam datang."
    },
    {
      "type": "paragraph",
      "text": "“Tarikh pertuduhan akan ditetapkan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Ada kemungkinan awak akan ditahan lebih lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Kes ini besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang dah cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Satu lagi perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Linda.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus diam."
    },
    {
      "type": "paragraph",
      "text": "“Dia mahu Roy datang lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Hari berikutnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di bilik lawatan."
    },
    {
      "type": "paragraph",
      "text": "Roy masuk."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia membawa sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Sebuah beg kecil."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Apa tu?”"
    },
    {
      "type": "paragraph",
      "text": "“Barang Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Roy membuka beg."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya ada buku kimia."
    },
    {
      "type": "paragraph",
      "text": "Rizal terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Buku ni kan dengan Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang Ayah bagi saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memegang buku itu."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Roy menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Supaya Ayah tak lupa siapa Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Ayah tak lupa.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang Ayah lupa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Roy berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Bila Ayah keluar?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tahu apa hendak jawab."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Roy.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau Ayah tak boleh balik…”"
    },
    {
      "type": "paragraph",
      "text": "Roy terus memotong."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cakap macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Roy menggenggam tangannya melalui ruang kecil di bawah kaca."
    },
    {
      "type": "paragraph",
      "text": "“Ayah baliklah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ayah akan cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bukan cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Dah kena ajar balik.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Selepas Roy pergi—"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang kerusi kosong di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia sedar."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah lama tidak bertanya soalan paling mudah."
    },
    {
      "type": "paragraph",
      "text": "**Apa yang Roy perlukan daripada aku?**"
    },
    {
      "type": "paragraph",
      "text": "Bukan wang."
    },
    {
      "type": "paragraph",
      "text": "Bukan rumah."
    },
    {
      "type": "paragraph",
      "text": "Bukan kereta."
    },
    {
      "type": "paragraph",
      "text": "Bukan sekolah terbaik."
    },
    {
      "type": "paragraph",
      "text": "Bukan masa depan yang sempurna."
    },
    {
      "type": "paragraph",
      "text": "Cuma ayah."
    },
    {
      "type": "paragraph",
      "text": "Dan dia telah kehilangan hampir semuanya kerana cuba membeli masa."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam."
    },
    {
      "type": "paragraph",
      "text": "Rizal dibawa ke sel."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "“Esok apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak akan dipindahkan.”"
    },
    {
      "type": "paragraph",
      "text": "“Ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat tahanan lain sementara menunggu proses mahkamah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
