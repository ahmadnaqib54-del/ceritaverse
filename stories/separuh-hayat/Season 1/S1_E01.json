  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 1\n### Hari Jadi"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6:10 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah berada di dapur."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di depan cerek sambil memegang cawan kopi yang sudah separuh kosong."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "Suara Linda datang dari belakang."
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Birthday abang hari ni.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang Linda."
    },
    {
      "type": "paragraph",
      "text": "“Betul ke?”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Abang lupa birthday sendiri?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak lupa.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Saja test.”"
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Test apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Test isteri.”"
    },
    {
      "type": "paragraph",
      "text": "“Result?”"
    },
    {
      "type": "paragraph",
      "text": "“Gagal.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mencapai bahunya dan menolak perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Pergi mandi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Hari itu genap lima puluh tahun."
    },
    {
      "type": "paragraph",
      "text": "Lima puluh."
    },
    {
      "type": "paragraph",
      "text": "Angka yang selama ini kedengaran jauh."
    },
    {
      "type": "paragraph",
      "text": "Sekarang angka itu berdiri tepat di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sekolah Menengah Bukit Salam."
    },
    {
      "type": "paragraph",
      "text": "Pukul 8:15 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal menulis satu persamaan di papan putih."
    },
    {
      "type": "paragraph",
      "text": "“Siapa boleh jawab?”"
    },
    {
      "type": "paragraph",
      "text": "Satu kelas diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang murid-muridnya."
    },
    {
      "type": "paragraph",
      "text": "“Takkan semua lupa?”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar di belakang mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya, Hakim?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya jawab salah?”"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu bagi peluang kedua.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau salah lagi?”"
    },
    {
      "type": "paragraph",
      "text": "“Peluang ketiga.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau salah lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan marker."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu bagi kerja rumah.”"
    },
    {
      "type": "paragraph",
      "text": "Satu kelas ketawa."
    },
    {
      "type": "paragraph",
      "text": "Hakim terus menurunkan tangan."
    },
    {
      "type": "paragraph",
      "text": "“Bijak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Dia suka mengajar."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana gaji."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana cuti."
    },
    {
      "type": "paragraph",
      "text": "Dia suka saat seorang pelajar yang tidak faham tiba-tiba faham."
    },
    {
      "type": "paragraph",
      "text": "Saat mata mereka berubah."
    },
    {
      "type": "paragraph",
      "text": "Saat mereka berkata—"
    },
    {
      "type": "paragraph",
      "text": "“Ohhh…”"
    },
    {
      "type": "paragraph",
      "text": "Itu kepuasan yang sukar diterangkan."
    },
    {
      "type": "paragraph",
      "text": "Selepas kelas tamat, Rizal kembali ke bilik guru."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk."
    },
    {
      "type": "paragraph",
      "text": "Membuka buku rekod."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Batuk."
    },
    {
      "type": "paragraph",
      "text": "Sekali."
    },
    {
      "type": "paragraph",
      "text": "Dia menutup mulut dengan tangan."
    },
    {
      "type": "paragraph",
      "text": "Batuk lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini lebih lama."
    },
    {
      "type": "paragraph",
      "text": "Seorang guru di meja sebelah menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Rizal, kau okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "“Dah lama aku dengar kau batuk.”"
    },
    {
      "type": "paragraph",
      "text": "“Cuaca.”"
    },
    {
      "type": "paragraph",
      "text": "“Cuaca?”"
    },
    {
      "type": "paragraph",
      "text": "“Cuaca sekarang banyak kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Rakannya ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal ikut ketawa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi selepas rakannya berpaling, senyuman itu hilang."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang tangannya."
    },
    {
      "type": "paragraph",
      "text": "Ada sedikit kesan merah pada tisu."
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Dia memasukkan tisu itu ke dalam poket."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal tidak terus pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia pergi ke Hospital Bandaraya."
    },
    {
      "type": "paragraph",
      "text": "Sudah beberapa minggu dia batuk."
    },
    {
      "type": "paragraph",
      "text": "Mula-mula dia fikir biasa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian batuk semakin kerap."
    },
    {
      "type": "paragraph",
      "text": "Berat badannya turun sedikit."
    },
    {
      "type": "paragraph",
      "text": "Kadang-kadang dadanya sakit."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah beberapa kali suruh dia pergi berjumpa doktor."
    },
    {
      "type": "paragraph",
      "text": "Hari itu dia akhirnya pergi."
    },
    {
      "type": "paragraph",
      "text": "Doktor memeriksa beberapa keputusan di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk diam."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya, doktor?”"
    },
    {
      "type": "paragraph",
      "text": "Doktor menarik nafas perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Kami jumpa sesuatu pada paru-paru encik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "“Tumor?”"
    },
    {
      "type": "paragraph",
      "text": "Doktor mengangguk kecil."
    },
    {
      "type": "paragraph",
      "text": "“Berdasarkan keputusan yang ada, kami sangat mengesyaki kanser paru-paru.”"
    },
    {
      "type": "paragraph",
      "text": "Bunyi penghawa dingin tiba-tiba terasa kuat."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang doktor."
    },
    {
      "type": "paragraph",
      "text": "“Kanser?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat berlalu."
    },
    {
      "type": "paragraph",
      "text": "“Stage berapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita perlu buat pemeriksaan lanjut untuk pastikan tahap sebenar dan jenisnya.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama saya ada?”"
    },
    {
      "type": "paragraph",
      "text": "Doktor terdiam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Kita jangan buat kesimpulan sekarang. Ada rawatan. Kita bincang pilihan selepas keputusan lengkap keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia sudah tidak mendengar sepenuhnya."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang keluar tingkap."
    },
    {
      "type": "paragraph",
      "text": "Di luar, orang berjalan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang membeli makanan."
    },
    {
      "type": "paragraph",
      "text": "Ada yang bercakap di telefon."
    },
    {
      "type": "paragraph",
      "text": "Ada yang tergesa-gesa pulang."
    },
    {
      "type": "paragraph",
      "text": "Dunia terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Seolah-olah tiada apa berlaku."
    },
    {
      "type": "paragraph",
      "text": "Sedangkan bagi Rizal, sesuatu baru sahaja berhenti."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam."
    },
    {
      "type": "paragraph",
      "text": "Rumah di Jalan Bulan Pristana."
    },
    {
      "type": "paragraph",
      "text": "Linda menunggu di meja makan."
    },
    {
      "type": "paragraph",
      "text": "Roy duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Mana ayah?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekejap lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandang jam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian pintu dibuka."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "“Assalamualaikum.”"
    },
    {
      "type": "paragraph",
      "text": "“Waalaikumsalam.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Happy birthday, ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia terlupa."
    },
    {
      "type": "paragraph",
      "text": "Sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Roy menghulurkan satu kotak kecil."
    },
    {
      "type": "paragraph",
      "text": "“Untuk ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membukanya."
    },
    {
      "type": "paragraph",
      "text": "Jam tangan."
    },
    {
      "type": "paragraph",
      "text": "Murah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cantik."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Roy beli?”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Guna duit simpanan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang anaknya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memeluknya."
    },
    {
      "type": "paragraph",
      "text": "Agak lama."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memerhati."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu ada sesuatu."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melepaskan Roy."
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Doktor cakap apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Linda terus tahu."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan kedua-dua tangan di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Doktor jumpa tumor.”"
    },
    {
      "type": "paragraph",
      "text": "Linda membeku."
    },
    {
      "type": "paragraph",
      "text": "Roy memandang mereka."
    },
    {
      "type": "paragraph",
      "text": "“Ayah sakit?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal cuba tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kita belum tahu lagi semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menarik kerusi dan duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Kanser?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Air mata Linda mula bergenang."
    },
    {
      "type": "paragraph",
      "text": "Rizal mencapai tangannya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan menangis.”"
    },
    {
      "type": "paragraph",
      "text": "“Abang suruh saya jangan menangis?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya belum mati.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya tajam."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cakap macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Roy memandang kedua-duanya."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, tiada siapa bercakap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Linda mengesat air mata."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak beritahu sesuatu juga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Linda menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Saya mengandung.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terpaku."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya mengandung.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Linda."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang Roy."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kembali kepada Linda."
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana lucu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu apa lagi yang patut dilakukan."
    },
    {
      "type": "paragraph",
      "text": "Lima puluh tahun."
    },
    {
      "type": "paragraph",
      "text": "Kanser."
    },
    {
      "type": "paragraph",
      "text": "Dan seorang anak yang bakal lahir."
    },
    {
      "type": "paragraph",
      "text": "Semuanya dalam satu hari."
    },
    {
      "type": "paragraph",
      "text": "Dia bangun dan berjalan ke ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Linda mengikut dari belakang."
    },
    {
      "type": "paragraph",
      "text": "“Abang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti di depan tingkap."
    },
    {
      "type": "paragraph",
      "text": "Di luar, lampu jalan menyala."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "Linda tahu apa yang dia maksudkan."
    },
    {
      "type": "paragraph",
      "text": "“Doktor belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Berapa kos rawatan?”"
    },
    {
      "type": "paragraph",
      "text": "“Abang…”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali ke meja."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "Membuka aplikasi bank."
    },
    {
      "type": "paragraph",
      "text": "Baki simpanan."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat nombor itu lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka kalkulator."
    },
    {
      "type": "paragraph",
      "text": "Kos rawatan."
    },
    {
      "type": "paragraph",
      "text": "Kos rumah."
    },
    {
      "type": "paragraph",
      "text": "Kos Roy."
    },
    {
      "type": "paragraph",
      "text": "Kos bayi."
    },
    {
      "type": "paragraph",
      "text": "Perbelanjaan bulanan."
    },
    {
      "type": "paragraph",
      "text": "Hutang kecil yang belum selesai."
    },
    {
      "type": "paragraph",
      "text": "Simpanan."
    },
    {
      "type": "paragraph",
      "text": "Pendapatan."
    },
    {
      "type": "paragraph",
      "text": "Dia mula mengira."
    },
    {
      "type": "paragraph",
      "text": "Satu angka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian angka lain."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Mengira semula."
