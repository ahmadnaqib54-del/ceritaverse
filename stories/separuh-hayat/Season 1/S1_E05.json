{
  "series": "Separuh Hayat",
  "season": 1,
  "episode": 5,
  "title": "S1 E5",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 5\n### Produk"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6:30 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah bangun."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di meja makan dengan secawan kopi."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada sebuah buku nota."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya hanya terdapat empat perkataan."
    },
    {
      "type": "paragraph",
      "text": "**Bahan.**"
    },
    {
      "type": "paragraph",
      "text": "**Proses.**"
    },
    {
      "type": "paragraph",
      "text": "**Produk.**"
    },
    {
      "type": "paragraph",
      "text": "**Duit.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menambah satu lagi."
    },
    {
      "type": "paragraph",
      "text": "**Risiko.**"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup buku."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di sekolah, Rizal mengajar seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "“Kalau eksperimen gagal, apa kita buat?”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Ulang?”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar lain mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Kalau gagal lagi?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari sebab.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau tak jumpa sebab?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jangan salahkan eksperimen.”"
    },
    {
      "type": "paragraph",
      "text": "Satu kelas ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal berpaling ke papan putih."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kata-kata itu terlekat dalam fikirannya."
    },
    {
      "type": "paragraph",
      "text": "**Cari sebab.**"
    },
    {
      "type": "paragraph",
      "text": "Itulah cara dia bekerja."
    },
    {
      "type": "paragraph",
      "text": "Kalau sesuatu tidak menjadi, jangan panik."
    },
    {
      "type": "paragraph",
      "text": "Cari punca."
    },
    {
      "type": "paragraph",
      "text": "Betulkan."
    },
    {
      "type": "paragraph",
      "text": "Ulang."
    },
    {
      "type": "paragraph",
      "text": "Pastikan hasil konsisten."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal bertemu Adam."
    },
    {
      "type": "paragraph",
      "text": "Adam membuka laptop."
    },
    {
      "type": "paragraph",
      "text": "“Batch seterusnya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memberikan angka."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka buku nota."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tengok jumlah sahaja.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa lagi?”"
    },
    {
      "type": "paragraph",
      "text": "“Input.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Output.”"
    },
    {
      "type": "paragraph",
      "text": "“QC.”"
    },
    {
      "type": "paragraph",
      "text": "“Inventory.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita buat benda haram.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi cara cikgu bercakap macam kita tengah buat production planning kilang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya tetap sama.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tak tahu apa masuk, apa keluar dan apa yang hilang…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup buku."
    },
    {
      "type": "paragraph",
      "text": "“…kita takkan tahu kita untung atau rugi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Fair.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, mereka menyelesaikan satu batch."
    },
    {
      "type": "paragraph",
      "text": "Adam memeriksa rekod."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuat kiraan."
    },
    {
      "type": "paragraph",
      "text": "Ada satu masalah."
    },
    {
      "type": "paragraph",
      "text": "“Berapa sepatutnya?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut angka jangkaan."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengira semula."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengira sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tak kena.”"
    },
    {
      "type": "paragraph",
      "text": "Adam datang ke sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Output.”"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat angka itu."
    },
    {
      "type": "paragraph",
      "text": "“Kurang?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk."
    },
    {
      "type": "paragraph",
      "text": "“Lebih.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Jangkaan 60.2 kilogram.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Produk siap yang kita rekod…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menulis satu lagi angka."
    },
    {
      "type": "paragraph",
      "text": "“Enam puluh kilogram.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua ratus gram.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu risau pasal dua ratus gram?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Lebih tak apa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk angka itu."
    },
    {
      "type": "paragraph",
      "text": "“Jangan kurang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Baiklah.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka mula memeriksa rekod."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Input."
    },
    {
      "type": "paragraph",
      "text": "Output."
    },
    {
      "type": "paragraph",
      "text": "Sampel."
    },
    {
      "type": "paragraph",
      "text": "Baki."
    },
    {
      "type": "paragraph",
      "text": "Hold."
    },
    {
      "type": "paragraph",
      "text": "Packaging."
    },
    {
      "type": "paragraph",
      "text": "Adam tiba-tiba berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ini.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjukkan satu rekod."
    },
    {
      "type": "paragraph",
      "text": "Rizal datang dekat."
    },
    {
      "type": "paragraph",
      "text": "Adam membaca semula."
    },
    {
      "type": "paragraph",
      "text": "“Yang ini kita dah kira.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang rekod lain."
    },
    {
      "type": "paragraph",
      "text": "Kemudian faham."
    },
    {
      "type": "paragraph",
      "text": "Mereka telah mengira satu bahagian dua kali dalam rekod sebelumnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak hilang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Adam bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Saya ingat ada orang curi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya ingat cikgu ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Saya?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua ratus gram.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya curi, saya tak ambil dua ratus gram.”"
    },
    {
      "type": "paragraph",
      "text": "Adam turut ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Betul juga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup buku."
    },
    {
      "type": "paragraph",
      "text": "“Kita bukan buat benda ni untuk guna.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Kita buat sebab duit.”"
    },
    {
      "type": "paragraph",
      "text": "Ayat itu keluar dengan mudah."
    },
    {
      "type": "paragraph",
      "text": "Terlalu mudah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, mereka menghantar produk kepada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak datang seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Ada seorang lelaki bersamanya."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mengenalinya."
    },
    {
      "type": "paragraph",
      "text": "Ah Len memperkenalkan secara ringkas."
    },
    {
      "type": "paragraph",
      "text": "“Orang saya.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu hanya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal membalas."
    },
    {
      "type": "paragraph",
      "text": "Mereka tidak banyak bercakap."
    },
    {
      "type": "paragraph",
      "text": "Urusan selesai."
    },
    {
      "type": "paragraph",
      "text": "Sebelum pergi, Ah Len berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Barang kau konsisten.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bagus?”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Orang tak cari barang yang bagus sekali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Mereka cari barang yang bagus setiap kali.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len masuk ke dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang kereta itu pergi."
    },
    {
      "type": "paragraph",
      "text": "Adam berdiri di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau dengar?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Apa dia cakap?”"
    },
    {
      "type": "paragraph",
      "text": "“Consistency.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang cikgu dah ada pelanggan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membetulkan."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia beli lagi, baru pelanggan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Minggu berikutnya, Ah Len datang lagi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian minggu selepas itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian lagi."
    },
    {
      "type": "paragraph",
      "text": "Jumlah semakin meningkat."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula menyimpan rekod."
    },
    {
      "type": "paragraph",
      "text": "Tarikh."
    },
    {
      "type": "paragraph",
      "text": "Jumlah."
    },
    {
      "type": "paragraph",
      "text": "Kos."
    },
    {
      "type": "paragraph",
      "text": "Bayaran."
    },
    {
      "type": "paragraph",
      "text": "Baki."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak mempercayai ingatan."
    },
    {
      "type": "paragraph",
      "text": "Dia mempercayai angka."
    },
    {
      "type": "paragraph",
      "text": "Setiap malam, selepas Linda tidur, Rizal duduk di meja."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka buku."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu angka dimasukkan."
    },
    {
      "type": "paragraph",
      "text": "Ada duit masuk."
    },
    {
      "type": "paragraph",
      "text": "Ada duit keluar."
    },
    {
      "type": "paragraph",
      "text": "Ada kos yang tidak dijangka."
    },
    {
      "type": "paragraph",
      "text": "Tetapi satu perkara semakin jelas."
    },
    {
      "type": "paragraph",
      "text": "**Ada keuntungan.**"
    },
    {
      "type": "paragraph",
      "text": "Bukan banyak."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk membuat Rizal sedar bahawa RM500,000 mungkin bukan lagi sesuatu yang mustahil."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu malam, Linda masuk ke ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Rizal cepat-cepat menutup buku."
    },
    {
      "type": "paragraph",
      "text": "Linda berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Abang buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
      "text": "“Pukul dua belas malam?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja tambahan.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang meja."
    },
    {
      "type": "paragraph",
      "text": "“Kena banyak sangat ke kerja tambahan sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekejap saja.”"
    },
    {
      "type": "paragraph",
      "text": "Linda duduk."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Duit kita okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab abang nampak lebih tenang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Baguslah kalau tenang.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum pergi, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan terlalu paksa diri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Selepas Linda masuk bilik, dia membuka buku semula."
    },
    {
      "type": "paragraph",
      "text": "Tangannya berhenti di satu angka."
    },
    {
      "type": "paragraph",
      "text": "Keuntungan bulan itu."
    },
    {
      "type": "paragraph",
      "text": "Dia memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian senyum."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Tetapi Adam tidak tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk di dalam kereta keesokan harinya."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus serius."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Demand.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut jumlah yang diminta Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Boleh?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita kekalkan cara sekarang, susah.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita perlukan kapasiti lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ke luar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Tempat?”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat.”"
    },
    {
      "type": "paragraph",
      "text": "“Orang?”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Bahan?”"
    },
    {
      "type": "paragraph",
      "text": "“Masalah lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "Dia mula menulis sesuatu di dalam buku."
    },
    {
      "type": "paragraph",
      "text": "Adam memandang."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Planning.”"
    },
    {
      "type": "paragraph",
      "text": "“Planning apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menulis empat perkataan."
    },
    {
      "type": "paragraph",
      "text": "**Capacity. Supply. Quality. Cash.**"
    },
    {
      "type": "paragraph",
      "text": "Adam membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu betul-betul dah jadi manager.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak ketawa."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang empat perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tak boleh scale…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…kita akan hilang pelanggan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dan itulah saat pertama Rizal memahami sesuatu yang jauh lebih besar daripada sekadar membuat duit."
    },
    {
      "type": "paragraph",
      "text": "**Pasaran tidak menunggu orang yang lambat.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Rizal duduk di rumah bersama Linda."
    },
    {
      "type": "paragraph",
      "text": "Linda membuka satu sampul surat."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Bil hospital.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat jumlah."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membayar."
    },
    {
      "type": "paragraph",
      "text": "Tanpa berfikir panjang."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dari mana duit ni?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kerja tambahan.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia percaya."
    },
    {
      "type": "paragraph",
      "text": "Rizal memasukkan telefon ke dalam poket."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang Linda."
    },
    {
      "type": "paragraph",
      "text": "“Dah cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal membuka buku nota."
    },
    {
      "type": "paragraph",
      "text": "Di halaman pertama masih tertulis:"
    },
    {
      "type": "paragraph",
      "text": "**RM500,000.**"
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Membulatkan angka itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menulis di sebelahnya:"
    },
    {
      "type": "paragraph",
      "text": "**RM1,000,000.**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Memandang angka itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadamnya."
    },
    {
      "type": "paragraph",
      "text": "“Bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menulis semula:"
    },
    {
      "type": "paragraph",
      "text": "**RM500,000.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup buku."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum tidur, dia membukanya semula."
    },
    {
      "type": "paragraph",
      "text": "Angka itu masih di situ."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Menambah satu lagi perkataan di bawahnya."
    },
    {
      "type": "paragraph",
      "text": "**Selepas itu berhenti.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Seolah-olah dia sendiri percaya."
    },
    {
      "type": "paragraph",
      "text": "Di luar rumah, sebuah kereta perlahan-lahan melalui Jalan Bulan Pristana."
    },
    {
      "type": "paragraph",
      "text": "Kereta itu tidak berhenti."
    },
    {
      "type": "paragraph",
      "text": "Tidak membunyikan hon."
    },
    {
      "type": "paragraph",
      "text": "Hanya lalu."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya, seorang lelaki memandang rumah Rizal dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Telefon di tangannya berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Suara di hujung talian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Betul orangnya?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu melihat rumah sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "“Belum pasti.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Dia diam beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi kalau betul…”"
    },
    {
      "type": "paragraph",
      "text": "Kereta itu terus bergerak."
    },
    {
      "type": "paragraph",
      "text": "“…kita baru jumpa orang yang kita cari.”"
    }
