    },
    {
      "type": "paragraph",
      "text": "“Masih sama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berjalan ke tingkap."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang luar."
    },
    {
      "type": "paragraph",
      "text": "Permintaan meningkat."
