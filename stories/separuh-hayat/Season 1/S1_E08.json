    },
    {
      "type": "paragraph",
      "text": "Adam membaca."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau orang lain nampak cara cikgu fikir…”"
