{
  "series": "Separuh Hayat",
  "season": 1,
  "episode": 8,
  "title": "S1 E8",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 8\n### Permintaan"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6:05 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di dapur."
    },
    {
      "type": "paragraph",
      "text": "Kopi di tangan."
    },
    {
      "type": "paragraph",
      "text": "Telefon di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej masih belum dibalas."
    },
    {
      "type": "paragraph",
      "text": "**Ah Len.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca mesej terakhirnya sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "> “Ada orang sedang cari kita.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengunci telefon."
    },
    {
      "type": "paragraph",
      "text": "Linda masuk ke dapur."
    },
    {
      "type": "paragraph",
      "text": "“Awal bangun?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tidur sangat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak fikir.”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Linda mengambil cawan."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan lupa appointment petang ni.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Tak lupa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda berhenti seketika."
    },
    {
      "type": "paragraph",
      "text": "“Abang…”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau abang ada masalah, beritahu saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang isterinya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi jelas dia tidak sepenuhnya percaya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8:30 pagi."
    },
    {
      "type": "paragraph",
      "text": "Sekolah."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengajar seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Di papan putih dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**PROSES YANG BAIK = HASIL YANG KONSISTEN**"
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu, kalau hasil tak konsisten?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari punca.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau punca banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Susun.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau banyak sangat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jangan panik.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal berpaling ke papan putih."
    },
    {
      "type": "paragraph",
      "text": "Dia sendiri sedang cuba mengikuti nasihat itu."
    },
    {
      "type": "paragraph",
      "text": "Jangan panik."
    },
    {
      "type": "paragraph",
      "text": "Susun."
    },
    {
      "type": "paragraph",
      "text": "Cari punca."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 12:46 tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Telefon Rizal bergetar."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "> “Kita perlu bincang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membalas."
    },
    {
      "type": "paragraph",
      "text": "> “Malam.”"
    },
    {
      "type": "paragraph",
      "text": "Jawapan datang hampir serta-merta."
    },
    {
      "type": "paragraph",
      "text": "> “Sekarang lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "Adam jarang mendesak."
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar dari bilik guru."
    },
    {
      "type": "paragraph",
      "text": "Menelefon."
    },
    {
      "type": "paragraph",
      "text": "“Apa jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Demand naik.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut angka."
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia nak cepat.”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kalau ikut kapasiti sekarang, tak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Saya jumpa kau malam.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu mereka duduk di sebuah meja."
    },
    {
      "type": "paragraph",
      "text": "Laptop dibuka."
    },
    {
      "type": "paragraph",
      "text": "Beberapa helaian rekod berada di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Adam menunjukkan angka."
    },
    {
      "type": "paragraph",
      "text": "“Kita ada tiga masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Pertama?”"
    },
    {
      "type": "paragraph",
      "text": "“Capacity.”"
    },
    {
      "type": "paragraph",
      "text": "“Kedua?”"
    },
    {
      "type": "paragraph",
      "text": "“Supply.”"
    },
    {
      "type": "paragraph",
      "text": "“Ketiga?”"
    },
    {
      "type": "paragraph",
      "text": "“Cash.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Quality?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Masih okay.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kita tak boleh tambah output tanpa ganggu quality.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau quality jatuh?”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len cari orang lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Menulis di atas kertas."
    },
    {
      "type": "paragraph",
      "text": "**DEMAND**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**CAPACITY**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**SUPPLY**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**CASH**"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita perlukan tempat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat yang lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan lebih selamat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Cari.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Macam cari rumah sewa?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari tempat.”"
    },
    {
      "type": "paragraph",
      "text": "“Budget?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyebut jumlah."
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Budget macam tu?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita tak boleh lebih.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Dua hari kemudian, mereka melihat beberapa tempat."
    },
    {
      "type": "paragraph",
      "text": "Satu terlalu terbuka."
    },
    {
      "type": "paragraph",
      "text": "Satu terlalu dekat dengan kawasan perumahan."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi terlalu mahal."
    },
    {
      "type": "paragraph",
      "text": "Tempat terakhir kelihatan sesuai."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Terlalu banyak orang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pekerja keluar masuk."
    },
    {
      "type": "paragraph",
      "text": "Sebuah lori berhenti."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka pergi."
    },
    {
      "type": "paragraph",
      "text": "Di dalam kereta, Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kita tak boleh terburu-buru.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Demand sedang naik.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tak ikut, orang lain akan ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu terlalu fikir pasal pelanggan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Pelanggan ialah duit.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Duit ialah masa.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Setiap bulan saya tak buat duit, masa saya berkurang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali, Adam tidak ada jawapan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal pergi ke Hospital Bandaraya."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di ruang menunggu bersama Linda."
    },
    {
      "type": "paragraph",
      "text": "Linda memegang tangannya."
    },
    {
      "type": "paragraph",
      "text": "“Takut?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Abang pun manusia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Selama ni ingat apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang abang macam robot.”"
    },
    {
      "type": "paragraph",
      "text": "“Robot pun kena servis.”"
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa."
    },
    {
      "type": "paragraph",
      "text": "Nama Rizal dipanggil."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk."
    },
    {
      "type": "paragraph",
      "text": "Pemeriksaan berlangsung beberapa lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian doktor menjelaskan keadaan semasa."
    },
    {
      "type": "paragraph",
      "text": "Rawatan perlu diteruskan."
    },
    {
      "type": "paragraph",
      "text": "Ada kemungkinan kesan sampingan."
    },
    {
      "type": "paragraph",
      "text": "Ada beberapa perkara yang perlu dipantau."
    },
    {
      "type": "paragraph",
      "text": "Rizal mendengar semuanya."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Doktor.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya terus kerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh. Tapi jangan paksa diri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Dalam perjalanan pulang, Linda diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Abang dah berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memandang jalan."
    },
    {
      "type": "paragraph",
      "text": "“Berubah macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda melihat keluar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kalau ada masalah, abang cerita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang abang simpan.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak nak awak risau.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Itu alasan abang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Ah Len datang."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di hadapan Rizal dan Adam."
    },
    {
      "type": "paragraph",
      "text": "“Saya perlukan lebih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal meneruskan,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi bukan sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Bila kita bersedia.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Pasaran tak tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu apa masalah orang yang baru masuk dunia ni?”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka fikir duit datang bila barang siap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menunjuk kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Duit datang bila barang sampai kepada orang yang nak beli.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Logistik.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang cikgu dah mula faham.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas Ah Len pergi, Rizal membuka buku nota."
