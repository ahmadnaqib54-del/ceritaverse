{
  "series": "Separuh Hayat",
  "season": 1,
  "episode": 12,
  "title": "S1 E12",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 12\n### Dato' Hashim"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8:15 malam."
    },
    {
      "type": "paragraph",
      "text": "Rumah di Jalan Bulan Pristana dipenuhi suara."
    },
    {
      "type": "paragraph",
      "text": "“Amir, tambah nasi?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak payah, kak. Dah kenyang.”"
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Kau dari dulu cakap dah kenyang. Lepas tu tambah.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kakak paksa, saya tambah.”"
    },
    {
      "type": "paragraph",
      "text": "Roy ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di hujung meja."
    },
    {
      "type": "paragraph",
      "text": "Dia lebih banyak diam."
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Abang Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Lama tak jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "“Kak Linda kata abang banyak kerja sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Biasalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Masih mengajar?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak nak pencen?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Umur lima puluh baru nak pencen?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh. Duduk rumah.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Kalau abang duduk rumah, lagi pening.”"
    },
    {
      "type": "paragraph",
      "text": "Semua ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal turut ketawa."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa minit, semuanya terasa normal."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Makanan."
    },
    {
      "type": "paragraph",
      "text": "Gurauan."
    },
    {
      "type": "paragraph",
      "text": "Seperti dahulu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Amir bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Abang pernah dengar nama Ah Len?”"
    },
    {
      "type": "paragraph",
      "text": "Tangan Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Hanya sesaat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup lama untuk Amir perasan."
    },
    {
      "type": "paragraph",
      "text": "“Ah Len?”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil air."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "Amir bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
      "text": "“Kes?”"
    },
    {
      "type": "paragraph",
      "text": "“Lebih kurang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Tak pernah.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Baguslah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membalas senyuman."
    },
    {
      "type": "paragraph",
      "text": "Tetapi di dalam kepalanya, satu perkataan berulang."
    },
    {
      "type": "paragraph",
      "text": "**Ah Len.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas makan, Amir membantu Linda mengemas meja."
    },
    {
      "type": "paragraph",
      "text": "Rizal membawa Roy ke ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Amir datang beberapa minit kemudian."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di sebelah Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak tanya sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Pasal kerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Amir membuka telefon."
    },
    {
      "type": "paragraph",
      "text": "Menunjukkan satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Tidak terlalu lama."
    },
    {
      "type": "paragraph",
      "text": "“Kenal?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Pernah nampak?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia antara orang yang kami sedang perhatikan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal cuba kelihatan tenang."
    },
    {
      "type": "paragraph",
      "text": "“Bahaya?”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kalau tak bahaya, saya takkan tengok.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jaga diri.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Abang pun.”"
    },
    {
      "type": "paragraph",
      "text": "Mata mereka bertemu."
    },
    {
      "type": "paragraph",
      "text": "Hanya beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Amir bangun."
    },
    {
      "type": "paragraph",
      "text": "“Saya balik dulu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pintu rumah ditutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Abang?”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Amir cakap apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
      "text": "“Pasal?”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len.”"
    },
    {
      "type": "paragraph",
      "text": "Linda terus memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang dia sedang siasat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Menutup pintu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon di atas meja berdering."
    },
    {
      "type": "paragraph",
      "text": "**Hashim.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya, Dato'.”"
    },
    {
      "type": "paragraph",
      "text": "“Sudah fikir?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat ke luar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Sudah.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak tengok.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Satu jam kemudian."
    },
    {
      "type": "paragraph",
      "text": "Rizal tiba di Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Hashim sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "Kali ini Adam turut berada di situ."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandang kedua-duanya."
    },
    {
      "type": "paragraph",
      "text": "“Dah buat keputusan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kami nak tahu apa Dato' tawarkan.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya bukan nak jual barang kepada kamu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan."
    },
    {
      "type": "paragraph",
      "text": "“Saya nak buka pintu.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka mengikut."
    },
    {
      "type": "paragraph",
      "text": "Pintu pertama dibuka."
    },
    {
      "type": "paragraph",
      "text": "Ruang penyimpanan."
    },
    {
      "type": "paragraph",
      "text": "Pintu kedua."
    },
    {
      "type": "paragraph",
      "text": "Ruang operasi."
    },
    {
      "type": "paragraph",
      "text": "Pintu ketiga."
    },
    {
      "type": "paragraph",
      "text": "Koridor yang lebih panjang."
    },
    {
      "type": "paragraph",
      "text": "Semakin jauh mereka berjalan, semakin sedikit bunyi dari luar kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Adam mula sedar."
    },
    {
      "type": "paragraph",
      "text": "“Dato'…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat ni sebenarnya apa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bumi Perdana ada banyak bahagian.”"
    },
    {
      "type": "paragraph",
      "text": "Dia membuka satu lagi pintu."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan mereka terdapat sebuah fasiliti tersembunyi yang jauh lebih besar daripada apa yang pernah mereka lihat."
    },
    {
      "type": "paragraph",
      "text": "Peralatan."
    },
    {
      "type": "paragraph",
      "text": "Tangki."
    },
    {
      "type": "paragraph",
      "text": "Ruang pemprosesan."
    },
    {
      "type": "paragraph",
      "text": "Sistem kawalan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang sedang bekerja."
    },
    {
      "type": "paragraph",
      "text": "Semuanya tersusun."
    },
    {
      "type": "paragraph",
      "text": "Teratur."
    },
    {
      "type": "paragraph",
      "text": "Senaman."
    },
    {
      "type": "paragraph",
      "text": "Tidak."
    },
    {
      "type": "paragraph",
      "text": "Ini bukan tempat kecil."
    },
    {
      "type": "paragraph",
      "text": "Ini sebuah operasi."
    },
    {
      "type": "paragraph",
      "text": "Adam tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Rizal hanya memandang."
    },
    {
      "type": "paragraph",
      "text": "Hashim berdiri di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Selamat datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan semua ini…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sudah berjalan sebelum kau datang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang melihat sesuatu yang lebih besar daripada apa yang pernah dibayangkannya."
    },
    {
      "type": "paragraph",
      "text": "Bukan sekadar produk."
    },
    {
      "type": "paragraph",
      "text": "Bukan sekadar pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Bukan sekadar wang."
    },
    {
      "type": "paragraph",
      "text": "**Sebuah sistem.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hashim membawa mereka ke sebuah bilik pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk."
    },
    {
      "type": "paragraph",
      "text": "Rizal dan Adam mengambil tempat."
    },
    {
      "type": "paragraph",
      "text": "Hashim menuang air."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kamu faham kenapa saya berminat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dato' tak perlukan pembuat.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Dato' perlukan orang yang boleh urus.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Dan kami dapat apa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Keselamatan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Dalam dunia macam ni?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tidak ada keselamatan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan gelas."
    },
    {
      "type": "paragraph",
      "text": "“Yang ada cuma orang yang cukup kuat untuk mengawal risiko.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Dan apa peranan kami?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menjawab tanpa teragak-agak."
    },
    {
      "type": "paragraph",
      "text": "“Kamu akan bantu saya bina sesuatu yang lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Bukan esok.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan bulan depan.”"
    },
    {
      "type": "paragraph",
      "text": "“Tetapi perlahan-lahan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya tidak perlukan orang yang mahu kaya cepat.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Saya perlukan orang yang faham sistem.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas perbincangan selesai, Rizal dan Adam keluar."
    },
    {
      "type": "paragraph",
      "text": "Mereka berjalan menuju kereta."
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Adam masih berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita tak patut masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat itu terlalu besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bukankah itu yang kita mahu?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Saya nak duit.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak nak perang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Adam ikut."
    },
    {
      "type": "paragraph",
