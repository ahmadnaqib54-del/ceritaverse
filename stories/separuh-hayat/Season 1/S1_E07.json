  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 7\n### Ah Len"
    },
    {
      "type": "paragraph",
      "text": "Ah Len duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang telefonnya."
    },
    {
      "type": "paragraph",
      "text": "Nama yang baru disimpan masih berada di skrin."
    },
    {
      "type": "paragraph",
      "text": "**Rizal.**"
    },
    {
      "type": "paragraph",
      "text": "Dia tekan nombor itu."
    },
    {
      "type": "paragraph",
      "text": "Tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Ah Len cuba sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Masih tiada jawapan."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu sibuk.”"
    },
    {
      "type": "paragraph",
      "text": "Telefon diletakkan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seseorang masuk ke dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki berusia lewat tiga puluhan."
    },
    {
      "type": "paragraph",
      "text": "“Dia siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang baru.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau tak penting, kenapa kau call dua kali?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kerana saya suka barang dia.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Barang orang lain pun banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tak macam dia.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 7:10 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sedang sarapan."
    },
    {
      "type": "paragraph",
      "text": "Linda meletakkan telur di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok appointment hospital.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan lupa.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak lupa.”"
    },
    {
      "type": "paragraph",
      "text": "Roy masuk."
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh hantar saya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jam."
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Thanks.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun mengambil kunci."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Abang nampak penat.”"
    },
    {
      "type": "paragraph",
      "text": "“Kurang tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
