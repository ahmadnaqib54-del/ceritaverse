      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandang suaminya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di dalam kereta, Roy membuka radio."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menukarnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menukarnya lagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang."
    },
    {
      "type": "paragraph",
      "text": "“Cari apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Lagu.”"
    },
    {
      "type": "paragraph",
      "text": "“Lagu apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Logik kau hebat.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian dia bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Ayah betul-betul okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jalan."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab mama risau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Ayah okay.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau ayah takut, tak apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh sekejap."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak apa kalau takut.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandang jalan."
    },
    {
      "type": "paragraph",
      "text": "Kata-kata itu melekat dalam kepalanya sepanjang perjalanan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal berjumpa Adam."
    },
    {
      "type": "paragraph",
      "text": "Adam membawa satu berita."
    },
    {
      "type": "paragraph",
      "text": "“Ah Len ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Supplier lama dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak suka kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa dia tahu tentang kita?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Orang bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Nama?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len takut?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ah Len tak nampak macam orang yang takut.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia nampak macam orang yang sedang mengira.”"
    },
    {
      "type": "paragraph",
      "text": "“Semua orang mengira.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Tapi orang macam Ah Len mengira berapa ramai orang yang boleh bunuh dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Ah Len bertemu dengan orang lama."
    },
    {
      "type": "paragraph",
      "text": "Sebuah meja."
    },
    {
      "type": "paragraph",
      "text": "Tiga lelaki."
    },
    {
      "type": "paragraph",
      "text": "Tiada senjata di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Tiada jeritan."
    },
    {
      "type": "paragraph",
      "text": "Hanya kopi."
    },
    {
      "type": "paragraph",
      "text": "Lelaki paling tua memandang Ah Len."
    },
    {
      "type": "paragraph",
      "text": "“Kau ambil barang dari orang baru?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Lebih konsisten.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu mengetuk meja dengan jarinya."
    },
    {
      "type": "paragraph",
      "text": "“Barang lama kita tak cukup bagus?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu berapa tahun kita bina rangkaian ni?”"
    },
    {
      "type": "paragraph",
      "text": "“Tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kenapa kau bawa orang baru?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Sebab pelanggan nak sesuatu yang lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tersenyum sinis."
    },
    {
      "type": "paragraph",
      "text": "“Pelanggan?”"
    },
    {
      "type": "paragraph",
      "text": "Dia menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Pelanggan boleh ditukar.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Barang pun boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Suasana terus senyap."
    },
    {
      "type": "paragraph",
      "text": "Ah Len bangun."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak cari masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Masalah akan cari kau.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Kalau begitu…”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“…biar dia datang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Ah Len datang berjumpa Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal sedang memeriksa beberapa rekod."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len duduk."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup buku."
    },
    {
      "type": "paragraph",
      "text": "“Supplier lama?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cepat belajar.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka tak suka saya ambil barang dari kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berfikir."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang mereka mahu?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu ni kelakar.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Masalah manusia tak selalu ada penyelesaian macam spreadsheet.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Mereka mahu saya berhenti ambil daripada kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak suka orang suruh saya buat apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kau akan terus beli?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam yang berada di sebelah Rizal terus mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Risiko?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Sentiasa ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kita tak nak perang.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya pun tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Saya akan urus.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari berlalu."
    },
    {
      "type": "paragraph",
      "text": "Tiada apa berlaku."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula berasa lega."
    },
    {
      "type": "paragraph",
      "text": "Dia kembali kepada rutin."
    },
    {
      "type": "paragraph",
      "text": "Sekolah."
    },
    {
      "type": "paragraph",
      "text": "Rumah."
    },
    {
      "type": "paragraph",
      "text": "Hospital."
    },
    {
      "type": "paragraph",
      "text": "Dan kerja malam."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ketenangan itu hanya sementara."
    },
    {
      "type": "paragraph",
      "text": "Suatu petang, ketika Rizal keluar dari sekolah, dia melihat sebuah kereta hitam berada di seberang jalan."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kereta itu tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kereta itu bergerak pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di situ."
    },
    {
      "type": "paragraph",
      "text": "Seorang guru keluar dari pintu."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersentak."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jom makan.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Guru itu ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Kau ni sejak kebelakangan ni macam businessman.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Gaji guru tak cukup untuk jadi businessman.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka ketawa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi mata Rizal masih mengikuti kereta tadi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, dia memberitahu Adam."
    },
    {
      "type": "paragraph",
      "text": "“Kereta hitam.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Nombor?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak nampak.”"
    },
    {
      "type": "paragraph",
      "text": "“Jenama?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak pasti.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kita tak tahu itu siapa.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan paranoid.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak paranoid.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu baru saja periksa tingkap tiga kali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Empat kali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjeling."
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada malam yang sama, Ah Len menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Suara di hujung talian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Orang kau masih ambil barang daripada dia?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Talian senyap."
    },
    {
      "type": "paragraph",
      "text": "Kemudian suara itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ini amaran terakhir.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Ah Len meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat lelaki di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya saya tak bosan.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, satu penghantaran sepatutnya berlaku."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Ah Len tidak muncul."
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Sepuluh minit."
    },
    {
      "type": "paragraph",
      "text": "Dua puluh."
    },
    {
      "type": "paragraph",
      "text": "Tiga puluh."
    },
    {
      "type": "paragraph",
      "text": "Adam melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Tak datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menelefon."
    },
    {
      "type": "paragraph",
      "text": "Tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia menelefon lagi."
    },
    {
      "type": "paragraph",
      "text": "Masih tidak."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej masuk."
    },
    {
      "type": "paragraph",
      "text": "**“Tangguh.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksudnya?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak suka jawapan itu."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka buku nota."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia tak ambil?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kita rugi.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut angka."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Bukan jumlah yang kecil."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bukan itu yang mengganggunya."
    },
    {
      "type": "paragraph",
      "text": "Yang mengganggu ialah satu perkara."
    },
    {
      "type": "paragraph",
      "text": "**Mereka bergantung kepada seorang pembeli.**"
    },
    {
      "type": "paragraph",
      "text": "Dan itu adalah kelemahan."
    },
    {
      "type": "paragraph",
      "text": "Rizal menulis sesuatu di dalam buku."
    },
    {
      "type": "paragraph",
      "text": "Adam melihat."
    },
    {
      "type": "paragraph",
      "text": "**Satu pelanggan = risiko.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menambah:"
    },
    {
      "type": "paragraph",
      "text": "**Dua pelanggan = lebih banyak risiko.**"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Tak membantu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kita perlukan lebih banyak pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Ah Len akhirnya muncul."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya sedikit lebam."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len duduk."
    },
    {
      "type": "paragraph",
      "text": "“Masalah kecil.”"
    },
    {
      "type": "paragraph",
      "text": "“Lebam macam ni masalah kecil?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu, kalau saya cerita semua masalah saya, kita takkan habis malam ni.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa buat?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa datang juga?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya dah pilih.”"
    },
    {
      "type": "paragraph",
      "text": "“Pilih apa?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Barang kau konsisten.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk dirinya."
    },
    {
      "type": "paragraph",
      "text": "“Dan saya tak suka orang buat keputusan untuk saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Buat pertama kali, dia mula memahami lelaki itu."
    },
    {
      "type": "paragraph",
      "text": "Ah Len bukan sekadar pembeli."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang memilih pihak."
    },
    {
      "type": "paragraph",
      "text": "Dan pilihan itu mungkin akan membawa masalah yang jauh lebih besar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sebelum Ah Len pergi, Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau percaya kami?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len berhenti di pintu."
    },
    {
      "type": "paragraph",
      "text": "Dia menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak percaya kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Saya percaya barang kau.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Belum sama.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len keluar."
    },
    {
      "type": "paragraph",
      "text": "Pintu ditutup."
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Dia jujur.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu suka orang macam tu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berfikir."
    },
    {
      "type": "paragraph",
      "text": "“Lebih baik daripada orang yang pura-pura percaya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin lewat."
    },
    {
      "type": "paragraph",
      "text": "Rizal pulang."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah tidur."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Meletakkan beg."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat sesuatu di bawah pintu."
    },
    {
      "type": "paragraph",
      "text": "Sekeping kertas."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Tiada nama."
    },
    {
      "type": "paragraph",
      "text": "Tiada alamat."
    },
    {
      "type": "paragraph",
      "text": "Hanya satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**BERHENTI SEBELUM KAU TAK BOLEH BERHENTI.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca sekali."
    },
    {
      "type": "paragraph",
      "text": "Kemudian sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang pintu."
    },
    {
      "type": "paragraph",
      "text": "Jantungnya mula berdegup laju."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej daripada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "> **“Cikgu, jangan panik. Ada orang sedang cari kita.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kertas di tangannya."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, dia hanya berdiri di tengah ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia melipat kertas itu."
    },
    {
      "type": "paragraph",
      "text": "Memasukkannya ke dalam poket."
    },
    {
      "type": "paragraph",
      "text": "Dan berjalan masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak memberitahu Linda."
    },
    {
      "type": "paragraph",
      "text": "Tidak memberitahu Roy."
    },
    {
      "type": "paragraph",
      "text": "Tidak memberitahu sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Kerana Rizal sudah mula belajar satu perkara:"
    },
    {
      "type": "paragraph",
      "text": "**Dalam dunia yang dia baru masuk, ketakutan tidak boleh ditunjukkan.**"
    },
    {
      "type": "paragraph",
      "text": "Tetapi jauh di dalam dirinya, satu soalan mula muncul."
    },
    {
      "type": "paragraph",
      "text": "**Siapa sebenarnya yang sedang memerhatikannya?**"
    }
  ],
