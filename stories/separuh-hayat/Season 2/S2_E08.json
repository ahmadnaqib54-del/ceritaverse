    {
      "type": "paragraph",
      "text": "Dia hampir menghantar."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Memadam."
    },
    {
      "type": "paragraph",
      "text": "Tidak."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak mahu mencampurkan keluarga dengan kerja."
    },
    {
      "type": "paragraph",
      "text": "Sekurang-kurangnya belum."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Rizal dan Hashim duduk berdua."
    },
    {
      "type": "paragraph",
      "text": "Hashim membuka satu fail lama."
    },
    {
      "type": "paragraph",
      "text": "“Awak nak tahu apa kesilapan terbesar saya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya pernah fikir saya boleh kawal semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Kita hanya boleh kawal sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan sistem?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak pernah betul-betul boleh dikawal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa yang kita buat?”"
    },
    {
      "type": "paragraph",
      "text": "“Jaga arah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Itu jawapan yang dia suka."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia belum sedar satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Dia mula membandingkan cara Hashim dengan caranya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Dan semakin banyak dia belajar…"
    },
    {
      "type": "paragraph",
      "text": "semakin banyak dia nampak perkara yang dia rasa boleh dilakukan dengan lebih baik."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Adam masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Rizal sedang melihat carta."
    },
    {
      "type": "paragraph",
      "text": "“Masih kerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau suatu hari nanti Hashim hilang…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus berhenti."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“…apa kau buat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya benda tu?”"
    },
    {
      "type": "paragraph",
      "text": "“Saja.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sistem tetap berjalan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan siapa yang pegang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang carta di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang paling layak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau tanya macam kau dah tahu jawapannya?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan lupa.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita datang sini sebab kau nak lindungi keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan sampai satu hari nanti kau lupa kenapa kau mula.”"
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali memandang carta."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Suara Hashim kedengaran tenang."
    },
    {
      "type": "paragraph",
      "text": "“Datang esok.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak tunjuk sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Benda yang saya tak pernah tunjuk sesiapa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim menambah,"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang skrin komputernya."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Panggilan tamat."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "Di dinding, ada carta besar sistem Hashim."
    },
    {
      "type": "paragraph",
      "text": "Selama berbulan-bulan dia belajar melihatnya sebagai satu keseluruhan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi malam itu, untuk pertama kali, matanya tidak lagi mencari masalah."
    },
    {
      "type": "paragraph",
      "text": "Dia mencari **kelemahan**."
    },
    {
      "type": "paragraph",
      "text": "Dan dia menemui satu."
    },
    {
      "type": "paragraph",
      "text": "Sangat kecil."
    },
    {
      "type": "paragraph",
      "text": "Tetapi nyata."
    },
    {
      "type": "paragraph",
      "text": "Satu titik yang bergantung kepada seorang manusia."
    },
    {
      "type": "paragraph",
      "text": "Rizal menandakan titik itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia sedar apa yang baru dibuatnya."
    },
    {
      "type": "paragraph",
      "text": "Dia bukan lagi melihat sistem sebagai anak murid."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang menilainya sebagai **pemilik masa depan.**"
    },
    {
      "type": "paragraph",
      "text": "Di luar, hujan mula turun."
    },
    {
      "type": "paragraph",
      "text": "Dan di dalam pejabat yang sunyi itu, satu garis mula terbentuk."
    },
    {
      "type": "paragraph",
      "text": "Bukan antara baik dan jahat."
    },
    {
      "type": "paragraph",
      "text": "Bukan antara Rizal dan Hashim."
    },
    {
      "type": "paragraph",
      "text": "Tetapi antara **guru dan anak murid.**"
    },
    {
      "type": "paragraph",
      "text": "Dan apabila seorang anak murid mula percaya bahawa dia boleh mengajar gurunya…"
    },
    {
      "type": "paragraph",
      "text": "hubungan itu tidak akan pernah sama lagi."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 8**"
    }
