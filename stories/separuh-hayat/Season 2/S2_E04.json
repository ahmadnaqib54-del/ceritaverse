  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 4\n## THE RESTAURANT"
    },
    {
      "type": "paragraph",
      "text": "Pukul 12.30 tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Ayam Gepuk Hut penuh."
    },
    {
      "type": "paragraph",
      "text": "Meja hampir semuanya terisi."
    },
    {
      "type": "paragraph",
      "text": "Pelajar kolej."
    },
    {
      "type": "paragraph",
      "text": "Pekerja pejabat."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Beberapa penghantar makanan keluar masuk membawa beg."
    },
    {
      "type": "paragraph",
      "text": "Di belakang kaunter, pekerja bergerak tanpa henti."
    },
    {
      "type": "paragraph",
      "text": "Pesanan masuk."
    },
    {
      "type": "paragraph",
      "text": "Pesanan keluar."
    },
    {
      "type": "paragraph",
      "text": "Duit masuk."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di satu sudut."
    },
    {
      "type": "paragraph",
      "text": "Dia memerhati."
    },
    {
      "type": "paragraph",
      "text": "Hashim duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa saya bawa awak ke sini?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Restoran.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itu jawapan paling bodoh yang pernah awak bagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat sekeliling lagi."
    },
    {
      "type": "paragraph",
      "text": "“Bisnes.”"
    },
    {
      "type": "paragraph",
      "text": "“Masih terlalu umum.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil air."
    },
    {
      "type": "paragraph",
      "text": "“Demonstrasi?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Lebih dekat.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke kaunter."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak duit awak nampak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang."
    },
    {
      "type": "paragraph",
      "text": "“Banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Salah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya nampak data.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mula memahami."
    },
    {
      "type": "paragraph",
      "text": "“Jumlah pelanggan.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Waktu puncak.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Menu paling laku.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Stok.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Pembaziran.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang awak mula nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang restoran itu semula."
    },
    {
      "type": "paragraph",
      "text": "Restoran yang tadi kelihatan biasa tiba-tiba kelihatan seperti satu sistem."
    },
    {
      "type": "paragraph",
      "text": "Setiap meja adalah transaksi."
    },
    {
      "type": "paragraph",
      "text": "Setiap pesanan adalah data."
    },
    {
      "type": "paragraph",
      "text": "Setiap pekerja adalah komponen."
    },
    {
      "type": "paragraph",
      "text": "Setiap minit yang pelanggan menunggu adalah risiko."
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Bisnes yang bagus bukan tentang menjual satu benda.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Menjual pengalaman yang orang mahu ulang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Seorang pekerja datang."
    },
    {
      "type": "paragraph",
      "text": "“Dato’, supplier ayam lambat lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam sejam.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Cari supplier kedua.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Pekerja itu pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Awak memang ada supplier kedua?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awak fikir saya akan bina bisnes yang bergantung pada satu supplier?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menghirup air."
    },
    {
      "type": "paragraph",
      "text": "“Itulah masalah orang kecil.”"
    },
    {
      "type": "paragraph",
      "text": "“Takut rugi?”"
    },
    {
      "type": "paragraph",
      "text": "“Takut kos tambahan.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menunjuk restoran."
    },
    {
      "type": "paragraph",
      "text": "“Orang fikir supplier kedua membazirkan duit.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk pelanggan."
    },
    {
      "type": "paragraph",
      "text": "“Saya fikir supplier kedua membeli ketenangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu masuk ke kepalanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Hashim membawa Rizal ke dapur."
    },
    {
      "type": "paragraph",
      "text": "“Jangan sentuh apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya bukan nak masak.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pekerja lalu."
    },
    {
      "type": "paragraph",
      "text": "“Dato’, sambal habis.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama nak siap?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua puluh minit.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Buat sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia melihat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Nampak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bottleneck.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau satu benda lambat, semua benda ikut lambat.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awak memang tak boleh berhenti jadi cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Awak yang bawa saya ke sini.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka keluar dari dapur."
    },
    {
      "type": "paragraph",
      "text": "Hashim tiba-tiba berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu kenapa saya suka restoran?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua orang datang dengan rela.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Mereka bayar untuk masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk pelanggan."
    },
    {
      "type": "paragraph",
      "text": "“Mereka percaya makanan yang kita beri.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia melihat kaunter."
    },
    {
      "type": "paragraph",
      "text": "“Mereka tinggalkan duit.”"
    },
    {
      "type": "paragraph",
      "text": "Dia kembali memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Dan esok mereka mungkin datang lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Reputasi.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menepuk bahunya."
    },
    {
      "type": "paragraph",
      "text": "“Reputasi lebih mahal daripada duit.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, restoran semakin sibuk."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di luar."
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak lagi berada di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang bercakap dengan pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Ketawa."
    },
    {
      "type": "paragraph",
      "text": "Bersalaman."
    },
    {
      "type": "paragraph",
      "text": "Bergambar."
    },
    {
      "type": "paragraph",
      "text": "Seorang pelanggan memanggil,"
    },
    {
      "type": "paragraph",
      "text": "“Dato’!”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sedap macam biasa!”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Esok datang lagi.”"
    },
    {
      "type": "paragraph",
      "text": "“Confirm!”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit kemudian, Hashim kembali."
    },
    {
      "type": "paragraph",
      "text": "“Awak nampak?”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang pelanggan tadi."
    },
    {
      "type": "paragraph",
      "text": "“Dia kenal awak.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Pelanggan?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sudah lima tahun.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Orang tak ingat nombor akaun.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi orang ingat siapa yang buat mereka rasa dihargai.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Awak buat semua ni sendiri?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ramai.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Orang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Rizal mula perasan sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Setiap kali dia datang ke Ayam Gepuk Hut, ada orang yang Hashim kenal."
    },
    {
      "type": "paragraph",
      "text": "Pembekal."
    },
    {
      "type": "paragraph",
      "text": "Kontraktor."
    },
    {
      "type": "paragraph",
      "text": "Pegawai syarikat."
    },
    {
      "type": "paragraph",
      "text": "Pemilik kedai."
    },
    {
      "type": "paragraph",
      "text": "Pelanggan lama."
    },
    {
      "type": "paragraph",
      "text": "Orang politik tempatan."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada siapa yang kelihatan seperti gangster."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa bercakap tentang perkara pelik."
    },
    {
      "type": "paragraph",
      "text": "Semua bercakap tentang bisnes."
    },
    {
      "type": "paragraph",
      "text": "Harga."
    },
    {
      "type": "paragraph",
      "text": "Premis."
    },
    {
      "type": "paragraph",
      "text": "Bekalan."
    },
    {
      "type": "paragraph",
      "text": "Permit."
    },
    {
      "type": "paragraph",
      "text": "Pekerja."
    },
    {
      "type": "paragraph",
      "text": "Peluang."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang membuat Rizal semakin berhati-hati."
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak membina kuasa dengan menakutkan semua orang."
    },
    {
      "type": "paragraph",
      "text": "Dia membina kuasa dengan membuat orang **mahu bekerja dengannya.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu malam, seorang lelaki tua duduk di meja Hashim."
    },
    {
      "type": "paragraph",
      "text": "Rizal kebetulan berada di situ."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Hashim, saya dengar awak buka cawangan baru.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Insya-Allah.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tapi jangan lupa orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Mana mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu bangun."
    },
    {
      "type": "paragraph",
      "text": "Mereka bersalaman."
    },
    {
      "type": "paragraph",
      "text": "Selepas lelaki itu pergi, Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Supplier?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Lebih penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak menjawab terus."
    },
    {
      "type": "paragraph",
      "text": "“Dia pernah tolong saya masa saya belum ada apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dan sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya boleh tolong dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "“Bisnes bukan cuma siapa berhutang dengan siapa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang siapa yang kita tak lupa.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Linda sedang menyusun pakaian bayi."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti di pintu."
    },
    {
      "type": "paragraph",
      "text": "“Dah beli?”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat pakaian kecil itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Cantik.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak suka?”"
    },
    {
      "type": "paragraph",
      "text": "“Suka.”"
    },
    {
      "type": "paragraph",
      "text": "“Nama?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Belum fikir.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awak sibuk sangat sampai nama anak pun tak fikir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Saya rasa awak banyak berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat pakaian bayi."
    },
    {
      "type": "paragraph",
      "text": "“Berubah macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak sekarang bercakap pasal sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Linda.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma cuba buat hidup kita lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia memegang sehelai baju bayi."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…hidup yang lebih baik bukan hidup yang lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud awak?”"
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan hari di sekolah."
    },
    {
      "type": "paragraph",
      "text": "Rizal sedang mengajar."
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa orang dewasa selalu cakap pasal duit?”"
    },
    {
      "type": "paragraph",
      "text": "Kelas menjadi senyap."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Soalan besar.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Mak saya kata duit penting.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan pen."
    },
    {
      "type": "paragraph",
      "text": "“Duit memang penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tapi…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menulis di papan putih."
    },
    {
      "type": "paragraph",
      "text": "**CUKUP**"
    },
    {
      "type": "paragraph",
      "text": "Dia berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Masalah manusia bukan selalu sebab tak cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang sebab kita tak tahu bila cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Beberapa pelajar diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal sendiri terdiam selepas mengucapkannya."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "**CUKUP.**"
    },
    {
      "type": "paragraph",
      "text": "Entah kenapa, perkataan itu terasa seperti ditulis untuk dirinya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal kembali ke Ayam Gepuk Hut."
    },
    {
      "type": "paragraph",
      "text": "Hashim sedang duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "“Awak lambat.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekolah.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Guru.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu kenapa saya suka awak masih mengajar?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab sekolah mengingatkan awak siapa awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang terlalu lama berada dalam dunia macam kita…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…akan lupa dunia biasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak lupa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak pernah kata saya tak lupa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "Hashim mengambil satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Kita buka cawangan baru.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Restoran?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca beberapa helaian."
    },
    {
      "type": "paragraph",
      "text": "Ada lokasi."
    },
    {
      "type": "paragraph",
      "text": "Syarikat."
    },
    {
      "type": "paragraph",
      "text": "Pelaburan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa angka."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ini langkah seterusnya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Lebih besar?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jauh lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, selepas restoran tutup, Rizal masih berada di dalam."
    },
    {
      "type": "paragraph",
      "text": "Lampu utama sudah dipadam."
    },
    {
      "type": "paragraph",
      "text": "Kerusi diangkat."
    },
    {
      "type": "paragraph",
      "text": "Lantai sedang dibersihkan."
    },
    {
      "type": "paragraph",
      "text": "Tiada pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Tiada muzik."
    },
    {
      "type": "paragraph",
      "text": "Tiada bunyi bising."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri seorang diri di tengah restoran."
    },
    {
      "type": "paragraph",
      "text": "Pada siang hari, tempat itu kelihatan seperti perniagaan biasa."
    },
    {
      "type": "paragraph",
      "text": "Malam itu, dia melihat sesuatu yang lain."
    },
    {
      "type": "paragraph",
      "text": "Satu sistem."
    },
    {
      "type": "paragraph",
      "text": "Satu rangkaian manusia."
    },
    {
      "type": "paragraph",
      "text": "Satu reputasi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesin yang menghasilkan wang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi yang paling menarik perhatiannya bukan restoran."
    },
    {
      "type": "paragraph",
      "text": "Ia adalah Hashim."
    },
    {
      "type": "paragraph",
      "text": "Hashim boleh bercakap dengan pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Boleh bercakap dengan pekerja."
    },
    {
      "type": "paragraph",
      "text": "Boleh bercakap dengan pembekal."
    },
    {
      "type": "paragraph",
      "text": "Boleh bercakap dengan orang kaya."
    },
    {
      "type": "paragraph",
      "text": "Boleh bercakap dengan orang biasa."
    },
    {
      "type": "paragraph",
      "text": "Dan setiap orang nampaknya mahu terus berurusan dengannya."
    },
    {
      "type": "paragraph",
      "text": "Rizal akhirnya memahami satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak membina empayar dengan wang semata-mata."
    },
    {
      "type": "paragraph",
      "text": "Dia membina **kepercayaan.**"
    },
    {
      "type": "paragraph",
      "text": "Dan kepercayaan adalah bentuk kuasa yang jauh lebih sukar untuk dilihat."
    },
    {
      "type": "paragraph",
      "text": "Telefon Rizal berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau dekat mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Ayam Gepuk.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Amir datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus tegak."
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Dia datang tanya pasal Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang pintu restoran."
    },
    {
      "type": "paragraph",
      "text": "Seketika, bunyi malam terasa hilang."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggenggam telefon."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang papan tanda Ayam Gepuk Hut."
    },
    {
      "type": "paragraph",
      "text": "Tempat yang beberapa jam lalu dipenuhi keluarga dan pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Sekarang sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali, Rizal sedar—"
    },
    {
      "type": "paragraph",
      "text": "tempat yang paling selamat untuk seseorang menyembunyikan sesuatu bukanlah tempat yang gelap."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tempat yang semua orang percaya adalah **biasa**."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 4**"
    }
  ],
