{
  "series": "Separuh Hayat",
  "season": 2,
  "episode": 12,
  "title": "S2 E12",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 12\n## THE PARTNERSHIP ENDS"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tidur."
    },
    {
      "type": "paragraph",
      "text": "Dia masih berada di pejabat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kerusi itu masih sama."
    },
    {
      "type": "paragraph",
      "text": "Meja masih sama."
    },
    {
      "type": "paragraph",
      "text": "Buku nota masih terbuka."
    },
    {
      "type": "paragraph",
      "text": "Tetapi orangnya sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "Adam masuk membawa dua cawan kopi."
    },
    {
      "type": "paragraph",
      "text": "“Satu untuk kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "Mereka diam."
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Adam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kau rasa dia masih hidup?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia hidup?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali melihat buku nota."
    },
    {
      "type": "paragraph",
      "text": "“Dia takkan datang balik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana dia tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Tahu apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup buku."
    },
    {
      "type": "paragraph",
      "text": "“Bahawa sistem itu bukan lagi milik dia.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Mesyuarat pertama tanpa Hashim."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di kerusi utama."
    },
    {
      "type": "paragraph",
      "text": "Di sebelahnya Adam."
    },
    {
      "type": "paragraph",
      "text": "Farid berada di belakang."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pengurus lama memandang mereka."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada siapa bercakap."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya seorang pengurus bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi… siapa yang buat keputusan sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat semua orang."
    },
    {
      "type": "paragraph",
      "text": "“Saya.”"
    },
    {
      "type": "paragraph",
      "text": "Sunyi."
    },
    {
      "type": "paragraph",
      "text": "Seorang lagi bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Secara rasmi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Secara praktikal.”"
    },
    {
      "type": "paragraph",
      "text": "Pengurus itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Operasi diteruskan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "“Tiada perubahan besar.”"
    },
    {
      "type": "paragraph",
      "text": "“Semua kontrak diteruskan.”"
    },
    {
      "type": "paragraph",
      "text": "“Pekerja kekal.”"
    },
    {
      "type": "paragraph",
      "text": "“Gaji dibayar.”"
    },
    {
      "type": "paragraph",
      "text": "“Pembekal yang masih bersama kita dikekalkan.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pengurus mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Dan Dato’ Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Mulai hari ini…”"
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“…jangan gunakan nama dia untuk buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "Semua diam."
    },
    {
      "type": "paragraph",
      "text": "“Kalau ada masalah, datang kepada saya.”"
    },
    {
      "type": "paragraph",
      "text": "Mesyuarat diteruskan."
    },
    {
      "type": "paragraph",
      "text": "Dan sesuatu yang pelik berlaku."
    },
    {
      "type": "paragraph",
      "text": "Sistem itu tidak runtuh."
    },
    {
      "type": "paragraph",
      "text": "Ia terus berjalan."
    },
    {
      "type": "paragraph",
      "text": "Tanpa Hashim."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas mesyuarat, Adam masuk ke pejabat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Kau nampak tenang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang panik tak boleh buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah belajar banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Daripada dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam faham siapa yang dimaksudkan."
    },
    {
      "type": "paragraph",
      "text": "“Masih rasa bersalah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kita buat pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan pilihan ada akibat.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tak buat…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memotong."
    },
    {
      "type": "paragraph",
      "text": "“Dia akan buat kepada kita.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Itulah alasan yang mereka gunakan."
    },
    {
      "type": "paragraph",
      "text": "Dan buat masa itu, mereka berdua masih percaya alasan itu cukup."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Rizal pergi ke Ayam Gepuk Hut."
    },
    {
      "type": "paragraph",
      "text": "Restoran masih beroperasi seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Pelanggan makan."
    },
    {
      "type": "paragraph",
      "text": "Pekerja bekerja."
    },
    {
      "type": "paragraph",
      "text": "Pesanan masuk."
    },
    {
      "type": "paragraph",
      "text": "Ketawa kedengaran."
    },
    {
      "type": "paragraph",
      "text": "Tetapi orang yang biasanya duduk di satu sudut…"
    },
    {
      "type": "paragraph",
      "text": "sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di meja yang sama."
    },
    {
      "type": "paragraph",
      "text": "Seorang pekerja datang."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Nak macam biasa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Pekerja itu pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "Hashim pernah duduk di sini."
    },
    {
      "type": "paragraph",
      "text": "Bercakap dengan pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Bersalaman dengan pembekal."
    },
    {
      "type": "paragraph",
      "text": "Mengajar Rizal tentang reputasi."
    },
    {
      "type": "paragraph",
      "text": "Tentang manusia."
    },
    {
      "type": "paragraph",
      "text": "Tentang kuasa."
    },
    {
      "type": "paragraph",
      "text": "Sekarang tempat itu masih hidup."
    },
    {
      "type": "paragraph",
      "text": "Tetapi gurunya sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "Makanan sampai."
    },
    {
      "type": "paragraph",
      "text": "Rizal makan perlahan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pelanggan datang kepada pekerja."
    },
    {
      "type": "paragraph",
      "text": "“Dato’ ada?”"
    },
    {
      "type": "paragraph",
      "text": "Pekerja itu terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia tak datang hari ni?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Pelanggan itu mengangguk dan duduk."
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "Satu perkara tentang dunia ini baru dia faham."
    },
    {
      "type": "paragraph",
      "text": "Manusia boleh hilang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sistem yang mereka bina boleh terus hidup."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal kembali ke pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Adam sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Ada benda kau kena tengok.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka laptop."
    },
    {
      "type": "paragraph",
      "text": "Satu senarai."
    },
    {
      "type": "paragraph",
      "text": "Beberapa aset."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita susun semula semuanya…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kita boleh buat lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat angka."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memberikan satu jumlah."
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Jumlah itu jauh melebihi sasaran asalnya."
    },
    {
      "type": "paragraph",
      "text": "RM500,000."
    },
    {
      "type": "paragraph",
      "text": "Itu sahaja yang dia perlukan dahulu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian RM1 juta."
    },
    {
      "type": "paragraph",
      "text": "Untuk rawatan."
    },
    {
      "type": "paragraph",
      "text": "Untuk keluarga."
    },
    {
      "type": "paragraph",
      "text": "Untuk masa depan."
    },
    {
      "type": "paragraph",
      "text": "Sekarang jumlah yang berada di hadapannya jauh lebih besar."
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup laptop."
    },
    {
      "type": "paragraph",
      "text": "Adam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Cukup?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal sendiri faham."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia tahu jawapan kepada soalan itu."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia tidak lagi tahu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pulang awal."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Dia terkejut melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak kerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ada masalah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memegang perutnya."
    },
    {
      "type": "paragraph",
      "text": "“Baby mungkin tak lama lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan tangan di atas perut Linda."
    },
    {
      "type": "paragraph",
      "text": "“Awak gembira?”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, semuanya terasa seperti dulu."
    },
    {
      "type": "paragraph",
      "text": "Rumah."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Anak yang bakal lahir."
    },
    {
      "type": "paragraph",
      "text": "Rizal hampir lupa semua perkara lain."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak jawab."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar lagi."
    },
    {
      "type": "paragraph",
      "text": "Linda memandang."
    },
    {
      "type": "paragraph",
      "text": "“Tak penting?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Dia mematikan telefon."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Tetapi beberapa saat kemudian…"
    },
    {
      "type": "paragraph",
      "text": "telefon itu bergetar sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Saya pergi ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke dapur."
    },
    {
      "type": "paragraph",
      "text": "Menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Suara Adam kedengaran."
    },
    {
      "type": "paragraph",
      "text": "“Kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memejam mata."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa akaun dibekukan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus serius."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut jumlah."
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dan ada lagi.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Seseorang hantar maklumat kepada pihak berkuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Linda masih duduk."
    },
    {
      "type": "paragraph",
      "text": "“Maklumat apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebahagian daripada sistem Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk buat mereka teruskan siasatan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal…”"
    },
    {
