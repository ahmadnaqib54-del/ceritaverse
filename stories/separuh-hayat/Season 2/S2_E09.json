  "title": "S2 E9",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 9\n## THE THREAT"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6.10 pagi."
    },
    {
      "type": "paragraph",
      "text": "Telefon Rizal berdering."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka mata."
    },
    {
      "type": "paragraph",
      "text": "Linda masih tidur."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada suara."
    },
    {
      "type": "paragraph",
      "text": "Dia menunggu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian panggilan terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "Panggilan selama tujuh saat."
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini mesej."
    },
    {
      "type": "paragraph",
      "text": "**“Kau fikir kau dah selamat?”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca sekali."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadam mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak membangunkan Linda."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tidak tidur semula."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke pejabat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Hashim sudah berada di situ."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak pun.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Semalam ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Hashim menolak satu laporan."
    },
    {
      "type": "paragraph",
      "text": "“Seorang pelanggan tarik diri.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kerugian?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan soal kerugian.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Ada beberapa transaksi yang dibatalkan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa hubungan perniagaan tiba-tiba menjadi senyap."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Orang takut.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Itu yang saya nak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Rizal memanggil Adam."
    },
    {
      "type": "paragraph",
      "text": "“Ada benda pelik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa orang mula menjauh.”"
    },
    {
      "type": "paragraph",
      "text": "Adam membaca laporan."
    },
    {
      "type": "paragraph",
      "text": "“Tekanan luar?”"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dan pagi tadi ada orang telefon aku.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Apa dia cakap?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjukkan mesej."
    },
    {
      "type": "paragraph",
      "text": "Adam membacanya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa nombor?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Kau kena beritahu Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku tak tahu ancaman tu datang dari mana.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau tak tahu, lagi sebab kau kena beritahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Hashim mengadakan mesyuarat tertutup."
    },
    {
      "type": "paragraph",
      "text": "Hanya beberapa orang."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Dua pengurus kanan."
    },
    {
      "type": "paragraph",
      "text": "Hashim berdiri di hadapan mereka."
    },
    {
      "type": "paragraph",
      "text": "“Mulai hari ini, semua perubahan mesti melalui saya.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pengurus bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab ada sesuatu yang saya tak suka.”"
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa bertanya lagi."
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Awak?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada sesiapa hubungi awak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam seketika."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Pagi tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Hashim pula tidak menunjukkan reaksi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tak beritahu saya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya belum tahu sama ada ia serius.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berjalan perlahan ke meja."
    },
    {
      "type": "paragraph",
      "text": "“Mulai sekarang…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…jangan buat keputusan sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Mesyuarat tamat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Rizal tahu sesuatu sudah berubah."
    },
    {
      "type": "paragraph",
      "text": "Hashim mula mengetatkan kawalan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di luar, Farid menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku dengar ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Biasa.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Bukan biasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Farid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang mula takut takkan bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Mereka akan hilang.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menyebut satu nama."
    },
    {
      "type": "paragraph",
      "text": "Seorang pembekal yang sudah lama bekerja dengan mereka."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus faham."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua hari.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat Farid."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau baru beritahu?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Saya cuba cari dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jalan di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi bahagian sistem hilang."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir berada di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia menerima satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Ini apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rekod kewangan syarikat berkaitan.”"
    },
    {
      "type": "paragraph",
      "text": "Amir membuka."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat beberapa angka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Dia menyusun semuanya."
    },
    {
      "type": "paragraph",
      "text": "Ada sesuatu yang pelik."
    },
    {
      "type": "paragraph",
      "text": "Bukan satu transaksi."
    },
    {
      "type": "paragraph",
      "text": "Bukan satu syarikat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi corak."
    },
    {
      "type": "paragraph",
      "text": "Syarikat berkembang terlalu cepat."
    },
    {
      "type": "paragraph",
      "text": "Struktur berubah terlalu kerap."
    },
    {
      "type": "paragraph",
      "text": "Beberapa entiti berkait secara tidak langsung."
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**HASHIM**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**RIZAL?**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Tanda soal itu masih ada."
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengambil fail keluarga."
    },
    {
      "type": "paragraph",
      "text": "Nama Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Guru kimia."
    },
    {
      "type": "paragraph",
      "text": "Konsultan operasi."
    },
    {
      "type": "paragraph",
      "text": "Cancer."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki biasa."
    },
    {
      "type": "paragraph",
      "text": "Dia menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini dia tidak memadam nama itu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Rizal tiba di pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Seorang pekerja datang kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ini untuk encik.”"
    },
    {
      "type": "paragraph",
      "text": "Sampul putih."
    },
    {
      "type": "paragraph",
      "text": "Tiada nama pengirim."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka."
    },
    {
      "type": "paragraph",
      "text": "Satu keping gambar."
    },
    {
      "type": "paragraph",
      "text": "Gambar rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Diambil dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus kaku."
    },
    {
      "type": "paragraph",
      "text": "Di belakang gambar ada tulisan:"
    },
    {
      "type": "paragraph",
      "text": "**“Kita tahu siapa keluarga kau.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggenggam gambar itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menunjukkan kepada sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Menutup pintu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian duduk."
    },
    {
      "type": "paragraph",
      "text": "Nafasnya berat."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali selepas bertahun-tahun, sesuatu menyentuh tempat yang paling dia takut."
    },
    {
      "type": "paragraph",
      "text": "Bukan wang."
    },
    {
      "type": "paragraph",
      "text": "Bukan operasi."
    },
    {
      "type": "paragraph",
      "text": "Bukan dirinya."
    },
    {
      "type": "paragraph",
      "text": "**Keluarga.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Adam masuk beberapa minit kemudian."
    },
    {
      "type": "paragraph",
      "text": "“Kau ok?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyembunyikan gambar."
    },
    {
      "type": "paragraph",
      "text": "“Ok.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau tipu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengeluarkan gambar."
    },
    {
      "type": "paragraph",
      "text": "Adam membacanya."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam faham."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tahu siapa.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kita cari.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bukan macam itu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kita jangan buat benda bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil gambar."
    },
    {
      "type": "paragraph",
      "text": "“Kita cari fakta.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal berjumpa Hashim."
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan gambar di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Hashim melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "Sangat sedikit."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Rizal nampak."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Pagi tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangkat gambar."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim duduk."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat berlalu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana awak tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab Amir masih ikut sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim meletakkan gambar."
    },
    {
      "type": "paragraph",
      "text": "“Orang ini tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Maksudnya?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan amaran daripada orang yang mahu menangkap kita.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Ini amaran daripada orang yang mahu mengambil sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Hashim membuka sebuah fail lama."
    },
    {
      "type": "paragraph",
      "text": "Kali ini Rizal berada di situ."
    },
    {
      "type": "paragraph",
      "text": "“Awak pernah ada musuh?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang tak ada?”"
    },
    {
      "type": "paragraph",
      "text": "“Yang serius?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka satu halaman."
    },
    {
      "type": "paragraph",
      "text": "Beberapa nama lama."
    },
    {
      "type": "paragraph",
      "text": "Beberapa perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa hubungan yang sudah berakhir."
    },
    {
      "type": "paragraph",
      "text": "“Orang lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebahagian.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan yang masih ada?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Lebih bahaya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Satu nama ditandakan."
    },
    {
      "type": "paragraph",
      "text": "**KHALID.**"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bekas rakan.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Pesaing.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu sistem awak?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum nipis."
    },
    {
      "type": "paragraph",
      "text": "“Dia pernah bantu bina sebahagiannya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Sekarang semuanya masuk akal."
    },
    {
      "type": "paragraph",
      "text": "Seseorang di luar mungkin memahami sistem Hashim."
    },
    {
      "type": "paragraph",
      "text": "Seseorang yang tahu di mana ia kuat."
    },
    {
      "type": "paragraph",
      "text": "Dan tahu di mana ia lemah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari berikutnya menjadi pelik."
    },
    {
      "type": "paragraph",
      "text": "Satu pelanggan hilang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Satu penghantaran tertangguh."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang mula bercakap."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa tahu siapa yang memulakan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ketakutan bergerak lebih cepat daripada fakta."
    },
    {
      "type": "paragraph",
      "text": "Hashim cuba mengawal keadaan."
    },
    {
      "type": "paragraph",
      "text": "Rizal pula melihat angka."
    },
    {
      "type": "paragraph",
      "text": "Dia menyedari sesuatu."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan serangan terus.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Tekanan.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk?”"
    },
    {
      "type": "paragraph",
      "text": "“Buat orang dalam sistem hilang kepercayaan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk laporan."
    },
    {
      "type": "paragraph",
      "text": "“Kalau cukup ramai takut…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…sistem akan rosak sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada malam itu, Hashim duduk bersama Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Awak betul.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ini lebih besar daripada yang saya jangka.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita perlukan perubahan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Mulai sekarang, saya mahu awak pegang lebih banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa saya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana saya perlukan seseorang yang boleh nampak keseluruhan gambar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi ada syarat.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat keputusan berdasarkan emosi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal teringat gambar rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Saya faham.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin lewat."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandu pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti di lampu merah."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Mesej baru."
    },
    {
      "type": "paragraph",
      "text": "**“Hashim bukan masalah sebenar.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "**“Masalah sebenar ialah orang yang akan menggantikannya.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jalan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej ketiga."
    },
    {
      "type": "paragraph",
      "text": "**“Kami sedang melihat kau, Rizal.”**"
    },
    {
      "type": "paragraph",
      "text": "Lampu bertukar hijau."
    },
    {
      "type": "paragraph",
      "text": "Kereta di belakang membunyikan hon."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca mesej itu sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang cermin belakang."
    },
    {
      "type": "paragraph",
      "text": "Sebuah kereta hitam berada beberapa meter di belakang."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula bergerak."
    },
    {
      "type": "paragraph",
      "text": "Kereta itu juga bergerak."
    },
    {
      "type": "paragraph",
      "text": "Rizal membelok."
    },
    {
      "type": "paragraph",
      "text": "Kereta itu membelok."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak panik."
    },
    {
      "type": "paragraph",
      "text": "Dia terus memandu."
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit kemudian, kereta itu hilang."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kebetulan."
    },
    {
      "type": "paragraph",
      "text": "Mungkin tidak."
    },
    {
      "type": "paragraph",
      "text": "Rizal akhirnya sampai rumah."
    },
    {
      "type": "paragraph",
      "text": "Lampu ruang tamu masih menyala."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Awak lambat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "“Maaf.”"
    },
    {
      "type": "paragraph",
      "text": "Linda melihat wajahnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Pergilah tengok Roy.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke bilik anaknya."
    },
    {
      "type": "paragraph",
      "text": "Roy sedang tidur."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di pintu."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat anaknya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat jam di pergelangan tangan."
    },
    {
      "type": "paragraph",
      "text": "Hadiah Roy."
    },
    {
      "type": "paragraph",
      "text": "Dia memegangnya."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali, Rizal sedar sesuatu yang mengganggunya."
    },
    {
      "type": "paragraph",
      "text": "Dia selama ini fikir dia masuk ke dunia ini untuk melindungi keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sekarang…"
    },
    {
      "type": "paragraph",
      "text": "**dunia itu sudah mula mengetahui di mana keluarganya berada.**"
    },
    {
      "type": "paragraph",
      "text": "Di tempat lain, Hashim berdiri di hadapan tingkap pejabatnya."
    },
    {
      "type": "paragraph",
      "text": "Dia menerima satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**“Anak murid awak sudah nampak terlalu banyak.”**"
    },
    {
      "type": "paragraph",
      "text": "Hashim membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadam."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "Bukan takut."
    },
    {
      "type": "paragraph",
      "text": "Marah."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "“Cari siapa yang hantar.”"
    },
    {
      "type": "paragraph",
      "text": "Panggilan disambungkan."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata satu ayat sahaja."
    },
    {
      "type": "paragraph",
      "text": "“Dan kali ini, jangan buat saya tertanya-tanya.”"
    },
    {
      "type": "paragraph",
      "text": "Panggilan tamat."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandang kota di luar."
    },
    {
      "type": "paragraph",
      "text": "Di satu sisi, Amir semakin hampir."
    },
    {
      "type": "paragraph",
      "text": "Di sisi lain, seseorang sedang menyerang sistemnya."
    },
    {
      "type": "paragraph",
      "text": "Dan di tengah-tengah semuanya berdiri Rizal."
    },
    {
      "type": "paragraph",
      "text": "Anak murid yang semakin penting."
    },
    {
      "type": "paragraph",
      "text": "Anak murid yang semakin berbahaya."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 9**"
    }
