{
  "series": "Separuh Hayat",
  "season": 2,
  "episode": 7,
  "title": "S2 E7",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 7\n## THE APPRENTICE"
    },
    {
      "type": "paragraph",
      "text": "Pukul 7.30 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah berada di pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada dua fail."
    },
    {
      "type": "paragraph",
      "text": "Satu untuk pusat pertama."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi untuk pusat baru."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail kedua."
    },
    {
      "type": "paragraph",
      "text": "Angka."
    },
    {
      "type": "paragraph",
      "text": "Jadual."
    },
    {
      "type": "paragraph",
      "text": "Kos."
    },
    {
      "type": "paragraph",
      "text": "Risiko."
    },
    {
      "type": "paragraph",
      "text": "Dia menutupnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka semula."
    },
    {
      "type": "paragraph",
      "text": "Adam masuk."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "“Biasalah.”"
    },
    {
      "type": "paragraph",
      "text": "Adam meletakkan kopi."
    },
    {
      "type": "paragraph",
      "text": "“Hashim dah sampai?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "“Bila dia datang, kau akan dapat kerja baru.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kita cari duit.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kita bina syarikat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak membetulkannya."
    },
    {
      "type": "paragraph",
      "text": "Kerana untuk pertama kali, ayat itu kedengaran benar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 9.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Hashim tiba."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk tanpa membawa fail."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengikut."
    },
    {
      "type": "paragraph",
      "text": "Mereka masuk ke kereta Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Jalan dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Tak bawa Adam?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Kereta bergerak meninggalkan Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Selepas beberapa minit, Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kita pergi mana?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awak terlalu banyak tanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak yang ajar saya jangan buat keputusan tanpa maklumat.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka berhenti di sebuah restoran kecil."
    },
    {
      "type": "paragraph",
      "text": "Bukan Ayam Gepuk Hut."
    },
    {
      "type": "paragraph",
      "text": "Restoran biasa."
    },
    {
      "type": "paragraph",
      "text": "Hashim masuk."
    },
    {
      "type": "paragraph",
      "text": "Pemilik restoran terus menyambutnya."
    },
    {
      "type": "paragraph",
      "text": "“Dato’!”"
    },
    {
      "type": "paragraph",
      "text": "Hashim bersalaman."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa sini?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim membuka menu."
    },
    {
      "type": "paragraph",
      "text": "“Makan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil menu."
    },
    {
      "type": "paragraph",
      "text": "“Serius?”"
    },
    {
      "type": "paragraph",
      "text": "“Serius.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka memesan makanan."
    },
    {
      "type": "paragraph",
      "text": "Selepas makanan sampai, Hashim mula bercakap."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu apa yang paling susah tentang membina bisnes?”"
    },
    {
      "type": "paragraph",
      "text": "“Modal?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Orang?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Pasaran?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Mengetahui bila cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang berjaya biasanya mahu lebih.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat jari."
    },
    {
      "type": "paragraph",
      "text": "“Lebih pelanggan.”"
    },
    {
      "type": "paragraph",
      "text": "Jari kedua."
    },
    {
      "type": "paragraph",
      "text": "“Lebih wang.”"
    },
    {
      "type": "paragraph",
      "text": "Ketiga."
    },
    {
      "type": "paragraph",
      "text": "“Lebih kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi orang yang tak tahu bila cukup…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“…akan mula membuat keputusan bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak pernah buat?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Sudah tentu.”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup banyak untuk saya belajar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyuap makanan."
    },
    {
      "type": "paragraph",
      "text": "“Awak pula?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Saya?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu bila cukup?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itulah yang saya mahu tahu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas makan, mereka kembali ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak terus memandu."
    },
    {
      "type": "paragraph",
      "text": "“Awak pernah fikir kenapa saya ajar awak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Jawapan?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya berguna.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Jawapan yang jujur.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Tapi salah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Awak berguna.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi bukan itu sebabnya.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab awak masih ada sesuatu yang saya sudah hilang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rasa takut.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandang jalan."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang masih takut kehilangan sesuatu akan fikir dua kali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Dan awak?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya sudah terlalu lama hidup dengan risiko.”"
    },
    {
      "type": "paragraph",
      "text": "Kereta bergerak."
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…bila seseorang sudah terlalu biasa dengan risiko, dia mula fikir dirinya kebal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hari-hari berikutnya, Hashim mula membawa Rizal ke beberapa tempat."
    },
    {
      "type": "paragraph",
      "text": "Bukan untuk mengajar kerja teknikal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi manusia."
    },
    {
      "type": "paragraph",
      "text": "Rizal bertemu pembekal."
    },
    {
      "type": "paragraph",
      "text": "Pemilik syarikat."
    },
    {
      "type": "paragraph",
      "text": "Pengurus."
    },
    {
      "type": "paragraph",
      "text": "Pelabur."
    },
    {
      "type": "paragraph",
      "text": "Pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Orang yang gagal."
    },
    {
      "type": "paragraph",
      "text": "Orang yang berjaya."
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak pernah memperkenalkan Rizal sebagai orang bawahan."
    },
    {
      "type": "paragraph",
      "text": "Dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ini Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Itu sahaja."
    },
    {
      "type": "paragraph",
      "text": "Dan orang akan bersalaman."
    },
    {
      "type": "paragraph",
      "text": "Bertanya soalan."
    },
    {
      "type": "paragraph",
      "text": "Mendengar."
    },
    {
      "type": "paragraph",
      "text": "Lama-kelamaan Rizal faham."
    },
    {
      "type": "paragraph",
      "text": "Nama Hashim membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cara Rizal bercakap membuat pintu itu terus terbuka."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu malam, mereka duduk di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Hashim membuka satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya tiada esok…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa cakap macam tu?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jawab.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca dokumen."
    },
    {
      "type": "paragraph",
      "text": "Dia mula menyusun."
    },
    {
      "type": "paragraph",
      "text": "“Pusat operasi terus berjalan.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Seterusnya?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang akan panik.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi orang kedua perlu ambil alih.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Awak tanya saya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat struktur organisasi."
    },
    {
      "type": "paragraph",
      "text": "“Bukan seorang.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau semua bergantung pada seorang, sistem itu lemah.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Perlu beberapa orang dengan fungsi berbeza.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Awak semakin faham.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa awak tanya?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya mahu tahu sama ada awak boleh bina sesuatu yang masih hidup walaupun saya sudah tiada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali, dia melihat Hashim bukan sebagai seorang bos."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebagai manusia."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki yang sedar masa juga berjalan untuk dirinya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di sekolah, Rizal semakin jarang berada di bilik guru."
    },
    {
      "type": "paragraph",
      "text": "Cikgu Faizal mula perasan."
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau nak berhenti mengajar?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab kau macam separuh hati.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Faizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nak keluar, keluar baik-baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak cakap nak keluar.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Faizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Tapi orang yang dah nampak dunia lain biasanya susah nak kembali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu tepat."
    },
    {
      "type": "paragraph",
      "text": "Terlalu tepat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Linda menunggu Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Awak.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Doktor kata tarikh dah dekat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memberi perhatian."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu tepat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tapi tak lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di sebelah isterinya."
    },
    {
      "type": "paragraph",
      "text": "“Awak takut?”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil tangan Linda."
    },
    {
      "type": "paragraph",
      "text": "“Saya ada.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian Linda bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Awak akan ada?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu mudah."
    },
    {
      "type": "paragraph",
      "text": "Jawapannya sepatutnya juga mudah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Kerja."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Operasi."
    },
    {
      "type": "paragraph",
      "text": "Semua sudah mengambil ruang yang sepatutnya milik keluarga."
    },
    {
      "type": "paragraph",
      "text": "Dia menggenggam tangan Linda lebih kuat."
    },
    {
      "type": "paragraph",
      "text": "“Saya akan cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cuba.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minggu kemudian."
    },
    {
      "type": "paragraph",
      "text": "Pusat operasi baru berjalan."
    },
    {
      "type": "paragraph",
      "text": "Dua lokasi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tiga."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula mengendalikan lebih banyak keputusan."
    },
    {
      "type": "paragraph",
      "text": "Hashim semakin jarang campur tangan."
    },
    {
      "type": "paragraph",
      "text": "Dan itu membuat Adam semakin risau."
    },
    {
      "type": "paragraph",
      "text": "“Dia bagi kau terlalu banyak kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat laporan."
    },
    {
      "type": "paragraph",
      "text": "“Dia percaya aku.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Bukan itu yang aku maksudkan.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia sedang tengok sejauh mana kau boleh pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti membaca."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Dan kau sedang pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bukankah itu yang dia mahu?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi masalah?”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya kau mula suka.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal dipanggil Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Hashim menolak satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Ini untuk awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka."
    },
    {
      "type": "paragraph",
      "text": "Struktur operasi."
    },
    {
      "type": "paragraph",
      "text": "Aset."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa projek."
    },
    {
      "type": "paragraph",
      "text": "Dan satu halaman terakhir."
    },
    {
      "type": "paragraph",
      "text": "**SUCCESSION.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Apa ni?”"
    },
    {
      "type": "paragraph",
      "text": "“Pelan penggantian.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya mahu awak belajar semua yang saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Supaya suatu hari nanti…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…awak tak perlukan saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menatapnya."
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itulah tujuan seorang guru.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu terasa pelik."
    },
    {
      "type": "paragraph",
      "text": "Dia seorang guru."
    },
    {
      "type": "paragraph",
      "text": "Hashim seorang guru."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kedua-duanya mengajar benda yang sangat berbeza."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengajar pelajar supaya memahami dunia."
    },
    {
      "type": "paragraph",
      "text": "Hashim mengajar Rizal bagaimana dunia yang sebenar berfungsi apabila wang dan kuasa berada di tangan orang yang betul."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal membuka fail tersebut di rumah."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah tidur."
    },
    {
      "type": "paragraph",
      "text": "Rumah sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian sampai ke halaman terakhir."
    },
    {
      "type": "paragraph",
      "text": "Ada satu nota tulisan tangan Hashim."
    },
    {
      "type": "paragraph",
      "text": "**“Jangan jadi saya.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya ada ayat kedua."
    },
    {
      "type": "paragraph",
      "text": "**“Jadi lebih baik.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Tanpa sedar, dia menulis satu perkataan di bawah nota itu."
    },
    {
      "type": "paragraph",
      "text": "**“Akan.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadamnya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi perkataan itu sudah berada dalam fikirannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Hashim masuk ke pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Semua orang berdiri."
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar dari bilik."
    },
    {
      "type": "paragraph",
      "text": "“Dato’.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagaimana?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua berjalan.”"
    },
    {
      "type": "paragraph",
      "text": "“Masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Tiada yang besar.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka berjalan bersama."
    },
    {
      "type": "paragraph",
      "text": "Adam memerhatikan dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Dia nampak sesuatu yang orang lain tidak nampak."
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak lagi berjalan di depan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Mereka berjalan **sebelah menyebelah**."
    },
    {
      "type": "paragraph",
      "text": "Dan itu membuat Adam tidak selesa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Hashim duduk seorang diri di pejabatnya."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka satu fail lama."
    },
    {
      "type": "paragraph",
      "text": "Gambar lama."
    },
    {
      "type": "paragraph",
      "text": "Sebuah kilang kecil."
    },
    {
      "type": "paragraph",
      "text": "Dirinya bertahun-tahun lalu."
    },
    {
      "type": "paragraph",
      "text": "Belum kaya."
    },
    {
      "type": "paragraph",
      "text": "Belum berkuasa."
    },
    {
      "type": "paragraph",
      "text": "Belum dikenali."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia membuka gambar lain."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang gambar itu lama."
    },
    {
      "type": "paragraph",
      "text": "“Jangan ulang kesilapan saya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup fail."
    },
    {
      "type": "paragraph",
      "text": "Di luar pejabat, Rizal sedang berjalan pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti seketika."
    },
    {
      "type": "paragraph",
      "text": "Melihat bangunan Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat telefon."
    },
    {
      "type": "paragraph",
      "text": "Ada mesej daripada Linda."
    },
    {
      "type": "paragraph",
      "text": "**“Jangan balik terlalu lewat.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menaip:"
    },
    {
      "type": "paragraph",
      "text": "**“Saya balik.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia memasukkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum masuk kereta, dia menerima satu lagi mesej."
    },
    {
      "type": "paragraph",
      "text": "Daripada Hashim."
    },
    {
      "type": "paragraph",
      "text": "**“Esok kita bincang sesuatu yang lebih besar.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian masuk ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu bahawa sesuatu yang lebih besar itu bukan sekadar peluang."
    },
    {
      "type": "paragraph",
      "text": "Ia adalah ujian."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali sejak dia masuk ke dunia Hashim…"
    },
    {
      "type": "paragraph",
      "text": "Rizal bukan lagi sedang belajar bagaimana untuk menjadi anak murid."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang belajar bagaimana untuk menjadi **pengganti**."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 7**"
    }
