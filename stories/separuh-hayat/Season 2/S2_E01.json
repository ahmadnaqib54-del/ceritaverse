  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 2 — Episode 1\n### Superlab"
    },
    {
      "type": "paragraph",
      "text": "Pukul 7:48 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di hadapan pintu Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat jam tangannya."
    },
    {
      "type": "paragraph",
      "text": "7:48."
    },
    {
      "type": "paragraph",
      "text": "Dua belas minit lagi."
    },
    {
      "type": "paragraph",
      "text": "Adam berdiri di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Kita awal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang bangunan itu."
    },
    {
      "type": "paragraph",
      "text": "“Saya masih rasa kita tak patut ada di sini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Semalam kau kata benda yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan saya masih betul.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nak balik…”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak kata saya nak balik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Pintu terbuka."
    },
    {
      "type": "paragraph",
      "text": "Seorang pekerja keluar."
    },
    {
      "type": "paragraph",
      "text": "“Dato' tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Mereka masuk."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana pada waktu pagi kelihatan seperti sebuah kilang biasa."
    },
    {
      "type": "paragraph",
      "text": "Pekerja datang."
    },
    {
      "type": "paragraph",
      "text": "Lori bergerak."
    },
    {
      "type": "paragraph",
      "text": "Forklift lalu."
    },
    {
      "type": "paragraph",
      "text": "Orang membawa fail."
    },
    {
      "type": "paragraph",
      "text": "Mesin berjalan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi selepas beberapa pintu, semuanya berubah."
    },
    {
      "type": "paragraph",
      "text": "Hashim sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dato' suruh pukul lapan.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang 7:50.”"
    },
    {
      "type": "paragraph",
      "text": "“Dua belas minit awal.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya suka.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Hashim berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Jom.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka berjalan melalui kawasan operasi."
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak bercakap banyak."
    },
    {
      "type": "paragraph",
      "text": "Dia membiarkan Rizal melihat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Apa yang kau nampak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Banyak.”"
    },
    {
      "type": "paragraph",
      "text": "“Pilih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat pekerja."
    },
    {
      "type": "paragraph",
      "text": "Kemudian lori."
    },
    {
      "type": "paragraph",
      "text": "Gudang."
    },
    {
      "type": "paragraph",
      "text": "Dokumen."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Flow.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Terangkan.”"
    },
    {
      "type": "paragraph",
      "text": "“Barang masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk ke arah gudang."
    },
    {
      "type": "paragraph",
      "text": "“Diproses.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian ke kawasan operasi."
    },
    {
      "type": "paragraph",
      "text": "“Diperiksa.”"
    },
    {
      "type": "paragraph",
      "text": "Ke arah kawasan penyimpanan."
    },
    {
      "type": "paragraph",
      "text": "“Disimpan.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian ke lori."
    },
    {
      "type": "paragraph",
      "text": "“Keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Maklumat.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum lebih lebar."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang mereka."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ramai orang tengok kilang.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk ke arah kawasan operasi."
    },
    {
      "type": "paragraph",
      "text": "“Kau tengok sistem.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka turun ke tingkat bawah."
    },
    {
      "type": "paragraph",
      "text": "Satu pintu besar terbuka."
    },
    {
      "type": "paragraph",
      "text": "Udara berubah."
    },
    {
      "type": "paragraph",
      "text": "Lebih sejuk."
    },
    {
      "type": "paragraph",
      "text": "Lebih sunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal melangkah masuk."
    },
    {
      "type": "paragraph",
      "text": "Adam di belakangnya."
    },
    {
      "type": "paragraph",
      "text": "Mereka berhenti."
    },
    {
      "type": "paragraph",
      "text": "Ruang itu jauh lebih besar daripada apa yang pernah mereka bayangkan."
    },
    {
      "type": "paragraph",
      "text": "Bukan satu bilik."
    },
    {
      "type": "paragraph",
      "text": "Bukan dua."
    },
    {
      "type": "paragraph",
      "text": "Satu fasiliti lengkap."
    },
    {
      "type": "paragraph",
      "text": "Beberapa bahagian bekerja serentak."
    },
    {
      "type": "paragraph",
      "text": "Ada orang mengawasi."
    },
    {
      "type": "paragraph",
      "text": "Ada orang mencatat."
    },
    {
      "type": "paragraph",
      "text": "Ada orang memeriksa."
    },
    {
      "type": "paragraph",
      "text": "Semuanya bergerak dalam urutan yang hampir sempurna."
    },
    {
      "type": "paragraph",
      "text": "Adam memandang sekeliling."
    },
    {
      "type": "paragraph",
      "text": "Dia benar-benar terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal juga."
    },
    {
      "type": "paragraph",
      "text": "Hashim berdiri di belakang mereka."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…baru kamu nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berjalan perlahan."
    },
    {
      "type": "paragraph",
      "text": "Matanya memerhati setiap bahagian."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada kekaguman pada mesin."
    },
    {
      "type": "paragraph",
      "text": "Yang menarik perhatiannya ialah sistem."
    },
    {
      "type": "paragraph",
      "text": "Siapa buat apa."
    },
    {
      "type": "paragraph",
      "text": "Bila."
    },
    {
      "type": "paragraph",
      "text": "Bagaimana maklumat bergerak."
    },
    {
      "type": "paragraph",
      "text": "Bagaimana bahan bergerak."
    },
    {
      "type": "paragraph",
      "text": "Bagaimana produk bergerak."
    },
    {
      "type": "paragraph",
      "text": "Bagaimana keputusan dibuat."
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat wajahnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau faham?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan makmal.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Ini kilang.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau faham.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Adam pula memandang satu kawasan tertentu."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang jaga QC?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menunjuk seorang lelaki di hujung ruang."
    },
    {
      "type": "paragraph",
      "text": "“Dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berjalan sedikit."
    },
    {
      "type": "paragraph",
      "text": "Berbual dengannya."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memerhatikan keseluruhan sistem."
    },
    {
      "type": "paragraph",
      "text": "Hashim datang berdiri di sebelah."
    },
    {
      "type": "paragraph",
      "text": "“Adam lebih suka benda teknikal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau pula?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya tengok semua.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itulah sebab saya pilih kau.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, mereka duduk di dalam pejabat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja terdapat satu fail."
    },
    {
      "type": "paragraph",
      "text": "Hashim menolaknya kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Operasi sekarang ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Beberapa laporan."
    },
    {
      "type": "paragraph",
      "text": "Angka."
    },
    {
      "type": "paragraph",
      "text": "Jadual."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "“Capacity?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bukan cuma itu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyelak lagi."
    },
    {
      "type": "paragraph",
      "text": "“Inventory?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Supply?”"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang.”"
    },
    {
      "type": "paragraph",
      "text": "“Quality?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Tidak konsisten.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti membaca."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang urus?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menyebut satu nama."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia tak sesuai.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia lihat setiap masalah secara berasingan.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Dan kau?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan fail."
    },
    {
      "type": "paragraph",
      "text": "“Saya tengok hubungan antara masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim diam beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya faham kenapa Ah Len suka kau.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hari pertama Rizal bersama Hashim bukan tentang membuat apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Ia tentang melihat."
    },
    {
      "type": "paragraph",
      "text": "Belajar."
    },
    {
      "type": "paragraph",
      "text": "Menyusun."
    },
    {
      "type": "paragraph",
      "text": "Memahami."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula melihat bagaimana sebuah operasi besar bergerak."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat bahawa wang bukan sekadar hasil jualan."
    },
    {
      "type": "paragraph",
      "text": "Wang bergerak mengikut masa."
    },
    {
      "type": "paragraph",
      "text": "Supply."
    },
    {
      "type": "paragraph",
      "text": "Production."
    },
    {
      "type": "paragraph",
      "text": "Inventory."
    },
    {
      "type": "paragraph",
      "text": "Payment."
    },
    {
      "type": "paragraph",
      "text": "Risk."
    },
    {
      "type": "paragraph",
      "text": "Semuanya berkait."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali, Rizal sedar bahawa apa yang dia lakukan sebelum ini hanyalah versi kecil."
    },
    {
      "type": "paragraph",
      "text": "Sangat kecil."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang."
    },
    {
      "type": "paragraph",
      "text": "Adam duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "Adam terus berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak suka.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memasang tali pinggang."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dato' Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa dengan dia?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia terlalu tenang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghidupkan enjin."
    },
    {
      "type": "paragraph",
      "text": "“Itu masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab orang yang terlalu tenang dalam dunia macam ni biasanya dah lama menang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin itu yang kita perlukan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Saya rasa dia perlukan kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia boleh buat semua sendiri, dia tak perlukan kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti seketika."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi persoalannya…”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Bumi Perdana melalui cermin."
    },
    {
      "type": "paragraph",
      "text": "“…apa yang dia nampak pada kita?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pulang."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja baru?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Besar.”"
    },
    {
      "type": "paragraph",
      "text": "“Gaji lebih?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Lebih.”"
    },
    {
      "type": "paragraph",
      "text": "Linda kelihatan lega."
    },
    {
      "type": "paragraph",
      "text": "“Baguslah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
