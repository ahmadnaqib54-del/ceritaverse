{
  "series": "Separuh Hayat",
  "season": 2,
  "episode": 11,
  "title": "S2 E11",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 11\n## THE FALL OF HASHIM"
    },
    {
      "type": "paragraph",
      "text": "Pukul 6.30 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Enjin belum dihidupkan."
    },
    {
      "type": "paragraph",
      "text": "Di tempat duduk sebelah ada satu fail."
    },
    {
      "type": "paragraph",
      "text": "Nama di muka hadapan:"
    },
    {
      "type": "paragraph",
      "text": "**HASHIM.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "“Dah bangun?”"
    },
    {
      "type": "paragraph",
      "text": "“Dah.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat bangunan Bumi Perdana di hadapan."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Betul-betul?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam faham."
    },
    {
      "type": "paragraph",
      "text": "Panggilan tamat."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil nafas panjang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menghidupkan enjin."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Hashim masuk ke pejabat seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kali ini suasana berbeza."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pekerja bercakap perlahan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pengurus menunggu di luar."
    },
    {
      "type": "paragraph",
      "text": "“Dato’.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Polis datang tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak berubah wajah."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka tanya tentang satu syarikat.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Suruh mereka bercakap dengan bahagian undang-undang.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia menutup pintu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menghubungi seseorang."
    },
    {
      "type": "paragraph",
      "text": "“Sudah bermula.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal tiba tidak lama kemudian."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Hashim menolak satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Awak dah tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Pasal serbuan?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Mereka makin dekat.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu apa yang saya akan buat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya akan tutup beberapa bahagian.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Yang mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Yang berisiko.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang untuk selamatkan keseluruhan sistem, kita perlu buang sebahagian daripadanya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau bahagian itu bukan masalah?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awak terlalu banyak berfikir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum balik."
    },
    {
      "type": "paragraph",
      "text": "“Kerja saya.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Adam masuk ke bilik Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Dia akan tutup pusat ketiga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dah tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan beberapa orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia buat begitu, kita kehilangan banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kita kena buat sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bukan kita.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menurunkan suara."
    },
    {
      "type": "paragraph",
      "text": "“Kita biarkan dia buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab dia sedang panik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk beberapa laporan."
    },
    {
      "type": "paragraph",
      "text": "“Bila dia potong bahagian sistem, dia akan hilangkan perlindungan sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memahami."
    },
    {
      "type": "paragraph",
      "text": "“Kau nak dia melemahkan dirinya sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Adam menatapnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah fikir semua ni lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang."
    },
    {
      "type": "paragraph",
      "text": "Amir menerima satu arahan."
    },
    {
      "type": "paragraph",
      "text": "Siasatan terhadap rangkaian Bumi Perdana dipercepatkan."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Nama Hashim."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa individu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu nama yang masih membuatnya berhenti."
    },
    {
      "type": "paragraph",
      "text": "**Rizal.**"
    },
    {
      "type": "paragraph",
      "text": "Amir mengeluarkan gambar lama."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersama Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Dia menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai masuk."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada satu perkembangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Nama Rizal muncul lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Amir terus diam."
    },
    {
      "type": "paragraph",
      "text": "“Dalam konteks apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Hubungan perniagaan.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil fail."
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat kesimpulan.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kita cuma laporkan.”"
    },
    {
      "type": "paragraph",
      "text": "Amir melihat nama itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Semak lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu bahawa pada masa yang sama…"
    },
    {
      "type": "paragraph",
      "text": "Rizal sedang membuat keputusan tentang Hashim."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu."
    },
    {
      "type": "paragraph",
      "text": "Rizal dan Adam bertemu."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa bercakap untuk beberapa minit."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Adam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita buat…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memotong."
    },
    {
      "type": "paragraph",
      "text": "“Kita tak boleh patah balik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan pasal duit.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan pasal Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi pasal apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Pasal siapa kita selepas ini.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita ambil semua yang dia bina…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…kita akan jadi apa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang lantai."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang menang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum hambar."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang menggantikannya.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hari berikutnya."
    },
    {
      "type": "paragraph",
      "text": "Hashim memanggil Rizal seorang diri."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Hashim kelihatan lebih tua hari itu."
    },
    {
      "type": "paragraph",
      "text": "Lebih letih."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka laci."
    },
    {
      "type": "paragraph",
      "text": "Mengeluarkan fail lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian meletakkannya di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Awak ingat saya pernah kata saya mahu awak jadi lebih baik daripada saya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya maksudkan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Awak fikir saya tak nampak perubahan awak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Awak sudah tidak datang kepada saya untuk bertanya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Awak datang untuk memberitahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Itu bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Bagus?”"
    },
    {
      "type": "paragraph",
      "text": "“Seorang guru tak mahu anak muridnya kekal bergantung.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tapi…”"
    },
    {
      "type": "paragraph",
      "text": "Senyuman itu hilang."
    },
    {
      "type": "paragraph",
      "text": "“…saya juga tahu bila anak murid mula melihat guru sebagai halangan.”"
    },
    {
      "type": "paragraph",
      "text": "Bilik menjadi sunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandang tepat ke matanya."
    },
    {
      "type": "paragraph",
      "text": "“Awak mahu saya keluar?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Saya sudah agak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal akhirnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya kata ya?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya awak jujur.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Dato’…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan panggil saya Dato’ kalau awak mahu jatuhkan saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Buat pertama kali sejak mereka bertemu, Hashim tidak kelihatan seperti seorang ahli perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Dia kelihatan seperti seorang guru."
    },
    {
      "type": "paragraph",
      "text": "Dan Rizal pula seperti anak murid yang datang untuk mengambil tempat gurunya."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Saya bangga dengan awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mampu menjawab."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya kecewa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana saya ajar awak terlalu baik.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, semuanya bergerak."
    },
    {
      "type": "paragraph",
      "text": "Tanpa bunyi besar."
    },
    {
      "type": "paragraph",
      "text": "Tanpa pengumuman."
    },
    {
      "type": "paragraph",
      "text": "Tanpa satu pun daripada mereka menyedari bahawa ini adalah titik terakhir."
    },
    {
      "type": "paragraph",
      "text": "Beberapa hubungan Hashim runtuh."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orang meninggalkan sistem."
    },
    {
      "type": "paragraph",
      "text": "Beberapa maklumat sampai kepada pihak yang sepatutnya."
    },
    {
      "type": "paragraph",
      "text": "Dan dalam masa yang sama, Rizal mengambil alih keputusan yang sebelum ini dibuat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana Hashim menyerah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana sistem itu sendiri mula berpindah tangan."
    },
    {
      "type": "paragraph",
      "text": "Adam berada di sisi Rizal."
    },
    {
      "type": "paragraph",
      "text": "Farid berada di sisi mereka."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tiada siapa bercakap tentang kemenangan."
    },
    {
      "type": "paragraph",
      "text": "Kerana kemenangan itu terasa terlalu mahal."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 2.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "“Dah selesai.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka semula."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kau ok?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang meja."
    },
    {
      "type": "paragraph",
      "text": "Di atasnya ada jam tangan Roy."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya."
    },
    {
      "type": "paragraph",
      "text": "Berita tersebar."
    },
    {
      "type": "paragraph",
      "text": "Dato’ Hashim tidak lagi mengawal operasi seperti dahulu."
    },
    {
      "type": "paragraph",
      "text": "Beberapa aset dibekukan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat disiasat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa orangnya hilang daripada rangkaian."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Hashim sendiri…"
    },
    {
      "type": "paragraph",
      "text": "tidak muncul."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di hadapan tingkap pejabat."
    },
    {
      "type": "paragraph",
      "text": "Adam masuk."
    },
    {
      "type": "paragraph",
      "text": "“Kita berjaya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kita ambil alih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal masih diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memberikan laporan."
    },
    {
      "type": "paragraph",
      "text": "Angka besar."
    },
    {
      "type": "paragraph",
      "text": "Jauh lebih besar daripada apa yang Rizal pernah bayangkan ketika dia mula."
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang semua ni kita punya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat angka itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat bangunan di luar."
    },
    {
      "type": "paragraph",
      "text": "Dia teringat rumah."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Bayi yang bakal lahir."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia teringat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Ayat terakhirnya."
    },
    {
      "type": "paragraph",
      "text": "**Saya bangga dengan awak.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Jangan sambut.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum habis.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal masuk ke pejabat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Kerusi yang selalu digunakan Hashim masih di situ."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada sebuah buku nota."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Membuka halaman pertama."
    },
    {
      "type": "paragraph",
      "text": "Tulisan Hashim."
    },
    {
      "type": "paragraph",
      "text": "**“Sistem yang bergantung kepada seorang manusia akan mati bersama manusia itu.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Halaman kedua."
    },
    {
      "type": "paragraph",
      "text": "**“Bina sesuatu yang boleh hidup tanpa kau.”**"
    },
    {
      "type": "paragraph",
      "text": "Halaman ketiga."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di kerusi Hashim."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat seluruh pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia masuk ke bilik ini sebagai guru yang mencari jalan untuk menyelamatkan keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia duduk di tempat seorang lelaki yang telah dia jatuhkan."
    },
    {
      "type": "paragraph",
      "text": "Adam masuk."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat papan putih."
    },
    {
      "type": "paragraph",
      "text": "Ada satu perkataan lama yang masih belum dipadam."
    },
    {
      "type": "paragraph",
      "text": "**SYSTEM.**"
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil marker."
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**EMPIRE.**"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kita jadi macam dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti menulis."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Kita akan jadi lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "**EMPIRE.**"
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali…"
    },
    {
      "type": "paragraph",
      "text": "dia tidak lagi bercakap tentang keluarga."
    },
    {
      "type": "paragraph",
      "text": "Tidak lagi tentang rawatan."
    },
    {
      "type": "paragraph",
      "text": "Tidak lagi tentang masa."
    },
    {
      "type": "paragraph",
      "text": "Dia bercakap tentang kuasa."
    },
    {
      "type": "paragraph",
      "text": "Di luar bangunan, sebuah kereta berhenti."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki keluar."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang papan tanda Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "“Hashim dah jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "Suara di hujung talian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Siapa ambil alih?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu memandang bangunan."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Dia diam seketika."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi sekarang kita tahu siapa masalah sebenar.”"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 11**"
    }
  ],
