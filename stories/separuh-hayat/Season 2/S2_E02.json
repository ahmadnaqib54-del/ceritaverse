{
  "series": "Separuh Hayat",
  "season": 2,
  "episode": 2,
  "title": "S2 E2",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 2\n## THE SYSTEM"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah berada di Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Adam sampai dua minit kemudian."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Dia suruh pukul lapan.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang baru tujuh lima puluh lapan.”"
    },
    {
      "type": "paragraph",
      "text": "“Dua minit lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengeluh."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah mula ikut perangai dia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka masuk ke pejabat operasi."
    },
    {
      "type": "paragraph",
      "text": "Hashim sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada tiga fail."
    },
    {
      "type": "paragraph",
      "text": "Hashim menolak semuanya ke arah Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Semalam saya bagi awak tiga hari.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail pertama."
    },
    {
      "type": "paragraph",
      "text": "“Tak sampai tiga hari pun.”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab itu saya panggil awak hari ini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Fail pertama tentang inventori."
    },
    {
      "type": "paragraph",
      "text": "Fail kedua tentang kapasiti."
    },
    {
      "type": "paragraph",
      "text": "Fail ketiga tentang kualiti."
    },
    {
      "type": "paragraph",
      "text": "Tiga masalah."
    },
    {
      "type": "paragraph",
      "text": "Tiga jabatan."
    },
    {
      "type": "paragraph",
      "text": "Tiga orang pengurus."
    },
    {
      "type": "paragraph",
      "text": "Semuanya ada alasan masing-masing."
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca tanpa bercakap."
    },
    {
      "type": "paragraph",
      "text": "Adam berdiri di belakang."
    },
    {
      "type": "paragraph",
      "text": "“Masalah apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Bukan tiga masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Satu.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Teruskan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Dia menarik satu kertas kosong."
    },
    {
      "type": "paragraph",
      "text": "“Stok tak stabil.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menulis."
    },
    {
      "type": "paragraph",
      "text": "“Pengeluaran tak konsisten.”"
    },
    {
      "type": "paragraph",
      "text": "Satu lagi."
    },
    {
      "type": "paragraph",
      "text": "“Kualiti berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Adam memandang kertas itu."
    },
    {
      "type": "paragraph",
      "text": "“Bukankah itu yang saya cakap?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia melukis tiga kotak."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu anak panah menghubungkan semuanya."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan tiga masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengetuk meja."
    },
    {
      "type": "paragraph",
      "text": "“Ini satu sistem yang tak seimbang.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Terangkan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk kotak pertama."
    },
    {
      "type": "paragraph",
      "text": "“Stok terlalu tinggi pada beberapa bahan. Tapi bahan tertentu pula selalu kurang.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk kotak kedua."
    },
    {
      "type": "paragraph",
      "text": "“Bila bahan tertentu kurang, pengeluaran terpaksa ubah jadual.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian kotak ketiga."
    },
    {
      "type": "paragraph",
      "text": "“Bila jadual berubah, proses berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mula faham."
    },
    {
      "type": "paragraph",
      "text": "“Dan bila proses berubah…”"
    },
    {
      "type": "paragraph",
      "text": "“Kualiti berubah.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Jadi mereka cuba selesaikan masalah kualiti dengan tambah pemeriksaan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Padahal punca dia mungkin bermula dari inventori.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Teruskan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan ke papan putih."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang kawal inventori?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menyebut satu nama."
    },
    {
      "type": "paragraph",
      "text": "“Pengurus pembelian.”"
    },
    {
      "type": "paragraph",
      "text": "“Pengeluaran?”"
    },
    {
      "type": "paragraph",
      "text": "“Pengurus operasi.”"
    },
    {
      "type": "paragraph",
      "text": "“Kualiti?”"
    },
    {
      "type": "paragraph",
      "text": "“QC.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menulis tiga nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia buat satu garisan panjang di bawah semuanya."
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya bukan orang.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya setiap orang cuma nampak bahagian masing-masing.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Macam kilang kita dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Macam semua kilang.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim bangun."
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa yang awak nak buat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia kembali ke fail."
    },
    {
      "type": "paragraph",
      "text": "“Saya nak tengok data.”"
    },
    {
      "type": "paragraph",
      "text": "“Data apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Stok. Pengeluaran. Downtime. Reject. Aduan pelanggan. Pembelian.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim diam."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua hari.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mencelah."
    },
    {
      "type": "paragraph",
      "text": "“Kau baru kata tiga hari tadi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang dua.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Hashim pula tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Beri dia akses.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Dua hari berikutnya, Rizal hampir tidak keluar dari bilik operasi."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca."
    },
    {
      "type": "paragraph",
      "text": "Semak."
    },
    {
      "type": "paragraph",
      "text": "Banding."
    },
    {
      "type": "paragraph",
      "text": "Catat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ulang semula."
    },
    {
      "type": "paragraph",
      "text": "Adam mula bosan."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah tengok fail tu empat kali.”"
    },
    {
      "type": "paragraph",
      "text": "“Lima.”"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Lima?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ada sesuatu yang tak kena.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Angka.”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk di kerusi sebelah."
    },
    {
      "type": "paragraph",
      "text": "“Angka apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk satu laporan."
    },
    {
      "type": "paragraph",
      "text": "“Pengeluaran bulanan meningkat.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia membuka laporan lain."
    },
    {
      "type": "paragraph",
      "text": "“Tapi margin turun.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail seterusnya."
    },
    {
      "type": "paragraph",
      "text": "“Stok meningkat.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "“Downtime meningkat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mula duduk tegak."
    },
    {
      "type": "paragraph",
      "text": "“Dan reject?”"
    },
    {
      "type": "paragraph",
      "text": "“Naik sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghembus nafas."
    },
    {
      "type": "paragraph",
      "text": "“Jadi mereka jual lebih banyak…”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi dapat kurang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan pertumbuhan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Ini pembaziran yang nampak macam pertumbuhan.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Hashim masuk."
    },
    {
      "type": "paragraph",
      "text": "“Jumpa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim duduk."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk buat saya tak suka laporan bulanan awak.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan beberapa kertas di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Masalah utama bukan kapasiti.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Bukan?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan inventori?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan sepenuhnya.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk kepada satu carta."
    },
    {
      "type": "paragraph",
      "text": "“Timing.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim diam."
    },
    {
      "type": "paragraph",
      "text": "“Bila pembelian dibuat.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk carta kedua."
    },
    {
      "type": "paragraph",
      "text": "“Bila stok masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Ketiga."
    },
    {
      "type": "paragraph",
      "text": "“Bila pengeluaran dijadualkan.”"
    },
    {
      "type": "paragraph",
      "text": "Keempat."
    },
    {
      "type": "paragraph",
      "text": "“Bila produk dihantar.”"
    },
    {
      "type": "paragraph",
      "text": "Dia susun semua kertas itu seperti satu rantaian."
    },
    {
      "type": "paragraph",
      "text": "“Semua benda bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi tak bergerak bersama.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat carta itu lama."
    },
    {
      "type": "paragraph",
      "text": "“Dan penyelesaian?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Berhenti urus jabatan.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Urus apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sistem.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pulang lewat."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Jam hampir sebelas."
    },
    {
      "type": "paragraph",
      "text": "“Kerja baru awak memang sampai malam?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka kasut."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kerja apa sebenarnya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Pengurusan.”"
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sejak bila cikgu kimia jadi pengurus?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sejak orang sanggup bayar.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandang suaminya."
    },
    {
      "type": "paragraph",
      "text": "Rizal nampak keletihan di wajahnya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ada sesuatu yang lain."
    },
    {
      "type": "paragraph",
      "text": "Curiga."
    },
    {
      "type": "paragraph",
      "text": "“Awak suka kerja ni?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab bila awak cerita pasal sekolah, awak selalu nampak penat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Tapi bila awak cerita pasal kilang…”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Awak nampak hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tahu mahu jawab apa."
    },
    {
      "type": "paragraph",
      "text": "Roy keluar dari bilik."
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jam tu masih pakai?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam pemberian Roy."
    },
    {
      "type": "paragraph",
      "text": "Masih di pergelangan tangan."
    },
    {
      "type": "paragraph",
      "text": "“Masih.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Dia kembali ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat Linda."
    },
    {
      "type": "paragraph",
      "text": "Untuk sesaat, dia teringat kenapa semua ini bermula."
    },
    {
      "type": "paragraph",
      "text": "Keluarga."
    },
    {
      "type": "paragraph",
      "text": "Masa."
    },
    {
      "type": "paragraph",
      "text": "Masa depan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi fikirannya sudah berubah."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia fikir tentang berapa banyak wang yang dia perlukan."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia fikir tentang berapa besar sistem yang boleh dia bina."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, perubahan bermula."
    },
    {
      "type": "paragraph",
      "text": "Bukan perubahan besar."
    },
    {
      "type": "paragraph",
      "text": "Tiada pengumuman."
    },
    {
      "type": "paragraph",
      "text": "Tiada mesyuarat dramatik."
    },
    {
      "type": "paragraph",
      "text": "Cuma beberapa keputusan kecil."
    },
    {
      "type": "paragraph",
      "text": "Jadual diubah."
    },
    {
      "type": "paragraph",
      "text": "Stok disusun semula."
    },
    {
      "type": "paragraph",
      "text": "Beberapa proses yang bertindih dihentikan."
    },
    {
      "type": "paragraph",
      "text": "Data mula dikumpulkan dalam satu sistem."
    },
    {
      "type": "paragraph",
      "text": "Setiap masalah mesti mempunyai pemilik."
    },
    {
      "type": "paragraph",
      "text": "Setiap pemilik mesti mempunyai angka."
    },
    {
      "type": "paragraph",
      "text": "Setiap angka mesti ada sebab."
    },
    {
      "type": "paragraph",
      "text": "Dan setiap sebab mesti ada tindakan."
    },
    {
      "type": "paragraph",
      "text": "Dalam masa beberapa minggu, sesuatu berubah."
    },
    {
      "type": "paragraph",
      "text": "Downtime turun."
    },
    {
      "type": "paragraph",
      "text": "Reject turun."
    },
    {
      "type": "paragraph",
      "text": "Stok mati berkurang."
    },
    {
      "type": "paragraph",
      "text": "Pengeluaran menjadi lebih stabil."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana Rizal bekerja lebih keras."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana sistem mula bekerja dengan lebih baik."
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat perubahan itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak puji Rizal di depan orang."
    },
    {
      "type": "paragraph",
      "text": "Sebaliknya, dia memanggil Rizal ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu apa beza awak dengan kebanyakan orang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka nampak kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Awak nampak hubungan antara kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim berdiri di tepi tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Sebab itu saya suka orang macam awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Hashim berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Tapi ada satu masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang boleh melihat keseluruhan sistem…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim berjalan kembali ke meja."
    },
    {
      "type": "paragraph",
      "text": "“…akhirnya akan mahu mengawal keseluruhan sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jangan risau.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil fail lain."
    },
    {
      "type": "paragraph",
      "text": "“Belum lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil fail tersebut."
    },
    {
      "type": "paragraph",
      "text": "“Ini apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bahagian yang belum awak lihat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Kali ini bukan tentang kilang."
    },
    {
      "type": "paragraph",
      "text": "Bukan tentang inventori."
    },
    {
      "type": "paragraph",
      "text": "Bukan tentang pengeluaran."
    },
    {
      "type": "paragraph",
      "text": "Ada senarai syarikat."
    },
    {
      "type": "paragraph",
      "text": "Akaun."
    },
    {
      "type": "paragraph",
      "text": "Restoran."
    },
    {
      "type": "paragraph",
      "text": "Gudang."
    },
    {
      "type": "paragraph",
      "text": "Pembekal."
    },
    {
      "type": "paragraph",
      "text": "Beberapa nama yang Rizal tidak kenal."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat Hashim."
    },
    {
      "type": "paragraph",
      "text": "“Ini semua bawah Bumi Perdana?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim duduk."
    },
    {
      "type": "paragraph",
      "text": "“Ini sistem saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca semula."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Barulah dia faham."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana bukan pusat."
    },
    {
      "type": "paragraph",
      "text": "Ia cuma salah satu bahagian."
    },
    {
      "type": "paragraph",
      "text": "Ayam Gepuk Hut bukan sekadar restoran."
    },
    {
      "type": "paragraph",
      "text": "Ia juga sebahagian daripada rangkaian."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat lain yang kelihatan tidak berkaitan sebenarnya mempunyai hubungan tertentu."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak bertanya bagaimana."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak perlu."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah nampak gambarnya."
    },
    {
      "type": "paragraph",
      "text": "Hashim bukan sekadar memiliki kilang."
    },
    {
      "type": "paragraph",
      "text": "Hashim memiliki ekosistem."
    },
    {
      "type": "paragraph",
      "text": "Satu sistem yang jauh lebih besar daripada apa yang Rizal bayangkan."
    },
    {
      "type": "paragraph",
      "text": "Hashim melihat wajah Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang awak faham kenapa saya pilih awak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab kalau awak rasa awak sudah faham semuanya…”"
    },
    {
      "type": "paragraph",
      "text": "Hashim bersandar."
    },
    {
      "type": "paragraph",
      "text": "“…awak akan mula buat silap.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal duduk sendirian di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak terus pulang."
    },
    {
      "type": "paragraph",
      "text": "Fail Hashim berada di tempat duduk sebelah."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat jam di pergelangan tangan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kembali melihat jam."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia mahu RM500,000."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu juta."
    },
    {
      "type": "paragraph",
      "text": "Sekarang angka itu tidak lagi berada dalam fikirannya."
    },
    {
      "type": "paragraph",
      "text": "Dia mula memikirkan sesuatu yang lain."
    },
    {
      "type": "paragraph",
      "text": "Bukan wang."
    },
    {
      "type": "paragraph",
      "text": "**Skala.**"
    },
    {
      "type": "paragraph",
      "text": "Bukan produk."
    },
    {
      "type": "paragraph",
      "text": "**Sistem.**"
    },
    {
      "type": "paragraph",
      "text": "Bukan menjadi pekerja Hashim."
    },
    {
      "type": "paragraph",
      "text": "**Menjadi orang yang memiliki sistem sendiri.**"
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghidupkan enjin."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim nak kita masuk satu lagi operasi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jalan di hadapan."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Kau tak nak tanya apa operasi tu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Esok kita tengok.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup telefon."
    },
    {
      "type": "paragraph",
      "text": "Kereta bergerak meninggalkan Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Di tingkat atas bangunan, Hashim berdiri di belakang tingkap."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat kereta Rizal hilang di jalan."
    },
    {
      "type": "paragraph",
      "text": "Di sebelahnya, seorang lelaki bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Dia boleh dipercayai?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kenapa beri dia akses?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya nak tahu…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…berapa jauh dia akan pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Di jalan raya, Rizal terus memandu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu Hashim sedang memerhatikannya."
    },
    {
      "type": "paragraph",
      "text": "Dan dia tidak tahu satu perkara lagi."
    },
    {
      "type": "paragraph",
      "text": "Semakin banyak sistem yang dia faham…"
    },
    {
      "type": "paragraph",
      "text": "semakin banyak sistem yang akan mula bergantung kepadanya."
    },
    {
      "type": "paragraph",
      "text": "Dan apabila seseorang menjadi terlalu penting kepada sebuah sistem—"
    },
    {
      "type": "paragraph",
      "text": "dia bukan lagi sekadar sebahagian daripada sistem."
    },
    {
      "type": "paragraph",
      "text": "Dia menjadi ancaman kepada sesiapa yang mengawalnya."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 2**"
    }
  ],
