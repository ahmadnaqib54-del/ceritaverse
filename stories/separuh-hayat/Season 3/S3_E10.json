      "type": "paragraph",
      "text": "“Kita pastikan dulu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal mendapat panggilan daripada Maya."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya jumpa sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan masalah kewangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Struktur.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Maya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ada beberapa bahagian dalam kumpulan ini yang saya tak boleh jelaskan hanya berdasarkan operasi yang kita nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang keluar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Awak fikir ada sesuatu yang disembunyikan?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya fikir…”"
    },
    {
      "type": "paragraph",
      "text": "Maya berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Seseorang tidak memberitahu saya semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dan itu siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum tipis."
    },
    {
      "type": "paragraph",
      "text": "“Cari.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Telefon ditutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "Satu masalah datang dari Amir."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi dari Maya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Farid."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Adam."
    },
    {
      "type": "paragraph",
      "text": "Empayar itu semakin besar."
    },
    {
      "type": "paragraph",
      "text": "Dan semakin besar empayar itu..."
    },
    {
      "type": "paragraph",
      "text": "semakin banyak bahagian yang Rizal sendiri tidak mampu lihat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir memandu pulang."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**“Saya ada sesuatu tentang Rizal.”**"
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti di lampu merah."
    },
    {
      "type": "paragraph",
      "text": "Dia membalas:"
    },
    {
      "type": "paragraph",
      "text": "**“Apa?”**"
    },
    {
      "type": "paragraph",
      "text": "Balasan datang."
    },
    {
      "type": "paragraph",
      "text": "**“Jumpa saya.”**"
    },
    {
      "type": "paragraph",
      "text": "Amir menunggu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lokasi dihantar."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat jam."
    },
    {
      "type": "paragraph",
      "text": "Dia membuat keputusan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama, Rizal menerima satu panggilan."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "Suara Farid."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir keluar.”"
    },
    {
      "type": "paragraph",
      "text": "“Mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Farid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Tapi dia seorang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu Amir sedang menuju ke sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Sesuatu yang mungkin mengubah semuanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Amir tiba di sebuah tempat sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia keluar dari kereta."
    },
    {
      "type": "paragraph",
      "text": "Menunggu."
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seorang lelaki muncul dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Amir mencapai failnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau awak nak tahu siapa Rizal…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tanya dia.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sebab dia akan tipu awak.”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu menyerahkan satu sampul."
    },
    {
      "type": "paragraph",
      "text": "Kemudian pergi."
    },
    {
      "type": "paragraph",
      "text": "Amir membuka sampul itu."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya hanya ada satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bukan Rizal yang dia kenal."
    },
    {
      "type": "paragraph",
      "text": "Gambar itu menunjukkan Rizal bersama seseorang yang Amir kenal."
    },
    {
      "type": "paragraph",
      "text": "Amir membeku."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat gambar itu sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berbisik,"
    },
    {
      "type": "paragraph",
      "text": "“Tak mungkin…”"
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia tidak percaya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana untuk pertama kali..."
    },
    {
      "type": "paragraph",
      "text": "**blind spot itu mula pecah.**"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 10**"
    }
