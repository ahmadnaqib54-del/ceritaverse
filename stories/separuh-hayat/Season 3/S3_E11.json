{
  "series": "Separuh Hayat",
  "season": 3,
  "episode": 11,
  "title": "S3 E11",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 3 — EPISODE 11\n## THE FAMILY"
    },
    {
      "type": "paragraph",
      "text": "Amir masih memegang gambar itu."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah melihatnya lebih daripada sepuluh kali."
    },
    {
      "type": "paragraph",
      "text": "Tetapi setiap kali dia melihatnya, dia berharap gambar itu akan berubah."
    },
    {
      "type": "paragraph",
      "text": "Tidak."
    },
    {
      "type": "paragraph",
      "text": "Ia masih sama."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bersama seseorang yang tidak sepatutnya berada di situ."
    },
    {
      "type": "paragraph",
      "text": "Dan di belakang mereka—"
    },
    {
      "type": "paragraph",
      "text": "tempat yang Amir kenal."
    },
    {
      "type": "paragraph",
      "text": "**Bumi Perdana.**"
    },
    {
      "type": "paragraph",
      "text": "Amir duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak terus memandu."
    },
    {
      "type": "paragraph",
      "text": "Telefon berada di tangannya."
    },
    {
      "type": "paragraph",
      "text": "Nama **Rizal** muncul di skrin."
    },
    {
      "type": "paragraph",
      "text": "Ibu jarinya hampir menekan panggilan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Tidak."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu tahu lebih banyak."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya, Rizal bangun seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah di dapur."
    },
    {
      "type": "paragraph",
      "text": "Roy sedang bersarapan."
    },
    {
      "type": "paragraph",
      "text": "Bayi menangis dari bilik."
    },
    {
      "type": "paragraph",
      "text": "Suasana rumah biasa."
    },
    {
      "type": "paragraph",
      "text": "Terlalu biasa."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Morning.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menjawab pendek."
    },
    {
      "type": "paragraph",
      "text": "“Morning.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ayah tidur?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Muka Ayah macam tak tidur.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia juga nampak."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil roti."
    },
    {
      "type": "paragraph",
      "text": "“Ayah okay.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Amir datang semalam?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Mak cakap dia datang.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang Roy."
    },
    {
      "type": "paragraph",
      "text": "“Jangan sibuk.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Rizal turut tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, semuanya normal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon Rizal bergetar."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "**Adam.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Saya jawab kejap.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar ke balkoni."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang rumah."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir dapat sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Gambar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membeku."
    },
    {
      "type": "paragraph",
      "text": "“Gambar apa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memberitahu."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang bagi?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata seketika."
    },
    {
      "type": "paragraph",
      "text": "“Cari.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Linda berdiri di pintu balkoni."
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Awak selalu jawab telefon jauh daripada kami sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu apa yang paling pelik?”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak semakin kaya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Tapi awak semakin takut.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal cuba tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tipu saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Linda keluar membeli barang."
    },
    {
      "type": "paragraph",
      "text": "Dia bertemu Amir secara tidak sengaja."
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Linda.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau okay?”"
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka berdiri di tepi jalan."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau sedang siasat sesuatu?”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "“Pasal Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Amir tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah tahu jawapannya."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau jumpa sesuatu…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Beritahu aku.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang kakaknya."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu macam mana.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab kalau apa yang aku fikir betul…”"
    },
    {
      "type": "paragraph",
      "text": "Amir tidak mampu menyelesaikan ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Linda menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Amir berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku takut kau akan terluka.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku dah lama terluka.”"
    },
    {
      "type": "paragraph",
      "text": "Amir terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Cuma aku tak tahu kenapa.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Linda menunggu Rizal."
    },
    {
      "type": "paragraph",
      "text": "Pukul 9."
    },
    {
      "type": "paragraph",
      "text": "10."
    },
    {
      "type": "paragraph",
      "text": "11."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Rizal pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Lampu masih menyala."
    },
    {
      "type": "paragraph",
      "text": "“Belum tidur?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan beg."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Linda berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Linda berdiri di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama awak dah buat benda ni?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membeku."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada penjelasan."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada soalan."
    },
    {
      "type": "paragraph",
      "text": "Hanya satu ayat."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah sampai ke tahap dia tidak lagi bertanya **sama ada**."
    },
    {
      "type": "paragraph",
      "text": "Dia bertanya **berapa lama**."
    },
    {
      "type": "paragraph",
      "text": "Rizal menatapnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang awak maksudkan?”"
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Pahit."
    },
    {
      "type": "paragraph",
      "text": "“Masih nak tipu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Saya nampak perubahan awak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mula menangis."
    },
    {
      "type": "paragraph",
      "text": "“Kereta. Rumah. Duit. Orang yang datang. Telefon. Cara awak bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Linda—”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu apa awak buat.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengesat air mata."
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya tahu satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan lagi tentang keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mampu menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Ini tentang awak.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk semula."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang lantai."
    },
    {
      "type": "paragraph",
      "text": "“Aku buat semua ni sebab aku takut.”"
    },
    {
      "type": "paragraph",
      "text": "Linda terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Takut mati.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Takut tinggalkan kamu semua tanpa apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menangis."
    },
    {
      "type": "paragraph",
      "text": "“Jadi awak buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Awak bina dunia yang saya sendiri tak kenal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya boleh betulkan.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Awak selalu cakap macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Linda berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Awak mula semua ni kerana masa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk jam tangan Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang awak habiskan masa itu dengan apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jamnya."
    },
    {
      "type": "paragraph",
      "text": "Jam yang Roy beri."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di pejabat, Amir sedang membaca dokumen."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah semakin hampir."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sesuatu mengganggunya."
    },
    {
      "type": "paragraph",
      "text": "Gambar tadi."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu tahu siapa yang mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Siapa yang memberikannya."
    },
    {
      "type": "paragraph",
      "text": "Dan kenapa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kami dapat nama.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menyebut satu nama."
    },
    {
      "type": "paragraph",
      "text": "Amir terus berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Pastikan maklumat itu sah.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia tidak lagi berkata,"
    },
    {
      "type": "paragraph",
      "text": "**“Tak mungkin.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia hanya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Zal…”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di Bumi Perdana, Rizal duduk bersama Adam."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dari sesetengah benda.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam memahami."
    },
    {
      "type": "paragraph",
      "text": "“Linda?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Adam bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau dah terlalu jauh.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku boleh susun semula.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menundukkan suara."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau berhenti sekarang, orang yang bergantung pada kau akan jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang ada dalam sistem ni bukan semua macam kita.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa kata?”"
    },
    {
      "type": "paragraph",
      "text": "“Realitinya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kita bina semua ni supaya kita bebas.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kita terperangkap sebab kita bina terlalu besar.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal masuk ke bilik Roy."
    },
    {
      "type": "paragraph",
      "text": "Roy masih berjaga."
    },
    {
      "type": "paragraph",
      "text": "“Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Boleh Ayah tanya sesuatu?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau Ayah buat sesuatu yang salah…”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Jawab saja.”"
    },
    {
      "type": "paragraph",
      "text": "Roy berfikir."
    },
    {
      "type": "paragraph",
      "text": "“Kalau Ayah salah, Ayah minta maaf.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kesalahan Ayah besar?”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Lagi kena minta maaf.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia memeluk anaknya."
    },
    {
      "type": "paragraph",
      "text": "Roy terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Ayah okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Tetapi matanya mula berair."
    },
    {
      "type": "paragraph",
      "text": "Roy berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan pergi mana-mana.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memeluk anaknya lebih kuat."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Linda membuat satu keputusan."
    },
    {
      "type": "paragraph",
      "text": "Dia mengemas sedikit barang bayi."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat."
    },
    {
      "type": "paragraph",
      "text": "“Awak nak ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Rumah mak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya perlukan masa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di pintu."
    },
    {
      "type": "paragraph",
      "text": "“Linda.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tinggalkan awak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bukan awak yang tinggalkan saya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Saya yang sedang cuba selamatkan diri saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Linda mengambil bayi."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Saya harap satu hari nanti awak faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bahawa keluarga bukan sesuatu yang awak boleh beli.”"
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri seorang diri."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir dah tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Sejauh mana?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk mula bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang pintu rumah."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bilik Roy."
    },
    {
      "type": "paragraph",
      "text": "Kemudian jam tangannya."
    },
    {
      "type": "paragraph",
      "text": "Semua yang dia mahu lindungi sedang mula menjauh."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali sejak dia memulakan semuanya..."
    },
    {
      "type": "paragraph",
      "text": "Rizal sedar sesuatu yang sangat pahit."
    },
    {
      "type": "paragraph",
      "text": "Dia telah membina empayar supaya keluarganya tidak pernah hidup susah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi empayar itu sendiri mungkin sedang menjadi sebab keluarganya meninggalkannya."
    },
    {
      "type": "paragraph",
      "text": "Telefon masih di telinganya."
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Zal?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kita kena pastikan semuanya tak jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 11**"
    }
