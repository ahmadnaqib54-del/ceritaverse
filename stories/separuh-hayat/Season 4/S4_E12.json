    {
      "type": "paragraph",
      "text": "Farid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang hubungi saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus serius."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia yang ugut keluarga kau?”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia yang suruh kau?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal faham."
    },
    {
      "type": "paragraph",
      "text": "Farid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bos…”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya rasa kita semua dipermainkan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Farid menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dan saya rasa orang itu mahu bos fikir saya yang paling bersalah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab bila bos sibuk melindungi saya…”"
    },
    {
      "type": "paragraph",
      "text": "Farid berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…bos takkan cari orang lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang membuatkan dia sedar."
    },
    {
      "type": "paragraph",
      "text": "Selama ini Farid mungkin bukan hanya alat."
    },
    {
      "type": "paragraph",
      "text": "Dia juga mungkin umpan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, Adam datang dengan berita."
    },
    {
      "type": "paragraph",
      "text": "“Aku jumpa sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus bangun."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa dia?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyerahkan satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Bukan siapa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membukanya."
    },
    {
      "type": "paragraph",
      "text": "Satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki berusia sekitar enam puluh tahun."
    },
    {
      "type": "paragraph",
      "text": "Kemas."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "Tidak kelihatan seperti orang yang menjalankan operasi haram."
    },
    {
      "type": "paragraph",
      "text": "Di bawah gambar:"
    },
    {
      "type": "paragraph",
      "text": "**DANIEL VOSS**"
    },
    {
      "type": "paragraph",
      "text": "**INVESTMENT ADVISOR**"
    },
    {
      "type": "paragraph",
      "text": "**PRIVATE CAPITAL**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "“Dia orang bisnes?”"
    },
    {
      "type": "paragraph",
      "text": "“Secara rasmi.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan secara tidak rasmi?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat halaman seterusnya."
    },
    {
      "type": "paragraph",
      "text": "Ada sejarah hubungan dengan beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Salah satunya—"
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi—"
    },
    {
      "type": "paragraph",
      "text": "syarikat yang pernah dikaitkan dengan Hashim."
    },
    {
      "type": "paragraph",
      "text": "Dan satu lagi—"
    },
    {
      "type": "paragraph",
      "text": "syarikat yang pernah membiayai operasi awal yang tidak diketahui Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Ini dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Belum tentu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Cari dia.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal pergi ke rumah lama Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu jawapan."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik sedang duduk di halaman."
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik tidak kelihatan terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Kau sudah sampai kepadanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia yang mulakan Project Hayat?”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik diam."
    },
    {
      "type": "paragraph",
      "text": "“Jawab.”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih fikir ada seorang lelaki di atas yang mengawal semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang sistem lebih tua daripada orang yang berada di dalamnya.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Dan itulah sebabnya kau dipilih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengepalkan tangan."
    },
    {
      "type": "paragraph",
      "text": "“Aku bukan dipilih untuk jadi raja.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik memandang tepat kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Kau dipilih untuk melihat sama ada sistem itu boleh menghasilkan seorang raja sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal kembali ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Adam sedang menunggu."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**DR. MALIK**"
    },
    {
      "type": "paragraph",
      "text": "**HASHIM**"
    },
    {
      "type": "paragraph",
      "text": "**KHALID**"
    },
    {
      "type": "paragraph",
      "text": "**DANIEL VOSS**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**AMIR**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Nama itu masih terasa sakit."
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**FARID**"
    },
    {
      "type": "paragraph",
      "text": "**ADAM**"
    },
    {
      "type": "paragraph",
      "text": "**MAYA**"
    },
    {
      "type": "paragraph",
      "text": "**LINDA**"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang semua nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu perkara menjadi jelas."
    },
    {
      "type": "paragraph",
      "text": "Musuhnya bukan satu orang."
    },
    {
      "type": "paragraph",
      "text": "Ia sebuah sistem."
    },
    {
      "type": "paragraph",
      "text": "Dan sistem itu sudah wujud sebelum dia masuk ke dalamnya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Adam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa kita buat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia mengambil fail Project Hayat."
    },
    {
      "type": "paragraph",
      "text": "“Cari semua orang yang terlibat.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua.”"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dr. Malik?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Daniel Voss?”"
    },
    {
      "type": "paragraph",
      "text": "“Terutama dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal menambah,"
    },
    {
      "type": "paragraph",
      "text": "“Dan sesiapa yang masih hidup daripada rangkaian lama.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau nak apa daripada mereka?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat gambar dirinya yang diambil bertahun-tahun dahulu."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tahu kenapa.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa aku?”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Dan siapa yang fikir mereka boleh menentukan hidup aku.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama, jauh dari situ—"
    },
    {
      "type": "paragraph",
      "text": "sebuah bilik gelap."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki duduk di hadapan beberapa skrin."
    },
    {
      "type": "paragraph",
      "text": "Di skrin utama ada gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "Di sebelahnya gambar Adam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Khalid."
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Dan gambar Amir."
    },
    {
      "type": "paragraph",
      "text": "Fail Amir ditandakan:"
    },
    {
      "type": "paragraph",
      "text": "**STATUS: TERMINATED**"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu membuka fail baru."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL — RESPONSE**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya satu ayat:"
    },
    {
      "type": "paragraph",
      "text": "**“SUBJEK TELAH MENYEDARI KEWUJUDAN SISTEM.”**"
    },
    {
      "type": "paragraph",
      "text": "Seseorang di belakang bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Patut kita hentikan?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Sebab sekarang baru menarik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Mulakan Phase Five.”"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT SEASON 4.**"
    }
  ],
