      "type": "paragraph",
      "text": "“Amir mungkin sudah mati.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Aku belum pasti.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
