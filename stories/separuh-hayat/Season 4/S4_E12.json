    {
      "type": "paragraph",
      "text": "Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kau perlu tahu sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandangnya."
