    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal bertemu Farid."
    },
    {
      "type": "paragraph",
      "text": "Farid kelihatan lebih kurus."
    },
    {
      "type": "paragraph",
      "text": "Lebih tua."
    },
