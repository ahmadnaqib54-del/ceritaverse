{
  "series": "Separuh Hayat",
  "season": 4,
  "episode": 6,
  "title": "S4 E6",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 4 — EPISODE 6\n## FARID"
    },
    {
      "type": "paragraph",
      "text": "Farid tidak tidur malam itu."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Enjin dimatikan."
    },
    {
      "type": "paragraph",
      "text": "Lampu juga dimatikan."
    },
    {
      "type": "paragraph",
      "text": "Hanya telefon di tangannya yang menyala."
    },
    {
      "type": "paragraph",
      "text": "Gambar yang diterima petang tadi masih berada di skrin."
    },
    {
      "type": "paragraph",
      "text": "Amir."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Farid sendiri."
    },
    {
      "type": "paragraph",
      "text": "Semuanya berada dalam satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu siapa yang mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Seseorang sedang memerhatikan mereka."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada suara."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu ayat."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau betul-betul setia kepada Rizal, kau tahu apa yang perlu dibuat.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terus mematikan panggilan."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ayat itu terus bermain dalam kepalanya."
    },
    {
      "type": "paragraph",
      "text": "**Apa yang perlu dibuat?**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya, Farid tiba di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah ada."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Farid duduk."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau okay?”"
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau nampak penat.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Farid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ada orang hubungi saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus serius."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa dia mahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia cakap saya tahu apa yang perlu dibuat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Kau jawab apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tutup telefon.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bos…”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau mereka datang kepada keluarga saya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu tidak mudah."
    },
    {
      "type": "paragraph",
      "text": "“Saya akan pastikan mereka tak sentuh keluarga kau.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Tapi kalau mereka datang kepada keluarga bos?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat apa-apa tanpa arahan.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan cuba jadi hero.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Saya bukan hero.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma orang yang tak suka tengok orang saya kena.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Farid keluar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, Amir menerima laporan."
    },
    {
      "type": "paragraph",
      "text": "Farid telah dikesan beberapa kali berhampiran lokasi yang berkaitan dengan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Amir membaca laporan itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Dia buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Pantau.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia sedar?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan dekat.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tidak mahu Farid tahu."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu melihat apa yang Farid lakukan apabila tiada siapa memberitahunya bahawa dia sedang diperhatikan."
    },
    {
      "type": "paragraph",
      "text": "Itulah cara Amir bekerja."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak suka meneka."
    },
    {
      "type": "paragraph",
      "text": "Dia suka melihat."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Farid pula sedar dia sedang diperhatikan."
    },
    {
      "type": "paragraph",
      "text": "Dia bukan bodoh."
    },
    {
      "type": "paragraph",
      "text": "Kereta yang sama muncul dua kali."
    },
    {
      "type": "paragraph",
      "text": "Lelaki yang sama berdiri di luar sebuah kedai."
    },
    {
      "type": "paragraph",
      "text": "Kemudian nombor yang sama menelefon."
    },
    {
      "type": "paragraph",
      "text": "Kali ketiga, Farid menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Suara lelaki itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu siapa Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "“Dia semakin dekat.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia teruskan…”"
    },
    {
      "type": "paragraph",
      "text": "Farid mencelah,"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengetap rahang."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kau tahu apa yang perlu dibuat.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terus memutuskan panggilan."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak mahu mendengar lagi."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kini satu perkara jelas."
    },
    {
      "type": "paragraph",
      "text": "Orang itu tahu tentang Amir."
    },
    {
      "type": "paragraph",
      "text": "Dan dia tahu tentang Rizal."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Farid pergi menemui Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Ah Len kelihatan tidak senang melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau datang?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tanya sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "“Pasal?”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len terus diam."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma nak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya tepat."
    },
    {
      "type": "paragraph",
      "text": "“Kau tak tahu apa yang kau sedang masuk.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi beritahu.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Khalid bukan macam orang yang biasa kita hadapi.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab dia tak perlu buat apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Dia cuma tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "“Tunggu apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang lain buat kerja untuk dia.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terdiam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dan orang seperti itu paling susah dihentikan.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Farid kembali ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Isterinya sedang tidur."
    },
    {
      "type": "paragraph",
      "text": "Anaknya juga."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri di pintu bilik."
    },
    {
      "type": "paragraph",
      "text": "Melihat mereka."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Farid melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "Satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Diambil dari seberang jalan."
    },
    {
      "type": "paragraph",
      "text": "Farid terus keluar."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat jalan."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan beberapa langkah."
    },
    {
      "type": "paragraph",
      "text": "Tiada sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia nampak sebuah kereta bergerak perlahan di hujung jalan."
    },
    {
      "type": "paragraph",
      "text": "Farid tidak mengejar."
    },
    {
      "type": "paragraph",
      "text": "Dia kembali ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali—"
    },
    {
      "type": "paragraph",
      "text": "dia benar-benar takut."
    },
    {
      "type": "paragraph",
      "text": "Bukan untuk dirinya."
    },
    {
      "type": "paragraph",
      "text": "Untuk keluarganya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Farid datang kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka tahu rumah saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus bangun."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud kau?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menunjukkan gambar."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau tak beritahu semalam?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak nak ganggu.”"
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Kalau mereka tahu rumah kau, ini bukan lagi permainan.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bawa keluarga kau keluar sementara.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Ke mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Mana-mana tempat yang selamat.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan bos?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku uruskan.”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bos selalu cakap jangan buat keputusan sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau suatu hari nanti saya perlu buat keputusan sendiri?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kalau keputusan itu untuk lindungi bos?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Farid bangun."
    },
    {
      "type": "paragraph",
      "text": "“Saya faham.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tidak faham."
    },
    {
      "type": "paragraph",
      "text": "Atau mungkin—"
    },
    {
      "type": "paragraph",
      "text": "dia faham terlalu baik."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Amir menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "“Encik Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kami ada sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir pergi ke lokasi."
    },
    {
      "type": "paragraph",
      "text": "Satu telefon ditemui."
    },
    {
      "type": "paragraph",
      "text": "Tiada nama."
    },
    {
      "type": "paragraph",
      "text": "Tiada maklumat jelas."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ada beberapa gambar."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Rumah Farid."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Amir sendiri."
    },
    {
      "type": "paragraph",
      "text": "Amir melihat gambar itu satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu gambar terakhir."
    },
    {
      "type": "paragraph",
      "text": "Linda dan Roy."
    },
    {
      "type": "paragraph",
      "text": "Amir terus berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang ambil?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang pegawainya."
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan untuk menakutkan Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau nak takutkan Rizal, mereka akan tunjuk gambar Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menunjukkan gambar Linda."
    },
    {
      "type": "paragraph",
      "text": "“Mereka mahu kita tahu mereka boleh sampai kepada keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Dia diam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Ini tekanan.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "Amir menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak semestinya.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir pergi menemui Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Melihat Amir."
    },
    {
      "type": "paragraph",
      "text": "“Masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Amir masuk."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk berhadapan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat tiada siapa bercakap."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Amir berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ada orang sedang perhatikan kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Farid?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia juga.”"
    },
    {
      "type": "paragraph",
      "text": "“Maya?”"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len?”"
    },
    {
      "type": "paragraph",
      "text": "“Sudah lama.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Amir faham."
    },
    {
      "type": "paragraph",
      "text": "“Kau kenal dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Baru.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu tentang Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu tentang kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menunduk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Rizal, aku bukan datang sebagai penyiasat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku datang sebagai abang ipar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kalau ada benda yang kau perlu beritahu aku…”"
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Beritahu sebelum terlambat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mahu menjawab."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tiada perkataan keluar."
    },
    {
      "type": "paragraph",
      "text": "Amir bangun."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu apa yang kau buat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tapi aku tahu kau takut.”"
    },
    {
      "type": "paragraph",
      "text": "Amir membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "“Dan orang yang takut biasanya buat keputusan paling buruk.”"
    },
    {
      "type": "paragraph",
      "text": "Pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri seorang diri."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, Farid menerima satu lagi panggilan."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Apa kau mahu?”"
    },
    {
      "type": "paragraph",
      "text": "Suara itu tenang."
    },
    {
      "type": "paragraph",
      "text": "“Amir akan datang kepada Rizal lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia teruskan, semua orang akan jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kau perlu pilih.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengetap rahang."
    },
    {
      "type": "paragraph",
      "text": "“Antara apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal…”"
    },
    {
      "type": "paragraph",
      "text": "Suara itu berhenti seketika."
    },
    {
      "type": "paragraph",
      "text": "“…atau keluarga kau.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Farid duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Tangannya menggigil."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat gambar anaknya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dua-duanya penting."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu—"
    },
    {
      "type": "paragraph",
      "text": "dia tidak boleh menyelamatkan kedua-duanya jika perang itu sampai ke tahap terakhir."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**ESOK. AMIR AKAN BERJUMPA DENGAN RIZAL.**"
    },
    {
      "type": "paragraph",
      "text": "Farid membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadamnya."
    },
    {
      "type": "paragraph",
      "text": "Dia memegang stereng."
    },
    {
      "type": "paragraph",
      "text": "Matanya kosong."
    },
    {
      "type": "paragraph",
      "text": "“Jangan paksa aku…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berbisik."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tiada siapa mendengar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, Amir masuk ke dalam keretanya."
    },
    {
      "type": "paragraph",
      "text": "Farid berada tidak jauh dari situ."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat Amir pergi."
    },
    {
      "type": "paragraph",
      "text": "Farid tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "Telefon di tangannya."
    },
    {
      "type": "paragraph",
      "text": "Satu nombor."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia hampir menelefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Jika dia memberitahu Rizal—"
    },
    {
      "type": "paragraph",
      "text": "Rizal mungkin bertindak."
    },
    {
      "type": "paragraph",
      "text": "Jika dia tidak memberitahu—"
    },
    {
      "type": "paragraph",
      "text": "Amir mungkin terus masuk lebih jauh."
    },
    {
      "type": "paragraph",
      "text": "Farid menutup mata."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali dalam hidupnya, dia sedar kesetiaan bukan lagi perkara mudah."
    },
    {
      "type": "paragraph",
      "text": "Kesetiaan sedang meminta harga."
    },
    {
      "type": "paragraph",
      "text": "Dan harga itu mungkin nyawa seseorang."
    },
    {
      "type": "paragraph",
      "text": "Farid membuka mata."
    },
    {
      "type": "paragraph",
      "text": "Menghidupkan enjin."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandu pergi."
    },
    {
      "type": "paragraph",
      "text": "Tanpa menelefon sesiapa."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 6**"
    }
  ],
