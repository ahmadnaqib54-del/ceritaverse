  "title": "S4 E2",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 4 — EPISODE 2\n## THE BROTHER-IN-LAW"
    },
    {
      "type": "paragraph",
      "text": "Amir tidak tidur malam itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana mesej."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana ancaman."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana satu persoalan."
    },
    {
      "type": "paragraph",
      "text": "**Kalau Rizal benar-benar terlibat, sejak bila?**"
    },
    {
      "type": "paragraph",
      "text": "Dia membuka semula fail lama."
    },
    {
      "type": "paragraph",
      "text": "Tahun pertama."
    },
    {
      "type": "paragraph",
      "text": "Tahun kedua."
    },
    {
      "type": "paragraph",
      "text": "Tahun ketiga."
    },
    {
      "type": "paragraph",
      "text": "Setiap kali dia mencari permulaan, dia menemui perkara yang sama."
    },
    {
      "type": "paragraph",
      "text": "Rizal sentiasa ada."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak pernah cukup dekat untuk dituduh."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang membuatnya berbahaya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pagi itu Amir datang ke rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Kali ini Rizal ada."
    },
    {
      "type": "paragraph",
      "text": "Dia sedang minum kopi."
    },
    {
      "type": "paragraph",
      "text": "Apabila pintu dibuka dan Amir muncul, Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "Amir masuk."
    },
    {
      "type": "paragraph",
      "text": "“Tak kerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Cuti.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Amir duduk."
    },
    {
      "type": "paragraph",
      "text": "Linda berada di dapur."
    },
    {
      "type": "paragraph",
      "text": "Suasana kelihatan seperti keluarga biasa."
    },
    {
      "type": "paragraph",
      "text": "Hampir."
    },
    {
      "type": "paragraph",
      "text": "Rizal menuang kopi untuk Amir."
    },
    {
      "type": "paragraph",
      "text": "“Gula?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak payah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan cawan di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Macam dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Macam dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka diam."
    },
    {
      "type": "paragraph",
      "text": "Linda datang membawa sarapan."
    },
    {
      "type": "paragraph",
      "text": "“Amir makan.”"
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka bertiga duduk."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil roti."
    },
    {
      "type": "paragraph",
      "text": "“Kerja macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Banyak.”"
    },
    {
      "type": "paragraph",
      "text": "“Masih sibuk dengan kes yang sama?”"
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kes apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kerja kau.”"
    },
    {
      "type": "paragraph",
      "text": "Amir turut tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Banyak kes.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bahaya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang.”"
    },
    {
      "type": "paragraph",
      "text": "“Jaga diri.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau pun.”"
    },
    {
      "type": "paragraph",
      "text": "Dua lelaki itu saling memandang."
    },
    {
      "type": "paragraph",
      "text": "Linda tidak menyedari apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Atau mungkin dia sudah mula menyedari semuanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas sarapan, Linda membawa bayi masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Tinggal Rizal dan Amir."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa datang?”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang cawan."
    },
    {
      "type": "paragraph",
      "text": "“Nak jumpa keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Kau okay?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau nampak lain.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang kata begitu.”"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk Linda.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Amir menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dia risau.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia rasa kau jauh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku cuba buat yang terbaik.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Untuk keluarga?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Amir menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Untuk semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Amir berdiri."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan ke rak buku."
    },
    {
      "type": "paragraph",
      "text": "Banyak buku lama Rizal masih ada."
    },
    {
      "type": "paragraph",
      "text": "Kimia."
    },
    {
      "type": "paragraph",
      "text": "Pengurusan."
    },
    {
      "type": "paragraph",
      "text": "Ekonomi."
    },
    {
      "type": "paragraph",
      "text": "Beberapa buku yang pernah dia baca ketika masih mengajar."
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil satu."
    },
    {
      "type": "paragraph",
      "text": "“Masih simpan?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa nak buang?”"
    },
    {
      "type": "paragraph",
      "text": "Amir membuka beberapa halaman."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau pernah cakap ilmu tak pernah hilang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menutup buku."
    },
    {
      "type": "paragraph",
      "text": "“Manusia pun?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Manusia berubah.”"
    },
    {
      "type": "paragraph",
      "text": "“Walaupun keluarga?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Terutama keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Amir kembali ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di hadapan papan siasatan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai datang."
    },
    {
      "type": "paragraph",
      "text": "“Kita ada satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kita dapat satu rekod lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Berkaitan dengan permulaan operasi.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil dokumen."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Tarikh itu."
    },
    {
      "type": "paragraph",
      "text": "Dia kenal."
    },
    {
      "type": "paragraph",
      "text": "**Tahun pertama.**"
    },
    {
      "type": "paragraph",
      "text": "Beberapa bulan selepas Rizal didiagnosis."
    },
    {
      "type": "paragraph",
      "text": "Amir bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Ini dia.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Bukti?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi?”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang tarikh itu."
    },
    {
      "type": "paragraph",
      "text": "“Permulaan.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama, Rizal sedang berada di Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Adam datang."
    },
    {
      "type": "paragraph",
      "text": "“Amir datang rumah tadi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia cuba cari apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam duduk."
    },
    {
      "type": "paragraph",
      "text": "“Dia makin dekat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kita kena buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "“Keputusan apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia teruskan…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dia keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengeluh."
    },
    {
      "type": "paragraph",
      "text": "“Kau selalu cakap benda yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab ia benar.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau dia paksa kau pilih?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam bangun."
    },
    {
      "type": "paragraph",
      "text": "“Suatu hari nanti kau tak boleh jawab semua masalah dengan perkataan ‘keluarga’.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya pergi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "Amir."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Esok makan dengan aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada sebab.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Esoknya mereka bertemu di sebuah restoran kecil."
    },
    {
      "type": "paragraph",
      "text": "Bukan tempat mewah."
    },
    {
      "type": "paragraph",
      "text": "Bukan tempat orang korporat."
    },
    {
      "type": "paragraph",
      "text": "Tempat yang mereka pernah makan ketika muda."
    },
    {
      "type": "paragraph",
      "text": "Amir datang dahulu."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Kau pilih tempat ni?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dulu kita selalu datang sini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Lama.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Banyak benda berubah.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Pelayan datang."
    },
    {
      "type": "paragraph",
      "text": "Mereka memesan makanan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian diam."
    },
    {
      "type": "paragraph",
      "text": "Amir akhirnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau pernah rasa hidup kau dah berubah terlalu jauh?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Pernah.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Lepas sakit.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya dah biasa.”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau boleh kembali ke masa sebelum semua ni…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…kau akan buat benda yang sama?”"
    },
    {
      "type": "paragraph",
      "text": "Soalan itu menggantung di udara."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Amir."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku tak tahu apa yang akan jadi.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Itu bukan jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nak jawapan sebenar…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali, dia nampak sesuatu dalam mata Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bukan takut."
    },
    {
      "type": "paragraph",
      "text": "Penyesalan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Makanan sampai."
    },
    {
      "type": "paragraph",
      "text": "Mereka makan."
    },
    {
      "type": "paragraph",
      "text": "Seperti dua orang adik-beradik."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Amir berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku sedang siasat sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti makan."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang sangat dekat dengan aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "“Aku belum boleh cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia salah?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku akan buat kerja aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Walaupun keluarga?”"
    },
    {
      "type": "paragraph",
      "text": "Amir terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Terutama kalau keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Amir melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Aku harap kau tak pernah buat aku pilih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu Rizal pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di ruang tamu seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Linda masih belum pulang."
    },
    {
      "type": "paragraph",
      "text": "Rumah sunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka telefon."
    },
    {
      "type": "paragraph",
      "text": "Ada satu mesej daripada Farid."
    },
    {
      "type": "paragraph",
      "text": "**“Amir makin dekat.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian, mesej kedua."
    },
    {
      "type": "paragraph",
      "text": "**“Apa arahan?”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menaip."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadam."
    },
    {
      "type": "paragraph",
      "text": "Menaip lagi."
    },
    {
      "type": "paragraph",
      "text": "Padam."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia hanya menulis:"
    },
    {
      "type": "paragraph",
      "text": "**“Tiada apa-apa.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, Amir mendapat maklumat baru."
    },
    {
      "type": "paragraph",
      "text": "Satu sumber memberi satu nama."
    },
    {
      "type": "paragraph",
      "text": "**Farid.**"
    },
    {
      "type": "paragraph",
      "text": "Amir melihat fail itu."
    },
    {
      "type": "paragraph",
      "text": "“Bawa masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Farid sedang memandu ketika telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Encik Farid?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Pihak kami perlukan encik datang untuk beberapa soalan.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Farid melihat jalan di hadapan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Ini bukan kebetulan."
    },
    {
      "type": "paragraph",
      "text": "Amir sudah mula mengetuk pintu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Farid tiba di pejabat JSJN."
    },
    {
      "type": "paragraph",
      "text": "Amir menunggu."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk berhadapan."
    },
    {
      "type": "paragraph",
      "text": "Amir membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Encik Farid.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak bekerja dengan Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Sudah berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab."
    },
    {
      "type": "paragraph",
      "text": "Amir mencatat."
    },
    {
      "type": "paragraph",
      "text": "“Hubungan awak dengan dia?”"
    },
    {
      "type": "paragraph",
      "text": "“Bos dan pekerja.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menutup pen."
    },
    {
      "type": "paragraph",
      "text": "“Awak percaya Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu mengingatkannya kepada panggilan lama."
    },
    {
      "type": "paragraph",
      "text": "**Sejauh mana kau sanggup pergi untuk dia?**"
    },
    {
      "type": "paragraph",
      "text": "Farid akhirnya menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab dia jaga orang dia.”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang orang yang kita percaya adalah orang yang paling kita tak kenal.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas sesi itu, Farid keluar."
    },
    {
      "type": "paragraph",
      "text": "Amir melihatnya melalui tingkap."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu Farid menyembunyikan sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Farid juga tahu Amir sedang mencari sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Perang sudah bermula."
    },
    {
      "type": "paragraph",
      "text": "Cuma kedua-duanya masih belum menyerang."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu Farid datang kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Amir panggil aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Apa dia tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Pasal kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Jawapan kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan bohong untuk saya.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia tanya lagi, jawab apa yang kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Bos?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak mahu kau masuk lebih dalam kerana aku.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Dah terlambat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Farid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya dah pilih.”"
    },
    {
      "type": "paragraph",
      "text": "“Pilih apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Pihak saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat keputusan yang kau akan sesal.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi di matanya sudah ada sesuatu yang berubah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir pulang ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka satu fail terakhir."
    },
    {
      "type": "paragraph",
      "text": "Nama Rizal."
    },
    {
      "type": "paragraph",
      "text": "Nama Farid."
    },
    {
      "type": "paragraph",
      "text": "Nama Linda."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat hubungan antara mereka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menulis satu ayat:"
    },
    {
      "type": "paragraph",
      "text": "**“Rizal bukan lagi sekadar suspek.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menambah:"
    },
    {
      "type": "paragraph",
      "text": "**“Dia mungkin pusat kepada rangkaian.”**"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "Membuka nama Rizal."
    },
    {
      "type": "paragraph",
      "text": "Ibu jarinya berada di atas butang panggilan."
    },
    {
      "type": "paragraph",
      "text": "Dia hampir menekan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak."
    },
    {
      "type": "paragraph",
      "text": "Sebaliknya, dia memadam nombor itu daripada skrin."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia sudah tidak sayang."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia akhirnya faham."
    },
    {
      "type": "paragraph",
      "text": "Kalau dia mahu menangkap Rizal..."
    },
    {
      "type": "paragraph",
      "text": "dia perlu berhenti melihatnya sebagai abang ipar."
    },
    {
      "type": "paragraph",
      "text": "Dan mula melihatnya sebagai suspek."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Rizal berdiri di balkoni."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "Daripada Amir."
    },
    {
      "type": "paragraph",
      "text": "**“Kita kena bercakap lagi.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang langit."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Hubungan mereka sedang sampai ke penghujungnya."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana mereka sudah berhenti menjadi keluarga."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana tidak lama lagi..."
    },
    {
      "type": "paragraph",
      "text": "seorang daripada mereka mungkin perlu memilih antara **keluarga dan kebenaran.**"
    },
    {
      "type": "paragraph",
      "text": "Dan kali ini..."
    },
    {
      "type": "paragraph",
      "text": "tidak akan ada jalan tengah."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 2**"
    }
  ],
