{
  "series": "Separuh Hayat",
  "season": 4,
  "episode": 3,
  "title": "S4 E3",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 4 — EPISODE 3\n## AH LEN"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak pernah suka pejabat."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak kerusi."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak kamera."
    },
    {
      "type": "paragraph",
      "text": "Terlalu banyak orang yang bercakap seperti mereka tahu apa yang sedang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Dia lebih suka tempat yang biasa."
    },
    {
      "type": "paragraph",
      "text": "Kedai kopi."
    },
    {
      "type": "paragraph",
      "text": "Kereta."
    },
    {
      "type": "paragraph",
      "text": "Restoran yang orang keluar masuk setiap lima minit."
    },
    {
      "type": "paragraph",
      "text": "Tempat yang tidak menarik perhatian."
    },
    {
      "type": "paragraph",
      "text": "Malam itu, dia duduk seorang diri di sudut Ayam Gepuk Hut."
    },
    {
      "type": "paragraph",
      "text": "Telefon diletakkan di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Tidak disentuh."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa panggil aku?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandang sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Bukan aku yang panggil kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menunjuk telefonnya."
    },
    {
      "type": "paragraph",
      "text": "“Ada orang hantar mesej.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku tahu, aku takkan panggil kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil telefon itu."
    },
    {
      "type": "paragraph",
      "text": "Satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Ah Len keluar dari sebuah bangunan."
    },
    {
      "type": "paragraph",
      "text": "Gambar kedua."
    },
    {
      "type": "paragraph",
      "text": "Kereta Rizal."
    },
    {
      "type": "paragraph",
      "text": "Gambar ketiga."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**KAMI TAHU RANGKAIAN LAMA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua hari lepas.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa baru beritahu?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak tengok sama ada aku boleh selesaikan sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyandarkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Jadi aku rasa belum selesai.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama, Amir berada di sebuah bilik mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja ada satu fail."
    },
    {
      "type": "paragraph",
      "text": "**AH LEN.**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya beberapa nama."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa lokasi."
    },
    {
      "type": "paragraph",
      "text": "Beberapa transaksi yang tidak cukup untuk menjadi bukti."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk membentuk corak."
    },
    {
      "type": "paragraph",
      "text": "Amir melihat satu nama."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak lagi menulis nama itu dengan tanda soal."
    },
    {
      "type": "paragraph",
      "text": "Dia menulisnya di tengah-tengah papan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menarik beberapa garisan."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Individu yang pernah dikaitkan dengan Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Farid."
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti."
    },
    {
      "type": "paragraph",
      "text": "Farid bukan orang lama."
    },
    {
      "type": "paragraph",
      "text": "Farid muncul selepas Rizal mengambil alih."
    },
    {
      "type": "paragraph",
      "text": "Itu membuatkan Amir lebih berminat."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "Dia bertanya kepada dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa semua benda berubah selepas Rizal naik?”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai di sebelahnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada cukup untuk teruskan?”"
    },
    {
      "type": "paragraph",
      "text": "Amir menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita jangan kejar apa yang kita fikir benar.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kita cari apa yang boleh dibuktikan.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Itulah perbezaan antara syak wasangka dan kes."
    },
    {
      "type": "paragraph",
      "text": "Dan Amir tahu dia belum mempunyai kes."
    },
    {
      "type": "paragraph",
      "text": "Dia cuma mempunyai corak."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Esoknya, Ah Len bertemu seseorang."
    },
    {
      "type": "paragraph",
      "text": "Bukan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bukan Farid."
    },
    {
      "type": "paragraph",
      "text": "Bukan orang daripada rangkaian lama."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki yang sudah lama tidak muncul."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Ah Len masuk dan menutup pintu."
    },
    {
      "type": "paragraph",
      "text": "“Lama tak jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Memang aku sengaja hilang.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa muncul sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu melihat Ah Len."
    },
    {
      "type": "paragraph",
      "text": "“Orang lama sedang bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu siapa.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu ramai.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan ramai.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu berhenti seketika."
    },
    {
      "type": "paragraph",
      "text": "“Seorang.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len terdiam."
    },
    {
      "type": "paragraph",
      "text": "Nama itu sudah lama tidak disebut."
    },
    {
      "type": "paragraph",
      "text": "Khalid bukan sekadar orang lama."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu terlalu banyak."
    },
    {
      "type": "paragraph",
      "text": "Tentang Hashim."
    },
    {
      "type": "paragraph",
      "text": "Tentang rangkaian lama."
    },
    {
      "type": "paragraph",
      "text": "Tentang siapa yang pernah bekerja dengan siapa."
    },
    {
      "type": "paragraph",
      "text": "Dan yang paling penting—"
    },
    {
      "type": "paragraph",
      "text": "dia tahu bagaimana semuanya bermula."
    },
    {
      "type": "paragraph",
      "text": "Ah Len membuka pintu kereta."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak mahu masalah lama.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Masalah lama tak pernah peduli kau nak atau tak.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Ah Len pergi berjumpa Rizal sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Rizal sedang membaca laporan."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len duduk."
    },
    {
      "type": "paragraph",
      "text": "“Khalid dah muncul.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang beritahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Dia nak apa?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandang tepat ke arahnya."
    },
    {
      "type": "paragraph",
      "text": "“Jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "“Jawapan apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang ambil tempat Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum nipis."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu jawapannya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia mahu dengar daripada mulut kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia nak jumpa aku, suruh dia datang.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Itu masalahnya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia tak mahu jumpa kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dia mahu kau yang cari dia.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pulang lewat."
    },
    {
      "type": "paragraph",
      "text": "Rumah sunyi."
    },
    {
      "type": "paragraph",
      "text": "Terlalu sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia selalu menganggap rumah kosong sebagai ketenangan."
    },
    {
      "type": "paragraph",
      "text": "Sekarang tidak."
    },
    {
      "type": "paragraph",
      "text": "Sekarang rumah kosong membuatkan dia berfikir."
    },
    {
      "type": "paragraph",
      "text": "Linda masih belum kembali."
    },
    {
      "type": "paragraph",
      "text": "Roy berada bersama Linda."
    },
    {
      "type": "paragraph",
      "text": "Bayi mereka juga."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Jam di pergelangan tangannya masih sama."
    },
    {
      "type": "paragraph",
      "text": "Hadiah Roy pada ulang tahunnya yang ke-50."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat jam itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Mesej."
    },
    {
      "type": "paragraph",
      "text": "**Kau kehilangan keluarga sedikit demi sedikit.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "**Jangan salahkan mereka.**"
    },
    {
      "type": "paragraph",
      "text": "Mesej ketiga."
    },
    {
      "type": "paragraph",
      "text": "Satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Bayi."
    },
    {
      "type": "paragraph",
      "text": "Mereka sedang keluar dari sebuah bangunan."
    },
    {
      "type": "paragraph",
      "text": "Gambar itu diambil dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus berdiri."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "Bukan marah."
    },
    {
      "type": "paragraph",
      "text": "Takut."
    },
    {
      "type": "paragraph",
      "text": "Itu lebih buruk."
    },
    {
      "type": "paragraph",
      "text": "Dia menelefon Farid."
    },
    {
      "type": "paragraph",
      "text": "“Ya, bos?”"
    },
    {
      "type": "paragraph",
      "text": "“Mana kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Dekat luar.”"
    },
    {
      "type": "paragraph",
      "text": "“Pergi tengok keluarga Linda.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ada apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan tanya. Tengok saja.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memahami nada itu."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia duduk."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali selepas sekian lama, dia tidak tahu apa yang perlu dibuat."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu bagaimana membina syarikat."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu bagaimana menyusun manusia."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu bagaimana mengawal sistem."
    },
    {
      "type": "paragraph",
      "text": "Tetapi keluarga bukan sistem."
    },
    {
      "type": "paragraph",
      "text": "Mereka tidak boleh dikawal dengan jadual."
    },
    {
      "type": "paragraph",
      "text": "Tidak boleh diukur dengan angka."
    },
    {
      "type": "paragraph",
      "text": "Tidak boleh diselamatkan dengan wang."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di rumah ibunya, Linda sedang memegang bayi."
    },
    {
      "type": "paragraph",
      "text": "Roy duduk di sofa."
    },
    {
      "type": "paragraph",
      "text": "Amir baru masuk."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Amir duduk."
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma nak pastikan kamu semua okay.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Uncle datang sebab Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "Amir terdiam."
    },
    {
      "type": "paragraph",
      "text": "Budak itu terlalu jujur."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab Uncle selalu tanya pasal Ayah sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang Amir."
    },
    {
      "type": "paragraph",
      "text": "Amir tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Roy menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Uncle marah Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Uncle tak suka Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "“Jadi Uncle takut Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersentak sedikit."
    },
    {
      "type": "paragraph",
      "text": "Linda melihat reaksi adiknya."
    },
    {
      "type": "paragraph",
      "text": "“Roy…”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi betul kan?”"
    },
    {
      "type": "paragraph",
      "text": "Amir menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang kita takut pada seseorang bukan sebab orang itu jahat.”"
    },
    {
      "type": "paragraph",
      "text": "Roy menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Tapi sebab kita tak tahu apa yang dia sanggup buat.”"
    },
    {
      "type": "paragraph",
      "text": "Roy diam."
    },
    {
      "type": "paragraph",
      "text": "Linda menundukkan pandangan."
    },
    {
      "type": "paragraph",
      "text": "Dia faham."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin lewat."
    },
    {
      "type": "paragraph",
      "text": "Amir kembali ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu fail lama."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dia menyusun semuanya di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Ada satu perkara yang mengganggunya."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak kelihatan seperti orang yang mengejar wang."
    },
    {
      "type": "paragraph",
      "text": "Dia kelihatan seperti orang yang mengejar kawalan."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang menjadikan dia berbahaya."
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Menulis:"
    },
    {
      "type": "paragraph",
      "text": "**AH LEN → HASHIM → RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia menambah:"
    },
    {
      "type": "paragraph",
      "text": "**FARID**"
    },
    {
      "type": "paragraph",
      "text": "Dan akhirnya:"
    },
    {
      "type": "paragraph",
      "text": "**KHALID**"
    },
    {
      "type": "paragraph",
      "text": "Amir bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Kalau Khalid muncul sekarang…”"
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menghabiskan ayat."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Amir menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada suara."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu rakaman suara dimainkan."
    },
    {
      "type": "paragraph",
      "text": "Suara lelaki."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau mahu Rizal, jangan cari dia.”"
    },
    {
      "type": "paragraph",
      "text": "Amir berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Siapa ni?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari Ah Len.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Amir memandang telefon."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian dia terus mengambil fail."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di pejabatnya, Rizal menerima panggilan daripada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku rasa kita ada masalah lebih besar.”"
    },
    {
      "type": "paragraph",
      "text": "“Cakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid bukan datang untuk ambil alih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Dia datang untuk buka semua yang Hashim pernah tutup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud kau?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu tentang Bumi Perdana.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu tentang rangkaian.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal masih diam."
    },
    {
      "type": "paragraph",
      "text": "“Dan dia tahu tentang kau.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian Ah Len berkata sesuatu yang membuatkan Rizal terus memandang kosong ke hadapan."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu siapa yang bunuh Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Talian senyap."
    },
    {
      "type": "paragraph",
      "text": "Rizal akhirnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan cari Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia memang mahu kita cari dia…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ke luar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“…mungkin itu memang perangkap.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau mula fikir macam aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Aku harap aku tak perlu fikir macam kau.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit kemudian, satu kereta berhenti di hadapan Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Pintu dibuka."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki keluar."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat bangunan itu lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Telefon di tangannya berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Suara di hujung talian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Dia masih di situ?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal tahu?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu memandang bangunan Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tapi dia akan tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Kamera CCTV di hadapan bangunan bergerak sedikit."
    },
    {
      "type": "paragraph",
      "text": "Wajah lelaki itu akhirnya kelihatan."
    },
    {
      "type": "paragraph",
      "text": "**Khalid.**"
    },
    {
      "type": "paragraph",
      "text": "Dia memasukkan telefon ke dalam poket."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang giliran aku.”"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 3**"
    }
