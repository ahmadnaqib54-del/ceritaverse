    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Aku belum sempat pastikan.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma tahu satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Orang itu masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dan dia tahu tentang kau.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
