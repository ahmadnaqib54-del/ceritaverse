    {
      "type": "paragraph",
      "text": "“Project Hayat.”"
    },
    {
      "type": "paragraph",
      "text": "Talian senyap."
    },
    {
      "type": "paragraph",
      "text": "Khalid tidak ketawa kali ini."
    },
    {
      "type": "paragraph",
      "text": "“Siapa beritahu kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid menarik nafas."
    },
