    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Cari dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari siapa yang mulakan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengulang."
