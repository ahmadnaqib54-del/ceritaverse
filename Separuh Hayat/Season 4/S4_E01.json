  "title": "S4 E1",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 4 — EPISODE 1\n## SUSPICION"
    },
    {
      "type": "paragraph",
      "text": "Perang tidak bermula dengan tembakan."
    },
    {
      "type": "paragraph",
      "text": "Ia bermula dengan satu soalan."
    },
    {
      "type": "paragraph",
      "text": "**“Kau rasa dia tahu?”**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam keretanya."
    },
    {
      "type": "paragraph",
      "text": "Enjin belum dihidupkan."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya, rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Lampu ruang tamu menyala."
    },
    {
      "type": "paragraph",
      "text": "Roy berada di dalam."
    },
    {
      "type": "paragraph",
      "text": "Bayi juga."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Rizal tidak keluar."
    },
    {
      "type": "paragraph",
      "text": "Telefon di tangannya masih menunjukkan satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**OPERASI: RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Dia sudah tahu."
    },
    {
      "type": "paragraph",
      "text": "Amir sudah membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Bukan lagi sekadar siasatan kecil."
    },
    {
      "type": "paragraph",
      "text": "Bukan lagi rasa curiga."
    },
    {
      "type": "paragraph",
      "text": "Amir kini mempunyai satu sasaran."
    },
    {
      "type": "paragraph",
      "text": "Dan sasaran itu ialah dia."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Farid duduk di sebelah."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita nak tunggu sampai bila?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang rumah itu."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau mereka datang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Farid menunggu."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Walaupun mereka datang kepada keluarga?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Terutamanya kalau mereka datang kepada keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kereta kembali sunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat rumah itu sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menghidupkan enjin."
    },
    {
      "type": "paragraph",
      "text": "Mereka pergi."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Amir masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Satu fail berada di atas mejanya."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL.**"
    },
    {
      "type": "paragraph",
      "text": "Dia membukanya."
    },
    {
      "type": "paragraph",
      "text": "Pegawai penyiasatnya berdiri di sebelah."
    },
    {
      "type": "paragraph",
      "text": "“Kita dah dapat kelulusan untuk teruskan siasatan.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Langkah seterusnya?”"
    },
    {
      "type": "paragraph",
      "text": "Amir melihat dokumen."
    },
    {
      "type": "paragraph",
      "text": "“Jangan sentuh dia dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia terlalu berhati-hati.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita bergerak sekarang, dia akan tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Kita biarkan dia terus bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memahami."
    },
    {
      "type": "paragraph",
      "text": "“Dan kita ikut.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal pula berada di Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Mesyuarat bermula pukul sembilan."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Maya."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pengurus kanan."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "Semua bangun."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Dia duduk."
    },
    {
      "type": "paragraph",
      "text": "Maya membuka laporan."
    },
    {
      "type": "paragraph",
      "text": "“Prestasi kumpulan stabil.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa.”"
    },
    {
      "type": "paragraph",
      "text": "“Yang paling besar?”"
    },
    {
      "type": "paragraph",
      "text": "Maya berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Risiko reputasi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada terlalu banyak perhatian kepada kumpulan kita.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Maya menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Media. Pelabur. Pihak berkuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Bilik menjadi sunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Pihak berkuasa?”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Beberapa pertanyaan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menunjukkan emosi."
    },
    {
      "type": "paragraph",
      "text": "“Pasal apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum jelas.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Jadi jangan buat kesimpulan.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Adam tahu."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah mula berjaga-jaga."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas mesyuarat, Adam tinggal."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dia dah sampai tahap yang kita tak boleh abaikan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berjalan ke tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Dia belum ada bukti.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kita ada masa.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana sekarang dia tahu apa yang dia cari.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Adam berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bila seseorang mencari sesuatu tanpa tahu apa yang dia cari, dia mudah tersesat.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi bila dia sudah tahu…”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Dia cuma perlukan masa.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada tengah hari, Amir datang ke rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia tidak memberitahu sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Linda membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh masuk?”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Amir masuk."
    },
    {
      "type": "paragraph",
      "text": "Bayi sedang tidur."
    },
    {
      "type": "paragraph",
      "text": "Roy berada di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau datang lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau selalu datang bila Ayah tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Amir terdiam."
    },
    {
      "type": "paragraph",
      "text": "Linda memandang anaknya."
    },
    {
      "type": "paragraph",
      "text": "“Roy.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Pergi tengok adik.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Amir duduk."
    },
    {
      "type": "paragraph",
      "text": "Linda membawa air."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Amir tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang rumah."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Linda.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau percaya Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Linda diam."
    },
    {
      "type": "paragraph",
      "text": "Soalan itu terlalu berat."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Jawab saja.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandang gelas di tangannya."
    },
    {
      "type": "paragraph",
      "text": "“Saya percaya suami saya.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau suami kau buat sesuatu yang salah?”"
    },
    {
      "type": "paragraph",
      "text": "Linda menatapnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah jumpa sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda terus faham."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum boleh cakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya belum boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Linda berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau memang jumpa sesuatu, jangan lindungi saya.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Bagi saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku sedang cuba.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada petang yang sama, Rizal menerima panggilan daripada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Sudah lama mereka tidak bercakap secara terus."
    },
    {
      "type": "paragraph",
      "text": "“Zal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau sibuk.”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau orang besar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Taklah.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan tipu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Aku dengar nama kau ada dalam banyak tempat.”"
    },
    {
      "type": "paragraph",
      "text": "“Orang suka bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi ada orang yang tak bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang sedang tunggu kau buat silap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kita kena jumpa.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada benda yang kau patut tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Malam.”"
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyebut satu tempat."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Talian tamat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal datang seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Ah Len sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada lagi gaya lama."
    },
    {
      "type": "paragraph",
      "text": "Ah Len kelihatan lebih berhati-hati."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Apa cerita?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Nama kau sedang naik.”"
    },
    {
      "type": "paragraph",
      "text": "“Baguslah.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan dalam dunia yang kau mahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Ada orang lama mula bertanya tentang kau.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak pasti.”"
    },
    {
      "type": "paragraph",
      "text": "“Polis?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Polis sentiasa bertanya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Ini lain.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len mencondongkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang bertanya bukan nak tahu kau siapa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Mereka nak tahu siapa yang berdiri belakang kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dan masalahnya…”"
    },
    {
      "type": "paragraph",
      "text": "“Masalah apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang semua orang fikir kau tak ada siapa-siapa di atas.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itu bermakna kau sendiri jadi sasaran.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sementara itu, Amir berada di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia menerima laporan."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita dapat pergerakan baru.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Dengan siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu meletakkan dokumen."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Amir membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menutup mata seketika."
    },
    {
      "type": "paragraph",
      "text": "“Buat pemerhatian sahaja.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan ganggu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal pulang hampir tengah malam."
    },
    {
      "type": "paragraph",
      "text": "Rumah sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Di atas meja terdapat satu sampul."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka."
    },
    {
      "type": "paragraph",
      "text": "Satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Gambar kedua."
    },
    {
      "type": "paragraph",
      "text": "Farid."
    },
    {
      "type": "paragraph",
      "text": "Gambar ketiga."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Gambar keempat."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Rizal membeku."
    },
    {
      "type": "paragraph",
      "text": "Di bawah semua gambar itu ada satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**“Kau bukan satu-satunya orang yang kami perhatikan.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat semua gambar."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "Tiada suara."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Diam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian suara seorang lelaki."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "“Amir bukan satu-satunya masalah kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Suara itu menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau kau fikir polis ialah musuh paling bahaya…”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang gambar Linda."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Roy."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Adam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Farid."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali, Rizal tidak tahu siapa yang sedang memerhatikan siapa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, Amir menerima satu laporan."
    },
    {
      "type": "paragraph",
      "text": "Dia membacanya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang pegawainya."
    },
    {
      "type": "paragraph",
      "text": "“Ini siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Kami tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir membaca lagi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa nama saya ada dalam laporan ini?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu terdiam."
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang hantar?”"
    },
    {
      "type": "paragraph",
      "text": "“Anonymous.”"
    },
    {
      "type": "paragraph",
      "text": "Amir bangun."
    },
    {
      "type": "paragraph",
      "text": "“Jangan gunakan maklumat ini.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana kita tak tahu siapa yang mahu kita melihatnya.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil fail itu."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan ke tingkap."
    },
    {
      "type": "paragraph",
      "text": "Di luar, bandar terus bergerak seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sesuatu sudah berubah."
    },
    {
      "type": "paragraph",
      "text": "Ada pihak ketiga."
    },
    {
      "type": "paragraph",
      "text": "Dan pihak ketiga itu tahu tentang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Tahu tentang Amir."
    },
    {
      "type": "paragraph",
      "text": "Tahu tentang keluarga."
    },
    {
      "type": "paragraph",
      "text": "Tahu tentang empayar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di Bumi Perdana, Rizal berdiri di hadapan papan putih."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis tiga nama."
    },
    {
      "type": "paragraph",
      "text": "**AMIR.**"
    },
    {
      "type": "paragraph",
      "text": "**KHALID.**"
    },
    {
      "type": "paragraph",
      "text": "**AH LEN.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menambah:"
    },
    {
      "type": "paragraph",
      "text": "**UNKNOWN.**"
    },
    {
      "type": "paragraph",
      "text": "Adam masuk."
    },
    {
      "type": "paragraph",
      "text": "“Apa kau buat?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Cari siapa yang sedang bermain.”"
    },
    {
      "type": "paragraph",
      "text": "Adam melihat papan."
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Polis.”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "“Ah Len?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang perkataan terakhir."
    },
    {
      "type": "paragraph",
      "text": "“Unknown?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal akhirnya berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Itulah yang paling saya risau.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil marker."
    },
    {
      "type": "paragraph",
      "text": "Menarik satu bulatan besar mengelilingi semua nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Mulai sekarang, jangan anggap sesiapa neutral.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Termasuk keluarga?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir berdiri di hadapan rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak masuk."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandang rumah itu."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**“Kau semakin dekat.”**"
    },
    {
      "type": "paragraph",
      "text": "Amir membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "**“Tapi kau tak tahu siapa yang sedang kau lindungi.”**"
    },
    {
      "type": "paragraph",
      "text": "Amir mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat rumah Linda."
    },
    {
      "type": "paragraph",
      "text": "Kemudian jalan di belakangnya."
    },
    {
      "type": "paragraph",
      "text": "Tiada sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Dia menyimpan telefon."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum masuk ke kereta, dia teringat satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Rizal pernah berkata kepadanya:"
    },
    {
      "type": "paragraph",
      "text": "**“Kalau kau ada masalah, beritahu aku.”**"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum pahit."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Kalau Rizal memang orang yang dia cari..."
    },
    {
      "type": "paragraph",
      "text": "dia tidak boleh lagi meminta bantuan daripada Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kerana mungkin—"
    },
    {
      "type": "paragraph",
      "text": "Rizal sendiri ialah masalah itu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di tempat lain, Rizal berdiri di balkoni rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat bandar."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**“Kita dah mula.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membalas hanya satu perkataan."
    },
    {
      "type": "paragraph",
      "text": "**“Siapa?”**"
    },
    {
      "type": "paragraph",
      "text": "Balasan datang beberapa saat kemudian."
    },
    {
      "type": "paragraph",
      "text": "**“Kau akan tahu.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tidur malam itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana takut."
    },
    {
      "type": "paragraph",
      "text": "Kerana buat pertama kali dalam hidupnya..."
    },
    {
      "type": "paragraph",
      "text": "dia tidak tahu siapa musuhnya."
    },
    {
      "type": "paragraph",
      "text": "Dan seorang lelaki yang sudah membina empayar tidak takut kepada musuh yang dikenali."
    },
    {
      "type": "paragraph",
      "text": "Dia takut kepada musuh yang **tidak mempunyai nama.**"
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 1**"
    }
  ],
