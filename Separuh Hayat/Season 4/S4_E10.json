      "text": "“Jangan hubungi keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan hubungi sesiapa.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
