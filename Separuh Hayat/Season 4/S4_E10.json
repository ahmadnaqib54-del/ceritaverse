      "type": "paragraph",
      "text": "nama Rizal kembali muncul."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal mendapat berita itu daripada Adam."
    },
    {
      "type": "paragraph",
      "text": "“Mereka dah mula cari Farid.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukti?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang meja."
    },
    {
      "type": "paragraph",
      "text": "“Jangan panik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih boleh cakap jangan panik?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita panik, mereka menang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Kau masih fikir macam CEO.”"
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "“Masalahnya sekarang bukan syarikat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Ini jenayah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Linda datang ke Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Rizal terkejut melihatnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau datang?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak cari jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Amir hilang.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau kata kau akan cari dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda melihat wajahnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu sesuatu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Dia masih diam."
    },
    {
      "type": "paragraph",
      "text": "Linda mula memahami."
    },
    {
      "type": "paragraph",
      "text": "Bukan keseluruhan kebenaran."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "Linda mundur selangkah."
    },
    {
      "type": "paragraph",
      "text": "“Ya Allah…”"
    },
    {
      "type": "paragraph",
      "text": "“Linda.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dengar dulu.”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menangis."
    },
    {
      "type": "paragraph",
      "text": "“Kali ini jangan tipu aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menatapnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku janji untuk lindungi dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda faham."
    },
    {
      "type": "paragraph",
      "text": "“Farid?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup mata."
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa kecil dalam tangisan."
    },
    {
      "type": "paragraph",
      "text": "“Kau lindungi orang yang bunuh adik aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Linda…”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu dia bunuh Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kau masih lindungi dia?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Dulu aku fikir kau buat semua ini kerana kami.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda mengesat air mata."
    },
    {
      "type": "paragraph",
      "text": "“Kau buat semua ini kerana kau tak boleh lepaskan apa yang kau dah bina.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal cuba mendekat."
    },
    {
      "type": "paragraph",
      "text": "Linda berundur."
    },
    {
      "type": "paragraph",
      "text": "“Jangan sentuh aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya buat kali terakhir."
    },
    {
      "type": "paragraph",
      "text": "“Aku dah kehilangan adik aku.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menangis."
    },
    {
      "type": "paragraph",
      "text": "“Aku tak mahu kehilangan diri aku sebab kau juga.”"
    },
    {
      "type": "paragraph",
      "text": "Linda berpaling dan pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mengejar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal duduk seorang diri di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada sekeping kertas."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**RM500,000**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**RM1,000,000**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**EMPIRE**"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menulis satu lagi."
    },
    {
      "type": "paragraph",
      "text": "**FAMILY**"
    },
    {
      "type": "paragraph",
      "text": "Dia garis."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menulis:"
    },
    {
      "type": "paragraph",
      "text": "**CONTROL**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Mesej daripada nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "**KAU PILIH FARID.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua:"
    },
    {
      "type": "paragraph",
      "text": "**SEKARANG KAU FAHAM HARGA SEBUAH PILIHAN.**"
    },
    {
      "type": "paragraph",
      "text": "Mesej ketiga:"
    },
    {
      "type": "paragraph",
      "text": "**TAPI KAU MASIH TAK TAHU SIAPA YANG MEMBUAT PILIHAN ITU UNTUK KAU.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat ke arah pintu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berdering."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Kau?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau dah faham.”"
    },
    {
      "type": "paragraph",
      "text": "“Faham apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa aku kata orang paling bahaya bukan musuh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Khalid menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Orang paling bahaya ialah orang yang membuat kau percaya bahawa kau sedang membuat pilihan sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali—"
    },
    {
      "type": "paragraph",
      "text": "dia mula tertanya-tanya sama ada keputusan paling besar dalam hidupnya benar-benar pernah menjadi keputusan dia sendiri."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 10**"
    }
  ],
