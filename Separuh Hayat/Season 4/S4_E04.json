{
  "series": "Separuh Hayat",
  "season": 4,
  "episode": 4,
  "title": "S4 E4",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 4 — EPISODE 4\n## THE DEAL"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tidur malam itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana Khalid."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana Amir."
    },
    {
      "type": "paragraph",
      "text": "Bukan juga kerana wang."
    },
    {
      "type": "paragraph",
      "text": "Dia teringat satu perkara."
    },
    {
      "type": "paragraph",
      "text": "**Hashim pernah memberitahunya tentang Khalid.**"
    },
    {
      "type": "paragraph",
      "text": "Bukan banyak."
    },
    {
      "type": "paragraph",
      "text": "Hanya sekali."
    },
    {
      "type": "paragraph",
      "text": "Beberapa tahun dahulu, ketika mereka masih bekerja bersama."
    },
    {
      "type": "paragraph",
      "text": "Hashim pernah berkata:"
    },
    {
      "type": "paragraph",
      "text": "> “Ada orang yang lebih bahaya daripada musuh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya siapa."
    },
    {
      "type": "paragraph",
      "text": "Hashim menjawab,"
    },
    {
      "type": "paragraph",
      "text": "> “Orang yang pernah kau percaya.”"
    },
    {
      "type": "paragraph",
      "text": "Kini Rizal faham."
    },
    {
      "type": "paragraph",
      "text": "Khalid bukan sekadar musuh lama."
    },
    {
      "type": "paragraph",
      "text": "Dia seseorang yang pernah berada cukup dekat untuk mengetahui bagaimana sistem itu dibina."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8:15 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Adam sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Kau tidur?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus diam."
    },
    {
      "type": "paragraph",
      "text": "“Kau kenal dia?”"
    },
    {
      "type": "paragraph",
      "text": "“Nama.”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim pernah cerita?”"
    },
    {
      "type": "paragraph",
      "text": "“Sedikit.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Dia orang lama. Sebelum Hashim jadi seperti yang kita kenal, Khalid sudah ada.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa berpisah?”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat bahu."
    },
    {
      "type": "paragraph",
      "text": "“Duit.”"
    },
    {
      "type": "paragraph",
      "text": "“Semua orang berpisah sebab duit?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang sebab kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum nipis."
    },
    {
      "type": "paragraph",
      "text": "“Lebih kurang sama.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak membalas."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada pukul 10 pagi, satu sampul surat sampai."
    },
    {
      "type": "paragraph",
      "text": "Tiada nama pengirim."
    },
    {
      "type": "paragraph",
      "text": "Tiada alamat."
    },
    {
      "type": "paragraph",
      "text": "Hanya nama Rizal."
    },
    {
      "type": "paragraph",
      "text": "Adam membuka sampul itu."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya ada satu kad."
    },
    {
      "type": "paragraph",
      "text": "**MALAM INI. 9:00.**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya satu alamat."
    },
    {
      "type": "paragraph",
      "text": "Dan satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**DATANG SEORANG.**"
    },
    {
      "type": "paragraph",
      "text": "Adam terus menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang kad itu."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau seseorang suruh kau datang seorang diri, itu biasanya bukan jemputan makan malam.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia mahu bunuh aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Lagi satu sebab untuk jangan pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku tak pergi?”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Dia akan cari cara lain.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal lama."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu apa masalah kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau terlalu biasa dengan masalah yang boleh diselesaikan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Khalid mungkin bukan masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia mungkin pilihan.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal tetap pergi."
    },
    {
      "type": "paragraph",
      "text": "Seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Tempat itu sebuah restoran lama yang hampir kosong."
    },
    {
      "type": "paragraph",
      "text": "Tiada muzik."
    },
    {
      "type": "paragraph",
      "text": "Tiada pelanggan."
    },
    {
      "type": "paragraph",
      "text": "Hanya beberapa meja."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di meja paling hujung."
    },
    {
      "type": "paragraph",
      "text": "Sembilan malam."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa."
    },
    {
      "type": "paragraph",
      "text": "9:05."
    },
    {
      "type": "paragraph",
      "text": "Masih tiada."
    },
    {
      "type": "paragraph",
      "text": "9:12."
    },
    {
      "type": "paragraph",
      "text": "Seorang lelaki masuk."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Dia lebih tua daripada yang Rizal bayangkan."
    },
    {
      "type": "paragraph",
      "text": "Tidak kelihatan seperti gangster."
    },
    {
      "type": "paragraph",
      "text": "Tidak kelihatan seperti orang yang datang mencari pergaduhan."
    },
    {
      "type": "paragraph",
      "text": "Dia kelihatan seperti seorang ahli perniagaan biasa."
    },
    {
      "type": "paragraph",
      "text": "Khalid duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kau Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan kau Khalid.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Hashim selalu cakap kau cepat belajar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak membalas senyum."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau cari aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Terus kepada perkara penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tak ada masa.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau sudah ada semua masa di dunia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya tajam."
    },
    {
      "type": "paragraph",
      "text": "Khalid tahu tentang penyakitnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak terkejut."
    },
    {
      "type": "paragraph",
      "text": "Dia cuma tidak suka."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu banyak.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Termasuk Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Terutama Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat sunyi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Khalid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Dia bukan orang baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia juga bukan orang paling jahat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Masalah Hashim,” sambung Khalid, “ialah dia fikir dia boleh mengawal semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Dan kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tidak cuba mengawal semua orang.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma pastikan orang yang salah tidak memegang terlalu banyak kuasa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Jadi kau datang untuk menyelamatkan aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid memandang tepat kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Aku datang untuk buat tawaran.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Khalid mengeluarkan satu fail."
    },
    {
      "type": "paragraph",
      "text": "Dia menolaknya ke arah Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak terus membukanya."
    },
    {
      "type": "paragraph",
      "text": "“Apa ini?”"
    },
    {
      "type": "paragraph",
      "text": "“Jalan keluar.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada sistem yang kau sedang bina.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Dokumen syarikat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa nama."
    },
    {
      "type": "paragraph",
      "text": "Beberapa aset."
    },
    {
      "type": "paragraph",
      "text": "Beberapa hubungan perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Bukan bukti jenayah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk menunjukkan bahawa Khalid memahami struktur empayar Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Apa yang kau mahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Bahagian.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan duit.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat.”"
    },
    {
      "type": "paragraph",
      "text": "“Tempat?”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau mahu bekerja dengan aku?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid menyandar."
    },
    {
      "type": "paragraph",
      "text": "“Aku mahu kau berhenti menganggap ini empayar kau seorang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kau ambil Hashim kerana kau fikir kau lebih baik daripada dia.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid mengetuk meja perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Mungkin kau memang lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi kau sedang buat kesilapan yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kesilapan apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Menganggap semua orang akan kekal setia.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di luar restoran, sebuah kereta berhenti."
    },
    {
      "type": "paragraph",
      "text": "Seseorang duduk di dalam."
    },
    {
      "type": "paragraph",
      "text": "Memerhatikan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Rizal tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Khalid juga tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Atau mungkin dia tahu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku tolak?” Rizal bertanya."
    },
    {
      "type": "paragraph",
      "text": "Khalid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tiada apa-apa berlaku.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menatapnya."
    },
    {
      "type": "paragraph",
      "text": "Khalid bangun."
    },
    {
      "type": "paragraph",
      "text": "“Saya tidak datang untuk mengugut awak, Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil jaket."
    },
    {
      "type": "paragraph",
      "text": "“Saya datang untuk beri awak peluang.”"
    },
    {
      "type": "paragraph",
      "text": "“Peluang untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berhenti di sebelah meja."
    },
    {
      "type": "paragraph",
      "text": "“Peluang untuk kekal hidup cukup lama untuk melihat bagaimana semua ini berakhir.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka semula fail itu."
    },
    {
      "type": "paragraph",
      "text": "Ada satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Gambar lama."
    },
    {
      "type": "paragraph",
      "text": "Hashim."
    },
    {
      "type": "paragraph",
      "text": "Khalid."
    },
    {
      "type": "paragraph",
      "text": "Dan seorang lelaki ketiga."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengecilkan mata."
    },
    {
      "type": "paragraph",
      "text": "Dia kenal lelaki itu."
    },
    {
      "type": "paragraph",
      "text": "**Rahman.**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Rizal memanggil Rahman."
    },
    {
      "type": "paragraph",
      "text": "“Datang pejabat.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman muncul sejam kemudian."
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan gambar di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Rahman melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "“Mana kau dapat?”"
    },
    {
      "type": "paragraph",
      "text": "“Jawab soalan aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman diam."
    },
    {
      "type": "paragraph",
      "text": "“Kau kenal Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau tak pernah cerita?”"
    },
    {
      "type": "paragraph",
      "text": "Rahman mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya fikir cerita lama dah mati.”"
    },
    {
      "type": "paragraph",
      "text": "“Cerita lama tak mati.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk gambar."
    },
    {
      "type": "paragraph",
      "text": "“Dia cuma tunggu masa.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman duduk."
    },
    {
      "type": "paragraph",
      "text": "“Bos…”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan panggil aku bos.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau cakap yang sebenar.”"
    },
    {
      "type": "paragraph",
      "text": "Rahman menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Khalid pernah bersama Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka bina sebahagian daripada rangkaian itu bersama.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Mereka bergaduh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rahman terdiam lama."
    },
    {
      "type": "paragraph",
      "text": "“Khalid mahu keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Keluar?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rahman memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Sebab dia tahu ke mana semua ini akan berakhir.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Rahman menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Hashim tak mahu lepaskan dia.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di tempat lain, Amir menerima panggilan."
    },
    {
      "type": "paragraph",
      "text": "“Encik Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kami ada maklumat baru.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak pasti.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Teruskan.”"
    },
    {
      "type": "paragraph",
      "text": "“Nama Khalid muncul.”"
    },
    {
      "type": "paragraph",
      "text": "Amir terus duduk tegak."
    },
    {
      "type": "paragraph",
      "text": "“Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam konteks apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Hubungan lama dengan Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandang papan siasatan."
    },
    {
      "type": "paragraph",
      "text": "Nama Khalid belum ada."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia menulisnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menarik satu garisan kepada Hashim."
    },
    {
      "type": "paragraph",
      "text": "Dan satu lagi kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum dia sempat menulis apa-apa lagi, telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Amir menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "Suara yang sama seperti sebelumnya."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau sudah nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada jawapan."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau bagi maklumat kepada aku?”"
    },
    {
      "type": "paragraph",
      "text": "Suara itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab kau sedang mencari orang yang salah.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Amir berdiri."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat papan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian kembali melihat nama Rizal."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali, Amir tidak tahu sama ada seseorang sedang membantu siasatannya—"
    },
    {
      "type": "paragraph",
      "text": "atau sedang menggunakannya."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal kembali ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Tiada Linda."
    },
    {
      "type": "paragraph",
      "text": "Tiada Roy."
    },
    {
      "type": "paragraph",
      "text": "Tiada bayi."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Mesej daripada Khalid."
    },
    {
      "type": "paragraph",
      "text": "**KAU TANYA TENTANG RAHMAN.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua."
    },
    {
      "type": "paragraph",
      "text": "**JANGAN.**"
    },
    {
      "type": "paragraph",
      "text": "Mesej ketiga."
    },
    {
      "type": "paragraph",
      "text": "**DIA BUKAN ORANG YANG KAU PATUT TAKUT.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Mesej keempat masuk."
    },
    {
      "type": "paragraph",
      "text": "**ORANG YANG KAU PATUT TAKUT ADA DALAM BULATAN KAU SENDIRI.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat ke arah pintu rumah."
    },
    {
      "type": "paragraph",
      "text": "Sunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia bangun."
    },
    {
      "type": "paragraph",
      "text": "Memeriksa tingkap."
    },
    {
      "type": "paragraph",
      "text": "Tiada sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Dia kembali ke ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Kali ini bukan mesej."
    },
    {
      "type": "paragraph",
      "text": "Panggilan."
    },
    {
      "type": "paragraph",
      "text": "Nombor Khalid."
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "Suara Khalid kedengaran perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Aku lupa satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku belum beritahu kau kenapa aku benar-benar datang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Khalid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Hashim bukan orang yang terakhir yang tahu tentang kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Siapa lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Khalid menjawab:"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang membina sistem sebelum Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Talian senyap beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Khalid berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Orang itu masih hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali sejak mengambil alih empayar Hashim—"
    },
    {
      "type": "paragraph",
      "text": "dia sedar mungkin dia tidak pernah benar-benar mengambil alih."
    },
    {
      "type": "paragraph",
      "text": "Mungkin selama ini…"
    },
    {
      "type": "paragraph",
      "text": "dia cuma duduk di kerusi yang sengaja ditinggalkan untuknya."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 4**"
    }
  ],
