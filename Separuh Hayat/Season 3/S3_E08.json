  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 3 — EPISODE 8\n## THE LOYALTY"
    },
    {
      "type": "paragraph",
      "text": "Farid tidak tidur malam itu."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana panggilan tadi."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana satu ayat."
    },
    {
      "type": "paragraph",
      "text": "**“Sejauh mana kau sanggup pergi untuk dia?”**"
    },
    {
      "type": "paragraph",
      "text": "Soalan itu mudah."
    },
    {
      "type": "paragraph",
      "text": "Jawapannya tidak."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 7 pagi."
    },
    {
      "type": "paragraph",
      "text": "Farid sudah berada di Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Rizal tiba beberapa minit kemudian."
    },
    {
      "type": "paragraph",
      "text": "Dia terus perasan Farid kelihatan lain."
    },
    {
      "type": "paragraph",
      "text": "“Tak tidur?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa jam?”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Ada masalah?”"
    },
    {
      "type": "paragraph",
      "text": "Farid hampir memberitahu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia teringat sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Rizal pernah berkata:"
    },
    {
      "type": "paragraph",
      "text": "**Jangan buat keputusan kerana marah.**"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Farid masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memandangnya sehingga pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu Farid menyembunyikan sesuatu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, Rizal bertemu Adam."
    },
    {
      "type": "paragraph",
      "text": "“Farid ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Apa jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia tak cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang setia memang macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang terlalu setia lebih susah.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana mereka boleh buat sesuatu untuk kita yang kita sendiri tak sanggup buat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memahami maksudnya."
    },
    {
      "type": "paragraph",
      "text": "Dan itu membuatnya tidak selesa."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Farid menerima panggilan kedua."
    },
    {
      "type": "paragraph",
      "text": "Kali ini mesej."
    },
    {
      "type": "paragraph",
      "text": "Satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Bukan rumah Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bukan keluarga."
    },
    {
      "type": "paragraph",
      "text": "Gambar Farid sendiri."
    },
    {
      "type": "paragraph",
      "text": "Diambil ketika dia keluar dari pejabat."
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**“Kami cuma nak tahu siapa yang kau lindungi.”**"
    },
    {
      "type": "paragraph",
      "text": "Farid memadam gambar itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak memberitahu Rizal."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hari itu berlalu seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Telefon."
    },
    {
      "type": "paragraph",
      "text": "Laporan."
    },
    {
      "type": "paragraph",
      "text": "Masalah."
    },
    {
      "type": "paragraph",
      "text": "Penyelesaian."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Farid mula melihat sekeliling."
    },
    {
      "type": "paragraph",
      "text": "Orang di kedai kopi."
    },
    {
      "type": "paragraph",
      "text": "Kereta di belakang."
    },
    {
      "type": "paragraph",
      "text": "Lelaki yang berdiri terlalu lama di luar bangunan."
    },
    {
      "type": "paragraph",
      "text": "Mungkin kebetulan."
    },
    {
      "type": "paragraph",
      "text": "Mungkin tidak."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi selepas bekerja untuk Rizal cukup lama, Farid tahu satu perkara:"
    },
    {
      "type": "paragraph",
      "text": "**paranoia kadang-kadang menyelamatkan nyawa.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Farid masuk ke pejabat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak minta satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau ada masalah yang berkaitan dengan saya, jangan libatkan keluarga saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud kau?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Apa yang berlaku?”"
    },
    {
      "type": "paragraph",
      "text": "Farid akhirnya memberitahu."
    },
    {
      "type": "paragraph",
      "text": "Panggilan."
    },
    {
      "type": "paragraph",
      "text": "Gambar."
    },
    {
      "type": "paragraph",
      "text": "Ancaman."
    },
    {
      "type": "paragraph",
      "text": "Semuanya."
    },
    {
      "type": "paragraph",
      "text": "Rizal mendengar tanpa mencelah."
    },
    {
      "type": "paragraph",
      "text": "Apabila Farid selesai, Rizal duduk semula."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa kau tak beritahu saya semalam?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak nak ganggu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Bukan tugas kau untuk tentukan apa yang saya perlu tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menundukkan kepala."
    },
    {
      "type": "paragraph",
      "text": "“Maaf.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Mulai sekarang, kalau ada apa-apa, kau beritahu saya.”"
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan jadi hero.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Saya bukan hero.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membalas,"
    },
    {
      "type": "paragraph",
      "text": "“Itulah yang saya risau.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal kemudian memanggil Adam."
    },
    {
      "type": "paragraph",
      "text": "Mereka bertiga duduk di satu bilik."
    },
    {
      "type": "paragraph",
      "text": "Adam membaca mesej itu."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Musuh Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "“Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Atau seseorang yang lebih dekat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa menjawab."
    },
    {
      "type": "paragraph",
      "text": "Nama itu berada di dalam bilik seperti sesuatu yang tidak patut disebut."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pulang awal."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang berada di dapur."
    },
    {
      "type": "paragraph",
      "text": "“Awal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Jawapan itu saya dah dengar seribu kali.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di meja makan."
    },
    {
      "type": "paragraph",
      "text": "Linda meletakkan makanan di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Kawan awak datang tadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Farid.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Farid?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia datang hantar sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Apa dia cakap?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda duduk."
    },
    {
      "type": "paragraph",
      "text": "“Dia nampak macam risau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa ramai orang yang sebenarnya tahu tentang kerja awak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab semakin ramai orang di sekeliling awak, semakin ramai orang yang boleh menyakiti keluarga kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dulu saya takut awak mati.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya takut awak hidup terlalu lama dalam dunia yang awak bina sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu masuk lebih dalam daripada yang Linda sedar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Farid menerima arahan."
    },
    {
      "type": "paragraph",
      "text": "“Jumpa orang itu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang hantar mesej.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dengar apa yang dia mahu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia cuba buat sesuatu?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Farid berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Jangan?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat apa-apa yang saya tak suruh.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal menambah,"
    },
    {
      "type": "paragraph",
      "text": "“Kita mahu tahu siapa.”"
    },
    {
      "type": "paragraph",
      "text": "Farid faham."
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pertemuan itu tidak berlaku seperti yang Farid jangka."
    },
    {
      "type": "paragraph",
      "text": "Tiada gangster."
    },
    {
      "type": "paragraph",
      "text": "Tiada senjata."
    },
    {
      "type": "paragraph",
      "text": "Tiada ugutan."
    },
    {
      "type": "paragraph",
      "text": "Hanya seorang lelaki duduk di sebuah restoran."
    },
    {
      "type": "paragraph",
      "text": "Dia lebih muda daripada Farid."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "Bahkan tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau Farid?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Farid duduk."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma nak tahu satu benda.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal tahu tentang semua yang berlaku?”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itulah jawapan aku.”"
    },
    {
      "type": "paragraph",
      "text": "Farid berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nak bercakap dengan dia, bercakap dengan dia.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Farid."
    },
    {
      "type": "paragraph",
      "text": "“Kami tak mahu bercakap dengan Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kami mahu tahu siapa yang akan berdiri di sebelah dia apabila semuanya runtuh.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menatapnya."
    },
    {
      "type": "paragraph",
      "text": "“Takkan runtuh.”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Semua empayar runtuh.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Farid kembali."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Apa dia cakap?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menceritakan semuanya."
    },
    {
      "type": "paragraph",
      "text": "Rizal diam lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kau percaya dia?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab dia terlalu tenang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kau dah belajar.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau satu hari nanti semua orang pergi…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "Farid menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Awak tahu saya akan tetap ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan cakap macam tu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab saya tak mahu kau mati untuk saya.”"
    },
    {
      "type": "paragraph",
      "text": "Farid tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak cakap pasal mati.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membalas,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid keluar."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang pintu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berbisik,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan terlalu setia.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama, Amir menerima satu maklumat baru."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Ada nama Farid."
    },
    {
      "type": "paragraph",
      "text": "Dan ada sesuatu yang lebih menarik."
    },
    {
      "type": "paragraph",
      "text": "Satu hubungan."
    },
    {
      "type": "paragraph",
      "text": "Rizal → Farid."
    },
    {
      "type": "paragraph",
      "text": "Farid → satu rangkaian lain."
    },
    {
      "type": "paragraph",
      "text": "Amir meneliti dokumen itu."
    },
    {
      "type": "paragraph",
      "text": "“Ini dia.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawainya bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan Rizal yang paling mudah disentuh.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Amir menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang percaya Rizal akan lindungi dia.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Farid pulang."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka pintu rumah."
    },
    {
      "type": "paragraph",
      "text": "Anaknya sedang tidur."
    },
    {
      "type": "paragraph",
      "text": "Isterinya menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Kau lambat.”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Isterinya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kerja dengan Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia masuk."
    },
    {
      "type": "paragraph",
      "text": "Duduk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat anaknya."
    },
    {
      "type": "paragraph",
      "text": "Tiba-tiba telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej."
    },
    {
      "type": "paragraph",
      "text": "**“Kami tahu keluarga kau.”**"
    },
    {
      "type": "paragraph",
      "text": "Farid membeku."
    },
    {
      "type": "paragraph",
      "text": "Kali ini bukan gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "Bukan gambar rumah Rizal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi gambar rumah **Farid sendiri**."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat anaknya."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali, ketakutan bukan lagi tentang dirinya."
    },
    {
      "type": "paragraph",
      "text": "Ia tentang keluarganya."
    },
    {
      "type": "paragraph",
      "text": "Dan pada saat itu, Farid membuat satu keputusan dalam diam."
    },
    {
      "type": "paragraph",
      "text": "Kalau seseorang datang untuk menyakiti Rizal..."
    },
    {
      "type": "paragraph",
      "text": "dia akan berdiri di hadapan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kalau seseorang datang untuk menyakiti keluarganya..."
    },
    {
      "type": "paragraph",
      "text": "dia tidak tahu sejauh mana dia sanggup pergi."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 8**"
    }
  ],
