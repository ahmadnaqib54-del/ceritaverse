  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 3 — EPISODE 4\n## THE INVESTMENT"
    },
    {
      "type": "paragraph",
      "text": "Rizal mula menyukai pagi."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia suka bangun awal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana pagi memberinya peluang untuk melihat semua yang telah berubah."
    },
    {
      "type": "paragraph",
      "text": "Kereta di garaj."
    },
    {
      "type": "paragraph",
      "text": "Rumah besar."
    },
    {
      "type": "paragraph",
      "text": "Anak-anak."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Syarikat."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Dan wang."
    },
    {
      "type": "paragraph",
      "text": "Banyak wang."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia bangun setiap pagi dengan satu soalan."
    },
    {
      "type": "paragraph",
      "text": "**Bagaimana nak cukupkan duit?**"
    },
    {
      "type": "paragraph",
      "text": "Sekarang soalan itu berubah."
    },
    {
      "type": "paragraph",
      "text": "**Apa yang boleh aku buat dengan semua ini?**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 8 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada seorang lelaki berusia sekitar lima puluh tahun."
    },
    {
      "type": "paragraph",
      "text": "Namanya **Tan Sri Kamal**."
    },
    {
      "type": "paragraph",
      "text": "Seorang pelabur."
    },
    {
      "type": "paragraph",
      "text": "Seorang yang sudah lama bermain dalam dunia korporat."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat laporan di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal masih muda dalam dunia ini.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi pertumbuhan syarikat encik agak luar biasa.”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja keras.”"
    },
    {
      "type": "paragraph",
      "text": "Tan Sri Kamal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang yang berjaya cakap begitu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal turut ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa jawapan yang betul?”"
    },
    {
      "type": "paragraph",
      "text": "“Timing.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Tan Sri Kamal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Duit paling besar bukan dibuat ketika semua orang nampak peluang.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Ketika semua orang takut.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia suka jawapan itu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pertemuan itu membawa kepada satu peluang."
    },
    {
      "type": "paragraph",
      "text": "Sebuah projek pembangunan."
    },
    {
      "type": "paragraph",
      "text": "Nilainya besar."
    },
    {
      "type": "paragraph",
      "text": "Terlalu besar untuk Rizal jika hanya menggunakan wang tunai."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak terlalu besar untuk seseorang yang sudah mempunyai rangkaian syarikat, aset dan hubungan."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak terus bersetuju."
    },
    {
      "type": "paragraph",
      "text": "Dia belajar daripada Hashim."
    },
    {
      "type": "paragraph",
      "text": "Jangan beli sesuatu hanya kerana mampu."
    },
    {
      "type": "paragraph",
      "text": "Tanya dahulu:"
    },
    {
      "type": "paragraph",
      "text": "**Apa yang benda itu boleh buat untuk kita?**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu Adam datang."
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjukkan dokumen projek."
    },
    {
      "type": "paragraph",
      "text": "“Pelaburan?”"
    },
    {
      "type": "paragraph",
      "text": "Adam membaca."
    },
    {
      "type": "paragraph",
      "text": "“Besar.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Diversifikasi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah mula bercakap macam orang korporat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Memang itu yang kita nak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam membaca lagi."
    },
    {
      "type": "paragraph",
      "text": "“Kau yakin?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa bagus?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab orang yang terlalu yakin biasanya tak baca kontrak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Tapi ada satu masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Semakin banyak benda kita miliki, semakin banyak orang boleh lihat kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia juga tahu sesuatu yang lebih penting."
    },
    {
      "type": "paragraph",
      "text": "Kalau dia mahu menjadi orang yang berpengaruh, dia perlu keluar daripada bayang-bayang."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Rizal membuat pelaburan pertamanya yang benar-benar besar."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada pesta."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada champagne."
    },
    {
      "type": "paragraph",
      "text": "Hanya tandatangan."
    },
    {
      "type": "paragraph",
      "text": "Satu dokumen."
    },
    {
      "type": "paragraph",
      "text": "Satu pen."
    },
    {
      "type": "paragraph",
      "text": "Satu nama."
    },
    {
      "type": "paragraph",
      "text": "**Rizal.**"
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan pen."
    },
    {
      "type": "paragraph",
      "text": "Orang di sekeliling berjabat tangan."
    },
    {
      "type": "paragraph",
      "text": "“Congratulations.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Thank you.”"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat dokumen itu."
    },
    {
      "type": "paragraph",
      "text": "Dulu namanya berada di buku rekod sekolah."
    },
    {
      "type": "paragraph",
      "text": "Sekarang namanya berada dalam kontrak berjuta ringgit."
    },
    {
      "type": "paragraph",
      "text": "Perubahan itu sepatutnya membuat dia bangga."
    },
    {
      "type": "paragraph",
      "text": "Dan memang dia bangga."
    },
    {
      "type": "paragraph",
      "text": "Tetapi ada sesuatu yang lebih berbahaya."
    },
    {
      "type": "paragraph",
      "text": "Dia mula menikmatinya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Linda melihat dokumen yang dibawa Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Ini apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Pelaburan.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyebut jumlah."
    },
    {
      "type": "paragraph",
      "text": "Linda terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Rizal…”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Duit sebanyak itu?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dari mana?”"
    },
    {
      "type": "paragraph",
      "text": "Soalan itu datang lagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah semakin pandai menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Bisnes.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal menghampirinya."
    },
    {
      "type": "paragraph",
      "text": "“Awak percaya saya?”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "“Saya percaya awak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya tak pasti saya percaya hidup yang awak sedang bina.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu Roy datang ke biliknya."
    },
    {
      "type": "paragraph",
      "text": "“Ayah.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh tanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa orang kaya selalu nampak sibuk?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Mana kamu tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam TV.”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan percaya semua dalam TV.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Ayah kaya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab Ayah selalu cakap duit bukan penting.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Duit memang bukan paling penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang anaknya."
    },
    {
      "type": "paragraph",
      "text": "“Keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kalau macam tu, Ayah tak perlu kerja banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Pandai kau.”"
    },
    {
      "type": "paragraph",
      "text": "Roy memandang jam tangan di pergelangan tangan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Jam yang pernah dia hadiahkan."
    },
    {
      "type": "paragraph",
      "text": "“Ayah masih pakai.”"
    },
    {
      "type": "paragraph",
      "text": "“Sudah tentu.”"
    },
    {
      "type": "paragraph",
      "text": "Roy tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat pintu yang tertutup."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, dia hanya duduk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefonnya berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi."
    },
    {
      "type": "paragraph",
      "text": "Adam datang awal."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya serius."
    },
    {
      "type": "paragraph",
      "text": "“Apa jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Pelaburan kita.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada orang cuba masuk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak pasti.”"
    },
    {
      "type": "paragraph",
      "text": "Adam meletakkan beberapa dokumen di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Orang yang sama muncul dalam beberapa urusan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Nama yang sama."
    },
    {
      "type": "paragraph",
      "text": "Syarikat yang sama."
    },
    {
      "type": "paragraph",
      "text": "Corak yang sama."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Khalid?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tak mungkin secara langsung.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Itulah masalahnya.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal bertemu Khalid."
    },
    {
      "type": "paragraph",
      "text": "Khalid datang tanpa ditemani sesiapa."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kau mula masuk terlalu banyak tempat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itu masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana orang mula nampak nama kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Aku nak nama aku nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Hashim pernah cakap benda yang sama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia belajar terlambat.”"
    },
    {
      "type": "paragraph",
      "text": "“Belajar apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bila nama kau terlalu besar, orang bukan lagi nak bekerjasama dengan kau.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Mereka nak jatuhkan kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Bagus?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya sekarang mereka perlu datang kepada saya.”"
    },
    {
      "type": "paragraph",
      "text": "Khalid memandang Rizal beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kau memang dah berubah.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal membuat satu keputusan."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak akan berhenti."
    },
    {
      "type": "paragraph",
      "text": "Sebaliknya, dia akan berkembang lebih jauh."
    },
    {
      "type": "paragraph",
      "text": "Dia mula menghadiri lebih banyak majlis."
    },
    {
      "type": "paragraph",
      "text": "Mengenali lebih ramai orang."
    },
    {
      "type": "paragraph",
      "text": "Membina lebih banyak hubungan."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia mahu menjadi terkenal."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia mula memahami kuasa sebenar wang."
    },
    {
      "type": "paragraph",
      "text": "**Akses.**"
    },
    {
      "type": "paragraph",
      "text": "Wang membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Nama membuat orang menunggu."
    },
    {
      "type": "paragraph",
      "text": "Hubungan membuat orang telefon dahulu."
    },
    {
      "type": "paragraph",
      "text": "Dan reputasi membuat orang berfikir dua kali sebelum menyentuh kau."
    },
    {
      "type": "paragraph",
      "text": "Rizal mahukan ketiga-tiganya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa bulan berlalu."
    },
    {
      "type": "paragraph",
      "text": "Nama Rizal semakin dikenali."
    },
    {
      "type": "paragraph",
      "text": "Dia mula menerima jemputan ke acara korporat."
    },
    {
      "type": "paragraph",
      "text": "Makan malam."
    },
    {
      "type": "paragraph",
      "text": "Majlis amal."
    },
    {
      "type": "paragraph",
      "text": "Forum perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Ada orang mula meminta pendapatnya."
    },
    {
      "type": "paragraph",
      "text": "Ada orang mula meminta bantuannya."
    },
    {
      "type": "paragraph",
      "text": "Ada orang mula mahu menjadi rakannya."
    },
    {
      "type": "paragraph",
      "text": "Rizal belajar tersenyum pada orang yang dia tidak suka."
    },
    {
      "type": "paragraph",
      "text": "Belajar berjabat tangan dengan orang yang dia tidak percaya."
    },
    {
      "type": "paragraph",
      "text": "Dan belajar bahawa dalam dunia itu, hampir semua orang mempunyai harga."
    },
    {
      "type": "paragraph",
      "text": "Adam melihat perubahan itu."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah pandai.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Aku cuma belajar.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab tanpa berfikir."
    },
    {
      "type": "paragraph",
      "text": "“Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "Nama itu masih mempunyai berat."
    },
    {
      "type": "paragraph",
      "text": "Walaupun Hashim sudah tiada."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu petang, Rizal berada di sebuah majlis amal."
    },
    {
      "type": "paragraph",
      "text": "Seorang wartawan menghampiri."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal, kenapa Encik banyak menyumbang kepada program pendidikan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya pernah jadi guru.”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah pendidikan masih penting bagi Encik?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang kamera."
    },
    {
      "type": "paragraph",
      "text": "“Sangat penting.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam seketika."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Sebab seseorang pernah beri saya peluang.”"
    },
    {
      "type": "paragraph",
      "text": "Klik."
    },
    {
      "type": "paragraph",
      "text": "Gambar diambil."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu menjadi tajuk berita."
    },
    {
      "type": "paragraph",
      "text": "**“Bekas guru bantu generasi muda.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca artikel itu malam tersebut."
    },
    {
      "type": "paragraph",
      "text": "Dia tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Linda membaca dari sebelah."
    },
    {
      "type": "paragraph",
      "text": "“Awak nampak baik dalam gambar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Saya memang baik.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan perasan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, mereka benar-benar seperti pasangan biasa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kemudian Linda bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak lagi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak lagi awak nak?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat artikel itu."
    },
    {
      "type": "paragraph",
      "text": "Tidak ada jawapan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di pejabat JSJN, Amir menampal satu lagi gambar di papan siasatan."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai masuk."
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Bos nak perkembangan.”"
    },
    {
      "type": "paragraph",
      "text": "Amir melihat papan."
    },
    {
      "type": "paragraph",
      "text": "“Kita dah ada rangkaian.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukti?”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "“Belum cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "“Kita jangan kejar duit.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita cari siapa yang menggerakkan semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang gambar Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya betul…”"
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak mahu menyebutnya."
    },
    {
      "type": "paragraph",
      "text": "Kerana jika dia menyebutnya, ia akan menjadi nyata."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pulang."
    },
    {
      "type": "paragraph",
      "text": "Rumah gelap."
    },
    {
      "type": "paragraph",
      "text": "Semua orang tidur."
    },
    {
      "type": "paragraph",
      "text": "Dia berjalan ke biliknya."
    },
    {
      "type": "paragraph",
      "text": "Linda sudah tertidur."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka jam tangannya."
    },
    {
      "type": "paragraph",
      "text": "Meletakkannya di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Jam itu masih sama."
    },
    {
      "type": "paragraph",
      "text": "Hadiah daripada Roy."
    },
    {
      "type": "paragraph",
      "text": "Lima puluh tahun."
    },
    {
      "type": "paragraph",
      "text": "Hari ketika dia fikir hidupnya akan berakhir tidak lama lagi."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil jam itu."
    },
    {
      "type": "paragraph",
      "text": "Memegangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefonnya berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej daripada Adam."
    },
    {
      "type": "paragraph",
      "text": "**Pelaburan seterusnya lebih besar.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian balasan daripada Rizal sendiri:"
    },
    {
      "type": "paragraph",
      "text": "**Buat.**"
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Memandang jam."
    },
    {
      "type": "paragraph",
      "text": "Dan tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Dulu dia mengejar masa kerana takut mati."
    },
    {
      "type": "paragraph",
      "text": "Sekarang dia mengejar kuasa kerana takut kehilangan apa yang telah dibina."
    },
    {
      "type": "paragraph",
      "text": "Ironinya mudah."
    },
    {
      "type": "paragraph",
      "text": "Semakin banyak yang dia miliki..."
    },
    {
      "type": "paragraph",
      "text": "semakin banyak yang dia takut kehilangan."
    },
    {
      "type": "paragraph",
      "text": "Dan semakin banyak yang dia takut kehilangan..."
    },
    {
      "type": "paragraph",
      "text": "semakin jauh dia sanggup pergi."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 4**"
    }
  ],
