{
  "series": "Separuh Hayat",
  "season": 3,
  "episode": 5,
  "title": "S3 E5",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 3 — EPISODE 5\n## THE ACCOUNTANT"
    },
    {
      "type": "paragraph",
      "text": "Rizal suka nombor."
    },
    {
      "type": "paragraph",
      "text": "Dari dulu."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak menipu."
    },
    {
      "type": "paragraph",
      "text": "Manusia yang menulis nombor boleh menipu."
    },
    {
      "type": "paragraph",
      "text": "Tetapi nombor sendiri hanya menunjukkan apa yang berlaku."
    },
    {
      "type": "paragraph",
      "text": "Itulah sebabnya Rizal percaya kepada sistem."
    },
    {
      "type": "paragraph",
      "text": "Masalahnya..."
    },
    {
      "type": "paragraph",
      "text": "sistem juga boleh menunjukkan terlalu banyak."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 9.15 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam bilik mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada seorang wanita berusia awal empat puluhan."
    },
    {
      "type": "paragraph",
      "text": "**Maya.**"
    },
    {
      "type": "paragraph",
      "text": "Akauntan profesional."
    },
    {
      "type": "paragraph",
      "text": "Sepuluh tahun pengalaman."
    },
    {
      "type": "paragraph",
      "text": "Tenang."
    },
    {
      "type": "paragraph",
      "text": "Tidak banyak bercakap."
    },
    {
      "type": "paragraph",
      "text": "Dan paling penting—"
    },
    {
      "type": "paragraph",
      "text": "dia tidak mudah kagum."
    },
    {
      "type": "paragraph",
      "text": "Maya membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Saya dah semak beberapa perkara.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada beberapa perkara yang saya perlukan penjelasan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Silakan.”"
    },
    {
      "type": "paragraph",
      "text": "Maya menolak satu dokumen ke arahnya."
    },
    {
      "type": "paragraph",
      "text": "“Pertumbuhan aset.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Cepat.”"
    },
    {
      "type": "paragraph",
      "text": "“Bisnes sedang berkembang.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia membuka halaman seterusnya."
    },
    {
      "type": "paragraph",
      "text": "“Pelaburan pun meningkat.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Pegangan syarikat pun bertambah.”"
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Maya berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Terlalu cepat.”"
    },
    {
      "type": "paragraph",
      "text": "Bilik itu sunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam yang duduk di sebelah Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berubah wajah."
    },
    {
      "type": "paragraph",
      "text": "“Cepat tidak semestinya salah.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya setuju.”"
    },
    {
      "type": "paragraph",
      "text": "Maya menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Tapi cepat bermaksud saya perlu faham.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Itulah sebab saya ambil awak.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Selepas mesyuarat, Adam masuk ke pejabat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Kau suka dia?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka komputer."
    },
    {
      "type": "paragraph",
      "text": "“Dia bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia banyak tanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Itu tugas dia.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau dia tanya soalan yang kita tak boleh jawab?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Cari jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Bukan suruh dia berhenti bertanya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Kau serius?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita buang semua orang yang bertanya soalan susah, akhirnya kita cuma akan dikelilingi orang bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau bukan macam ni.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "“Dulu aku tak ada apa-apa untuk hilang.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Maya mula bekerja."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak cuba memahami seluruh empayar dalam satu hari."
    },
    {
      "type": "paragraph",
      "text": "Dia pecahkan semuanya."
    },
    {
      "type": "paragraph",
      "text": "Satu syarikat."
    },
    {
      "type": "paragraph",
      "text": "Satu akaun."
    },
    {
      "type": "paragraph",
      "text": "Satu aset."
    },
    {
      "type": "paragraph",
      "text": "Satu pelaburan."
    },
    {
      "type": "paragraph",
      "text": "Satu laporan."
    },
    {
      "type": "paragraph",
      "text": "Satu demi satu."
    },
    {
      "type": "paragraph",
      "text": "Rizal memerhatikannya dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu Maya sedang membina satu peta."
    },
    {
      "type": "paragraph",
      "text": "Dan Rizal tahu orang yang mempunyai peta boleh melihat jalan yang orang lain tidak nampak."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sebulan kemudian."
    },
    {
      "type": "paragraph",
      "text": "Maya masuk ke pejabat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya dah siapkan laporan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "“Masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Beberapa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Cukup untuk saya minta kopi dulu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Maya duduk."
    },
    {
      "type": "paragraph",
      "text": "“Pertama, ada beberapa transaksi yang waktunya tidak selari dengan perkembangan operasi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mendengar."
    },
    {
      "type": "paragraph",
      "text": "“Kedua, beberapa syarikat berkembang lebih cepat daripada yang saya jangka.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan ketiga…”"
    },
    {
      "type": "paragraph",
      "text": "Maya berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Beberapa aliran kewangan kelihatan terlalu rumit.”"
    },
    {
      "type": "paragraph",
      "text": "Adam yang berada di situ terus diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Rumit?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Adakah salah?”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya belum kata salah.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma kata saya tak faham.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itulah sebab kita bayar awak.”"
    },
    {
      "type": "paragraph",
      "text": "Maya tidak tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya bekerja untuk syarikat ini.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Bukan untuk melindungi sesiapa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Maya bangun."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Adam menunggu sehingga pintu tertutup."
    },
    {
      "type": "paragraph",
      "text": "“Kau yakin?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang pintu."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang membaca."
    },
    {
      "type": "paragraph",
      "text": "“Kerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Masih banyak?”"
    },
    {
      "type": "paragraph",
      "text": "“Semakin banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dulu awak selalu kata bila duit cukup, awak nak berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila cukup?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat rumah."
    },
    {
      "type": "paragraph",
      "text": "Kemudian anak-anak."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefonnya."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menutup bukunya."
    },
    {
      "type": "paragraph",
      "text": "“Awak sedar tak?”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak dah tak bercakap tentang sakit awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Linda menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Dulu semua yang awak buat sebab awak fikir awak tak ada masa.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang awak macam takut masa tak cukup untuk semua benda yang awak nak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Linda bangun."
    },
    {
      "type": "paragraph",
      "text": "“Selamat malam.”"
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Rizal kekal di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu mengganggunya."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana ia salah."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana ia tepat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, Maya datang ke Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Dia meminta satu mesyuarat khas."
    },
    {
      "type": "paragraph",
      "text": "Rizal, Adam dan beberapa pengurus hadir."
    },
    {
      "type": "paragraph",
      "text": "Maya meletakkan satu carta di skrin."
    },
    {
      "type": "paragraph",
      "text": "“Ini struktur kumpulan sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Kotak-kotak memenuhi skrin."
    },
    {
      "type": "paragraph",
      "text": "Syarikat."
    },
    {
      "type": "paragraph",
      "text": "Pelaburan."
    },
    {
      "type": "paragraph",
      "text": "Aset."
    },
    {
      "type": "paragraph",
      "text": "Operasi."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihatnya."
    },
    {
      "type": "paragraph",
      "text": "Adam juga."
    },
    {
      "type": "paragraph",
      "text": "Maya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Dari sudut perniagaan, kumpulan ini sudah terlalu besar untuk bergantung kepada beberapa orang sahaja.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Setuju.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita perlukan sistem kawalan yang lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "“Setuju.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan audit dalaman yang lebih ketat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Maya."
    },
    {
      "type": "paragraph",
      "text": "“Buat.”"
    },
    {
      "type": "paragraph",
      "text": "Maya kelihatan sedikit terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Encik setuju?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita nak jadi besar, kita kena bersedia kalau orang periksa kita.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Itulah jawapan seorang ahli perniagaan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi di dalam kepala Rizal, satu perkara lain bermain."
    },
    {
      "type": "paragraph",
      "text": "**Kalau orang periksa terlalu dalam, berapa banyak yang mereka akan jumpa?**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Farid masuk."
    },
    {
      "type": "paragraph",
      "text": "“Bos.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ada masalah dengan satu orang lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Orang Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Dia nak apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia kata ada benda yang dia tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Benda apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak jelas.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Farid menunggu arahan."
    },
    {
      "type": "paragraph",
      "text": "“Jangan sentuh dia.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Bos?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya kata jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia bercakap, kita dengar.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Rizal menambah,"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang bercakap terlalu banyak biasanya akhirnya memberitahu apa yang mereka tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid faham."
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Adam yang berada di sudut bilik memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Dulu kau akan suruh dia diam.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang saya nak tahu apa yang dia tahu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Maya masih berada di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Hampir pukul sebelas."
    },
    {
      "type": "paragraph",
      "text": "Dia menyemak satu lagi fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berhenti."
    },
    {
      "type": "paragraph",
      "text": "Ada sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Bukan jumlah besar."
    },
    {
      "type": "paragraph",
      "text": "Bukan transaksi yang jelas pelik."
    },
    {
      "type": "paragraph",
      "text": "Tetapi satu corak."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail lain."
    },
    {
      "type": "paragraph",
      "text": "Corak yang sama."
    },
    {
      "type": "paragraph",
      "text": "Fail ketiga."
    },
    {
      "type": "paragraph",
      "text": "Sama."
    },
    {
      "type": "paragraph",
      "text": "Maya bersandar di kerusi."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak terus membuat kesimpulan."
    },
    {
      "type": "paragraph",
      "text": "Dia tahu seorang akauntan yang baik tidak menuduh."
    },
    {
      "type": "paragraph",
      "text": "Dia mengesahkan."
    },
    {
      "type": "paragraph",
      "text": "Maya mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak semak satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menerangkan secara ringkas."
    },
    {
      "type": "paragraph",
      "text": "Suara di hujung talian menjawab."
    },
    {
      "type": "paragraph",
      "text": "Maya diam."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat semula skrin."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi."
    },
    {
      "type": "paragraph",
      "text": "Maya meminta berjumpa Rizal seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk ke bilik mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Maya tidak duduk."
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak tanya sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "“Silakan.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama Encik rancang untuk terus berkembang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana pada kadar sekarang, struktur syarikat ini akan menjadi jauh lebih besar dalam masa yang singkat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Itulah rancangan.”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau begitu, kita perlukan satu perkara.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Ketelusan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Maya menyambung."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tidak tahu apa yang berlaku di dalam sistem kita sendiri, suatu hari nanti sistem itu akan makan kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Awak bagus.”"
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "“Teruskan.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebelum dia keluar, Rizal berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Maya.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau awak jumpa sesuatu yang tak masuk akal…”"
    },
    {
      "type": "paragraph",
      "text": "Maya menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Beritahu saya dahulu.”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sudah tentu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu sama ada Maya boleh dipercayai."
    },
    {
      "type": "paragraph",
      "text": "Tetapi buat pertama kali sejak dia membina empayar itu, dia sedar satu perkara:"
    },
    {
      "type": "paragraph",
      "text": "**dia sendiri tidak tahu sepenuhnya apa yang telah dibina.**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Amir menerima satu fail."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka."
    },
    {
      "type": "paragraph",
      "text": "Beberapa dokumen."
    },
    {
      "type": "paragraph",
      "text": "Beberapa nama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu nama yang dia kenal terlalu baik."
    },
    {
      "type": "paragraph",
      "text": "**Maya.**"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Siapa dia?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawainya menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Akauntan kumpulan Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Amir diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak pasti.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Cari tahu.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada malam yang sama, Rizal berada di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Maya sudah pulang."
    },
    {
      "type": "paragraph",
      "text": "Adam sudah pulang."
    },
    {
      "type": "paragraph",
      "text": "Semua orang sudah pulang."
    },
    {
      "type": "paragraph",
      "text": "Hanya Rizal seorang."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka laporan kewangan."
    },
    {
      "type": "paragraph",
      "text": "Membaca angka demi angka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Satu angka tidak sepadan."
    },
    {
      "type": "paragraph",
      "text": "Dia menyemak lagi."
    },
    {
      "type": "paragraph",
      "text": "Masih sama."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil telefon."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Datang pejabat.”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Ada apa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "“Masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa masalah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Bukan duit.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Orang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terus senyap."
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "Di luar tingkap, lampu bandar terus menyala."
    },
    {
      "type": "paragraph",
      "text": "Empayar itu semakin besar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi untuk pertama kali..."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula sedar bahawa empayar yang besar mempunyai terlalu banyak mata."
    },
    {
      "type": "paragraph",
      "text": "Dan salah satu mata itu mungkin milik seseorang yang bekerja **di dalam** empayarnya sendiri."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 5**"
    }
