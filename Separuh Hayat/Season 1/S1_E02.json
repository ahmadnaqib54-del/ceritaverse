  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 2\n### Harga Masa"
    },
    {
      "type": "paragraph",
      "text": "Pukul 5:42 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal terjaga sebelum jam loceng berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang siling."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang jam tangan yang diberikan Roy."
    },
    {
      "type": "paragraph",
      "text": "5:42."
    },
    {
      "type": "paragraph",
      "text": "Dia bangun perlahan-lahan."
    },
    {
      "type": "paragraph",
      "text": "Di sebelahnya, Linda masih tidur."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di tepi katil."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat dia hanya diam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tangannya naik ke dada."
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas panjang."
    },
    {
      "type": "paragraph",
      "text": "Tidak sakit."
    },
    {
      "type": "paragraph",
      "text": "Belum."
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun dan keluar dari bilik."
    },
    {
      "type": "paragraph",
      "text": "Di ruang tamu, buku kimia yang dibacanya malam tadi masih berada di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "Menutupnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memasukkannya ke dalam beg kerja."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Di sekolah, semuanya kelihatan normal."
    },
    {
      "type": "paragraph",
      "text": "Pelajar bising."
    },
    {
      "type": "paragraph",
      "text": "Guru bercakap."
    },
    {
      "type": "paragraph",
      "text": "Mesin fotostat rosak."
    },
    {
      "type": "paragraph",
      "text": "Dan seseorang di bilik guru sekali lagi kehilangan pen merah."
    },
    {
      "type": "paragraph",
      "text": "“Siapa ambil pen aku?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Pen kau ada dalam tangan.”"
    },
    {
      "type": "paragraph",
      "text": "Guru itu melihat tangannya sendiri."
    },
    {
      "type": "paragraph",
      "text": "“Oh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kanser belum buat semua orang hilang akal.”"
    },
    {
      "type": "paragraph",
      "text": "Rakannya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah beritahu keluarga?”"
    },
    {
      "type": "paragraph",
      "text": "“Dah.”"
    },
    {
      "type": "paragraph",
      "text": "“Teruk?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rakannya terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau perlukan apa-apa, bagitahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Loceng berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "Masuk ke kelas."
    },
    {
      "type": "paragraph",
      "text": "Dia mengajar seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi pagi itu, fikirannya bukan pada formula di papan putih."
    },
    {
      "type": "paragraph",
      "text": "Ia pada satu soalan."
    },
    {
      "type": "paragraph",
      "text": "**Berapa banyak wang yang diperlukan untuk memastikan keluarganya tidak terjejas jika dia tiada?**"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Enjin belum dihidupkan."
    },
    {
      "type": "paragraph",
      "text": "Di tangan kirinya ada senarai perbelanjaan."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah mengira beberapa kali."
    },
    {
      "type": "paragraph",
      "text": "Rawatan."
    },
    {
      "type": "paragraph",
      "text": "Ubat."
    },
    {
      "type": "paragraph",
      "text": "Pengangkutan ke hospital."
    },
    {
      "type": "paragraph",
      "text": "Keperluan Roy."
    },
    {
      "type": "paragraph",
      "text": "Rumah."
    },
    {
      "type": "paragraph",
      "text": "Bil."
    },
    {
      "type": "paragraph",
      "text": "Keperluan bayi."
    },
    {
      "type": "paragraph",
      "text": "Dan selepas itu?"
    },
    {
      "type": "paragraph",
      "text": "Bagaimana Linda mahu hidup jika dia tidak lagi bekerja?"
    },
    {
      "type": "paragraph",
      "text": "Bagaimana dengan Roy?"
    },
    {
      "type": "paragraph",
      "text": "Bagaimana dengan anak yang belum lahir?"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengeluarkan kalkulator."
    },
    {
      "type": "paragraph",
      "text": "Dia menaip satu angka."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memadamnya."
    },
    {
      "type": "paragraph",
      "text": "Dia menaip lagi."
    },
    {
      "type": "paragraph",
      "text": "RM100,000."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang angka itu."
    },
    {
      "type": "paragraph",
      "text": "“Seratus ribu.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengira semula."
    },
    {
      "type": "paragraph",
      "text": "Tidak cukup."
    },
    {
      "type": "paragraph",
      "text": "Dia menukar angka."
    },
    {
      "type": "paragraph",
      "text": "RM300,000."
    },
    {
      "type": "paragraph",
      "text": "Masih terasa kecil."
    },
    {
      "type": "paragraph",
      "text": "RM500,000."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Setengah juta.”"
    },
    {
      "type": "paragraph",
      "text": "Kali ini dia tidak terus menekan butang sama."
    },
    {
      "type": "paragraph",
      "text": "Dia hanya memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Setengah juta ringgit."
    },
    {
      "type": "paragraph",
      "text": "Itu bukan lagi duit untuk membayar bil."
    },
    {
      "type": "paragraph",
      "text": "Itu duit untuk membeli masa."
    },
    {
      "type": "paragraph",
      "text": "Sekurang-kurangnya pada fikirannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal bercakap dengan Linda."
    },
    {
      "type": "paragraph",
      "text": "“Kita jual kereta.”"
    },
    {
      "type": "paragraph",
      "text": "Linda terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kereta?”"
    },
    {
      "type": "paragraph",
      "text": "“Kereta abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau rawatan mahal, kita perlukan tunai.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Kita masih perlukan kereta.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh guna kereta lama.”"
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya serius.”"
    },
    {
      "type": "paragraph",
      "text": "Linda duduk di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Berapa banyak abang fikir kita perlukan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Banyak.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memegang tangannya."
    },
    {
      "type": "paragraph",
      "text": "“Kita hadap satu-satu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Satu-satu tidak akan menyelesaikan semuanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Hari berikutnya, Rizal pergi ke bank."
    },
    {
      "type": "paragraph",
      "text": "Dia bertanya tentang pinjaman."
    },
    {
      "type": "paragraph",
      "text": "Pegawai bank menerangkan syarat."
    },
    {
      "type": "paragraph",
      "text": "Pendapatan tetap."
    },
    {
      "type": "paragraph",
      "text": "Komitmen sedia ada."
    },
    {
      "type": "paragraph",
      "text": "Tempoh pinjaman."
    },
    {
      "type": "paragraph",
      "text": "Dokumen."
    },
    {
      "type": "paragraph",
      "text": "Jumlah kelayakan."
    },
    {
      "type": "paragraph",
      "text": "Rizal mendengar semuanya."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia bertanya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya perlukan lebih?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Bergantung pada kelayakan encik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum nipis."
    },
    {
      "type": "paragraph",
      "text": "“Faham.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Di dalam kereta, dia duduk lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menelefon sebuah syarikat insurans."
    },
    {
      "type": "paragraph",
      "text": "Mereka bercakap tentang polisi."
    },
    {
      "type": "paragraph",
      "text": "Tentang perlindungan."
    },
    {
      "type": "paragraph",
      "text": "Tentang syarat."
    },
    {
      "type": "paragraph",
      "text": "Tentang apa yang dilindungi dan apa yang tidak."
    },
    {
      "type": "paragraph",
      "text": "Rizal semakin diam."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Terima kasih.”"
    },
    {
      "type": "paragraph",
      "text": "Telefon diletakkan."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang stereng."
    },
    {
      "type": "paragraph",
      "text": "Kemudian ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana gembira."
    },
    {
      "type": "paragraph",
      "text": "“Pandai betul hidup ni buat kira-kira.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Rizal berjumpa doktor sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "Keputusan pemeriksaan lanjut sudah keluar."
    },
    {
      "type": "paragraph",
      "text": "Doktor menerangkan keadaan dengan tenang."
    },
    {
      "type": "paragraph",
      "text": "Rizal mendengar."
    },
    {
      "type": "paragraph",
      "text": "Dia bertanya banyak soalan."
    },
    {
      "type": "paragraph",
      "text": "Tentang rawatan."
    },
    {
      "type": "paragraph",
      "text": "Tentang kesan sampingan."
    },
    {
      "type": "paragraph",
      "text": "Tentang tempoh rawatan."
    },
    {
      "type": "paragraph",
      "text": "Tentang prognosis."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menangis."
    },
    {
      "type": "paragraph",
      "text": "Tidak panik."
    },
    {
      "type": "paragraph",
      "text": "Dia mencatat semuanya."
    },
    {
      "type": "paragraph",
      "text": "Seperti seorang pelajar yang sedang membuat nota."
    },
    {
      "type": "paragraph",
      "text": "Sebelum keluar, doktor berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Encik Rizal, kita akan cuba rawatan terbaik yang ada.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya faham.”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti di pintu."
    },
    {
      "type": "paragraph",
      "text": "“Doktor.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya nak terus bekerja?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh, bergantung kepada keadaan encik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, dia membuka laptop."
    },
    {
      "type": "paragraph",
      "text": "Rizal mencari kerja sambilan."
    },
    {
      "type": "paragraph",
      "text": "Tutor."
    },
    {
      "type": "paragraph",
      "text": "Kelas tambahan."
    },
    {
      "type": "paragraph",
      "text": "Konsultan makmal."
    },
    {
      "type": "paragraph",
      "text": "Pemeriksaan kualiti."
    },
    {
      "type": "paragraph",
      "text": "Penulisan teknikal."
    },
    {
      "type": "paragraph",
      "text": "Apa sahaja."
    },
    {
      "type": "paragraph",
      "text": "Dia menghantar beberapa permohonan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia teringat sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Seorang bekas rakan universiti pernah menghubunginya."
    },
    {
      "type": "paragraph",
      "text": "Menawarkan kerja konsultasi."
    },
    {
      "type": "paragraph",
      "text": "Rizal menelefon."
    },
    {
      "type": "paragraph",
      "text": "“Bro.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih perlukan orang untuk buat kerja teknikal?”"
    },
    {
      "type": "paragraph",
      "text": "“Kadang-kadang.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya ambil?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau nak?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh. Tapi bukan banyak.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rakannya menyebut jumlah."
    },
    {
      "type": "paragraph",
      "text": "Rizal diam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Telefon ditutup."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang laptop."
    },
    {
      "type": "paragraph",
      "text": "Pendapatan tambahan itu ada."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kecil."
    },
    {
      "type": "paragraph",
      "text": "Terlalu kecil."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka spreadsheet."
    },
    {
      "type": "paragraph",
      "text": "Dia memasukkan angka gaji."
    },
    {
      "type": "paragraph",
      "text": "Pendapatan sampingan."
    },
    {
      "type": "paragraph",
      "text": "Simpanan."
    },
    {
      "type": "paragraph",
      "text": "Perbelanjaan."
    },
    {
      "type": "paragraph",
      "text": "Kos rawatan yang dianggarkan."
    },
    {
      "type": "paragraph",
      "text": "Dia buat satu jadual."
    },
    {
      "type": "paragraph",
      "text": "**12 bulan.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian **24 bulan.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian **36 bulan.**"
    },
    {
      "type": "paragraph",
      "text": "Pada akhir setiap jadual, angka yang sama muncul."
    },
    {
      "type": "paragraph",
      "text": "Defisit."
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "Dia cuba lagi."
    },
    {
      "type": "paragraph",
      "text": "Jual kereta."
    },
    {
      "type": "paragraph",
      "text": "Kurangkan perbelanjaan."
    },
    {
      "type": "paragraph",
      "text": "Ambil kerja tambahan."
    },
    {
      "type": "paragraph",
      "text": "Pinjaman."
    },
    {
      "type": "paragraph",
      "text": "Jual beberapa aset."
    },
    {
      "type": "paragraph",
      "text": "Dia masukkan semuanya."
    },
    {
      "type": "paragraph",
      "text": "Masih tidak cukup untuk jumlah yang dia mahukan."
    },
    {
      "type": "paragraph",
      "text": "Dia menutup laptop."
    },
    {
      "type": "paragraph",
      "text": "Pukul 1:18 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rumah sunyi."
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun untuk mengambil air."
    },
    {
      "type": "paragraph",
      "text": "Ketika melalui bilik Roy, dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Pintu terbuka sedikit."
    },
    {
      "type": "paragraph",
      "text": "Roy sedang tidur."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk perlahan."
    },
    {
      "type": "paragraph",
      "text": "Dia membetulkan selimut anaknya."
    },
    {
      "type": "paragraph",
      "text": "Roy bergerak sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Ayah?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidur.”"
    },
    {
      "type": "paragraph",
      "text": "Roy membuka mata separuh."
    },
    {
      "type": "paragraph",
      "text": "“Ayah okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Okay.”"
    },
    {
      "type": "paragraph",
      "text": "Roy mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian tidur semula."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri di situ beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian keluar."
    },
    {
      "type": "paragraph",
      "text": "Di ruang tamu, dia nampak satu kotak lama."
    },
    {
      "type": "paragraph",
      "text": "Kotak yang sudah bertahun-tahun tidak disentuh."
    },
    {
