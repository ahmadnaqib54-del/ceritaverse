  "content": [
    {
      "type": "paragraph",
      "text": "# SEPARUH HAYAT\n## Season 1 — Episode 9\n### Bekalan"
    },
    {
      "type": "paragraph",
      "text": "Pukul 11:36 malam."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di dalam kereta."
    },
    {
      "type": "paragraph",
      "text": "Adam di sebelah."
    },
    {
      "type": "paragraph",
      "text": "Kedua-duanya diam."
    },
    {
      "type": "paragraph",
      "text": "Di hadapan mereka, sebuah kawasan industri kelihatan hampir kosong."
    },
    {
      "type": "paragraph",
      "text": "Lampu gudang masih menyala."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Adam."
    },
    {
      "type": "paragraph",
      "text": "“Ini jalan yang kau cakap?”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang gudang itu."
    },
    {
      "type": "paragraph",
      "text": "“Boleh dapat?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita berjaya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau tak?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kita balik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab kau masih ada jawapan untuk balik.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka turun dari kereta."
    },
    {
      "type": "paragraph",
      "text": "Berjalan beberapa langkah."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita masih boleh patah balik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat gudang."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefonnya."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej daripada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "> **“Esok saya perlukan barang.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengunci skrin."
    },
    {
      "type": "paragraph",
      "text": "Dia memasukkan telefon ke dalam poket."
    },
    {
      "type": "paragraph",
      "text": "“Jom.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minit kemudian, mereka berada di dalam kawasan gudang."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak bercakap banyak."
    },
    {
      "type": "paragraph",
      "text": "Adam juga diam."
    },
    {
      "type": "paragraph",
      "text": "Mereka bergerak dengan berhati-hati."
    },
    {
      "type": "paragraph",
      "text": "Setiap bunyi terasa terlalu kuat."
    },
    {
      "type": "paragraph",
      "text": "Bunyi kipas."
    },
    {
      "type": "paragraph",
      "text": "Bunyi pintu."
    },
    {
      "type": "paragraph",
      "text": "Bunyi sebuah kenderaan dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti apabila terdengar sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Adam turut berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kedua-duanya menunggu."
    },
    {
      "type": "paragraph",
      "text": "Tiada apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Adam berbisik,"
    },
    {
      "type": "paragraph",
      "text": "“Terus?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Mereka meneruskan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Kemudian sesuatu berlaku."
    },
    {
      "type": "paragraph",
      "text": "Lampu menyala."
    },
    {
      "type": "paragraph",
      "text": "Rizal membeku."
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Satu suara kedengaran dari jauh."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam berbisik,"
    },
    {
      "type": "paragraph",
      "text": "“Pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka berpatah balik."
    },
    {
      "type": "paragraph",
      "text": "Langkah mereka semakin cepat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian terdengar bunyi pintu dibuka."
    },
    {
      "type": "paragraph",
      "text": "“Oi!”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menoleh."
    },
    {
      "type": "paragraph",
      "text": "Seorang pengawal sedang menuju ke arah mereka."
    },
    {
      "type": "paragraph",
      "text": "Adam menarik lengan Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang!”"
    },
    {
      "type": "paragraph",
      "text": "Mereka berlari."
    },
    {
      "type": "paragraph",
      "text": "Rizal hampir terjatuh ketika membelok."
    },
    {
      "type": "paragraph",
      "text": "“Cepat!”"
    },
    {
      "type": "paragraph",
      "text": "Mereka sampai ke kereta."
    },
    {
      "type": "paragraph",
      "text": "Adam membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "Rizal masuk."
    },
    {
      "type": "paragraph",
      "text": "Enjin dihidupkan."
    },
    {
      "type": "paragraph",
      "text": "Kereta bergerak."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian, mereka keluar dari kawasan itu."
    },
    {
      "type": "paragraph",
      "text": "Kedua-duanya diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang cermin belakang."
    },
    {
      "type": "paragraph",
      "text": "Tiada siapa mengejar."
    },
    {
      "type": "paragraph",
      "text": "Dia menarik nafas panjang."
    },
    {
      "type": "paragraph",
      "text": "Adam bersandar di tempat duduk."
    },
    {
      "type": "paragraph",
      "text": "“Gila.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan macam yang kita bincang.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil kerana gugup."
    },
    {
      "type": "paragraph",
      "text": "“Kita hampir kena tangkap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak ketawa."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang tangannya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Sedikit menggigil."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita dah buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu…”"
    },
    {
      "type": "paragraph",
      "text": "“Kita baru masuk gudang orang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk ambil barang.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang jalan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Ini bukan lagi sekadar jual barang.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka tidak mendapatkan apa yang mereka mahukan malam itu."
    },
    {
      "type": "paragraph",
      "text": "Sebahagian rancangan gagal."
    },
    {
      "type": "paragraph",
      "text": "Mereka hanya berjaya mendapatkan sedikit bekalan sebelum terpaksa beredar."
    },
    {
      "type": "paragraph",
      "text": "Namun bagi Rizal, itu sudah cukup untuk membuat satu perkara jelas."
    },
    {
      "type": "paragraph",
      "text": "Supply bukan lagi masalah atas kertas."
    },
    {
      "type": "paragraph",
      "text": "Ia sudah menjadi masalah sebenar."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan paginya, Rizal masuk ke sekolah seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu, kenapa mata merah?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak tidur.”"
    },
    {
      "type": "paragraph",
      "text": "“Main game?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Main hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal cuba tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Tetapi fikirannya masih di gudang malam tadi."
    },
    {
      "type": "paragraph",
      "text": "Buat pertama kali sejak dia mula melakukan jenayah, dia hampir ditangkap."
    },
    {
      "type": "paragraph",
      "text": "Dan yang lebih mengganggunya—"
    },
    {
      "type": "paragraph",
      "text": "dia tidak berhenti."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Adam datang."
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan sebuah beg di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang."
    },
    {
      "type": "paragraph",
      "text": "“Berapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyebut jumlah."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Tak cukup.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengira dalam kepalanya."
    },
    {
      "type": "paragraph",
      "text": "“Untuk satu cycle.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kemudian?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Kita perlukan supplier.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan curi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "“Cari supplier.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang baru saya dengar cikgu bercakap macam orang waras.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjeling."
    },
    {
      "type": "paragraph",
      "text": "“Jangan selesa sangat.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal menerima panggilan daripada Ah Len."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Barang esok.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Pasti?”"
    },
    {
      "type": "paragraph",
      "text": "“Pasti.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len diam seketika."
    },
    {
      "type": "paragraph",
      "text": "Kemudian bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu okay?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Suara macam penat.”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu ni memang kuat kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Sebelum telefon ditutup, Ah Len berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Satu lagi.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat benda bodoh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Apa maksud kau?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menelefon semula."
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa jam kemudian, Rizal duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "Linda datang membawa segelas air."
    },
    {
      "type": "paragraph",
      "text": "“Abang.”"
    },
    {
      "type": "paragraph",
      "text": "“Hmm?”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tangan abang?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat tangannya."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Macam luka.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal cepat-cepat menarik tangannya."
    },
    {
      "type": "paragraph",
      "text": "“Terkena barang.”"
    },
    {
      "type": "paragraph",
      "text": "“Barang apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Barang kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kerja apa sebenarnya?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kerja teknikal.”"
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Abang semakin banyak rahsia.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Linda masuk ke bilik."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang belakang isterinya."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, penghantaran kepada Ah Len berjalan lancar."
    },
    {
      "type": "paragraph",
      "text": "Ah Len memeriksa barang."
    },
    {
      "type": "paragraph",
      "text": "Mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas lega."
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Semalam ada orang masuk gudang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membeku."
    },
    {
      "type": "paragraph",
      "text": "Adam yang berdiri di sebelahnya juga diam."
    },
    {
      "type": "paragraph",
      "text": "Ah Len meneruskan,"
    },
    {
      "type": "paragraph",
      "text": "“Pengawal nampak dua orang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandang tepat kepadanya."
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu apa-apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil barang."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Adam menunggu sehingga Ah Len hilang dari pandangan."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Macam mana?”"
    },
    {
      "type": "paragraph",
      "text": "“Entah.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, berita kecil muncul di media tempatan."
    },
    {
      "type": "paragraph",
      "text": "**“Cubaan menceroboh gudang bahan industri disiasat.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca tajuk itu di telefon."
    },
    {
      "type": "paragraph",
      "text": "Tiada nama."
    },
    {
      "type": "paragraph",
      "text": "Tiada gambar."
    },
    {
      "type": "paragraph",
      "text": "Tiada kaitan dengan mereka."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk membuat jantungnya berdegup lebih laju."
    },
    {
      "type": "paragraph",
      "text": "Adam menghantar mesej."
    },
    {
      "type": "paragraph",
      "text": "> **“Jangan panik.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membalas:"
    },
    {
      "type": "paragraph",
      "text": "> **“Saya tak panik.”**"
    },
    {
      "type": "paragraph",
      "text": "Adam:"
    },
    {
      "type": "paragraph",
      "text": "> **“Cikgu tipu.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal hampir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej lain masuk."
    },
    {
      "type": "paragraph",
      "text": "> **“Tapi kita perlu berhenti buat sementara.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Di ruang tamu, Linda sedang menonton televisyen."
    },
    {
      "type": "paragraph",
      "text": "Roy ketawa dari biliknya."
    },
    {
      "type": "paragraph",
      "text": "Rumah itu masih sama."
    },
    {
      "type": "paragraph",
      "text": "Keluarganya masih ada."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Rizal tahu sesuatu telah berubah."
    },
    {
      "type": "paragraph",
      "text": "Dia sudah melangkah lebih jauh daripada yang dia rancangkan."
    },
    {
      "type": "paragraph",
      "text": "Dan kini, setiap langkah seterusnya akan menjadi lebih mudah."
    },
    {
      "type": "paragraph",
      "text": "Itulah perkara yang paling menakutkan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 1:03 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal masih belum tidur."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka buku nota."
    },
    {
      "type": "paragraph",
      "text": "Di halaman pertama:"
    },
    {
      "type": "paragraph",
      "text": "**RM500,000.**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**Selepas itu berhenti.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ayat itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membuka halaman baru."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis:"
    },
    {
      "type": "paragraph",
      "text": "**SUPPLY**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**PRODUCTION**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**DEMAND**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "**CASH FLOW**"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Menambah satu lagi:"
    },
    {
      "type": "paragraph",
      "text": "**RISK**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang semua perkataan itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat."
    },
    {
      "type": "paragraph",
      "text": "“Hello?”"
    },
    {
      "type": "paragraph",
      "text": "Suara lelaki."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Lelaki itu tidak menjawab soalan."
    },
    {
      "type": "paragraph",
      "text": "Sebaliknya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Gudang semalam.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus tegak."
    },
    {
      "type": "paragraph",
      "text": "Jantungnya berdegup kencang."
    },
    {
      "type": "paragraph",
      "text": "“Siapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "Suara itu ketawa perlahan."
    },
    {
      "type": "paragraph",
      "text": "“Saya orang yang jaga gudang tu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menggenggam telefon."
    },
    {
      "type": "paragraph",
      "text": "“Kau nampak kami?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak jelas.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Tapi saya nampak kereta.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang ke luar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Kau nak apa?”"
    },
    {
      "type": "paragraph",
      "text": "Suara itu senyap beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian:"
    },
    {
      "type": "paragraph",
      "text": "“Tak ada apa.”"
    },
    {
      "type": "paragraph",
      "text": "Talian terputus."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk kaku."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian, satu mesej masuk."
    },
    {
      "type": "paragraph",
      "text": "**Satu gambar.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membukanya."
    },
    {
      "type": "paragraph",
      "text": "Gambar keretanya."
    },
    {
      "type": "paragraph",
      "text": "Diambil dari jauh."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Kemudian perlahan-lahan memandang ke arah tingkap rumah."
    },
    {
      "type": "paragraph",
      "text": "Dan buat pertama kali, Rizal sedar—"
    },
    {
      "type": "paragraph",
      "text": "**jenayah pertama yang benar-benar menakutkan bukan ketika dia melakukannya.**"
    },
    {
      "type": "paragraph",
      "text": "**Tetapi ketika dia sedar ada orang lain yang tahu.**"
    }
  ],
