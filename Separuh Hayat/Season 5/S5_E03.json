  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 5 — EPISODE 3\n## WITNESS"
    },
    {
      "type": "paragraph",
      "text": "Fail di skrin masih terbuka."
    },
    {
      "type": "paragraph",
      "text": "**ACCESS GRANTED.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menyentuh tetikus."
    },
    {
      "type": "paragraph",
      "text": "Nama pengguna masih tertera."
    },
    {
      "type": "paragraph",
      "text": "**ADAM.**"
    },
    {
      "type": "paragraph",
      "text": "Tetapi Adam berada dalam tahanan."
    },
    {
      "type": "paragraph",
      "text": "“Siapa kau?”"
    },
    {
      "type": "paragraph",
      "text": "Tiada jawapan."
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup laptop."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membukanya semula."
    },
    {
      "type": "paragraph",
      "text": "Fail itu sudah hilang."
    },
    {
      "type": "paragraph",
      "text": "Satu-satunya perkara yang tinggal ialah satu folder kosong."
    },
    {
      "type": "paragraph",
      "text": "**WITNESS.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal bersandar."
    },
    {
      "type": "paragraph",
      "text": "Dia mula memahami."
    },
    {
      "type": "paragraph",
      "text": "Seseorang bukan sekadar memerhatikan mereka."
    },
    {
      "type": "paragraph",
      "text": "Seseorang mempunyai akses kepada sistem mereka."
    },
    {
      "type": "paragraph",
      "text": "Dan mungkin sudah lama."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di bilik soal siasat, Adam duduk diam."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai meletakkan dokumen di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "“Kami tahu kau simpan data.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kami tahu data itu berkaitan dengan Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kami mahu tahu semuanya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menolak satu gambar."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kemudian gambar Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "“Siapa ketua sebenar?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Itu soalan yang salah.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab semua orang dalam gambar ini fikir mereka ketua.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Soal siasat berterusan."
    },
    {
      "type": "paragraph",
      "text": "Mereka bertanya tentang Rizal."
    },
    {
      "type": "paragraph",
      "text": "Tentang Hashim."
    },
    {
      "type": "paragraph",
      "text": "Tentang Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Tentang Farid."
    },
    {
      "type": "paragraph",
      "text": "Tentang Maya."
    },
    {
      "type": "paragraph",
      "text": "Adam memberikan maklumat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bukan semuanya."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak menipu."
    },
    {
      "type": "paragraph",
      "text": "Dia cuma tidak menceritakan perkara yang belum dia tahu."
    },
    {
      "type": "paragraph",
      "text": "Dan satu perkara dia simpan."
    },
    {
      "type": "paragraph",
      "text": "**Project Hayat.**"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada waktu petang, seorang pegawai berkata kepada rakannya,"
    },
    {
      "type": "paragraph",
      "text": "“Dia tak nampak macam orang yang mahu lindungi Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia beri banyak maklumat.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Tapi setiap kali kita hampir sampai kepada sesuatu yang penting, dia berhenti.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia takut?”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia sedang menunggu sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal pula cuba mencari jawapan."
    },
    {
      "type": "paragraph",
      "text": "Dia pergi menemui Maya."
    },
    {
      "type": "paragraph",
      "text": "Maya sedang mengemas barang di pejabat."
    },
    {
      "type": "paragraph",
      "text": "“Kau betul-betul nak keluar?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya dah nampak cukup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Adam ditahan.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia mungkin akan jadi saksi.”"
    },
    {
      "type": "paragraph",
      "text": "Maya terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Awak takut?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab jujur."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bagus?”"
    },
    {
      "type": "paragraph",
      "text": "“Sekurang-kurangnya awak masih boleh rasa takut.”"
    },
    {
      "type": "paragraph",
      "text": "Maya mengambil satu kotak."
    },
    {
      "type": "paragraph",
      "text": "“Saya dah buat salinan beberapa rekod.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk perlindungan.”"
    },
    {
      "type": "paragraph",
      "text": "“Daripada siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Maya tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum hambar."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang sekarang simpan insurans.”"
    },
    {
      "type": "paragraph",
      "text": "Maya memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Termasuk awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menafikan."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal pergi menemui Dr. Malik."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu tahu satu perkara."
    },
    {
      "type": "paragraph",
      "text": "“Adam jadi saksi.”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kau tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana saksi diperlukan apabila sistem mula runtuh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Siapa yang perlukan saksi?”"
    },
    {
      "type": "paragraph",
      "text": "Dr. Malik memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Semua pihak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Pihak berkuasa perlukan saksi untuk membina kes.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan pihak lain?”"
    },
    {
      "type": "paragraph",
      "text": "“Perlukan saksi untuk mengawal cerita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memahami."
    },
    {
      "type": "paragraph",
      "text": "Kalau Adam bercakap—"
    },
    {
      "type": "paragraph",
      "text": "cerita akan keluar."
    },
    {
      "type": "paragraph",
      "text": "Kalau Adam diam—"
    },
    {
      "type": "paragraph",
      "text": "seseorang masih boleh menggunakan dia."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan harinya, berita tersebar."
    },
    {
      "type": "paragraph",
      "text": "**BEKAS PEGAWAI KIMIA DIKAITKAN DENGAN RANGKAIAN JENAYAH.**"
    },
    {
      "type": "paragraph",
      "text": "Nama Adam tidak disebut sepenuhnya."
    },
    {
      "type": "paragraph",
      "text": "Tetapi orang yang mengenalinya tahu."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat berita itu."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak membaca komen."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak mahu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Peguam."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Adam mungkin akan beri kerjasama.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Dia akan jadi saksi?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum pasti.”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia beri kerjasama?”"
    },
    {
      "type": "paragraph",
      "text": "“Kes terhadap awak akan menjadi lebih kuat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang keluar tingkap."
    },
    {
      "type": "paragraph",
      "text": "“Aku faham.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Ada arahan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan buat apa-apa.”"
    },
    {
      "type": "paragraph",
      "text": "“Pasti?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Talian tamat."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Farid datang malam itu."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk di hadapan Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ditahan.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya dengar dia akan bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia bercakap?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia berhak.”"
    },
    {
      "type": "paragraph",
      "text": "Farid terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Kau nak buat apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Farid kelihatan terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Bos tak pernah tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang aku tak ada banyak benda lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Farid menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Aku boleh…”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya cuma nak—”"
    },
    {
      "type": "paragraph",
      "text": "“Jangan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tidak ada siapa sentuh Adam.”"
    },
    {
      "type": "paragraph",
      "text": "Farid diam."
    },
    {
      "type": "paragraph",
      "text": "“Faham?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Dia buat kesalahan sendiri. Dia kena hadap akibat sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di dalam tahanan, Adam menerima seorang pelawat."
    },
    {
      "type": "paragraph",
      "text": "Peguamnya."
    },
    {
      "type": "paragraph",
      "text": "Peguam itu duduk di hadapannya."
    },
    {
      "type": "paragraph",
      "text": "“Pihak pendakwa mahu kerjasama.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Apa syarat?”"
    },
    {
      "type": "paragraph",
      "text": "“Pengurangan hukuman mungkin dipertimbangkan bergantung kepada maklumat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Awak mahu bekerjasama?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang meja."
    },
    {
      "type": "paragraph",
      "text": "“Aku mahu kebenaran keluar.”"
    },
    {
      "type": "paragraph",
      "text": "Peguam itu terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Bukan sekadar tentang Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "“Kalau aku hanya beri mereka Rizal, mereka akan berhenti mencari.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang sepatutnya mereka cari.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Adam menulis sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Bukan pengakuan."
    },
    {
      "type": "paragraph",
      "text": "Bukan nama."
    },
    {
      "type": "paragraph",
      "text": "Satu senarai."
    },
    {
      "type": "paragraph",
      "text": "**HASHIM.**"
    },
    {
      "type": "paragraph",
      "text": "**KHALID.**"
    },
    {
      "type": "paragraph",
      "text": "**DR. MALIK.**"
    },
    {
      "type": "paragraph",
      "text": "**DANIEL VOSS.**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi nama."
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti lama."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya menulis:"
    },
    {
      "type": "paragraph",
      "text": "**RIZAL.**"
    },
    {
      "type": "paragraph",
      "text": "Di bawah semua nama itu:"
    },
    {
      "type": "paragraph",
      "text": "**WHO BENEFITED?**"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang soalan itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menambah:"
    },
    {
      "type": "paragraph",
      "text": "**WHO CHOSE?**"
    },
    {
      "type": "paragraph",
      "text": "Dia tahu jawapannya tidak sama."
    },
    {
      "type": "paragraph",
      "text": "Seseorang boleh mendapat manfaat daripada tindakan seseorang tanpa menjadi orang yang memilih tindakan itu."
    },
    {
      "type": "paragraph",
      "text": "Itulah yang membuat kes ini begitu rumit."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi, Amir's old files dibawa ke bilik siasatan."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai membuka fail lama."
    },
    {
      "type": "paragraph",
      "text": "Nama Amir masih tertera sebagai pegawai penyiasat."
    },
    {
      "type": "paragraph",
      "text": "Di dalamnya ada nota tulisan tangan."
    },
    {
      "type": "paragraph",
      "text": "**“Rizal bukan sekadar sasaran. Cari siapa yang membentuk laluan dia.”**"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu membaca."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Amir sudah fikir benda ini.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Awak kenal Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dia percaya Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Dia cuba.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Adam akhirnya membuat keputusan."
    },
    {
      "type": "paragraph",
      "text": "Dia meminta untuk bekerjasama."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dengan satu syarat."
    },
    {
      "type": "paragraph",
      "text": "“Aku akan beri apa yang aku tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Aku mahu semua rekod Project Hayat dilindungi.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab itu lebih besar daripada Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Berita itu sampai kepada Rizal malam tersebut."
    },
    {
      "type": "paragraph",
      "text": "**ADAM AKAN MEMBERI KERJASAMA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk."
    },
    {
      "type": "paragraph",
      "text": "Tidak marah."
    },
    {
      "type": "paragraph",
      "text": "Tidak terkejut."
    },
    {
      "type": "paragraph",
      "text": "Hanya penat."
    },
    {
      "type": "paragraph",
      "text": "Dia mengambil gambar lama."
    },
    {
      "type": "paragraph",
      "text": "Dia dan Adam."
    },
    {
      "type": "paragraph",
      "text": "Season pertama hidup mereka."
    },
    {
      "type": "paragraph",
      "text": "Dua orang yang pada awalnya cuma mahu mencari jalan keluar."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kita memang sampai jauh.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia menyimpan gambar itu."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pagi berikutnya, Adam dibawa masuk ke bilik khas."
    },
    {
      "type": "paragraph",
      "text": "Fail diletakkan di atas meja."
    },
    {
      "type": "paragraph",
      "text": "Seorang pegawai bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Siapa Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang mereka."
    },
    {
      "type": "paragraph",
      "text": "“Seorang guru.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu kelihatan pelik."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang seorang lelaki yang terlalu lama cuba mengawal perkara yang tidak boleh dikawal.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Bagaimana semuanya bermula?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Dia sakit.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia takut.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang fail."
    },
    {
      "type": "paragraph",
      "text": "“Dia mahu tinggalkan sesuatu untuk keluarganya.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Jadi dia menjadi penjenayah?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab sakit bukan alasan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Dia memilih.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal menerima satu mesej."
    },
    {
      "type": "paragraph",
      "text": "Bukan daripada Adam."
    },
    {
      "type": "paragraph",
      "text": "Daripada nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "**ADAM SUDAH BERCERITA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua:"
    },
    {
      "type": "paragraph",
      "text": "**TAPI DIA BELUM CERITA SEMUANYA.**"
    },
    {
      "type": "paragraph",
      "text": "Mesej ketiga:"
    },
    {
      "type": "paragraph",
      "text": "**SEBAB DIA MASIH MELINDUNGI KAU.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej terakhir muncul."
    },
    {
      "type": "paragraph",
      "text": "**ATAU DIA SEDANG MELINDUNGI DIRINYA DARIPADA KITA.**"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu yang mana satu benar."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Di bilik siasatan, Adam duduk berhadapan dengan pegawai."
    },
    {
      "type": "paragraph",
      "text": "Dia baru sahaja selesai memberikan kenyataan panjang."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Kami akan perlukan satu perkara lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Bukti yang menghubungkan Rizal secara langsung.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu menunggu."
    },
    {
      "type": "paragraph",
      "text": "Adam akhirnya berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku ada.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu membuka mata sedikit."
    },
    {
      "type": "paragraph",
      "text": "“Di mana?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Bukan di tangan aku.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi di mana?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Dalam sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Pegawai itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Awak maksudkan?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menjawab perlahan:"
    },
    {
      "type": "paragraph",
      "text": "“Rizal bukan satu-satunya orang yang mempunyai akses.”"
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama—"
    },
    {
      "type": "paragraph",
      "text": "di sebuah lokasi yang tidak diketahui—"
    },
    {
      "type": "paragraph",
      "text": "seseorang membuka satu fail."
    },
    {
      "type": "paragraph",
      "text": "**WITNESS — ADAM**"
    },
    {
      "type": "paragraph",
      "text": "Status:"
    },
    {
      "type": "paragraph",
      "text": "**COOPERATING**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi fail dibuka."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL**"
    },
    {
      "type": "paragraph",
      "text": "Status:"
    },
    {
      "type": "paragraph",
      "text": "**ISOLATED**"
    },
    {
      "type": "paragraph",
      "text": "Dan satu arahan muncul:"
    },
    {
      "type": "paragraph",
      "text": "**“BIARKAN DIA BERCAKAP.”**"
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian, arahan kedua muncul."
    },
    {
      "type": "paragraph",
      "text": "**“KITA MAHU RIZAL TAHU ADAM SUDAH MEMILIH.”**"
    },
    {
      "type": "paragraph",
      "text": "Skrin menjadi gelap."
    },
    {
      "type": "paragraph",
      "text": "***"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri di pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia memandang kerusi Adam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau pilih untuk bercakap…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…aku faham.”"
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia tidak tahu—"
    },
    {
      "type": "paragraph",
      "text": "Adam belum selesai bercakap."
    },
    {
      "type": "paragraph",
      "text": "Dan apa yang Adam simpan bukan sekadar bukti untuk menjatuhkan Rizal."
    },
    {
      "type": "paragraph",
      "text": "Ia mungkin bukti yang akan membuka seluruh rangkaian yang bermula jauh sebelum mereka berdua bertemu."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 3**"
    }
  ],
