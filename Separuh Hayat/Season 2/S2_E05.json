    {
      "type": "paragraph",
      "text": "Rizal sedikit terkejut."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerana dia bukan musuh kita.”"
