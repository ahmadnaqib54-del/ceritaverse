    {
      "type": "paragraph",
      "text": "Daripada Amir."
    },
    {
      "type": "paragraph",
      "text": "**“Esok free? Aku nak belanja makan.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang mesej itu lama."
    },
    {
      "type": "paragraph",
      "text": "Kemudian membalas."
    },
    {
      "type": "paragraph",
      "text": "**“Boleh.”**"
    },
    {
      "type": "paragraph",
      "text": "Dia menyimpan telefon."
    },
    {
      "type": "paragraph",
      "text": "Di dalam rumah, Linda sedang bercakap dengan Roy."
    },
    {
      "type": "paragraph",
      "text": "Suara mereka kedengaran samar."
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang rumahnya."
