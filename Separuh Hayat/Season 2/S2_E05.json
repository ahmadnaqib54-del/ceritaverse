    {
      "type": "paragraph",
      "text": "Rizal terus bekerja."
    },
    {
      "type": "paragraph",
      "text": "Sekolah berjalan seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Di rumah, Linda semakin hampir melahirkan."
    },
    {
      "type": "paragraph",
      "text": "Semua kelihatan normal."
    },
    {
      "type": "paragraph",
      "text": "Terlalu normal."
    },
    {
      "type": "paragraph",
      "text": "Sehinggalah satu petang, Amir menerima satu laporan."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail."
