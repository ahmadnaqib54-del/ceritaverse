    {
      "type": "paragraph",
      "text": "Nama kedua."
    },
    {
      "type": "paragraph",
      "text": "Nama ketiga."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu nama yang dia kenal sejak bertahun-tahun."
    },
    {
      "type": "paragraph",
      "text": "**RIZAL.**"
    },
    {
      "type": "paragraph",
      "text": "Amir berhenti."
    },
    {
      "type": "paragraph",
      "text": "Dia mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak mungkin.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menutup fail."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana dia sudah yakin Rizal tidak terlibat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana fikirannya belum sanggup meletakkan seorang abang ipar di tempat yang sama dengan orang-orang yang selama ini dia buru."
    },
    {
      "type": "paragraph",
      "text": "Dan itulah blind spot terbesar Amir."
    },
    {
      "type": "paragraph",
      "text": "Bukan kurangnya bukti."
    },
    {
      "type": "paragraph",
      "text": "Tetapi terlalu banyak **kepercayaan**."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 5**"
    }
