    },
    {
      "type": "paragraph",
      "text": "Rizal menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar kali ketiga."
    },
    {
      "type": "paragraph",
      "text": "Rizal bangun."
    },
    {
      "type": "paragraph",
      "text": "“Saya pergi ambil.”"
    },
    {
      "type": "paragraph",
      "text": "Dia masuk ke dapur."
    },
    {
      "type": "paragraph",
      "text": "Melihat skrin."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Rizal jawab."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Suara Adam rendah."
    },
    {
      "type": "paragraph",
      "text": "“Amir dah jumpa sesuatu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memejam mata."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia dah mula kaitkan Bumi Perdana dengan rangkaian kita.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Hashim tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa dia kata?”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti sekejap."
    },
    {
      "type": "paragraph",
      "text": "“Dia kata…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "“…biarkan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka mata."
    },
    {
      "type": "paragraph",
      "text": "“Biarkan?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "“Dia kata dia nak tengok sejauh mana Amir boleh pergi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Adam.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Kalau dia teruskan?”"
    },
    {
      "type": "paragraph",
      "text": "Adam tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Rizal tahu jawapannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam semakin lewat."
    },
    {
      "type": "paragraph",
      "text": "Rizal keluar ke halaman rumah."
    },
    {
      "type": "paragraph",
      "text": "Langit gelap."
    },
    {
      "type": "paragraph",
      "text": "Dia berdiri seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Telefon di tangan."
    },
    {
      "type": "paragraph",
      "text": "Satu mesej masuk."
