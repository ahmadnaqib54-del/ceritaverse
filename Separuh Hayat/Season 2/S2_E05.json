    {
      "type": "paragraph",
      "text": "Masa jelas."
    },
    {
      "type": "paragraph",
      "text": "Lokasi jelas."
    },
    {
      "type": "paragraph",
      "text": "Amir melihat alamat destinasi."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia membuka rekod syarikat."
    },
    {
      "type": "paragraph",
      "text": "Ada hubungan dengan Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Dia bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Menarik.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada malam yang sama, Rizal sedang makan bersama keluarga."
    },
    {
      "type": "paragraph",
      "text": "Roy bercerita tentang sekolah."
    },
    {
      "type": "paragraph",
      "text": "Linda ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Telefon dalam poketnya bergetar."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak keluarkan."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian, bergetar lagi."
    },
    {
      "type": "paragraph",
      "text": "Linda memandang."
    },
    {
      "type": "paragraph",
      "text": "“Tak jawab?”"
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
