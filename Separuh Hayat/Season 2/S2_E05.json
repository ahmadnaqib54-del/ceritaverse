    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Jangan ganggu dia.”"
