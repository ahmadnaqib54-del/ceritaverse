{
  "series": "Separuh Hayat",
  "season": 2,
  "episode": 6,
  "title": "S2 E6",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 6\n## THE EXPANSION"
    },
    {
      "type": "paragraph",
      "text": "Pukul 10.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di bilik mesyuarat Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada lima orang."
    },
    {
      "type": "paragraph",
      "text": "Pengurus operasi."
    },
    {
      "type": "paragraph",
      "text": "Pengurus kewangan."
    },
    {
      "type": "paragraph",
      "text": "Pengurus logistik."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "Dan Hashim."
    },
    {
      "type": "paragraph",
      "text": "Hashim membuka mesyuarat."
    },
    {
      "type": "paragraph",
      "text": "“Mulai bulan depan, kita tambah kapasiti.”"
    },
    {
      "type": "paragraph",
      "text": "Seorang pengurus mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Berapa besar?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Rizal?”"
    },
    {
      "type": "paragraph",
      "text": "Semua mata beralih kepadanya."
    },
    {
      "type": "paragraph",
      "text": "Rizal membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Kalau ikut angka sekarang, kita boleh naik.”"
    },
    {
      "type": "paragraph",
      "text": "Pengurus operasi menyampuk."
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tapi bukan macam itu.”"
    },
    {
      "type": "paragraph",
      "text": "Suasana berubah."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik satu carta."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang sistem kita sudah hampir penuh.”"
    },
    {
      "type": "paragraph",
      "text": "Dia menunjuk beberapa angka."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tambah beban tanpa ubah struktur, masalah lama akan datang balik.”"
    },
    {
      "type": "paragraph",
      "text": "Pengurus itu mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Kita jangan tambah satu benda.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Kita tambah keseluruhan sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Dalam beberapa minggu berikutnya, perubahan berlaku."
    },
    {
      "type": "paragraph",
      "text": "Bukan satu tempat."
    },
    {
      "type": "paragraph",
      "text": "Banyak tempat."
    },
    {
      "type": "paragraph",
      "text": "Gudang diperluaskan."
    },
    {
      "type": "paragraph",
      "text": "Jadual operasi disusun semula."
    },
    {
      "type": "paragraph",
      "text": "Sistem inventori diperketat."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pembekal baru diperkenalkan."
    },
    {
      "type": "paragraph",
      "text": "Saluran penghantaran ditambah."
    },
    {
      "type": "paragraph",
      "text": "Rizal mula hadir dalam mesyuarat yang sebelum ini tidak pernah melibatkannya."
    },
    {
      "type": "paragraph",
      "text": "Pada mulanya, orang menganggap dia hanya orang baru."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mereka mula sedar sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Hashim mendengar cakap Rizal."
    },
    {
      "type": "paragraph",
      "text": "Dan itu membuat semua orang lain mula mendengar juga."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu petang, pengurus logistik datang."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua penghantaran bertindih.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat jadual."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Supplier ubah masa.”"
    },
    {
      "type": "paragraph",
      "text": "“Siapa luluskan?”"
    },
    {
      "type": "paragraph",
      "text": "“Pengurus.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia kata urgent.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Benda urgent bukan bermaksud benda itu betul.”"
    },
    {
      "type": "paragraph",
      "text": "Pengurus itu diam."
    },
    {
      "type": "paragraph",
      "text": "Rizal membetulkan jadual."
    },
    {
      "type": "paragraph",
      "text": "“Buat semula.”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan jangan ubah jadual tanpa maklumkan semua pihak.”"
    },
    {
      "type": "paragraph",
      "text": "Pengurus itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Adam yang duduk di sebelah Rizal hanya memandang."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Kau dah macam boss.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Belum?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat pintu."
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada masa yang sama, Amir semakin sibuk."
    },
    {
      "type": "paragraph",
      "text": "Siasatannya mula menghubungkan beberapa syarikat."
    },
    {
      "type": "paragraph",
      "text": "Tidak cukup untuk tindakan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk satu perkara."
    },
    {
      "type": "paragraph",
      "text": "Corak."
    },
    {
      "type": "paragraph",
      "text": "Bumi Perdana bukan satu-satunya syarikat yang kelihatan pelik."
    },
    {
      "type": "paragraph",
      "text": "Ada beberapa perniagaan lain yang mempunyai hubungan secara tidak langsung."
    },
    {
      "type": "paragraph",
      "text": "Satu restoran."
    },
    {
      "type": "paragraph",
      "text": "Satu gudang."
    },
    {
      "type": "paragraph",
      "text": "Beberapa pembekal."
    },
    {
      "type": "paragraph",
      "text": "Beberapa syarikat logistik."
    },
    {
      "type": "paragraph",
      "text": "Semua nampak normal secara berasingan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bila disusun bersama…"
    },
    {
      "type": "paragraph",
      "text": "Amir nampak sesuatu."
    },
    {
      "type": "paragraph",
      "text": "Satu rangkaian."
    },
    {
      "type": "paragraph",
      "text": "Dia menulis di papan putih:"
    },
    {
      "type": "paragraph",
      "text": "**HASHIM**"
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya:"
    },
    {
      "type": "paragraph",
      "text": "**NETWORK**"
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi perkataan."
    },
    {
      "type": "paragraph",
      "text": "**SUPPLIER**"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang semuanya."
    },
    {
      "type": "paragraph",
      "text": "“Siapa sebenarnya kau?”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam Jumaat."
    },
    {
      "type": "paragraph",
      "text": "Rizal makan bersama Linda."
    },
    {
      "type": "paragraph",
      "text": "Linda sedang mengira pakaian bayi."
    },
    {
      "type": "paragraph",
      "text": "“Awak tak pernah tanya.”"
    },
    {
      "type": "paragraph",
      "text": "“Tanya apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Doktor kata baby mungkin awal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus berhenti makan."
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Dalam beberapa minggu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa tak beritahu?”"
    },
    {
      "type": "paragraph",
      "text": "Linda tersenyum kecil."
    },
    {
      "type": "paragraph",
      "text": "“Saya dah beritahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Dua hari lepas.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Linda menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Itulah.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunduk."
    },
    {
      "type": "paragraph",
      "text": "“Saya minta maaf.”"
    },
    {
      "type": "paragraph",
      "text": "Linda memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Awak terlalu sibuk.”"
    },
    {
      "type": "paragraph",
      "text": "“Saya tahu.”"
    },
    {
      "type": "paragraph",
      "text": "“Dengan kerja?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Linda tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya harap kerja itu berbaloi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu menjawab."
    },
    {
      "type": "paragraph",
      "text": "Tetapi tidak ada jawapan yang cukup baik."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa hari kemudian, Hashim membawa Rizal ke sebuah bangunan baru."
    },
    {
      "type": "paragraph",
      "text": "“Ini?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat bangunan itu."
    },
    {
      "type": "paragraph",
      "text": "“Cawangan baru.”"
    },
    {
      "type": "paragraph",
      "text": "“Untuk apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Pusat operasi.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berjalan masuk."
    },
    {
      "type": "paragraph",
      "text": "Kosong."
    },
    {
      "type": "paragraph",
      "text": "Masih baru."
    },
    {
      "type": "paragraph",
      "text": "Hashim berdiri di sebelahnya."
    },
    {
      "type": "paragraph",
      "text": "“Saya nak awak uruskan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Pusat ini.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa saya?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sebab awak tahu bagaimana sistem bergerak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat ruang itu."
    },
    {
      "type": "paragraph",
      "text": "Besar."
    },
    {
      "type": "paragraph",
      "text": "Lebih besar daripada apa yang pernah dia uruskan."
    },
    {
      "type": "paragraph",
      "text": "“Adam?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Adam bagus dalam bidang dia.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Tapi awak…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…awak boleh nampak keseluruhan gambar.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyerahkan kunci."
    },
    {
      "type": "paragraph",
      "text": "“Mulai sekarang, awak ada kuasa buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil kunci itu."
    },
    {
      "type": "paragraph",
      "text": "Beratnya bukan pada logam."
    },
    {
      "type": "paragraph",
      "text": "Tetapi pada maksudnya."
    },
    {
      "type": "paragraph",
      "text": "Ini kali pertama Hashim menyerahkan sesuatu yang benar-benar penting kepadanya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Adam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Hashim bagi kau pusat operasi?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Masalah?”"
    },
    {
      "type": "paragraph",
      "text": "“Tak.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Dia percaya kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyandarkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Jangan terlalu percaya balik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab orang yang beri kita kuasa…”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…boleh tarik balik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang Adam."
    },
    {
      "type": "paragraph",
      "text": "“Kau takut?”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Aku berhati-hati.”"
    },
    {
      "type": "paragraph",
      "text": "“Bezanya?”"
    },
    {
      "type": "paragraph",
      "text": "“Takut buat kita lari.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menunjuk kepala Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Berhati-hati buat kita hidup.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Falsafah baru?”"
    },
    {
      "type": "paragraph",
      "text": "“Pengalaman lama.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pusat operasi baru mula berfungsi."
    },
    {
      "type": "paragraph",
      "text": "Rizal bekerja hampir setiap hari."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak lagi menunggu Hashim memberi arahan."
    },
    {
      "type": "paragraph",
      "text": "Dia mula membuat keputusan sendiri."
    },
    {
      "type": "paragraph",
      "text": "Masalah kecil diselesaikan tanpa Hashim."
    },
    {
      "type": "paragraph",
      "text": "Masalah besar dibentangkan dengan pilihan."
    },
    {
      "type": "paragraph",
      "text": "Hashim hanya memilih."
    },
    {
      "type": "paragraph",
      "text": "Lama-kelamaan, orang mula datang terus kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Rizal, masalah ni.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal, supplier ni.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal, jadual ni.”"
    },
    {
      "type": "paragraph",
      "text": "“Rizal, angka ni.”"
    },
    {
      "type": "paragraph",
      "text": "Dan setiap kali seseorang datang, Rizal menyelesaikannya."
    },
    {
      "type": "paragraph",
      "text": "Sedikit demi sedikit, satu perkara berlaku."
    },
    {
      "type": "paragraph",
      "text": "Orang mula menganggap Rizal sebagai pusat."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pada suatu malam, Farid berdiri di luar pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia menunggu Rizal keluar."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh cakap?”"
    },
    {
      "type": "paragraph",
      "text": "“Boleh.”"
    },
    {
      "type": "paragraph",
      "text": "Farid memandang sekeliling."
    },
    {
      "type": "paragraph",
      "text": "“Kau makin banyak orang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Orang?”"
    },
    {
      "type": "paragraph",
      "text": "“Yang ikut kau.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Saya tak suruh mereka ikut.”"
    },
    {
      "type": "paragraph",
      "text": "Farid mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Itulah masalahnya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Farid menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Orang tak ikut orang yang suruh.”"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Orang ikut orang yang mereka percaya boleh bawa mereka keluar bila keadaan jadi buruk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat Farid."
    },
    {
      "type": "paragraph",
      "text": "“Kau percaya aku?”"
    },
    {
      "type": "paragraph",
      "text": "Farid menjawab tanpa ragu."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal berdiri sendirian."
    },
    {
      "type": "paragraph",
      "text": "Ayat itu tinggal dalam fikirannya."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Sementara itu, Amir akhirnya bertemu seseorang."
    },
    {
      "type": "paragraph",
      "text": "Ah Len."
    },
    {
      "type": "paragraph",
      "text": "Bilik soal siasat sunyi."
    },
    {
      "type": "paragraph",
      "text": "Ah Len duduk tenang."
    },
    {
      "type": "paragraph",
      "text": "Amir membuka fail."
    },
    {
      "type": "paragraph",
      "text": "“Kita ulang.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak penat?”"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Amir meletakkan beberapa dokumen."
    },
    {
      "type": "paragraph",
      "text": "“Siapa supplier?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len diam."
    },
    {
      "type": "paragraph",
      "text": "Amir menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Bumi Perdana?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len masih diam."
    },
    {
      "type": "paragraph",
      "text": "Amir menukar soalan."
    },
    {
      "type": "paragraph",
      "text": "“Hashim?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dato’?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len bersandar."
    },
    {
      "type": "paragraph",
      "text": "“Dato’ Hashim bukan orang yang kau cari.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Dia businessman.”"
    },
    {
      "type": "paragraph",
      "text": "Amir ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Semua orang yang kita tangkap pun businessman.”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Amir mencondongkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Siapa di belakang semua ni?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nak cari orang paling penting…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…jangan cari orang yang paling banyak bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Amir menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Cari orang yang orang lain tunggu untuk bercakap.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mencatat."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Ah Len tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Tak tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Amir tahu dia berbohong."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir pulang ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka telefon."
    },
    {
      "type": "paragraph",
      "text": "Ada mesej daripada Linda."
    },
    {
      "type": "paragraph",
      "text": "**Esok datang makan. Rizal pun ada.**"
    },
    {
      "type": "paragraph",
      "text": "Amir tersenyum."
    },
    {
      "type": "paragraph",
      "text": "Dia membalas."
    },
    {
      "type": "paragraph",
      "text": "**Boleh.**"
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat papan putih di pejabatnya."
    },
    {
      "type": "paragraph",
      "text": "Nama Hashim masih di situ."
    },
    {
      "type": "paragraph",
      "text": "Di bawahnya, satu ruang kosong."
    },
    {
      "type": "paragraph",
      "text": "Nama yang belum dapat dia buktikan."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Esoknya, makan tengah hari keluarga."
    },
    {
      "type": "paragraph",
      "text": "Linda."
    },
    {
      "type": "paragraph",
      "text": "Rizal."
    },
    {
      "type": "paragraph",
      "text": "Amir."
    },
    {
      "type": "paragraph",
      "text": "Roy."
    },
    {
      "type": "paragraph",
      "text": "Suasana santai."
    },
    {
      "type": "paragraph",
      "text": "Roy bercerita tentang sekolah."
    },
    {
      "type": "paragraph",
      "text": "Amir mengusik Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Kau makin sibuk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Kerja.”"
    },
    {
      "type": "paragraph",
      "text": "Amir memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kerja apa sampai macam CEO?”"
    },
    {
      "type": "paragraph",
      "text": "Linda menyampuk."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tanya dia.”"
    },
    {
      "type": "paragraph",
      "text": "Semua ketawa."
    },
    {
      "type": "paragraph",
      "text": "Rizal turut ketawa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Amir memerhatikannya."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai abang ipar."
    },
    {
      "type": "paragraph",
      "text": "Sebagai penyiasat."
    },
    {
      "type": "paragraph",
      "text": "Cara Rizal menjawab."
    },
    {
      "type": "paragraph",
      "text": "Cara dia berhenti sebelum menjawab."
    },
    {
      "type": "paragraph",
      "text": "Cara dia mengalihkan topik."
    },
    {
      "type": "paragraph",
      "text": "Kecil."
    },
    {
      "type": "paragraph",
      "text": "Sangat kecil."
    },
    {
      "type": "paragraph",
      "text": "Tetapi Amir mula melihat."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Roy berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Ayah selalu balik malam sekarang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang anaknya."
    },
    {
      "type": "paragraph",
      "text": "Linda terdiam."
    },
    {
      "type": "paragraph",
      "text": "Amir tidak berkata apa-apa."
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat kemudian dia"
    }
  ],
