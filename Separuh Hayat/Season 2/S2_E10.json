{
  "series": "Separuh Hayat",
  "season": 2,
  "episode": 10,
  "title": "S2 E10",
  "content": [
    {
      "type": "paragraph",
      "text": "# SEASON 2 — EPISODE 10\n## THE PLAN"
    },
    {
      "type": "paragraph",
      "text": "Pukul 7.00 pagi."
    },
    {
      "type": "paragraph",
      "text": "Rizal sudah berada di pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada tiga perkara."
    },
    {
      "type": "paragraph",
      "text": "Laporan kewangan."
    },
    {
      "type": "paragraph",
      "text": "Struktur operasi."
    },
    {
      "type": "paragraph",
      "text": "Dan gambar rumahnya."
    },
    {
      "type": "paragraph",
      "text": "Gambar itu masih berada di dalam fail."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak membuangnya."
    },
    {
      "type": "paragraph",
      "text": "Bukan kerana takut."
    },
    {
      "type": "paragraph",
      "text": "Tetapi kerana dia mahu mengingatinya."
    },
    {
      "type": "paragraph",
      "text": "Apa yang dipertaruhkan."
    },
    {
      "type": "paragraph",
      "text": "Telefon berbunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam."
    },
    {
      "type": "paragraph",
      "text": "“Dah sampai?”"
    },
    {
      "type": "paragraph",
      "text": "“Dah.”"
    },
    {
      "type": "paragraph",
      "text": "“Aku datang.”"
    },
    {
      "type": "paragraph",
      "text": "Panggilan tamat."
    },
    {
      "type": "paragraph",
      "text": "Rizal menutup fail."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat carta besar di dinding."
    },
    {
      "type": "paragraph",
      "text": "Sistem Hashim."
    },
    {
      "type": "paragraph",
      "text": "Selama berbulan-bulan, dia belajar memahaminya."
    },
    {
      "type": "paragraph",
      "text": "Hari ini dia melihatnya dengan cara yang berbeza."
    },
    {
      "type": "paragraph",
      "text": "Bukan sebagai sistem yang perlu dia urus."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebagai sistem yang perlu dia **warisi**."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Adam masuk beberapa minit kemudian."
    },
    {
      "type": "paragraph",
      "text": "Dia duduk tanpa bercakap."
    },
    {
      "type": "paragraph",
      "text": "Rizal menolak satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Buka.”"
    },
    {
      "type": "paragraph",
      "text": "Adam membuka."
    },
    {
      "type": "paragraph",
      "text": "“Ini apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Semua yang kita tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam membaca."
    },
    {
      "type": "paragraph",
      "text": "Struktur syarikat."
    },
    {
      "type": "paragraph",
      "text": "Operasi."
    },
    {
      "type": "paragraph",
      "text": "Aset."
    },
    {
      "type": "paragraph",
      "text": "Orang penting."
    },
    {
      "type": "paragraph",
      "text": "Hubungan."
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat muka."
    },
    {
      "type": "paragraph",
      "text": "“Kau buat ni bila?”"
    },
    {
      "type": "paragraph",
      "text": "“Semalam.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menyandarkan badan."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Sebab kita perlu tahu apa yang kita ada.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Kita?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menutup fail."
    },
    {
      "type": "paragraph",
      "text": "“Kau dah fikir jauh.”"
    },
    {
      "type": "paragraph",
      "text": "“Hashim pun fikir jauh.”"
    },
    {
      "type": "paragraph",
      "text": "“Bukan itu yang aku maksudkan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Adam melihatnya lama."
    },
    {
      "type": "paragraph",
      "text": "“Kau nak ambil alih?”"
    },
    {
      "type": "paragraph",
      "text": "Soalan itu akhirnya keluar."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak terus menjawab."
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Aku nak sistem yang boleh kita kawal.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "“Itu bukan jawapan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau Hashim hilang, sistem akan jatuh.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menggeleng."
    },
    {
      "type": "paragraph",
      "text": "“Tak semestinya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunjuk carta."
    },
    {
      "type": "paragraph",
      "text": "“Banyak perkara bergantung kepada dia.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi kita boleh buat lebih baik.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa kecil."
    },
    {
      "type": "paragraph",
      "text": "“Kau dengar tak apa yang kau cakap?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Kau sekarang bercakap macam Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Tidak.”"
    },
    {
      "type": "paragraph",
      "text": "Dia melihat carta."
    },
    {
      "type": "paragraph",
      "text": "“Aku bercakap macam orang yang dah belajar daripada Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Mereka diam lama."
    },
    {
      "type": "paragraph",
      "text": "Akhirnya Adam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nak dia keluar…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memotong."
    },
    {
      "type": "paragraph",
      "text": "“Jangan cakap benda yang kita belum buat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Baik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Kita bukan bincang cara.”"
    },
    {
      "type": "paragraph",
      "text": "Dia mengetuk fail."
    },
    {
      "type": "paragraph",
      "text": "“Kita bincang sama ada perlu.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Itu perbezaan penting."
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak mahu bergerak kerana marah."
    },
    {
      "type": "paragraph",
      "text": "Dia mahu bergerak kerana logik."
    },
    {
      "type": "paragraph",
      "text": "Sekurang-kurangnya itu yang dia katakan kepada dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Tengah hari."
    },
    {
      "type": "paragraph",
      "text": "Hashim memanggil Rizal."
    },
    {
      "type": "paragraph",
      "text": "Mereka duduk berdua."
    },
    {
      "type": "paragraph",
      "text": "“Ada berita?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "“Orang yang ancam kita?”"
    },
    {
      "type": "paragraph",
      "text": "“Masih belum diketahui.”"
    },
    {
      "type": "paragraph",
      "text": "Hashim mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya nak awak keluar dari beberapa keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Keselamatan.”"
    },
    {
      "type": "paragraph",
      "text": "“Awak tak percaya saya?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bukan.”"
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Semakin banyak awak tahu, semakin besar risiko kepada awak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terdiam."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Saya tak mahu awak terperangkap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Untuk seketika, dia hampir percaya."
    },
    {
      "type": "paragraph",
      "text": "Hampir."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Awak masih guru.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "“Awak ada keluarga.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jangan lupa.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Petang itu, Rizal kembali ke sekolah."
    },
    {
      "type": "paragraph",
      "text": "Kelas berjalan seperti biasa."
    },
    {
      "type": "paragraph",
      "text": "Dia mengajar."
    },
    {
      "type": "paragraph",
      "text": "Menjawab soalan."
    },
    {
      "type": "paragraph",
      "text": "Menegur pelajar."
    },
    {
      "type": "paragraph",
      "text": "Ketawa."
    },
    {
      "type": "paragraph",
      "text": "Tetapi fikirannya berada di tempat lain."
    },
    {
      "type": "paragraph",
      "text": "Seorang pelajar datang selepas kelas."
    },
    {
      "type": "paragraph",
      "text": "“Cikgu.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu nampak macam penat.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Memang.”"
    },
    {
      "type": "paragraph",
      "text": "“Cikgu ada masalah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Semua orang ada masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Macam mana nak selesaikan?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam seketika."
    },
    {
      "type": "paragraph",
      "text": "“Jangan tambah masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Senanglah cikgu cakap.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal turut ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Pelajar itu pergi."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk seorang diri."
    },
    {
      "type": "paragraph",
      "text": "Dia melihat papan putih."
    },
    {
      "type": "paragraph",
      "text": "Ada satu ayat yang dia tulis tadi:"
    },
    {
      "type": "paragraph",
      "text": "**SETIAP TINDAKAN ADA KESAN.**"
    },
    {
      "type": "paragraph",
      "text": "Dia memandang ayat itu lama."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Amir datang ke rumah."
    },
    {
      "type": "paragraph",
      "text": "Rizal baru pulang."
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Linda membuka pintu."
    },
    {
      "type": "paragraph",
      "text": "“Masuklah.”"
    },
    {
      "type": "paragraph",
      "text": "Amir masuk."
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk di ruang tamu."
    },
    {
      "type": "paragraph",
      "text": "“Kau datang sebab apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Makan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Bagus.”"
    },
    {
      "type": "paragraph",
      "text": "Mereka makan bersama."
    },
    {
      "type": "paragraph",
      "text": "Selepas beberapa ketika, Amir berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kau kerja dengan Hashim lama dah?”"
    },
    {
      "type": "paragraph",
      "text": "“Agak.”"
    },
    {
      "type": "paragraph",
      "text": "“Ok?”"
    },
    {
      "type": "paragraph",
      "text": "“Ok.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia orang baik?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti makan."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Saja.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dia businessman.”"
    },
    {
      "type": "paragraph",
      "text": "Amir ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Aku tanya baik atau tak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Tak ada orang seratus peratus baik.”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Betul.”"
    },
    {
      "type": "paragraph",
      "text": "Kemudian dia berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau kau nampak sesuatu pelik…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“…beritahu aku.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Sebagai polis?”"
    },
    {
      "type": "paragraph",
      "text": "Amir mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Sebagai adik.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Amir bangun."
    },
    {
      "type": "paragraph",
      "text": "“Sebab kalau kau tak beritahu…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…aku mungkin jumpa sendiri.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat Amir keluar."
    },
    {
      "type": "paragraph",
      "text": "Untuk beberapa saat, dia tidak bergerak."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Pukul 11.30 malam."
    },
    {
      "type": "paragraph",
      "text": "Rizal dan Adam bertemu."
    },
    {
      "type": "paragraph",
      "text": "Tempat itu sunyi."
    },
    {
      "type": "paragraph",
      "text": "Adam bertanya,"
    },
    {
      "type": "paragraph",
      "text": "“Dia dah datang?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Dia tahu?”"
    },
    {
      "type": "paragraph",
      "text": "“Belum.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghela nafas."
    },
    {
      "type": "paragraph",
      "text": "“Ini makin bahaya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "“Kita ada dua masalah.”"
    },
    {
      "type": "paragraph",
      "text": "Adam menunggu."
    },
    {
      "type": "paragraph",
      "text": "“Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan?”"
    },
    {
      "type": "paragraph",
      "text": "“Amir.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambil pen."
    },
    {
      "type": "paragraph",
      "text": "Dia melukis satu garis."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu lagi."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita bergerak terhadap Hashim sekarang, kita beri Amir lebih banyak alasan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam diam."
    },
    {
      "type": "paragraph",
      "text": "“Kalau kita tak bergerak…”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…Hashim mungkin bergerak terhadap kita.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Jadi?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal meletakkan pen."
    },
    {
      "type": "paragraph",
      "text": "“Kita tunggu.”"
    },
    {
      "type": "paragraph",
      "text": "“Berapa lama?”"
    },
    {
      "type": "paragraph",
      "text": "“Sehingga kita tahu siapa yang menyerang Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengerutkan dahi."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab orang itu mungkin akan membuka jalan untuk kita.”"
    },
    {
      "type": "paragraph",
      "text": "Adam terdiam."
    },
    {
      "type": "paragraph",
      "text": "Rizal menyambung,"
    },
    {
      "type": "paragraph",
      "text": "“Kalau Hashim lemah, kita tak perlu paksa sistem.”"
    },
    {
      "type": "paragraph",
      "text": "“Kita cuma perlu pastikan sistem terus berjalan.”"
    },
    {
      "type": "paragraph",
      "text": "Adam memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Dan kalau dia tak lemah?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Then we become the weakness.”"
    },
    {
      "type": "paragraph",
      "text": "Adam tersenyum hambar."
    },
    {
      "type": "paragraph",
      "text": "“Sekarang baru aku kenal kau.”"
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Beberapa minggu berlalu."
    },
    {
      "type": "paragraph",
      "text": "Ancaman semakin jelas."
    },
    {
      "type": "paragraph",
      "text": "Seorang pengurus berhenti."
    },
    {
      "type": "paragraph",
      "text": "Kemudian seorang pembekal."
    },
    {
      "type": "paragraph",
      "text": "Satu kontrak dibatalkan."
    },
    {
      "type": "paragraph",
      "text": "Hashim kehilangan beberapa hubungan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi dia masih berdiri."
    },
    {
      "type": "paragraph",
      "text": "Lebih keras."
    },
    {
      "type": "paragraph",
      "text": "Lebih berhati-hati."
    },
    {
      "type": "paragraph",
      "text": "Dan lebih curiga."
    },
    {
      "type": "paragraph",
      "text": "Dia mula memeriksa orang sekeliling."
    },
    {
      "type": "paragraph",
      "text": "Termasuk Rizal."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Suatu malam, Hashim memanggil Rizal."
    },
    {
      "type": "paragraph",
      "text": "“Duduk.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal duduk."
    },
    {
      "type": "paragraph",
      "text": "Hashim membuka satu fail."
    },
    {
      "type": "paragraph",
      "text": "“Ada seseorang dalam sistem saya yang saya tak percaya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Belum tahu.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal menunggu."
    },
    {
      "type": "paragraph",
      "text": "Hashim berkata,"
    },
    {
      "type": "paragraph",
      "text": "“Saya mahu awak cari.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Saya?”"
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab awak nampak apa yang saya tak nampak.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "Hashim menyerahkan fail."
    },
    {
      "type": "paragraph",
      "text": "“Cari.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengambilnya."
    },
    {
      "type": "paragraph",
      "text": "“Kalau saya jumpa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menjawab,"
    },
    {
      "type": "paragraph",
      "text": "“Beritahu saya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Dia keluar."
    },
    {
      "type": "paragraph",
      "text": "Tetapi sebaik pintu tertutup, dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "Ada sesuatu yang tidak kena."
    },
    {
      "type": "paragraph",
      "text": "Hashim sedang meminta dia mencari pengkhianat."
    },
    {
      "type": "paragraph",
      "text": "Tetapi bagaimana kalau pengkhianat itu sebenarnya tidak wujud?"
    },
    {
      "type": "paragraph",
      "text": "Bagaimana kalau Hashim cuma semakin paranoid?"
    },
    {
      "type": "paragraph",
      "text": "Dan kalau begitu…"
    },
    {
      "type": "paragraph",
      "text": "Hashim sedang melemahkan sistemnya sendiri."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Rizal kembali ke pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Dia membuka fail."
    },
    {
      "type": "paragraph",
      "text": "Adam masuk."
    },
    {
      "type": "paragraph",
      "text": "“Dapat kerja baru?”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "“Cari pengkhianat.”"
    },
    {
      "type": "paragraph",
      "text": "Adam ketawa."
    },
    {
      "type": "paragraph",
      "text": "“Senang.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Kenapa?”"
    },
    {
      "type": "paragraph",
      "text": "“Sebab aku tahu siapa.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangkat kening."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menunjuk kepada fail."
    },
    {
      "type": "paragraph",
      "text": "“Hashim.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak ketawa."
    },
    {
      "type": "paragraph",
      "text": "Adam pun berhenti tersenyum."
    },
    {
      "type": "paragraph",
      "text": "“Dia dah mula takut.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal mengangguk."
    },
    {
      "type": "paragraph",
      "text": "“Ya.”"
    },
    {
      "type": "paragraph",
      "text": "“Dan orang yang takut…”"
    },
    {
      "type": "paragraph",
      "text": "Adam berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…buat keputusan berdasarkan ketakutan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang carta sistem di dinding."
    },
    {
      "type": "paragraph",
      "text": "Kemudian satu perkara menjadi jelas."
    },
    {
      "type": "paragraph",
      "text": "Hashim sedang kehilangan perkara paling penting yang dia ajar kepada Rizal."
    },
    {
      "type": "paragraph",
      "text": "Kawalan."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Malam itu, Rizal berdiri di luar pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar."
    },
    {
      "type": "paragraph",
      "text": "Mesej daripada nombor tidak dikenali."
    },
    {
      "type": "paragraph",
      "text": "**“Kau nak tahu siapa yang jatuhkan Hashim?”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal membaca."
    },
    {
      "type": "paragraph",
      "text": "Mesej kedua masuk."
    },
    {
      "type": "paragraph",
      "text": "**“Bukan Amir.”**"
    },
    {
      "type": "paragraph",
      "text": "Ketiga."
    },
    {
      "type": "paragraph",
      "text": "**“Bukan orang lama dia.”**"
    },
    {
      "type": "paragraph",
      "text": "Keempat."
    },
    {
      "type": "paragraph",
      "text": "**“Orang paling dekat dengan dia.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal berhenti."
    },
    {
      "type": "paragraph",
      "text": "Jantungnya berdegup lebih laju."
    },
    {
      "type": "paragraph",
      "text": "Dia menaip:"
    },
    {
      "type": "paragraph",
      "text": "**“Siapa?”**"
    },
    {
      "type": "paragraph",
      "text": "Beberapa saat."
    },
    {
      "type": "paragraph",
      "text": "Tiada jawapan."
    },
    {
      "type": "paragraph",
      "text": "Kemudian mesej masuk."
    },
    {
      "type": "paragraph",
      "text": "**“Tanya cermin.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandang skrin."
    },
    {
      "type": "paragraph",
      "text": "Dia mengangkat kepala."
    },
    {
      "type": "paragraph",
      "text": "Di hadapannya ada kaca gelap pusat operasi."
    },
    {
      "type": "paragraph",
      "text": "Pantulan dirinya sendiri."
    },
    {
      "type": "paragraph",
      "text": "Dia faham."
    },
    {
      "type": "paragraph",
      "text": "Atau sekurang-kurangnya dia fikir dia faham."
    },
    {
      "type": "paragraph",
      "text": "Telefon bergetar sekali lagi."
    },
    {
      "type": "paragraph",
      "text": "**“Esok Hashim akan buat keputusan yang tak boleh diundur.”**"
    },
    {
      "type": "paragraph",
      "text": "Rizal menatap mesej itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian memandang bangunan Bumi Perdana."
    },
    {
      "type": "paragraph",
      "text": "Untuk pertama kali, dia sedar bahawa mungkin rancangan itu tidak lagi berada di tangan mereka."
    },
    {
      "type": "paragraph",
      "text": "Mungkin seseorang lain sudah mula bermain."
    },
    {
      "type": "paragraph",
      "text": "Dan mungkin…"
    },
    {
      "type": "paragraph",
      "text": "mereka sedang bermain tepat seperti yang orang itu mahu."
    },
    {
      "type": "paragraph",
      "text": "---"
    },
    {
      "type": "paragraph",
      "text": "Keesokan pagi."
    },
    {
      "type": "paragraph",
      "text": "Hashim masuk ke pejabat."
    },
    {
      "type": "paragraph",
      "text": "Dia meletakkan satu fail di atas meja."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "“Ya?”"
    },
    {
      "type": "paragraph",
      "text": "“Saya dah buat keputusan.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Keputusan apa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim menutup pintu."
    },
    {
      "type": "paragraph",
      "text": "“Mulai hari ini…”"
    },
    {
      "type": "paragraph",
      "text": "Dia berhenti."
    },
    {
      "type": "paragraph",
      "text": "“…saya akan potong beberapa orang daripada sistem.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal terus faham."
    },
    {
      "type": "paragraph",
      "text": "“Siapa?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim memandangnya."
    },
    {
      "type": "paragraph",
      "text": "“Semua yang saya tak percaya.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal diam."
    },
    {
      "type": "paragraph",
      "text": "“Termasuk?”"
    },
    {
      "type": "paragraph",
      "text": "Hashim tidak menjawab."
    },
    {
      "type": "paragraph",
      "text": "Tetapi pandangan mereka bertemu."
    },
    {
      "type": "paragraph",
      "text": "Dan untuk pertama kali…"
    },
    {
      "type": "paragraph",
      "text": "Rizal tidak tahu sama ada Hashim sedang meminta bantuan."
    },
    {
      "type": "paragraph",
      "text": "Atau sedang menguji kesetiaan."
    },
    {
      "type": "paragraph",
      "text": "Di luar pejabat, Adam menerima satu mesej."
    },
    {
      "type": "paragraph",
      "text": "Dia membaca."
    },
    {
      "type": "paragraph",
      "text": "Wajahnya berubah."
    },
    {
      "type": "paragraph",
      "text": "Dia terus masuk."
    },
    {
      "type": "paragraph",
      "text": "“Rizal.”"
    },
    {
      "type": "paragraph",
      "text": "Rizal berpaling."
    },
    {
      "type": "paragraph",
      "text": "“Apa?”"
    },
    {
      "type": "paragraph",
      "text": "Adam menghulurkan telefon."
    },
    {
      "type": "paragraph",
      "text": "Satu berita."
    },
    {
      "type": "paragraph",
      "text": "Satu lagi syarikat berkaitan dengan rangkaian Hashim telah diserbu pihak berkuasa."
    },
    {
      "type": "paragraph",
      "text": "Tiada nama disebut."
    },
    {
      "type": "paragraph",
      "text": "Tetapi cukup untuk membuat semua orang faham."
    },
    {
      "type": "paragraph",
      "text": "Amir semakin hampir."
    },
    {
      "type": "paragraph",
      "text": "Rizal melihat berita itu."
    },
    {
      "type": "paragraph",
      "text": "Kemudian melihat Hashim."
    },
    {
      "type": "paragraph",
      "text": "Kemudian Adam."
    },
    {
      "type": "paragraph",
      "text": "Tiga lelaki."
    },
    {
      "type": "paragraph",
      "text": "Tiga pilihan."
    },
    {
      "type": "paragraph",
      "text": "Dan satu sistem yang mula retak dari semua arah."
    },
    {
      "type": "paragraph",
      "text": "Rizal menarik nafas."
    },
    {
      "type": "paragraph",
      "text": "Kemudian berkata perlahan,"
    },
    {
      "type": "paragraph",
      "text": "“Sekarang kita tak boleh tunggu lagi.”"
    },
    {
      "type": "paragraph",
      "text": "Adam mengangguk."
    },
    {
      "type": "paragraph",
      "text": "Hashim memandang mereka berdua."
    },
    {
      "type": "paragraph",
      "text": "Dia tidak tahu apa yang mereka sudah putuskan."
    },
    {
      "type": "paragraph",
      "text": "Tetapi mungkin…"
    },
    {
      "type": "paragraph",
      "text": "sudah terlambat untuk mengetahuinya."
    },
    {
      "type": "paragraph",
      "text": "**TAMAT EPISODE 10**"
    }
  ],
